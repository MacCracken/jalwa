[package]
name = "jalwa"
version = "0.1.0"
description = "jalwa — AI-native media player for AGNOS. Cyrius port of a 15,355-line Rust workspace (rust-old/)."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.4.29"

[build]
entry = "src/main.cyr"
output = "jalwa"

[deps]
stdlib = ["string", "fmt", "alloc", "vec", "str", "syscalls", "io", "args", "assert", "math", "random", "chrono", "patra", "fs"]
