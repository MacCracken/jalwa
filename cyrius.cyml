[package]
name = "jalwa"
version = "0.1.0"
description = "jalwa — AI-native media player for AGNOS. Cyrius port of a 15,355-line Rust workspace (rust-old/)."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.4.29"

[build]
entry = "src/main.cyr"
output = "jalwa"

[deps]
stdlib = ["string", "fmt", "alloc", "vec", "str", "syscalls", "io", "args", "assert", "math", "random", "chrono", "patra", "fs", "yukti", "hashmap", "tagged", "process"]

[deps.dhvani]
path = "../dhvani"
tag = "2.2.1"
modules = ["dist/dhvani.cyr"]

[deps.abaco]
path = "../abaco"
tag = "2.3.2"
modules = ["dist/abaco.cyr"]
