[package]
name = "jalwa"
version = "0.1.0"
description = "jalwa — Cyrius port (from 2076 lines of Rust)"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.4.29"

[build]
entry = "src/main.cyr"
output = "jalwa"

[deps]
stdlib = ["string", "fmt", "alloc", "vec", "str", "syscalls", "io", "args", "assert"]
