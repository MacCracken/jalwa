[package]
name = "jalwa"
version = "0.1.0"
description = "jalwa — AI-native media player for AGNOS. Cyrius port of a 15,355-line Rust workspace (rust-old/)."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.4.29"

[build]
entry = "src/main.cyr"
output = "jalwa"

[deps]
stdlib = ["string", "fmt", "alloc", "vec", "str", "syscalls", "io", "args", "assert", "math", "random", "chrono", "patra", "fs", "yukti", "hashmap", "tagged", "process", "ganita", "thread", "fnptr", "bayan", "freelist", "sakshi", "atomic", "sync", "thread_local"]

[deps.dhvani]
path = "../dhvani"
tag = "2.2.1"
modules = ["dist/dhvani.cyr"]

[deps.abaco]
path = "../abaco"
tag = "2.3.2"
modules = ["dist/abaco.cyr"]

[deps.darshana]
path = "../darshana"
tag = "0.9.0"
modules = ["dist/darshana.cyr"]

# sankoch before shravan (shravan depends on sankoch). Audio codecs (decode/probe/
# tags) go through shravan -- tarang is video-only.
[deps.sankoch]
path = "../sankoch"
tag = "2.4.9"
modules = ["dist/sankoch.cyr"]

[deps.shravan]
path = "../shravan"
tag = "2.6.7"
modules = ["dist/shravan.cyr"]

# vani = ALSA/agnos audio OUTPUT (playback sink). Audio pipeline:
# shravan decode -> dhvani DSP -> vani out. Not tarang (video-only).
[deps.vani]
path = "../vani"
tag = "1.0.0"
modules = ["dist/vani.cyr"]

# kashi — freestanding VGA 8x16 font-data core (zero stdlib: load8/store8 + arithmetic).
# Provides kashi_glyph_row(font_id, ch, row) for the GUI CPU rasterizer (src/gui/raster.cyr).
[deps.kashi]
path = "../kashi"
tag = "1.0.2"
modules = ["src/font_data.cyr"]
