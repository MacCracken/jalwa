# core_types.tcyr -- parity tests for src/core/types.cyr (enums + PlaybackStatus).
# Ported one-for-one from the #[test] blocks in
# rust-old/crates/jalwa-core/src/lib.rs:
#   media_type_display, repeat_mode_cycle, repeat_mode_display,
#   playback_state_display, playback_status_stopped, playback_status_progress,
#   playback_status_progress_zero_duration.
# The *_serialization tests (serde round-trip) are DROPPED (no serde; the integer
# code IS the identity). Playlist/PlayQueue/MediaItem/Library tests land with
# those types.

include "src/error.cyr"
include "src/core/types.cyr"

# Helper (was inline `(0..n).map(|_| Uuid::new_v4()).collect()` in the Rust
# tests): return a vec of n fresh v4 uuids. Kept in fn scope so the loop var
# doesn't collide across the top-level test statements.
fn make_ids(n) {
    var v = vec_new();
    for (var i = 0; i < n; i = i + 1) { vec_push(v, jlw_uuid_v4()); }
    return v;
}

alloc_init();

# ---- media_type_display ----
test_group("MediaType display");
assert_streq(jlw_media_type_name(JLW_MEDIA_AUDIO), "audio", "Audio");
assert_streq(jlw_media_type_name(JLW_MEDIA_VIDEO), "video", "Video");

# ---- ContainerFormat / AudioCodec / VideoCodec names (Debug-derived) ----
test_group("format/codec names");
assert_streq(jlw_container_format_name(JLW_FMT_FLAC), "Flac", "Flac");
assert_streq(jlw_container_format_name(JLW_FMT_WEBM), "WebM", "WebM");
assert_streq(jlw_audio_codec_name(JLW_ACODEC_VORBIS), "Vorbis", "Vorbis");
assert_streq(jlw_video_codec_name(JLW_VCODEC_H264), "H264", "H264");

# ---- repeat_mode_cycle ----
test_group("RepeatMode cycle");
assert_eq(jlw_repeat_mode_cycle(JLW_REPEAT_OFF), JLW_REPEAT_ONE, "Off->One");
assert_eq(jlw_repeat_mode_cycle(JLW_REPEAT_ONE), JLW_REPEAT_ALL, "One->All");
assert_eq(jlw_repeat_mode_cycle(JLW_REPEAT_ALL), JLW_REPEAT_OFF, "All->Off");

# ---- repeat_mode_display ----
test_group("RepeatMode display");
assert_streq(jlw_repeat_mode_name(JLW_REPEAT_OFF), "off", "off");
assert_streq(jlw_repeat_mode_name(JLW_REPEAT_ONE), "one", "one");
assert_streq(jlw_repeat_mode_name(JLW_REPEAT_ALL), "all", "all");

# ---- playback_state_display ----
test_group("PlaybackState display");
assert_streq(jlw_playback_state_name(JLW_STATE_STOPPED),   "stopped",   "stopped");
assert_streq(jlw_playback_state_name(JLW_STATE_PLAYING),   "playing",   "playing");
assert_streq(jlw_playback_state_name(JLW_STATE_PAUSED),    "paused",    "paused");
assert_streq(jlw_playback_state_name(JLW_STATE_BUFFERING), "buffering", "buffering");

# ---- playback_status_stopped ----
test_group("PlaybackStatus stopped");
var st = jlw_pb_status_stopped();
assert_eq(JlwPlaybackStatus_state(st), JLW_STATE_STOPPED, "state stopped");
assert_eq(JlwPlaybackStatus_volume(st), 1.0, "volume 1.0");
assert_eq(JlwPlaybackStatus_muted(st), 0, "not muted");
assert_eq(jlw_is_finite(jlw_pb_status_progress(st)), 0, "progress is None");

# ---- playback_status_progress: pos 60s / dur 240s -> ~0.25 ----
test_group("PlaybackStatus progress");
var pr = jlw_pb_status_new(JLW_STATE_PLAYING, 0, f64_from(60), f64_from(240), 0.8, 0);
var p = jlw_pb_status_progress(pr);
assert_eq(jlw_is_finite(p), 1, "progress present");
assert_eq(f64_lt(f64_abs(f64_sub(p, 0.25)), 0.001), 1, "progress ~0.25");

# ---- playback_status_progress_zero_duration -> None ----
test_group("PlaybackStatus progress zero duration");
var zr = jlw_pb_status_new(JLW_STATE_PLAYING, 0, f64_from(10), 0, 1.0, 0);
assert_eq(jlw_is_finite(jlw_pb_status_progress(zr)), 0, "zero duration -> None");

# ---- playlist_new ----
test_group("Playlist new");
var pl = jlw_playlist_new("My Playlist");
assert_streq(jlw_playlist_name(pl), "My Playlist", "name");
assert_eq(jlw_playlist_is_empty(pl), 1, "empty");
assert_eq(jlw_playlist_len(pl), 0, "len 0");

# ---- playlist_add_remove ----
test_group("Playlist add/remove");
var pl2 = jlw_playlist_new("Test");
var pid1 = jlw_uuid_v4();
var pid2 = jlw_uuid_v4();
jlw_playlist_add(pl2, pid1);
jlw_playlist_add(pl2, pid2);
assert_eq(jlw_playlist_len(pl2), 2, "len 2");
assert_eq(jlw_playlist_remove(pl2, pid1), 1, "removed id1");
assert_eq(jlw_playlist_len(pl2), 1, "len 1");
assert_eq(jlw_playlist_remove(pl2, pid1), 0, "already removed");

# ---- playlist_clear ----
test_group("Playlist clear");
var pl3 = jlw_playlist_new("Test");
jlw_playlist_add(pl3, jlw_uuid_v4());
jlw_playlist_add(pl3, jlw_uuid_v4());
jlw_playlist_clear(pl3);
assert_eq(jlw_playlist_is_empty(pl3), 1, "empty after clear");

# ---- queue_new ----
test_group("PlayQueue new");
var q = jlw_queue_new();
assert_eq(jlw_queue_is_empty(q), 1, "empty");
assert_eq(jlw_queue_current(q), 0, "current None");

# ---- queue_enqueue ----
test_group("PlayQueue enqueue");
var q2 = jlw_queue_new();
var qid = jlw_uuid_v4();
jlw_queue_enqueue(q2, qid);
assert_eq(jlw_queue_len(q2), 1, "len 1");
assert_eq(jlw_queue_current(q2), qid, "current == id");

# ---- queue_enqueue_many ----
test_group("PlayQueue enqueue_many");
var q3 = jlw_queue_new();
var ids3 = make_ids(5);
jlw_queue_enqueue_many(q3, ids3);
assert_eq(jlw_queue_len(q3), 5, "len 5");
assert_eq(jlw_queue_current(q3), vec_get(ids3, 0), "current == ids[0]");

# ---- queue_next ----
test_group("PlayQueue advance");
var q4 = jlw_queue_new();
var ids4 = make_ids(3);
jlw_queue_enqueue_many(q4, ids4);
assert_eq(jlw_queue_current(q4), vec_get(ids4, 0), "current ids[0]");
assert_eq(jlw_queue_advance(q4), vec_get(ids4, 1), "advance ids[1]");
assert_eq(jlw_queue_current(q4), vec_get(ids4, 1), "current ids[1]");
assert_eq(jlw_queue_advance(q4), vec_get(ids4, 2), "advance ids[2]");
assert_eq(jlw_queue_advance(q4), 0, "advance None at end");

# ---- queue_previous ----
test_group("PlayQueue go_back");
var q5 = jlw_queue_new();
var ids5 = make_ids(3);
jlw_queue_enqueue_many(q5, ids5);
jlw_queue_advance(q5);
jlw_queue_advance(q5);
assert_eq(jlw_queue_go_back(q5), vec_get(ids5, 1), "back ids[1]");
assert_eq(jlw_queue_go_back(q5), vec_get(ids5, 0), "back ids[0]");
assert_eq(jlw_queue_go_back(q5), 0, "back None at start");

# ---- queue_repeat_all ----
test_group("PlayQueue repeat all");
var q6 = jlw_queue_new();
JlwPlayQueue_set_repeat_mode(q6, JLW_REPEAT_ALL);
var ids6 = make_ids(2);
jlw_queue_enqueue_many(q6, ids6);
jlw_queue_advance(q6);
assert_eq(jlw_queue_advance(q6), vec_get(ids6, 0), "wrap to ids[0]");

# ---- queue_repeat_all_previous ----
test_group("PlayQueue repeat all back");
var q7 = jlw_queue_new();
JlwPlayQueue_set_repeat_mode(q7, JLW_REPEAT_ALL);
var ids7 = make_ids(2);
jlw_queue_enqueue_many(q7, ids7);
assert_eq(jlw_queue_go_back(q7), vec_get(ids7, 1), "wrap back to ids[1]");

# ---- queue_clear ----
test_group("PlayQueue clear");
var q8 = jlw_queue_new();
jlw_queue_enqueue(q8, jlw_uuid_v4());
jlw_queue_clear(q8);
assert_eq(jlw_queue_is_empty(q8), 1, "empty after clear");
assert_eq(jlw_queue_current(q8), 0, "current None");

# ---- media_item is_audio/is_video ----
test_group("MediaItem is_audio/is_video");
var mi = jlw_media_item_new("/music/song.flac", "song", JLW_MEDIA_AUDIO, JLW_FMT_FLAC);
assert_eq(jlw_media_item_is_audio(mi), 1, "is_audio");
assert_eq(jlw_media_item_is_video(mi), 0, "not video");
assert_eq(JlwMediaItem_play_count(mi), 0, "play_count 0");

# ---- library_new ----
test_group("Library new");
var lib = jlw_library_new();
assert_eq(jlw_library_items_len(lib), 0, "no items");
assert_eq(jlw_library_playlists_len(lib), 0, "no playlists");

# ---- library_add_find ----
test_group("Library add/find");
var lib2 = jlw_library_new();
var it2 = jlw_media_item_new("/music/song.flac", "song", JLW_MEDIA_AUDIO, JLW_FMT_FLAC);
var id2 = jlw_library_add_item(lib2, it2);
assert_eq(jlw_library_find_by_id(lib2, id2), it2, "find_by_id hits");
assert_eq(jlw_library_find_by_path(lib2, "/music/song.flac"), it2, "find_by_path hits");
assert_eq(jlw_library_find_by_id(lib2, jlw_uuid_v4()), 0, "find_by_id miss -> None");

# ---- library_remove (also purges from playlists) ----
test_group("Library remove");
var lib3 = jlw_library_new();
var it3 = jlw_media_item_new("/music/song.flac", "song", JLW_MEDIA_AUDIO, JLW_FMT_FLAC);
var id3 = jlw_library_add_item(lib3, it3);
var plid3 = jlw_library_create_playlist(lib3, "Test PL");
jlw_playlist_add(jlw_library_find_playlist(lib3, plid3), id3);
assert_eq(jlw_library_remove(lib3, id3), 1, "removed");
assert_eq(jlw_library_find_by_id(lib3, id3), 0, "gone from items");
assert_eq(jlw_playlist_is_empty(jlw_library_find_playlist(lib3, plid3)), 1, "gone from playlist");

# ---- library_search (title/artist, case-insensitive) ----
test_group("Library search");
var lib4 = jlw_library_new();
var it4 = jlw_media_item_new("/music/song.flac", "song", JLW_MEDIA_AUDIO, JLW_FMT_FLAC);
JlwMediaItem_set_title(it4, "Bohemian Rhapsody");
JlwMediaItem_set_artist(it4, "Queen");
jlw_library_add_item(lib4, it4);
assert_eq(vec_len(jlw_library_search(lib4, "bohemian")), 1, "title match");
assert_eq(vec_len(jlw_library_search(lib4, "queen")), 1, "artist match");
assert_eq(vec_len(jlw_library_search(lib4, "RHAPSODY")), 1, "case-insensitive");
assert_eq(vec_len(jlw_library_search(lib4, "nonexistent")), 0, "no match");

# ---- library_search_tags ----
test_group("Library search tags");
var lib5 = jlw_library_new();
var it5 = jlw_media_item_new("/music/song.flac", "song", JLW_MEDIA_AUDIO, JLW_FMT_FLAC);
var tags5 = vec_new();
vec_push(tags5, "rock");
vec_push(tags5, "classic");
JlwMediaItem_set_tags(it5, tags5);
jlw_library_add_item(lib5, it5);
assert_eq(vec_len(jlw_library_search(lib5, "rock")), 1, "tag rock");
assert_eq(vec_len(jlw_library_search(lib5, "classic")), 1, "tag classic");

# ---- library_filter_by_type ----
test_group("Library filter by type");
var lib6 = jlw_library_new();
jlw_library_add_item(lib6, jlw_media_item_new("/music/song.flac", "song", JLW_MEDIA_AUDIO, JLW_FMT_FLAC));
jlw_library_add_item(lib6, jlw_media_item_new("/videos/movie.mp4", "movie", JLW_MEDIA_VIDEO, JLW_FMT_MP4));
assert_eq(jlw_library_audio_count(lib6), 1, "one audio");
assert_eq(jlw_library_video_count(lib6), 1, "one video");

# ---- library_scan_paths (dedup) ----
test_group("Library scan paths");
var lib7 = jlw_library_new();
jlw_library_add_scan_path(lib7, "/home/user/Music");
jlw_library_add_scan_path(lib7, "/home/user/Music");
assert_eq(jlw_library_scan_paths_len(lib7), 1, "dedup");
jlw_library_add_scan_path(lib7, "/home/user/Videos");
assert_eq(jlw_library_scan_paths_len(lib7), 2, "second path");

# ---- library_playlists ----
test_group("Library playlists");
var lib8 = jlw_library_new();
var plid8 = jlw_library_create_playlist(lib8, "Favorites");
var pl8 = jlw_library_find_playlist(lib8, plid8);
assert_streq(jlw_playlist_name(pl8), "Favorites", "name");
assert_eq(jlw_playlist_is_empty(pl8), 1, "empty");

var rc = assert_summary();
syscall(60, rc);
