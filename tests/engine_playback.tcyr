# engine_playback.tcyr -- the engine's threaded-playback integration over the
# audio-backend fnptr seam. This is the ONE test that wires a real backend (so it
# folds shravan/vani); the other engine/tui/gui tests leave the seam unwired and
# stay on the state-only no-op path. No audio device under CI -> the decode thread
# decodes (real) then device-open fails, so it finishes fast; the control flow
# (play spawns -> poll yields TrackFinished -> Stopped; stop cancels) is verified.

include "src/error.cyr"
include "src/core/types.cyr"
include "src/core/db.cyr"
include "src/core/scanner.cyr"
include "src/playback/dsp.cyr"
include "src/playback/decode_thread.cyr"
include "src/playback/engine.cyr"
include "src/playback/audio.cyr"

alloc_init();
jlw_engine_set_audio_backend(&jlw_audio_play_async_dsp, &jlw_audio_play_is_done,
                             &jlw_audio_play_stop, &jlw_audio_play_position, &jlw_audio_play_ctl);

# ---- play (no file) errors ----
test_group("play without a file");
var e0 = jlw_engine_new(jlw_engine_config_default());
assert_eq(jlw_is_err(jlw_engine_play(e0)), 1, "play errors without a loaded file");
assert_eq(jlw_engine_state(e0), JLW_STATE_STOPPED, "still Stopped");

# ---- open + play -> background thread -> TrackFinished ----
test_group("threaded play -> TrackFinished");
var e = jlw_engine_new(jlw_engine_config_default());
assert_eq(jlw_engine_open(e, "tests/fixtures/probe.flac"), JLW_ERR_NONE, "open ok");
assert_eq(jlw_engine_play(e), JLW_ERR_NONE, "play ok");
assert_eq(jlw_engine_state(e), JLW_STATE_PLAYING, "state Playing after play");
assert_eq(JlwPlaybackEngine_play_handle(e) != 0, 1, "play handle set (thread spawned)");

var got = 0;
var spins = 0;
while (got == 0 && spins < 500) {
    var evs = jlw_engine_poll_events(e);
    for (var i = 0; i < vec_len(evs); i = i + 1) {
        if (JlwEngineEvent_code(vec_get(evs, i)) == JLW_EVT_TRACK_FINISHED) { got = 1; }
    }
    if (got == 0) { sleep_ms(10); spins = spins + 1; }
}
assert_eq(got, 1, "poll_events yields TrackFinished");
assert_eq(jlw_engine_state(e), JLW_STATE_STOPPED, "state Stopped after finish");
assert_eq(JlwPlaybackEngine_play_handle(e), 0, "handle cleared after finish");
# poll again -> no duplicate event
assert_eq(vec_len(jlw_engine_poll_events(e)), 0, "no duplicate TrackFinished");

# ---- stop cancels an active playback ----
test_group("stop cancels playback");
var e2 = jlw_engine_new(jlw_engine_config_default());
jlw_engine_open(e2, "tests/fixtures/probe.mp3");
jlw_engine_play(e2);
jlw_engine_stop(e2);
assert_eq(jlw_engine_state(e2), JLW_STATE_STOPPED, "Stopped after stop");
assert_eq(JlwPlaybackEngine_play_handle(e2), 0, "handle cleared on stop");

# ---- transport control: pause / resume / live volume reach the thread handle ----
# (don't poll before checking -- poll would clear the handle when the thread is done)
test_group("transport pause/resume/volume");
var e3 = jlw_engine_new(jlw_engine_config_default());
jlw_engine_open(e3, "tests/fixtures/probe.flac");
jlw_engine_play(e3);
var h3 = JlwPlaybackEngine_play_handle(e3);
assert_eq(h3 != 0, 1, "handle set");
jlw_engine_pause(e3);
assert_eq(jlw_engine_state(e3), JLW_STATE_PAUSED, "state Paused");
assert_eq(JlwPlayHandle_paused(h3), 1, "handle paused flag set");
jlw_engine_play(e3);   # resume from pause -> unpause, NOT re-spawn
assert_eq(jlw_engine_state(e3), JLW_STATE_PLAYING, "state Playing after resume");
assert_eq(JlwPlayHandle_paused(h3), 0, "handle unpaused");
assert_eq(JlwPlaybackEngine_play_handle(e3), h3, "same handle (not re-spawned)");
jlw_engine_set_volume(e3, 0.5);
assert_eq(f64_to(f64_mul(JlwPlayHandle_volume(h3), 100.0)), 50, "live volume -> handle 0.5");
jlw_engine_stop(e3);

# ---- open() cancels active playback (no orphaned decode thread) ----
# regression: manual track-switch while PLAYING must stop the old thread first
# (rust-old open() calls self.stop()), else a second worker is spawned + leaked.
test_group("open cancels active playback");
var e4 = jlw_engine_new(jlw_engine_config_default());
jlw_engine_open(e4, "tests/fixtures/probe.flac");
jlw_engine_play(e4);
var h4 = JlwPlaybackEngine_play_handle(e4);
assert_eq(h4 != 0, 1, "playing (handle set)");
jlw_engine_open(e4, "tests/fixtures/probe.mp3");   # switch tracks while still playing
assert_eq(JlwPlaybackEngine_play_handle(e4), 0, "old handle cleared (thread stopped)");
assert_eq(jlw_engine_state(e4), JLW_STATE_STOPPED, "state reset by open");
assert_eq(JlwPlayHandle_stop(h4), 1, "old handle received stop signal (not orphaned)");
assert_streq(JlwPlaybackEngine_current_path(e4), "tests/fixtures/probe.mp3", "current_path updated");

# ---- seek reaches the thread as a millisecond target ----
test_group("transport seek");
var e5 = jlw_engine_new(jlw_engine_config_default());
jlw_engine_open(e5, "tests/fixtures/probe.flac");
jlw_engine_play(e5);
var h5 = JlwPlaybackEngine_play_handle(e5);
jlw_engine_seek(e5, f64_from(2));                 # 2.0 s
assert_eq(JlwPlayHandle_seek_to(h5), 2000, "seek 2s -> handle 2000ms");
jlw_engine_seek(e5, f64_neg(5.0));                # negative clamps to 0
assert_eq(JlwPlayHandle_seek_to(h5), 0, "negative seek clamps to 0");
jlw_engine_seek_relative(e5, f64_from(3));        # from live pos (0) + 3s
assert_eq(JlwPlayHandle_seek_to(h5), 3000, "seek_relative +3s -> 3000ms");
jlw_engine_stop(e5);

var rc = assert_summary();
syscall(60, rc);
