# renderers.tcyr -- parity tests for src/ui/renderers.cyr.
# Ports all 12 #[test]s from jalwa-ui/src/lib.rs.

include "src/error.cyr"
include "src/core/types.cyr"
include "src/ui/renderers.cyr"

fn cstr3(a, b, c) {
    var la = strlen(a); var lb = strlen(b); var lc = strlen(c);
    var d = alloc(la + lb + lc + 1);
    memcpy(d, a, la); memcpy(d + la, b, lb); memcpy(d + la + lb, c, lc);
    store8(d + la + lb + lc, 0);
    return d;
}
fn make_item(title, artist, dur_secs) {
    var it = jlw_media_item_new(cstr3("/music/", title, ".flac"), title, JLW_MEDIA_AUDIO, JLW_FMT_FLAC);
    JlwMediaItem_set_artist(it, artist);
    JlwMediaItem_set_duration(it, f64_from(dur_secs));
    return it;
}
fn contains(hay, needle) { if (strstr(hay, needle) >= 0) { return 1; } return 0; }
fn count_char(s, ch) { var n = 0; for (var i = 0; i < strlen(s); i = i + 1) { if (load8(s + i) == ch) { n = n + 1; } } return n; }

alloc_init();

# ---- status_bar ----
test_group("status bar playing");
var st1 = jlw_pb_status_new(JLW_STATE_PLAYING, 0, f64_from(65), f64_from(240), 0.8, 0);
var bar1 = jlw_ui_render_status_bar(st1, make_item("Song", "Artist", 240));
assert_eq(contains(bar1, ">>"), 1, ">> icon");
assert_eq(contains(bar1, "Artist - Song"), 1, "artist - title");
assert_eq(contains(bar1, "1:05"), 1, "position 1:05");
assert_eq(contains(bar1, "4:00"), 1, "duration 4:00");
assert_eq(contains(bar1, "80%"), 1, "volume 80%");

test_group("status bar stopped no item");
var bar2 = jlw_ui_render_status_bar(jlw_pb_status_stopped(), 0);
assert_eq(contains(bar2, "[]"), 1, "[] icon");
assert_eq(contains(bar2, "No media loaded"), 1, "no media");

test_group("status bar muted");
var st3 = jlw_pb_status_new(JLW_STATE_PAUSED, 0, 0, JLW_NAN, 0.5, 1);
assert_eq(contains(jlw_ui_render_status_bar(st3, 0), "MUTE"), 1, "MUTE");

# ---- progress bar ----
test_group("progress bar");
var pb = jlw_ui_render_progress_bar(0.5, 20);
assert_eq(strlen(pb), 22, "len 22");
assert_eq(load8(pb), 91, "starts [");
assert_eq(load8(pb + 21), 93, "ends ]");
assert_eq(count_char(pb, 61), 10, "10 '='");
assert_streq(jlw_ui_render_progress_bar(0, 10), "[          ]", "empty");
assert_streq(jlw_ui_render_progress_bar(1.0, 10), "[==========]", "full");

# ---- queue summary ----
test_group("queue summary");
assert_streq(jlw_ui_render_queue_summary(jlw_queue_new()), "Queue: 0/0", "empty");
var q2 = jlw_queue_new();
jlw_queue_enqueue(q2, jlw_uuid_v4());
jlw_queue_enqueue(q2, jlw_uuid_v4());
assert_streq(jlw_ui_render_queue_summary(q2), "Queue: 1/2", "1/2");
var q3 = jlw_queue_new();
jlw_queue_enqueue(q3, jlw_uuid_v4());
JlwPlayQueue_set_repeat_mode(q3, JLW_REPEAT_ALL);
assert_eq(contains(jlw_ui_render_queue_summary(q3), "[RA]"), 1, "repeat all");
var q4 = jlw_queue_new();
jlw_queue_enqueue(q4, jlw_uuid_v4());
JlwPlayQueue_set_shuffle(q4, 1);
assert_eq(contains(jlw_ui_render_queue_summary(q4), "[S]"), 1, "shuffle");

# ---- library item ----
test_group("library item");
var line = jlw_ui_render_library_item(make_item("Bohemian Rhapsody", "Queen", 354), 0);
assert_eq(contains(line, "1."), 1, "index 1.");
assert_eq(contains(line, "Queen"), 1, "artist");
assert_eq(contains(line, "Bohemian Rhapsody"), 1, "title");
assert_eq(contains(line, "5:54"), 1, "duration 5:54");
assert_eq(contains(line, "audio"), 1, "type audio");

# ---- library stats ----
test_group("library stats");
var lib = jlw_library_new();
jlw_library_add_item(lib, make_item("Song 1", "A", 180));
jlw_library_add_item(lib, make_item("Song 2", "B", 240));
jlw_library_create_playlist(lib, "Favs");
var stats = jlw_ui_render_library_stats(lib);
assert_eq(contains(stats, "2 items"), 1, "2 items");
assert_eq(contains(stats, "2 audio"), 1, "2 audio");
assert_eq(contains(stats, "0 video"), 1, "0 video");
assert_eq(contains(stats, "1 playlists"), 1, "1 playlists");
assert_eq(contains(stats, "7:00"), 1, "total 7:00");

var rc = assert_summary();
syscall(60, rc);
