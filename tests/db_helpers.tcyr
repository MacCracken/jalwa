# db_helpers.tcyr -- parity tests for the pure helpers in src/core/db.cyr.
# Ports the parse_helpers + default_db_path_ends_correctly #[test]s from
# rust-old/crates/jalwa-core/src/db.rs, plus uuid<->hex and tags<->JSON
# round-trips (which stand in for the serde/uuid behavior the DB layer relies on).

include "src/error.cyr"
include "src/core/types.cyr"
include "src/core/db.cyr"

# ends_with(s, suffix): 1 if cstring s ends with suffix.
fn ends_with(s, suffix) {
    var ls = strlen(s);
    var lf = strlen(suffix);
    if (lf > ls) { return 0; }
    return streq(s + (ls - lf), suffix);
}

alloc_init();
args_init();

# ---- parse_helpers ----
test_group("parse_format");
assert_eq(jlw_parse_format("Mp4"),  JLW_FMT_MP4,  "Mp4");
assert_eq(jlw_parse_format("Mkv"),  JLW_FMT_MKV,  "Mkv");
assert_eq(jlw_parse_format("WebM"), JLW_FMT_WEBM, "WebM");
assert_eq(jlw_parse_format("Ogg"),  JLW_FMT_OGG,  "Ogg");
assert_eq(jlw_parse_format("Wav"),  JLW_FMT_WAV,  "Wav");
assert_eq(jlw_parse_format("Flac"), JLW_FMT_FLAC, "Flac");
assert_eq(jlw_parse_format("Mp3"),  JLW_FMT_MP3,  "Mp3");
assert_eq(jlw_parse_format("Avi"),  JLW_FMT_AVI,  "Avi");
assert_eq(jlw_parse_format("unknown"), JLW_FMT_MP3, "fallback Mp3");

test_group("parse_audio_codec");
assert_eq(jlw_parse_audio_codec("Pcm"),    JLW_ACODEC_PCM,    "Pcm");
assert_eq(jlw_parse_audio_codec("Mp3"),    JLW_ACODEC_MP3,    "Mp3");
assert_eq(jlw_parse_audio_codec("Aac"),    JLW_ACODEC_AAC,    "Aac");
assert_eq(jlw_parse_audio_codec("Flac"),   JLW_ACODEC_FLAC,   "Flac");
assert_eq(jlw_parse_audio_codec("Vorbis"), JLW_ACODEC_VORBIS, "Vorbis");
assert_eq(jlw_parse_audio_codec("Opus"),   JLW_ACODEC_OPUS,   "Opus");
assert_eq(jlw_parse_audio_codec("Alac"),   JLW_ACODEC_ALAC,   "Alac");
assert_eq(jlw_parse_audio_codec("Wma"),    JLW_ACODEC_WMA,    "Wma");
assert_eq(jlw_parse_audio_codec("???"),    JLW_ACODEC_PCM,    "fallback Pcm");

test_group("parse_video_codec");
assert_eq(jlw_parse_video_codec("H264"),   JLW_VCODEC_H264,   "H264");
assert_eq(jlw_parse_video_codec("H265"),   JLW_VCODEC_H265,   "H265");
assert_eq(jlw_parse_video_codec("Vp8"),    JLW_VCODEC_VP8,    "Vp8");
assert_eq(jlw_parse_video_codec("Vp9"),    JLW_VCODEC_VP9,    "Vp9");
assert_eq(jlw_parse_video_codec("Av1"),    JLW_VCODEC_AV1,    "Av1");
assert_eq(jlw_parse_video_codec("Theora"), JLW_VCODEC_THEORA, "Theora");
assert_eq(jlw_parse_video_codec("???"),    JLW_VCODEC_H264,   "fallback H264");

# ---- default_db_path_ends_correctly ----
test_group("default_db_path");
assert_eq(ends_with(jlw_default_db_path(), "jalwa/library.db"), 1, "ends with jalwa/library.db");

# ---- uuid <-> hex round-trip ----
test_group("uuid hex round-trip");
var u = jlw_uuid_v4();
var us = jlw_uuid_to_str(u);
assert_eq(strlen(us), 32, "32 hex chars");
var u2 = jlw_uuid_from_str(us);
assert_eq(jlw_uuid_eq(u, u2), 1, "round-trips to the same 16 bytes");

# ---- tags <-> JSON round-trip ----
test_group("tags JSON round-trip");
var tags = vec_new();
vec_push(tags, "rock");
vec_push(tags, "classic");
var json = jlw_tags_to_json(tags);
assert_streq(json, "[\"rock\",\"classic\"]", "encodes JSON array");
var back = jlw_tags_from_json(json);
assert_eq(vec_len(back), 2, "2 tags");
assert_streq(vec_get(back, 0), "rock", "tag 0");
assert_streq(vec_get(back, 1), "classic", "tag 1");
# empty
assert_streq(jlw_tags_to_json(vec_new()), "[]", "empty -> []");
assert_eq(vec_len(jlw_tags_from_json("[]")), 0, "[] -> empty");

var rc = assert_summary();
syscall(60, rc);
