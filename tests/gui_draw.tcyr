# gui_draw.tcyr -- tests for the GUI draw-command layer (src/gui/draw.cyr).
# The whole point of the command IR is headless testability: assert the emitted
# command list (kinds, geometry, colors, text) for given GuiApp states -- no pixels,
# no window. Phase 1 covers the sidebar + transport builders + the color bridge.

include "src/error.cyr"
include "src/core/types.cyr"
include "src/core/db.cyr"
include "src/playback/dsp.cyr"
include "src/playback/decode_thread.cyr"
include "src/playback/engine.cyr"
include "src/gui/theme.cyr"
include "src/gui/app.cyr"
include "src/gui/views.cyr"
include "src/gui/draw.cyr"

fn rm(path) { syscall(87, path); return 0; }
fn fresh_plib() { rm("/tmp/jalwa_gui_draw.db"); return jlw_plib_open("/tmp/jalwa_gui_draw.db"); }
fn eng() { return jlw_engine_new(jlw_engine_config_default()); }
fn contains(hay, needle) { if (strstr(hay, needle) >= 0) { return 1; } return 0; }
# first command of `kind` whose text contains `needle`, or 0
fn find_text(cmds, needle) {
    for (var i = 0; i < vec_len(cmds); i = i + 1) {
        var c = vec_get(cmds, i);
        if (JlwDrawCmd_kind(c) == JLW_DRAW_TEXT) {
            if (JlwDrawCmd_text(c) != 0) { if (contains(JlwDrawCmd_text(c), needle) == 1) { return c; } }
        }
    }
    return 0;
}
# count commands of a kind with a given color
fn count_rect_color(cmds, color) {
    var n = 0;
    for (var i = 0; i < vec_len(cmds); i = i + 1) {
        var c = vec_get(cmds, i);
        if (JlwDrawCmd_kind(c) == JLW_DRAW_RECT) { if (JlwDrawCmd_color(c) == color) { n = n + 1; } }
    }
    return n;
}
fn count_kind(cmds, kind) {
    var n = 0;
    for (var i = 0; i < vec_len(cmds); i = i + 1) { if (JlwDrawCmd_kind(vec_get(cmds, i)) == kind) { n = n + 1; } }
    return n;
}
fn cat3(a, b, c) {
    var la = strlen(a); var lb = strlen(b); var lc = strlen(c);
    var d = alloc(la + lb + lc + 1);
    memcpy(d, a, la); memcpy(d + la, b, lb); memcpy(d + la + lb, c, lc); store8(d + la + lb + lc, 0);
    return d;
}
fn mk(app, title, artist) {
    var it = jlw_media_item_new(cat3("/m/", title, ".flac"), title, JLW_MEDIA_AUDIO, JLW_FMT_FLAC);
    JlwMediaItem_set_artist(it, artist);
    jlw_library_add_item(jlw_gui_app_lib(app), it);
    return it;
}

alloc_init();

# ---- color bridge: 0xRRGGBBAA -> XRGB8888 ----
test_group("color_to_xrgb");   # strips alpha: 0xRRGGBBAA -> 0x00RRGGBB (Aurora Void default palette)
assert_eq(jlw_gui_color_to_xrgb(JLW_GUI_ACCENT), 0x3DE7FF, "accent -> 0x3DE7FF (luminous cyan)");
assert_eq(jlw_gui_color_to_xrgb(JLW_GUI_BG_DARK), 0x0A0A10, "bg dark -> 0x0A0A10 (void)");
assert_eq(jlw_gui_color_to_xrgb(JLW_GUI_TEXT_PRIMARY), 0xF2F3F7, "text -> 0xF2F3F7");

# ---- sidebar builder ----
test_group("build_sidebar");
var app = jlw_gui_app_new(fresh_plib(), eng());
JlwGuiApp_set_view(app, JLW_GUI_VIEW_LIBRARY);
var c1 = vec_new();
jlw_gui_build_sidebar(app, 0, 0, JLW_GUI_SIDEBAR_W, 600, c1);
# first command is the panel background rect over the full sidebar
var bg = vec_get(c1, 0);
assert_eq(JlwDrawCmd_kind(bg), JLW_DRAW_RECT, "first cmd is a rect");
assert_eq(JlwDrawCmd_color(bg), JLW_GUI_BG_PANEL, "sidebar bg = panel color");
assert_eq(JlwDrawCmd_w(bg), JLW_GUI_SIDEBAR_W, "sidebar full width");
# 5 entries (no video) -> a Library label present
assert_eq(find_text(c1, "Library") != 0, 1, "Library entry drawn");
assert_eq(find_text(c1, "Queue") != 0, 1, "Queue entry drawn");
# the active (Library) row draws a widget-bg highlight rect; inactive rows do not
assert_eq(count_rect_color(c1, JLW_GUI_BG_WIDGET), 1, "exactly one active-row highlight");
# the active row also gets a luminous accent edge bar
assert_eq(count_rect_color(c1, JLW_GUI_ACCENT), 1, "active row has one accent edge bar");
# active entry text uses the accent color
var libtxt = find_text(c1, "Library");
assert_eq(JlwDrawCmd_color(libtxt), JLW_GUI_ACCENT, "active entry text = accent");
var qtxt = find_text(c1, "Queue");
assert_eq(JlwDrawCmd_color(qtxt), JLW_GUI_TEXT_SECONDARY, "inactive entry = secondary");

# switching the active view moves the highlight
JlwGuiApp_set_view(app, JLW_GUI_VIEW_QUEUE);
var c2 = vec_new();
jlw_gui_build_sidebar(app, 0, 0, JLW_GUI_SIDEBAR_W, 600, c2);
assert_eq(JlwDrawCmd_color(find_text(c2, "Queue")), JLW_GUI_ACCENT, "Queue now active (accent)");
assert_eq(JlwDrawCmd_color(find_text(c2, "Library")), JLW_GUI_TEXT_SECONDARY, "Library now inactive");

# ---- transport builder ----
test_group("build_transport");
var app2 = jlw_gui_app_new(fresh_plib(), eng());
var ct = vec_new();
jlw_gui_build_transport(app2, 0, 536, 800, JLW_GUI_TRANSPORT_H, ct);
# transport bg rect first
assert_eq(JlwDrawCmd_color(vec_get(ct, 0)), JLW_GUI_BG_PANEL, "transport bg = panel");
# stopped engine -> play glyph "|>" (not pause)
assert_eq(find_text(ct, "|>") != 0, 1, "stopped -> play glyph");
assert_eq(find_text(ct, "||"), 0, "not the pause glyph when stopped");
# no media loaded
assert_eq(find_text(ct, "No media loaded") != 0, 1, "no-media title");
# volume 100% (default volume 1.0)
assert_eq(find_text(ct, "100%") != 0, 1, "volume 100%");
# progress bar track (BG_WIDGET rect of height 3) present; no fill at position 0
assert_eq(count_rect_color(ct, JLW_GUI_BG_WIDGET), 1, "seek track drawn");
# the accent progress fill is absent at position 0 (ratio 0 -> no fill rect)
assert_eq(count_rect_color(ct, JLW_GUI_ACCENT), 0, "no progress fill at start");

# ---- scroll/virtualization math ----
test_group("scroll_start");
assert_eq(jlw_gui_scroll_start(0, 10, 100), 0, "sel 0 -> start 0");
assert_eq(jlw_gui_scroll_start(5, 10, 100), 0, "sel within first window -> 0");
assert_eq(jlw_gui_scroll_start(12, 10, 100), 3, "sel 12, 10 visible -> start 3 (bottom-anchored)");
assert_eq(jlw_gui_scroll_start(99, 10, 100), 90, "sel last -> start 90");
assert_eq(jlw_gui_scroll_start(5, 10, 4), 0, "fewer rows than window -> 0");

# ---- library builder (list, scroll, selection, search) ----
test_group("build_library");
var la = jlw_gui_app_new(fresh_plib(), eng());
var it0 = mk(la, "Alpha", "A");
mk(la, "Beta", "B"); mk(la, "Gamma", "C");
for (var k = 0; k < 40; k = k + 1) { mk(la, cat3("Trk", "X", "Y"), "Z"); }   # 43 items total
JlwGuiApp_set_view(la, JLW_GUI_VIEW_LIBRARY);
JlwGuiApp_set_selected_index(la, 0);
var cl = vec_new();
# viewport 300px tall -> 300/32 = 9 visible rows; only those emit text
jlw_gui_build_library(la, JLW_GUI_SIDEBAR_W, 0, 620, 300, cl);
assert_eq(JlwDrawCmd_color(vec_get(cl, 0)), JLW_GUI_BG_DARK, "content bg = dark");
assert_eq(count_kind(cl, JLW_DRAW_TEXT), 9, "virtualized: only 9 visible rows drawn (not 43)");
assert_eq(find_text(cl, "Alpha") != 0, 1, "row 0 Alpha visible");
# selected row (0) gets a widget-bg tint; row 0 text is accent-or-primary (not playing -> primary)
assert_eq(count_rect_color(cl, JLW_GUI_BG_WIDGET), 1, "one selected-row tint");
assert_eq(JlwDrawCmd_color(find_text(cl, "Alpha")), JLW_GUI_TEXT_PRIMARY, "selected row text primary");
# playing highlight: mark Alpha playing -> its row text is accent
JlwGuiApp_set_current_playing_id(la, JlwMediaItem_id(it0));
var cl2 = vec_new();
jlw_gui_build_library(la, JLW_GUI_SIDEBAR_W, 0, 620, 300, cl2);
assert_eq(JlwDrawCmd_color(find_text(cl2, "Alpha")), JLW_GUI_ACCENT, "playing row text accent");
# scroll: select row 30 -> Alpha (row 0) no longer visible
JlwGuiApp_set_selected_index(la, 30);
var cl3 = vec_new();
jlw_gui_build_library(la, JLW_GUI_SIDEBAR_W, 0, 620, 300, cl3);
assert_eq(find_text(cl3, "Alpha"), 0, "scrolled: Alpha no longer drawn");

# search filter: only matching rows
JlwGuiApp_set_search_query(la, "beta");
jlw_gui_app_update_search(la);
JlwGuiApp_set_selected_index(la, 0);
var cl4 = vec_new();
jlw_gui_build_library(la, JLW_GUI_SIDEBAR_W, 0, 620, 300, cl4);
assert_eq(count_kind(cl4, JLW_DRAW_TEXT), 1, "search 'beta' -> 1 row");
assert_eq(find_text(cl4, "Beta") != 0, 1, "the Beta row");

# ---- now playing builder ----
test_group("build_now_playing");
var na = jlw_gui_app_new(fresh_plib(), eng());
var cn0 = vec_new();
jlw_gui_build_now_playing(na, JLW_GUI_SIDEBAR_W, 0, 620, 500, cn0);
assert_eq(find_text(cn0, "Nothing playing") != 0, 1, "no track -> Nothing playing");
var npi = mk(na, "SongX", "BandY");
JlwGuiApp_set_current_playing_id(na, JlwMediaItem_id(npi));
var cn1 = vec_new();
jlw_gui_build_now_playing(na, JLW_GUI_SIDEBAR_W, 0, 620, 500, cn1);
assert_eq(find_text(cn1, "SongX") != 0, 1, "title drawn");
assert_eq(find_text(cn1, "BandY") != 0, 1, "artist drawn");
assert_eq(count_kind(cn1, JLW_DRAW_IMAGE), 1, "album-art image cmd emitted");
assert_eq(find_text(cn1, "NOW PLAYING") != 0, 1, "hero accent eyebrow");
assert_eq(JlwDrawCmd_color(find_text(cn1, "NOW PLAYING")), JLW_GUI_ACCENT, "eyebrow is accent");
# empty state keeps the eyebrow too
assert_eq(find_text(cn0, "NOW PLAYING") != 0, 1, "empty hero eyebrow");

# ---- settings view (theme picker) ----
test_group("build_settings");
var sa = jlw_gui_app_new(fresh_plib(), eng());
JlwGuiApp_set_view(sa, JLW_GUI_VIEW_SETTINGS);
jlw_gui_theme_apply(JLW_GUI_THEME_AURORA);                 # active = Aurora
JlwGuiApp_set_selected_index(sa, 1);                       # selecting the Caustic row
var cs = vec_new();
jlw_gui_build_settings(sa, JLW_GUI_SIDEBAR_W, 0, 620, 400, cs);
assert_eq(JlwDrawCmd_color(vec_get(cs, 0)), JLW_GUI_BG_DARK, "settings bg = dark");
assert_eq(find_text(cs, "SETTINGS") != 0, 1, "settings eyebrow present");
assert_eq(find_text(cs, "Aurora Void") != 0, 1, "aurora row drawn");
assert_eq(find_text(cs, "Caustic Glass") != 0, 1, "caustic row drawn");
assert_eq(find_text(cs, "Sacred Bloom") != 0, 1, "sacred row drawn");
assert_eq(JlwDrawCmd_color(find_text(cs, "Aurora Void")), JLW_GUI_ACCENT, "active theme name = accent");
assert_eq(JlwDrawCmd_color(find_text(cs, "Caustic Glass")), JLW_GUI_TEXT_SECONDARY, "inactive theme = secondary");
assert_eq(find_text(cs, "active") != 0, 1, "active marker drawn");
assert_eq(count_rect_color(cs, JLW_GUI_BG_WIDGET), 1, "one selected-row tint");
assert_eq(count_kind(cs, JLW_DRAW_TEXT) >= 4, 1, "eyebrow + 3 theme rows at minimum");

# ---- queue builder ----
test_group("build_queue");
var qa = jlw_gui_app_new(fresh_plib(), eng());
JlwGuiApp_set_view(qa, JLW_GUI_VIEW_QUEUE);
var cq0 = vec_new();
jlw_gui_build_queue(qa, JLW_GUI_SIDEBAR_W, 0, 620, 400, cq0);
assert_eq(find_text(cq0, "Queue is empty") != 0, 1, "empty queue message");
# enqueue two tracks
var qi1 = mk(qa, "First", "AA");
var qi2 = mk(qa, "Second", "BB");
jlw_queue_enqueue(JlwGuiApp_queue(qa), JlwMediaItem_id(qi1));
jlw_queue_enqueue(JlwGuiApp_queue(qa), JlwMediaItem_id(qi2));   # position -> 0
var cq1 = vec_new();
jlw_gui_build_queue(qa, JLW_GUI_SIDEBAR_W, 0, 620, 400, cq1);
assert_eq(find_text(cq1, "First") != 0, 1, "queue row First");
assert_eq(find_text(cq1, "Second") != 0, 1, "queue row Second");
# current position (row 0) is accent
assert_eq(JlwDrawCmd_color(find_text(cq1, "First")), JLW_GUI_ACCENT, "current queue row accent");
assert_eq(JlwDrawCmd_color(find_text(cq1, "Second")), JLW_GUI_TEXT_SECONDARY, "non-current row secondary");

# ---- equalizer builder ----
test_group("build_equalizer");
var ea = jlw_gui_app_new(fresh_plib(), eng());
JlwGuiApp_set_view(ea, JLW_GUI_VIEW_EQUALIZER);
JlwGuiApp_set_selected_index(ea, 3);
var ce = vec_new();
jlw_gui_build_equalizer(ea, JLW_GUI_SIDEBAR_W, 0, 620, 500, ce);
assert_eq(find_text(ce, "Equalizer: OFF") != 0, 1, "eq header OFF (default)");
assert_eq(count_rect_color(ce, JLW_GUI_BG_WIDGET), 1, "selected band column tinted");
assert_eq(count_kind(ce, JLW_DRAW_TEXT) >= 11, 1, "header + 10 band names");
# a flat EQ draws no accent bars; boosting band 3 draws one
assert_eq(count_rect_color(ce, JLW_GUI_ACCENT), 0, "flat eq -> no boost bars");
jlw_engine_set_eq_band(JlwGuiApp_engine(ea), 3, f64_from(6));   # +6 dB
var ce2 = vec_new();
jlw_gui_build_equalizer(ea, JLW_GUI_SIDEBAR_W, 0, 620, 500, ce2);
assert_eq(count_rect_color(ce2, JLW_GUI_ACCENT), 1, "boosted band -> one accent bar");

# ---- devices builder ----
test_group("build_devices");
var da = jlw_gui_app_new(fresh_plib(), eng());
var cd = vec_new();
jlw_gui_build_devices(da, JLW_GUI_SIDEBAR_W, 0, 620, 500, cd);
assert_eq(find_text(cd, "No media devices detected") != 0, 1, "devices stub message");

# ---- full frame: sidebar + transport + active-view content, view-switchable ----
test_group("build_frame");
var fa = jlw_gui_app_new(fresh_plib(), eng());
mk(fa, "FrameTrack", "FA");
JlwGuiApp_set_view(fa, JLW_GUI_VIEW_LIBRARY);
var cf = vec_new();
jlw_gui_build_frame(fa, 800, 600, cf);
assert_eq(find_text(cf, "Library") != 0, 1, "frame has the sidebar");
assert_eq(find_text(cf, "No media loaded") != 0, 1, "frame has the transport bar");
assert_eq(find_text(cf, "FrameTrack") != 0, 1, "library content in frame");
JlwGuiApp_set_view(fa, JLW_GUI_VIEW_NOW_PLAYING);
var cf2 = vec_new();
jlw_gui_build_frame(fa, 800, 600, cf2);
assert_eq(find_text(cf2, "Nothing playing") != 0, 1, "content switches to now-playing");
assert_eq(find_text(cf2, "FrameTrack"), 0, "old library content gone");

# ---- input mapping ----
test_group("key_to_action");
assert_eq(jlw_gui_key_to_action(32), JLW_GUI_ACT_PLAY_PAUSE, "space -> play/pause");
assert_eq(jlw_gui_key_to_action(JLW_KEY_UP), JLW_GUI_ACT_NAV_UP, "up");
assert_eq(jlw_gui_key_to_action(JLW_KEY_DOWN), JLW_GUI_ACT_NAV_DOWN, "down");
assert_eq(jlw_gui_key_to_action(JLW_KEY_ENTER), JLW_GUI_ACT_ENTER, "enter");
assert_eq(jlw_gui_key_to_action(JLW_KEY_TAB), JLW_GUI_ACT_NEXT_VIEW, "tab -> next view");
assert_eq(jlw_gui_key_to_action(47), JLW_GUI_ACT_SEARCH, "/ -> search");
assert_eq(jlw_gui_key_to_action(113), JLW_GUI_ACT_QUIT, "q -> quit");
assert_eq(jlw_gui_key_to_action(101), JLW_GUI_ACT_EQ_TOGGLE, "e -> eq");
assert_eq(jlw_gui_key_to_action(110), JLW_GUI_ACT_NEXT_TRACK, "n -> next");
assert_eq(jlw_gui_key_to_action(78), JLW_GUI_ACT_NORMALIZE, "N -> normalize");
assert_eq(jlw_gui_key_to_action(65), JLW_GUI_ACT_NONE, "unmapped 'A' -> none");

# ---- empty states (parity: library.rs / now_playing.rs / queue.rs) ----
test_group("empty_states");
var le = jlw_gui_app_new(fresh_plib(), eng());                 # empty library
JlwGuiApp_set_view(le, JLW_GUI_VIEW_LIBRARY);
var cle = vec_new();
jlw_gui_build_library(le, 0, 0, 600, 400, cle);
assert_eq(find_text(cle, "Library is empty") != 0, 1, "empty library -> scan hint");
# search active over a non-empty library, zero matches -> "No matches"
var lm = jlw_gui_app_new(fresh_plib(), eng());
mk(lm, "SomeTrack", "SA");
JlwGuiApp_set_search_query(lm, "zzzz");
JlwGuiApp_set_search_results(lm, vec_new());
var clm = vec_new();
jlw_gui_build_library(lm, 0, 0, 600, 400, clm);
assert_eq(find_text(clm, "No matches") != 0, 1, "search miss -> No matches");
assert_eq(find_text(clm, "Library is empty"), 0, "no scan hint when library non-empty");
# now_playing / queue two-line guidance
var npe = jlw_gui_app_new(fresh_plib(), eng());
var cnp = vec_new();
jlw_gui_build_now_playing(npe, 0, 0, 600, 400, cnp);
assert_eq(find_text(cnp, "Nothing playing") != 0, 1, "now_playing line 1");
assert_eq(find_text(cnp, "and press Enter") != 0, 1, "now_playing line 2 guidance");
var qe = jlw_gui_app_new(fresh_plib(), eng());
var cqe = vec_new();
jlw_gui_build_queue(qe, 0, 0, 600, 400, cqe);
assert_eq(find_text(cqe, "Queue is empty") != 0, 1, "queue line 1");
assert_eq(find_text(cqe, "enqueue tracks") != 0, 1, "queue line 2 guidance");

# ---- key_to_action: 'a' enqueue / 'd' remove (library.rs:148 / queue.rs:102) ----
test_group("key_enqueue_remove");
assert_eq(jlw_gui_key_to_action(97), JLW_GUI_ACT_ENQUEUE, "a -> enqueue");
assert_eq(jlw_gui_key_to_action(100), JLW_GUI_ACT_REMOVE, "d -> remove");
assert_eq(jlw_gui_key_to_action(103), JLW_GUI_ACT_TOGGLE_GRID, "g -> toggle grid");
assert_eq(jlw_gui_key_to_action(116), JLW_GUI_ACT_CYCLE_THEME, "t -> cycle theme");

# ---- library grid mode (library.rs grid_view) ----
test_group("build_library_grid");
var ga = jlw_gui_app_new(fresh_plib(), eng());
mk(ga, "GridA", "AA"); mk(ga, "GridB", "BB"); mk(ga, "GridC", "CC");
JlwGuiApp_set_view(ga, JLW_GUI_VIEW_LIBRARY);
JlwGuiApp_set_library_view_mode(ga, JLW_GUI_LIBVIEW_GRID);
JlwGuiApp_set_selected_index(ga, 1);
var cg = vec_new();
jlw_gui_build_library_grid(ga, 0, 0, 400, 400, cg);       # 400/130 = 3 columns
assert_eq(JlwGuiApp_grid_columns(ga), 3, "grid stashes column count (400/130=3)");
assert_eq(find_text(cg, "GridA") != 0, 1, "grid renders titles");
assert_eq(find_text(cg, "GridB") != 0, 1, "grid renders selected title");
assert_eq(count_kind(cg, JLW_DRAW_IMAGE), 3, "one art box per grid cell");
assert_eq(count_rect_color(cg, JLW_GUI_BG_WIDGET), 1, "selected cell tinted");
# build_library dispatches to grid when the mode is grid
var cg2 = vec_new();
jlw_gui_build_library(ga, 0, 0, 400, 400, cg2);
assert_eq(count_kind(cg2, JLW_DRAW_IMAGE), 3, "build_library dispatches to grid mode");
# clip commands wrap the cells
assert_eq(count_kind(cg2, JLW_DRAW_CLIP_PUSH), 1, "grid emits a clip push");
assert_eq(count_kind(cg2, JLW_DRAW_CLIP_POP), 1, "grid emits a clip pop");

rm("/tmp/jalwa_gui_draw.db");
var rc = assert_summary();
syscall(60, rc);
