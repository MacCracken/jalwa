include "src/gui/wayland.cyr"          # Linux: Wayland backend
#endif
include "src/gui/present.cyr"

fn _pp_say(s): i64 { return syscall(1, 1, s, strlen(s)); }

# print a signed integer to stdout (diagnostic).
fn _pp_sayn(n): i64 {
    if (n < 0) { _pp_say("-"); n = 0 - n; }
    if (n == 0) { return _pp_say("0"); }
    var tmp = alloc(24);
    var i = 0;
    var v = n;
    while (v > 0) { store8(tmp + i, 48 + (v - (v / 10) * 10)); i = i + 1; v = v / 10; }
    var out = alloc(24);
    var j = 0;
    while (j < i) { store8(out + j, load8(tmp + (i - 1 - j))); j = j + 1; }
    return syscall(1, 1, out, i);
}

fn _pp_main(): i64 {
    alloc_init();

    # 1. decode /tone.wav via jalwa's real decode path (shravan wav_decode).
    var dr = jlw_audio_decode("/tone.wav");
    if (dr == 0) { _pp_say("jalwa: decode FAILED\n"); return 1; }
    var fi = decode_result_info(dr);
    var rate = fmtinfo_sample_rate(fi);
    var channels = fmtinfo_channels(fi);
    var samples = decode_result_samples(dr);
    var count = vec_len(samples);
    _pp_say("jalwa: decoded /tone.wav\n");

    # 2. stand up the mishran mixer: router + vani sink + one stream for jalwa's audio.
    #    We feed the stream DIRECTLY (msh_stream_write) rather than over the TCP wire:
    #    agnos loopback can't complete a connect within a SINGLE process (no scheduler-
    #    driven net-stack draining during the blocking connect — it works only across
    #    two procs, e.g. the desktop). The msh_* wire protocol + backpressure ring are
    #    proven separately by serve_probe; here we prove jalwa's decode -> the MIXER
    #    (msh_mix fan-in + Q8 gain) -> msh_router_pump -> vani -> snd on-device.
    var router = msh_router_new();
    if (msh_router_open(router, 0, 0) != MISHRAN_OK) { _pp_say("jalwa: mixer sink FAILED\n"); return 2; }
    var st = msh_stream_new(rate, channels);
    msh_router_add(router, st);
    msh_stream_set_gain(st, 256);                # unity — the mixer applies the gain
    _pp_say("jalwa: audio routed through the mishran mixer\n");

    # 3. push jalwa's decoded PCM into the mixer stream + pump, in real time.
    var chunk = 1024;                            # == MSH_PUMP_FRAMES
    var outbuf = alloc(chunk * channels * 2);
    var i = 0;
    while (i < count) {
        var m = count - i;
        if (m > chunk * channels) { m = chunk * channels; }
        jlw_audio_f64_to_i16(samples, i, m, 1.0, outbuf);   # jalwa's f64 -> S16
        var frames = m / channels;
        msh_stream_write(st, outbuf, frames);    # jalwa's audio -> mixer stream ring
        msh_router_pump(router);                 # mix (fan-in + gain) -> vani -> snd (paces us)
        i = i + m;
    }

    msh_router_close(router);
    _pp_say("jalwa play-probe: done\n");
    return 0;
}

fn _entry(): i64 { var r = _pp_main(); syscall(SYS_EXIT, r); return 0; }
_entry();
