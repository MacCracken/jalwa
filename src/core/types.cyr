# core/types.cyr -- jalwa-core domain types (was crates/jalwa-core/src/lib.rs).
# L0. Entry files include src/error.cyr FIRST, then this. Modules never `include`
# each other.
#
# Ports the enums + core structs (MediaItem, Playlist, PlayQueue, PlaybackStatus,
# Library). Rust `enum`s become integer `var` codes + if/elif dispatch; `Display`
# impls become `_name(code)` fns returning the Rust string. serde derives and the
# serde round-trip tests are dropped (integer codes carry the identity).
#
# PORT STATUS (incremental): enums + PlaybackStatus done. Playlist/PlayQueue/
# MediaItem/Library land next (need the uuid + vec-of-struct + option idioms).

# ================================================================
# ContainerFormat  (was fallback_types::ContainerFormat; Display = Debug name)
# ================================================================
var JLW_FMT_MP4  = 0;
var JLW_FMT_MKV  = 1;
var JLW_FMT_WEBM = 2;
var JLW_FMT_OGG  = 3;
var JLW_FMT_WAV  = 4;
var JLW_FMT_FLAC = 5;
var JLW_FMT_MP3  = 6;
var JLW_FMT_AVI  = 7;

#must_use
fn jlw_container_format_name(code) {
    if (code == JLW_FMT_MP4)  { return "Mp4"; }
    if (code == JLW_FMT_MKV)  { return "Mkv"; }
    if (code == JLW_FMT_WEBM) { return "WebM"; }
    if (code == JLW_FMT_OGG)  { return "Ogg"; }
    if (code == JLW_FMT_WAV)  { return "Wav"; }
    if (code == JLW_FMT_FLAC) { return "Flac"; }
    if (code == JLW_FMT_MP3)  { return "Mp3"; }
    if (code == JLW_FMT_AVI)  { return "Avi"; }
    return "Unknown";
}

# ================================================================
# AudioCodec  (Display = Debug name)
# ================================================================
var JLW_ACODEC_PCM    = 0;
var JLW_ACODEC_MP3    = 1;
var JLW_ACODEC_AAC    = 2;
var JLW_ACODEC_FLAC   = 3;
var JLW_ACODEC_VORBIS = 4;
var JLW_ACODEC_OPUS   = 5;
var JLW_ACODEC_ALAC   = 6;
var JLW_ACODEC_WMA    = 7;

#must_use
fn jlw_audio_codec_name(code) {
    if (code == JLW_ACODEC_PCM)    { return "Pcm"; }
    if (code == JLW_ACODEC_MP3)    { return "Mp3"; }
    if (code == JLW_ACODEC_AAC)    { return "Aac"; }
    if (code == JLW_ACODEC_FLAC)   { return "Flac"; }
    if (code == JLW_ACODEC_VORBIS) { return "Vorbis"; }
    if (code == JLW_ACODEC_OPUS)   { return "Opus"; }
    if (code == JLW_ACODEC_ALAC)   { return "Alac"; }
    if (code == JLW_ACODEC_WMA)    { return "Wma"; }
    return "Unknown";
}

