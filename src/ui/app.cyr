# ui/app.cyr -- top-level TUI application state.
# Ports rust-old/crates/jalwa-ui/src/app.rs. L3: depends on error.cyr +
# core/types.cyr + core/db.cyr (PersistentLibrary) + playback/engine.cyr
# (PlaybackEngine). Pure state management -- a direct port. std::time::Instant
# error timing -> epoch seconds.

# ---- View ----
var JLW_VIEW_LIBRARY     = 0;
var JLW_VIEW_NOW_PLAYING = 1;
var JLW_VIEW_QUEUE       = 2;
var JLW_VIEW_EQUALIZER   = 3;

# cycle: Library -> NowPlaying -> Queue -> Equalizer -> Library.
#must_use
fn jlw_view_cycle(code) { return (code + 1) % 4; }

# ---- InputMode ----
var JLW_INPUT_NORMAL = 0;
var JLW_INPUT_SEARCH = 1;

# ---- App ----
#derive(accessors)
struct JlwApp {
    library; engine; queue; view; selected_index; search_query;
    search_results; input_mode; running; last_error; last_error_at;
}

#must_use
fn jlw_app_new(library, engine) {
    var a = alloc(sizeof(JlwApp));
    JlwApp_set_library(a, library);
    JlwApp_set_engine(a, engine);
    JlwApp_set_queue(a, jlw_queue_new());
    JlwApp_set_view(a, JLW_VIEW_LIBRARY);
    JlwApp_set_selected_index(a, 0);
    JlwApp_set_search_query(a, "");
    JlwApp_set_search_results(a, vec_new());
    JlwApp_set_input_mode(a, JLW_INPUT_NORMAL);
    JlwApp_set_running(a, 1);
    JlwApp_set_last_error(a, 0);          # None
    JlwApp_set_last_error_at(a, (0 - 1)); # None
    return a;
}

# inner in-memory Library (app.library.library in Rust).
#inline
#must_use
fn jlw_app_lib(a) { return jlw_plib_library(JlwApp_library(a)); }

# list_len: item count for the current view.
#must_use
fn jlw_app_list_len(a) {
    var view = JlwApp_view(a);
    if (view == JLW_VIEW_LIBRARY) {
        if (JlwApp_input_mode(a) == JLW_INPUT_SEARCH) { return vec_len(JlwApp_search_results(a)); }
        if (strlen(JlwApp_search_query(a)) > 0)       { return vec_len(JlwApp_search_results(a)); }
        return jlw_library_items_len(jlw_app_lib(a));
    }
    if (view == JLW_VIEW_QUEUE)       { return jlw_queue_len(JlwApp_queue(a)); }
    if (view == JLW_VIEW_NOW_PLAYING) { return 0; }
    return 10;   # Equalizer: 10 bands
}

fn jlw_app_select_prev(a) {
    if (JlwApp_selected_index(a) > 0) { JlwApp_set_selected_index(a, JlwApp_selected_index(a) - 1); }
    return 0;
}
fn jlw_app_select_next(a) {
    var len = jlw_app_list_len(a);
    if (len > 0) {
        if (JlwApp_selected_index(a) < len - 1) { JlwApp_set_selected_index(a, JlwApp_selected_index(a) + 1); }
    }
    return 0;
}

# update_search: filter library by the query (title/artist/album, ci); clamp selection.
fn jlw_app_update_search(a) {
    var q = JlwApp_search_query(a);
    if (strlen(q) == 0) { JlwApp_set_search_results(a, vec_new()); return 0; }
    var ql = str_lower_cstr(q);
    var results = vec_new();
    var items = JlwLibrary_items(jlw_app_lib(a));
    var n = vec_len(items);
    for (var i = 0; i < n; i = i + 1) {
        var item = vec_get(items, i);
        var matched = 0;
        if (jlw_str_contains_ci(JlwMediaItem_title(item), ql) == 1) { matched = 1; }
        var artist = JlwMediaItem_artist(item);
        if (artist != 0) { if (jlw_str_contains_ci(artist, ql) == 1) { matched = 1; } }
        var album = JlwMediaItem_album(item);
        if (album != 0) { if (jlw_str_contains_ci(album, ql) == 1) { matched = 1; } }
        if (matched == 1) { vec_push(results, i); }
    }
    JlwApp_set_search_results(a, results);
    if (JlwApp_selected_index(a) >= vec_len(results)) {
        if (vec_len(results) > 0) { JlwApp_set_selected_index(a, vec_len(results) - 1); }
    }
    return 0;
}

# error handling (last_error_at = epoch seconds; None = -1).
fn jlw_app_set_error(a, msg) {
    JlwApp_set_last_error(a, msg);
    JlwApp_set_last_error_at(a, clock_epoch_secs());
    return 0;
}
fn jlw_app_clear_error(a) {
    JlwApp_set_last_error(a, 0);
    JlwApp_set_last_error_at(a, (0 - 1));
    return 0;
}
# clear the error if older than 5 seconds.
fn jlw_app_clear_stale_error(a) {
    var at = JlwApp_last_error_at(a);
    if (at != (0 - 1)) {
        if (clock_epoch_secs() - at >= 5) {
            JlwApp_set_last_error(a, 0);
            JlwApp_set_last_error_at(a, (0 - 1));
        }
    }
    return 0;
}

# selected_library_index: the library index of the selection, or -1 (None).
#must_use
fn jlw_app_selected_library_index(a) {
    if (JlwApp_view(a) != JLW_VIEW_LIBRARY) { return (0 - 1); }
    if (strlen(JlwApp_search_query(a)) > 0) {
        var results = JlwApp_search_results(a);
        if (JlwApp_selected_index(a) < vec_len(results)) { return vec_get(results, JlwApp_selected_index(a)); }
        return (0 - 1);
    }
    if (JlwApp_selected_index(a) < jlw_library_items_len(jlw_app_lib(a))) { return JlwApp_selected_index(a); }
    return (0 - 1);
}
