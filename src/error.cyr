# error.cyr -- jalwa error codes + base helpers.
# L0 base module: included FIRST by every build/test entry. Modules never
# `include` each other -- the entry file / [lib].modules orders them.
#
# Ports rust-old/crates/jalwa-core/src/lib.rs (the `JalwaError` enum, 8 variants).
# Rust carried a String payload per variant (or a `#[from]` source error); the
# Cyrius port uses integer codes -- fallible fns return JLW_ERR_NONE (0) on
# success or a negative code on failure. Diagnostic text via jlw_err_name().
# The runtime payload (the "{0}" message / io::Error / TarangError context) is
# dropped -- it can't ride an i64 code.
#
# NAMING: every jalwa top-level symbol is `jlw_`/`Jlw`/`JLW_`-prefixed so the
# jalwa bundle coexists with the sibling dist bundles it pulls (dhvani exports
# dhvani_*, bote exports bote_*, yukti exports yukti_*) in one flat namespace.

# ================================================================
# Error codes (was `enum JalwaError`). One per Rust variant, in order.
# The Io + Tarang variants were `#[from]` wrappers; here they are plain codes
# (the wrapped source-error detail is dropped). Tarang was `#[cfg(feature =
# "tarang")]`-gated in Rust; the port keeps it always-present since tarang is
# stubbed, not feature-gated.
# ================================================================
var JLW_ERR_NONE               = 0;
var JLW_ERR_NOT_FOUND          = (0 - 1);   # media not found
var JLW_ERR_PLAYBACK           = (0 - 2);   # playback error
var JLW_ERR_LIBRARY            = (0 - 3);   # library error
var JLW_ERR_UNSUPPORTED_FORMAT = (0 - 4);   # unsupported container/codec
var JLW_ERR_DATABASE           = (0 - 5);   # database (patra) error
var JLW_ERR_SCANNER            = (0 - 6);   # library scanner error
var JLW_ERR_IO                 = (0 - 7);   # was Io(#[from] std::io::Error)
var JLW_ERR_TARANG             = (0 - 8);   # was Tarang(#[from] tarang::core::TarangError)

# ================================================================
# Shared f64 sentinels (IEEE-754 bit patterns) for the sentinel-return port of
# Rust `Option<f64>` / `Option<Duration>`: NaN = None (a real value is never NaN
# in these paths), +/-inf for saturating cases. Used e.g. by playback progress.
# ================================================================
var JLW_NAN     = 0x7FF8000000000000;   # quiet NaN -- the Option<f64> "None" sentinel
var JLW_POS_INF = 0x7FF0000000000000;   # +inf
var JLW_NEG_INF = 0xFFF0000000000000;   # -inf

# 1 if `code` is an error (negative), 0 otherwise.
#must_use
fn jlw_is_err(code) {
    if (code < 0) { return 1; }
    return 0;
}

# Static name for an error code (for diagnostics / logging). Mirrors the Rust
# `#[error("...")]` Display messages, minus the runtime payload ({0}).
#must_use
fn jlw_err_name(code) {
    if (code == JLW_ERR_NONE)               { return "none"; }
    if (code == JLW_ERR_NOT_FOUND)          { return "media not found"; }
    if (code == JLW_ERR_PLAYBACK)           { return "playback error"; }
    if (code == JLW_ERR_LIBRARY)            { return "library error"; }
    if (code == JLW_ERR_UNSUPPORTED_FORMAT) { return "unsupported format"; }
    if (code == JLW_ERR_DATABASE)           { return "database error"; }
    if (code == JLW_ERR_SCANNER)            { return "scanner error"; }
    if (code == JLW_ERR_IO)                 { return "I/O error"; }
    if (code == JLW_ERR_TARANG)             { return "tarang error"; }
    return "unknown error";
}

# Finite test: 1 iff x is neither +/-inf nor NaN. abs(x) < +inf holds for finite
# x, fails for infinities (inf < inf is false) and NaN (any NaN compare is false).
# Used to detect the JLW_NAN "None" sentinel on Option<f64> returns.
#must_use
fn jlw_is_finite(x) {
    return f64_lt(f64_abs(x), JLW_POS_INF);
}
