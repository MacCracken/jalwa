# main.cyr -- jalwa CLI entry + the full-crate ASSEMBLY.
# Ports rust-old/src/main.rs (clap CLI). This file is the [build] entry: it
# includes every ported module in dependency order (deps before dependents),
# so `cyrius build src/main.cyr build/jalwa` links the whole crate.
#
# clap derive -> hand-rolled args dispatch. cmd_* handlers return their output
# string (main prints it); tokio/ctrl-c/blocking-playback loops are elided
# (playback is tarang-stubbed). GUI is Wave F; the MCP stdio loop is deferred.

# ===== ASSEMBLY: all modules, L0 -> L4 =====
include "src/error.cyr"
include "src/core/types.cyr"
include "src/core/db.cyr"
include "src/core/playlist_io.cyr"
include "src/core/scanner.cyr"
include "src/core/watcher.cyr"
include "src/core/hardware.cyr"
include "src/playback/dsp.cyr"
include "src/playback/decode_thread.cyr"
include "src/playback/engine.cyr"
include "src/playback/mpris.cyr"
include "src/playback/audio.cyr"
include "src/ai/reco.cyr"
include "src/ai/daimon.cyr"
include "src/ai/fingerprint.cyr"
include "src/ui/renderers.cyr"
include "src/ui/app.cyr"
include "src/ui/tui.cyr"
include "src/ui/widgets.cyr"
include "src/mcp.cyr"
include "src/mcp_serve.cyr"
include "src/gui/theme.cyr"
include "src/gui/art_cache.cyr"
include "src/gui/app.cyr"
include "src/gui/views.cyr"
include "src/gui/draw.cyr"
include "src/gui/raster.cyr"
include "src/gui/input.cyr"
include "src/gui/control.cyr"
# Display backend — jalwa's GUI is cross-platform: agnos presents its XRGB8888 raster
# over setu (the sovereign desktop -> aethersafha), Linux over Wayland. Both define the
# same jlw_win_* seam that present.cyr drives; exactly one is included per target.
#ifdef CYRIUS_TARGET_AGNOS
include "src/gui/setu_present.cyr"    # AGNOS: setu display backend
#endif
#ifndef CYRIUS_TARGET_AGNOS
include "src/gui/wayland.cyr"          # Linux: Wayland backend
#endif
include "src/gui/present.cyr"    # render loop over the jlw_win_* seam

# ===== library open =====
# mkdir -p: create each path component (0755); pre-existing dirs error harmlessly.
fn jlw_mkdir_p(path) {
    var n = strlen(path);
    for (var i = 1; i < n; i = i + 1) {
        if (load8(path + i) == 47) {
            var pre = alloc(i + 1);
            memcpy(pre, path, i);
            store8(pre + i, 0);
            syscall(83, pre, 493);   # mkdir 0755
        }
    }
    syscall(83, path, 493);
    return 0;
}
# open the default library, creating its parent dir first (Rust create_dir_all).
#must_use
fn jlw_open_library() {
    var path = jlw_default_db_path();
    var n = strlen(path);
    var last = 0;
    for (var i = 0; i < n; i = i + 1) { if (load8(path + i) == 47) { last = i; } }
    var parent = alloc(last + 1);
    memcpy(parent, path, last);
    store8(parent + last, 0);
    jlw_mkdir_p(parent);
    return jlw_plib_open(path);
}

# ===== cmd handlers (return the output string) =====
#must_use
fn jlw_cmd_search(plib, query) {
    var results = jlw_library_search(jlw_plib_library(plib), query);
    if (vec_len(results) == 0) { return jlw_mcp_cat(jlw_mcp_cat("No results for '", query), "'"); }
    var sb = str_builder_new();
    for (var i = 0; i < vec_len(results); i = i + 1) {
        if (i > 0) { str_builder_putc(sb, 10); }
        str_builder_add_cstr(sb, jlw_ui_render_library_item(vec_get(results, i), i));
    }
    return str_cstr(str_builder_build(sb));
}
#must_use
fn jlw_cmd_stats(plib) { return jlw_ui_render_library_stats(jlw_plib_library(plib)); }
#must_use
fn jlw_cmd_library(plib) {
    var lib = jlw_plib_library(plib);
    var items = JlwLibrary_items(lib);
    if (vec_len(items) == 0) { return "Library is empty. Use 'jalwa scan <directory>' to add files."; }
    var sb = str_builder_new();
    for (var i = 0; i < vec_len(items); i = i + 1) {
        str_builder_add_cstr(sb, jlw_ui_render_library_item(vec_get(items, i), i));
        str_builder_putc(sb, 10);
    }
    str_builder_putc(sb, 10);
    str_builder_add_cstr(sb, jlw_ui_render_library_stats(lib));
    return str_cstr(str_builder_build(sb));
}
#must_use
# play a file: open (probe) + decode+output synchronously (blocks until done).
# Real audio via shravan->vani; falls back to a message when no device/decoder.
#must_use
fn jlw_cmd_play(engine, path) {
    if (file_exists(path) == 0) { return jlw_mcp_cat("error: file not found: ", path); }
    jlw_engine_open(engine, path);
    var rc = jlw_audio_play_file(path, JlwPlaybackEngine_volume(engine));
    if (rc == JLW_ERR_UNSUPPORTED_FORMAT) { return jlw_mcp_cat("error: cannot decode: ", path); }
    if (rc != JLW_ERR_NONE) { return jlw_mcp_cat("Loaded (no audio device): ", path); }
    return jlw_mcp_cat("Played: ", path);
}
#must_use
# info: real audio probe summary (shravan header probe -- tarang is video-only).
#must_use
fn jlw_cmd_info(path) {
    if (file_exists(path) == 0) { return jlw_mcp_cat("error: cannot open: ", path); }
    return jlw_scanner_probe_summary(path);
}
# scan a directory (real, via shravan audio probe -- tarang is video-only), add
# new files to the library, and report. Ports rust-old cmd_scan (backed by
# shravan instead of tarang::probe_audio).
#must_use
fn jlw_cmd_scan(plib, dir) {
    var result = jlw_scanner_scan_directory(dir);
    if (result == 0) { return jlw_mcp_cat("error: not a directory: ", dir); }
    var lib = jlw_plib_library(plib);
    var files = JlwScanResult_files(result);
    var errors = JlwScanResult_errors(result);
    var added = 0;
    for (var i = 0; i < vec_len(files); i = i + 1) {
        var f = vec_get(files, i);
        if (jlw_library_find_by_path(lib, JlwScannedFile_path(f)) == 0) {
            jlw_plib_add_item(plib, jlw_scanner_scanned_to_media_item(f));
            added = added + 1;
        }
    }
    jlw_plib_add_scan_path(plib, dir);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Scanning "); str_builder_add_cstr(sb, dir); str_builder_add_cstr(sb, "...\n");
    str_builder_add_cstr(sb, "Found "); str_builder_add_int(sb, vec_len(files)); str_builder_add_cstr(sb, " media files\n");
    if (vec_len(errors) > 0) { str_builder_add_int(sb, vec_len(errors)); str_builder_add_cstr(sb, " files had errors\n"); }
    str_builder_add_cstr(sb, "Added "); str_builder_add_int(sb, added); str_builder_add_cstr(sb, " new items to library\n");
    str_builder_add_cstr(sb, jlw_ui_render_library_stats(lib));
    return str_cstr(str_builder_build(sb));
}
#must_use
fn jlw_cmd_export(plib, name, output) {
    var lib = jlw_plib_library(plib);
    var pls = JlwLibrary_playlists(lib);
    for (var i = 0; i < vec_len(pls); i = i + 1) {
        var pl = vec_get(pls, i);
        if (jlw_ci_eq(jlw_playlist_name(pl), name) == 1) {
            jlw_save_m3u(pl, lib, output);
            return jlw_mcp_cat(jlw_mcp_cat("Exported '", name), jlw_mcp_cat("' to ", output));
        }
    }
    return jlw_mcp_cat(jlw_mcp_cat("error: playlist '", name), "' not found");
}
#must_use
fn jlw_cmd_import(plib, file) {
    var paths = jlw_load_m3u(file);
    if (paths == 0) { return jlw_mcp_cat("error: cannot read ", file); }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Imported ");
    str_builder_add_int(sb, vec_len(paths));
    str_builder_add_cstr(sb, " tracks");
    return str_cstr(str_builder_build(sb));
}
#must_use
fn jlw_cmd_devices() { return "No media devices detected."; }

# ===== main dispatch =====
fn main() {
    alloc_init();
    args_init();
    # wire the real audio backend into the engine (threaded shravan->vani playback);
    # the TUI's jlw_engine_play then plays in the background. Keeps engine.cyr free of
    # a compile-time dep on the audio stack (fnptr seam).
    jlw_engine_set_audio_backend(&jlw_audio_play_async_dsp, &jlw_audio_play_is_done,
                                 &jlw_audio_play_stop, &jlw_audio_play_position, &jlw_audio_play_ctl);
    var n = argc();
    if (n < 2) {
#ifdef CYRIUS_TARGET_AGNOS
        # On the sovereign desktop the compositor spawns us as /bin/puka with NO args;
        # default to the GUI window (mirrors doom booting its PM_SETU window with no
        # args). A fresh desktop may have no library db yet — jlw_open_library() returns
        # 0 when the on-disk db can't be opened — so fall back to an empty in-memory
        # library rather than handing the render loop a null handle.
        println("jalwa: agnos desktop gui starting");
        var plib = jlw_open_library();
        if (plib == 0) { plib = jlw_plib_new_empty(); }
        jlw_gui_run(jlw_gui_app_new(plib, jlw_engine_new(jlw_engine_config_default())));
        return 0;
#endif
#ifndef CYRIUS_TARGET_AGNOS
        println("jalwa -- AI-native media player for AGNOS");
        println("usage: jalwa <play|info|search|stats|scan|library|export|import|devices|tui|gui|mcp>");
        return 0;
#endif
    }
    var cmd = argv(1);
    if (streq(cmd, "search") == 1)  { if (n >= 3) { println(jlw_cmd_search(jlw_open_library(), argv(2))); } return 0; }
    if (streq(cmd, "stats") == 1)   { println(jlw_cmd_stats(jlw_open_library())); return 0; }
    if (streq(cmd, "library") == 1) { println(jlw_cmd_library(jlw_open_library())); return 0; }
    if (streq(cmd, "play") == 1)    { if (n >= 3) { println(jlw_cmd_play(jlw_engine_new(jlw_engine_config_default()), argv(2))); } return 0; }
    if (streq(cmd, "info") == 1)    { if (n >= 3) { println(jlw_cmd_info(argv(2))); } return 0; }
    if (streq(cmd, "scan") == 1)    { if (n >= 3) { println(jlw_cmd_scan(jlw_open_library(), argv(2))); } return 0; }
    if (streq(cmd, "export") == 1)  { if (n >= 4) { println(jlw_cmd_export(jlw_open_library(), argv(2), argv(3))); } return 0; }
    if (streq(cmd, "import") == 1)  { if (n >= 3) { println(jlw_cmd_import(jlw_open_library(), argv(2))); } return 0; }
    if (streq(cmd, "devices") == 1) { println(jlw_cmd_devices()); return 0; }
    if (streq(cmd, "tui") == 1)     { jlw_tui_run(jlw_app_new(jlw_open_library(), jlw_engine_new(jlw_engine_config_default()))); return 0; }
    if (streq(cmd, "mcp") == 1)     { return jlw_mcp_serve(jlw_open_library(), jlw_engine_new(jlw_engine_config_default())); }
    if (streq(cmd, "gui") == 1)     { jlw_gui_run(jlw_gui_app_new(jlw_open_library(), jlw_engine_new(jlw_engine_config_default()))); return 0; }
    println(jlw_mcp_cat("unknown command: ", cmd));
    return 0;
}

fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
