# playback/audio.cyr -- real audio playback: shravan decode -> volume -> vani out.
# tarang is VIDEO-only; audio decodes through shravan and plays through vani
# (ALSA / agnos snd band). This replaces the tarang-stubbed decode path. CLI
# `jalwa play` uses the synchronous blocking path; jlw_audio_play_async spawns a
# real background decode thread (cancellable, polled) -- the primitive the engine
# will build on to play while the TUI stays live. Cyrius threads are real and the
# bump allocator is thread-safe (process-wide CAS lock), so a decode thread and
# the main thread can both allocate safely.
#
# Depends on core/scanner.cyr (jlw_detect_audio_format, jlw_file_size) + the
# shravan and vani deps. dhvani DSP/EQ is available (jlw_dsp) but not yet wired
# into the live loop -- volume is applied; EQ is a follow-up.
#
# TESTABLE seam: jlw_audio_decode (decode a fixture -> rate/channels/samples) and
# jlw_audio_f64_to_i16 (sample conversion). SMOKE-only: jlw_audio_play_file needs
# a real audio device (absent under cyrius test / headless CI -> returns cleanly).

# shravan decoders read the F64 conversion constants (shravan_init_constants) and
# FLAC needs its CRC tables (flac_init); mp3_decode self-inits its tables. Once.
var JLW_AUDIO_INIT = 0;
fn jlw_audio_ensure_init() {
    if (JLW_AUDIO_INIT == 0) {
        shravan_init_constants();
        flac_init();
        JLW_AUDIO_INIT = 1;
    }
    return 0;
}

# decode an audio file to a shravan decode_result (>0), or 0 on failure. Bypasses
# shravan codec_open (its internal detect_format collides with sankoch's) by
# dispatching on jalwa's own magic-byte detector to the per-format decoder.
# Reads the whole file (one alloc). Supports WAV/FLAC/MP3 (shravan's OGG/AAC/MP4
# decoders are not production-ready -- see jlw_audio_decode).
#must_use
fn jlw_audio_decode(path) {
    jlw_audio_ensure_init();
    var size = jlw_file_size(path);
    if (size <= 0) { return 0; }
    var buf = alloc(size);
    var n = file_read_all(path, buf, size);
    if (n <= 0) { return 0; }
    var sf = jlw_detect_audio_format(buf, n);
    var dr = 0;
    if (sf == 0) { dr = wav_decode(buf, n); }   # WAV (PCM)
    if (sf == 1) { dr = flac_decode(buf, n); }  # FLAC
    if (sf == 5) { dr = mp3_decode(buf, n); }   # MP3
    # OGG/AAC/MP4 are DELIBERATELY excluded: shravan's ogg_decode errors and
    # mp4_decode SEGFAULTS on standard files (verified 2026-07-09) -- they are not
    # production-ready, so those formats return "cannot decode" rather than crash.
    # flac_init + shravan_init_constants run once in jlw_audio_ensure_init; mp3_decode self-inits.
    if (dr <= 0) { return 0; }
    return dr;
}

# convert `count` normalized-f64 samples starting at `start` to interleaved S16_LE
# in `out` (2 bytes/sample), applying `volume` and clamping to [-32768, 32767].
fn jlw_audio_f64_to_i16(samples, start, count, volume, out) {
    var neg = f64_neg(32768.0);
    for (var j = 0; j < count; j = j + 1) {
        var v = f64_mul(f64_mul(vec_get(samples, start + j), volume), 32768.0);
        if (f64_gt(v, 32767.0) == 1) { v = 32767.0; }
        if (f64_lt(v, neg) == 1) { v = neg; }
        store16(out + j * 2, f64_to(v));
    }
    return 0;
}

# ---- output sink: the mishran mixer (route through the server) or direct vani ----
# jlw_sink is a tagged handle: +0 kind (1 = mishran, 2 = vani), +8 handle. All
# playback goes through this seam so jalwa SHARES the one hardware writer with
# every other sounding app when a mishran server is up — falling back to a direct
# vani device when standalone (no mixer). The mishran path streams PCM over
# loopback:7701; the server paces us via TCP backpressure (its ring-full latch),
# so the play loop stays real-time without a client-side timer.
enum JlwSinkKind {
    JLW_SINK_MISHRAN = 1;
    JLW_SINK_VANI    = 2;
}

# Open an output sink for rate/channels. Prefer the mishran mixer; fall back to a
# direct vani device if no server is listening. Returns a *jlw_sink, or 0 when
# neither is available.
fn jlw_sink_open(rate, channels) {
    var c = msh_client_connect(rate, channels);
    if (c != 0) {
        var mm = "jalwa: audio routed through the mishran mixer\n";
        syscall(1, 1, mm, strlen(mm));
        var s = alloc(16);
        store64(s + 0, JLW_SINK_MISHRAN);
        store64(s + 8, c);
        return s;
    }
    var dev = audio_open_playback(0, 0);
    if (dev == 0) { return 0; }
    var vm = "jalwa: audio via direct vani (no mixer)\n";
    syscall(1, 1, vm, strlen(vm));
    audio_set_params(dev, rate, channels, 16);
    audio_prepare(dev);
    var s2 = alloc(16);
    store64(s2 + 0, JLW_SINK_VANI);
    store64(s2 + 8, dev);
    return s2;
}

# Write `frames` interleaved S16 frames from `buf`; returns 0 on success, -1 on a
# write error. mishran takes the whole chunk in one msh_client_write (paced by the
# server's TCP backpressure); vani loops over partial writes.
fn jlw_sink_write(s, buf, frames, channels) {
    if (load64(s + 0) == JLW_SINK_MISHRAN) {
        if (msh_client_write(load64(s + 8), buf, frames) < 0) { return 0 - 1; }
        return 0;
    }
    var dev = load64(s + 8);
    var written = 0;
    while (written < frames) {
        var w = audio_write(dev, buf + written * channels * 2, frames - written);
        if (w <= 0) { return 0 - 1; }
        written = written + w;
    }
    return 0;
}

# Flush queued audio on a seek. vani drops + re-arms the device buffer; mishran has
# no client-side flush yet (the mixer ring drains naturally — brief extra latency).
fn jlw_sink_drop(s) {
    if (load64(s + 0) == JLW_SINK_VANI) { audio_drop(load64(s + 8)); }
    return 0;
}
fn jlw_sink_prepare(s) {
    if (load64(s + 0) == JLW_SINK_VANI) { audio_prepare(load64(s + 8)); }
    return 0;
}

# Drain + close the sink (BYE + close for mishran; drain + close for vani).
fn jlw_sink_close(s) {
    if (load64(s + 0) == JLW_SINK_MISHRAN) { return msh_client_close(load64(s + 8)); }
    var dev = load64(s + 8);
    audio_drain(dev);
    audio_close(dev);
    return 0;
}

# play a decoded file to the default device. `h` is an optional JlwPlayHandle
# (0 = none): between chunks the loop checks JlwPlayHandle_stop(h) and, if set,
# stops early -- the hook a background thread / the engine uses to cancel playback.
# Also updates JlwPlayHandle_position(h) (seconds played). Returns JLW_ERR_NONE on
# completion, JLW_ERR_UNSUPPORTED_FORMAT on decode failure, JLW_ERR_PLAYBACK when
# no device is available. Blocks (vani audio_write is kernel-paced).
fn jlw_audio_play_file_h(path, volume, h) {
    var dr = jlw_audio_decode(path);
    if (dr == 0) { return JLW_ERR_UNSUPPORTED_FORMAT; }
    var fi = decode_result_info(dr);
    var rate = fmtinfo_sample_rate(fi);
    var channels = fmtinfo_channels(fi);
    var samples = decode_result_samples(dr);
    var count = vec_len(samples);
    if (count == 0) { return JLW_ERR_PLAYBACK; }
    if (channels <= 0) { channels = 1; }

    # DSP chain (upfront, whole-track): graphic EQ then loudness-normalize, each a
    # no-op when disabled. A mid-track EQ/normalize change takes effect on the next track.
    if (h != 0) {
        samples = jlw_audio_apply_eq(samples, channels, rate, JlwPlayHandle_eq(h));
        samples = jlw_audio_apply_normalize(samples, channels, rate, JlwPlayHandle_normalize(h));
        count = vec_len(samples);
    }

    var sink = jlw_sink_open(rate, channels);
    if (sink == 0) { return JLW_ERR_PLAYBACK; }   # no mixer and no device

    var chunk_frames = 1024;                      # <= mishran ring (backpressure); fine for vani too
    var chunk_samples = chunk_frames * channels;
    var outbuf = alloc(chunk_samples * 2);       # reused per chunk (no per-frame alloc)
    var silbuf = alloc(chunk_samples * 2);       # zero-filled: fed to the device while paused
    for (var z = 0; z < chunk_samples; z = z + 1) { store16(silbuf + z * 2, 0); }
    var i = 0;
    while (i < count) {
        var cancelled = 0;
        var paused = 0;
        if (h != 0) {
            if (JlwPlayHandle_stop(h) == 1) { cancelled = 1; }
            else { if (JlwPlayHandle_paused(h) == 1) { paused = 1; } }
        }
        if (cancelled == 1) { i = count; }
        else {
            # apply a pending seek: jump the sample index, flush queued audio for
            # responsiveness (audio_drop discards the buffer; prepare re-arms it).
            if (h != 0) {
                var st = JlwPlayHandle_seek_to(h);
                if (st >= 0) {
                    var ts = (st * rate / 1000) * channels;   # ms -> frame -> interleaved sample
                    if (ts < 0) { ts = 0; }
                    if (ts > count) { ts = count; }
                    i = ts;
                    JlwPlayHandle_set_seek_to(h, 0 - 1);
                    jlw_sink_drop(sink);
                    jlw_sink_prepare(sink);
                    if (rate > 0) { JlwPlayHandle_set_position(h, f64_div(f64_from(i / channels), f64_from(rate))); }
                }
            }
            if (paused == 1) {
                # keep the device fed with silence (no ALSA underrun); hold position
                jlw_sink_write(sink, silbuf, chunk_frames, channels);
            } else {
                var vol = volume;
                if (h != 0) { vol = JlwPlayHandle_volume(h); }   # live volume
                var m = count - i;
                if (m > chunk_samples) { m = chunk_samples; }
                jlw_audio_f64_to_i16(samples, i, m, vol, outbuf);
                var frames = m / channels;
                if (jlw_sink_write(sink, outbuf, frames, channels) < 0) { i = count; }   # write error -> stop
                i = i + m;
                if (h != 0) { if (rate > 0) { JlwPlayHandle_set_position(h, f64_div(f64_from(i / channels), f64_from(rate))); } }
            }
        }
    }
    jlw_sink_close(sink);
    return JLW_ERR_NONE;
}

# synchronous, uncancellable playback (the CLI `jalwa play` path).
#must_use
fn jlw_audio_play_file(path, volume) { return jlw_audio_play_file_h(path, volume, 0); }

# ---- background (threaded) playback ----
# JlwPlayHandle is the shared control block between the main thread and a decode
# thread. Single-word fields -> aligned load64/store64 are atomic on x86_64/agnos,
# so `stop`/`done`/`position` need no lock for this producer/consumer pattern.
#derive(accessors)
struct JlwPlayHandle { path; volume; stop; done; position; rc; paused; seek_to; eq; normalize; }

# the thread body: play the file (cancellable via the handle), then mark done.
fn jlw_audio_play_worker(h) {
    JlwPlayHandle_set_rc(h, jlw_audio_play_file_h(JlwPlayHandle_path(h), JlwPlayHandle_volume(h), h));
    JlwPlayHandle_set_done(h, 1);
    return 0;
}

# start playback on a background thread with the given volume + optional EQ settings
# (0 = none). Returns the JlwPlayHandle immediately (non-blocking). Poll is_done /
# read position; cancel via _stop; pause / live volume / seek via _ctl. Mirrors
# rust-old's spawned decode thread (gapless / prepare_next is a follow-up).
#must_use
fn jlw_audio_play_async_full(path, volume, eq, normalize) {
    var h = alloc(sizeof(JlwPlayHandle));
    JlwPlayHandle_set_path(h, path);
    JlwPlayHandle_set_volume(h, volume);
    JlwPlayHandle_set_stop(h, 0);
    JlwPlayHandle_set_done(h, 0);
    JlwPlayHandle_set_position(h, 0.0);
    JlwPlayHandle_set_rc(h, JLW_ERR_NONE);
    JlwPlayHandle_set_paused(h, 0);
    JlwPlayHandle_set_seek_to(h, 0 - 1);   # no pending seek
    JlwPlayHandle_set_eq(h, eq);           # dhvani geq settings ptr, or 0
    JlwPlayHandle_set_normalize(h, normalize);   # loudness-normalize on/off
    thread_create(&jlw_audio_play_worker, h);
    return h;
}
#inline
#must_use
fn jlw_audio_play_async(path, volume) { return jlw_audio_play_async_full(path, volume, 0, 0); }

# transport control from the main thread -> the decode thread (atomic single-word
# flags; the loop re-reads them between chunks). code/arg use the JLW_PLAY_CMD_*
# constants from engine.cyr.
fn jlw_audio_play_ctl(h, code, arg) {
    if (code == JLW_PLAY_CMD_PAUSE)  { JlwPlayHandle_set_paused(h, arg); }
    if (code == JLW_PLAY_CMD_VOLUME) { JlwPlayHandle_set_volume(h, f64_div(f64_from(arg), 100.0)); }
    if (code == JLW_PLAY_CMD_SEEK)   { JlwPlayHandle_set_seek_to(h, arg); }   # arg = target ms
    return 0;
}
#inline
#must_use
fn jlw_audio_play_is_done(h) { return JlwPlayHandle_done(h); }
#inline
fn jlw_audio_play_stop(h) { JlwPlayHandle_set_stop(h, 1); return 0; }
#inline
#must_use
fn jlw_audio_play_position(h) { return JlwPlayHandle_position(h); }   # f64 seconds

# engine-backend adapter: volume arrives as an integer percent (0-100) across the
# fnptr seam. Registered via jlw_engine_set_audio_backend(&jlw_audio_play_async_dsp,
# &jlw_audio_play_is_done, &jlw_audio_play_stop, &jlw_audio_play_position).
#must_use
fn jlw_audio_play_async_dsp(path, vol_pct, eq, normalize) {
    return jlw_audio_play_async_full(path, f64_div(f64_from(vol_pct), 100.0), eq, normalize);
}

# apply loudness normalization (dhvani analysis -> peak-limited gain) to decoded
# samples, or return them unchanged when disabled. Like EQ, this is upfront/whole-track
# (RMS analysis needs the full buffer). Returns the (possibly new) sample vec.
#must_use
fn jlw_audio_apply_normalize(samples, channels, rate, enabled) {
    if (enabled == 0) { return samples; }
    if (vec_len(samples) == 0) { return samples; }
    var buf = jlw_audio_buffer_new(samples, channels, rate);
    var loud = jlw_dsp_analyze_loudness(buf);
    var nbuf = jlw_dsp_normalize(buf, JlwLoudnessInfo_gain(loud));
    return JlwAudioBuffer_samples(nbuf);
}

# apply the graphic EQ (dhvani jlw_dsp) to decoded samples, returning the EQ'd
# samples (a copy) -- or the input unchanged when the settings are absent, disabled,
# or flat (no allocation in that common case). Stateful biquads process the whole
# track once; a real render loop would reuse scratch (parity with dhvani's copy).
#must_use
fn jlw_audio_apply_eq(samples, channels, rate, eqset) {
    if (eqset == 0) { return samples; }
    if (dhvani_geq_settings_enabled(eqset) == 0) { return samples; }
    if (dhvani_geq_settings_is_flat(eqset) == 1) { return samples; }
    var eq = jlw_dsp_eq_new(rate);
    JlwEqualizer_set_settings(eq, eqset);
    jlw_dsp_eq_update_coefficients(eq);
    var eqbuf = jlw_dsp_eq_process(eq, jlw_audio_buffer_new(samples, channels, rate));
    return JlwAudioBuffer_samples(eqbuf);
}
