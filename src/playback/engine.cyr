# playback/engine.cyr -- the PlaybackEngine facade (was jalwa-playback/src/lib.rs).
# L2: depends on error.cyr + core/types.cyr (PlaybackState/Status) + the dhvani
# dist (EqSettings). Orchestrates the decode thread + tarang probe.
#
# The decode thread is STUBBED (see decode_thread.cyr), so the channel handles
# (cmd_tx/decode_status/event_rx/video_frame_rx) are always 0 (None) and the
# command sends are no-ops -- exactly the Rust `if let Some(tx)` guards. The
# state-management surface (config/volume/mute/EQ/normalize/state/status/
# format_duration) ports faithfully; play/open are stubbed to their error paths.

# ---- EngineConfig ----
#derive(accessors)
struct JlwEngineConfig { buffer_size; sample_rate; channels; }
#must_use
fn jlw_engine_config_default() {
    var c = alloc(sizeof(JlwEngineConfig));
    JlwEngineConfig_set_buffer_size(c, 4096);
    JlwEngineConfig_set_sample_rate(c, 48000);
    JlwEngineConfig_set_channels(c, 2);
    return c;
}

# ---- PlaybackEngine ----
#derive(accessors)
struct JlwPlaybackEngine {
    config; state; current_path; position; duration; volume; muted;
    eq_settings; normalize_enabled; cmd_tx; decode_status; event_rx;
    is_video; video_frame_rx; play_handle;
}

# ---- audio-backend seam ----
# The engine stays decoupled from the shravan/vani audio stack: playback is driven
# through these fnptr slots, wired by main() via jlw_engine_set_audio_backend. When
# 0 (unwired -- every engine/tui/gui unit test), play is a state-only no-op, so those
# tests don't fold the heavy audio deps. Volume crosses as an integer percent (0-100)
# to avoid any f64-through-fncall question; position returns f64 bits (Cyrius f64 IS
# an i64 bit pattern, so it survives fncall1's i64 return).
var JLW_ENG_PLAY_FP = 0;   # (path, vol_pct) -> handle
var JLW_ENG_DONE_FP = 0;   # (handle) -> 0/1
var JLW_ENG_STOP_FP = 0;   # (handle) -> 0
var JLW_ENG_POS_FP  = 0;   # (handle) -> position (f64 bits)
fn jlw_engine_set_audio_backend(play_fp, done_fp, stop_fp, pos_fp) {
    JLW_ENG_PLAY_FP = play_fp;
    JLW_ENG_DONE_FP = done_fp;
    JLW_ENG_STOP_FP = stop_fp;
    JLW_ENG_POS_FP  = pos_fp;
    return 0;
}

#must_use
fn jlw_engine_new(config) {
    var e = alloc(sizeof(JlwPlaybackEngine));
    JlwPlaybackEngine_set_config(e, config);
    JlwPlaybackEngine_set_state(e, JLW_STATE_STOPPED);
    JlwPlaybackEngine_set_current_path(e, 0);      # None
    JlwPlaybackEngine_set_position(e, 0);          # 0.0 s
    JlwPlaybackEngine_set_duration(e, JLW_NAN);    # None
    JlwPlaybackEngine_set_volume(e, 1.0);
    JlwPlaybackEngine_set_muted(e, 0);
    JlwPlaybackEngine_set_eq_settings(e, dhvani_geq_settings_default());
    JlwPlaybackEngine_set_normalize_enabled(e, 0);
    JlwPlaybackEngine_set_cmd_tx(e, 0);
    JlwPlaybackEngine_set_decode_status(e, 0);
    JlwPlaybackEngine_set_event_rx(e, 0);
    JlwPlaybackEngine_set_is_video(e, 0);
    JlwPlaybackEngine_set_video_frame_rx(e, 0);
    JlwPlaybackEngine_set_play_handle(e, 0);       # None (no active playback thread)
    return e;
}

# ---- simple accessors ----
#inline
#must_use
fn jlw_engine_config(e) { return JlwPlaybackEngine_config(e); }
#must_use
fn jlw_engine_volume(e) { return JlwPlaybackEngine_volume(e); }
#must_use
fn jlw_engine_muted(e) { return JlwPlaybackEngine_muted(e); }
#must_use
fn jlw_engine_duration(e) { return JlwPlaybackEngine_duration(e); }   # JLW_NAN = None
#must_use
fn jlw_engine_current_path(e) { return JlwPlaybackEngine_current_path(e); }
#must_use
fn jlw_engine_is_video(e) { return JlwPlaybackEngine_is_video(e); }
#must_use
fn jlw_engine_eq_settings(e) { return JlwPlaybackEngine_eq_settings(e); }
#must_use
fn jlw_engine_normalize_enabled(e) { return JlwPlaybackEngine_normalize_enabled(e); }
#must_use
fn jlw_engine_events(e) { return JlwPlaybackEngine_event_rx(e); }   # None (0) without a thread

# state()/position(): read the decode status if a thread is running, else self.
#must_use
fn jlw_engine_state(e) {
    if (JlwPlaybackEngine_decode_status(e) != 0) { return JlwDecodeStatus_state(JlwPlaybackEngine_decode_status(e)); }
    return JlwPlaybackEngine_state(e);
}
#must_use
fn jlw_engine_position(e) {
    var h = JlwPlaybackEngine_play_handle(e);
    if (h != 0 && JLW_ENG_POS_FP != 0) { return fncall1(JLW_ENG_POS_FP, h); }   # live thread position
    if (JlwPlaybackEngine_decode_status(e) != 0) { return JlwDecodeStatus_position(JlwPlaybackEngine_decode_status(e)); }
    return JlwPlaybackEngine_position(e);
}

# ---- volume / mute ----
fn jlw_engine_set_volume(e, vol) {
    var v = vol;
    if (f64_lt(v, 0) == 1)   { v = 0; }
    if (f64_gt(v, 1.0) == 1) { v = 1.0; }
    JlwPlaybackEngine_set_volume(e, v);
    return 0;   # (Volume command send is a no-op without a decode thread)
}
fn jlw_engine_toggle_mute(e) {
    JlwPlaybackEngine_set_muted(e, 1 - JlwPlaybackEngine_muted(e));
    return 0;
}

# ---- EQ / normalize ----
fn jlw_engine_set_eq_settings(e, settings) { JlwPlaybackEngine_set_eq_settings(e, settings); return 0; }
fn jlw_engine_set_eq_band(e, band, gain_db) {
    dhvani_geq_settings_set_band(JlwPlaybackEngine_eq_settings(e), band, gain_db);
    return 0;
}
fn jlw_engine_toggle_eq(e) {
    var s = JlwPlaybackEngine_eq_settings(e);
    if (dhvani_geq_settings_enabled(s) == 0) { DhGraphicEqSettings_set_enabled(s, 1); }
    else { DhGraphicEqSettings_set_enabled(s, 0); }
    return 0;
}
fn jlw_engine_toggle_normalize(e) {
    JlwPlaybackEngine_set_normalize_enabled(e, 1 - JlwPlaybackEngine_normalize_enabled(e));
    return 0;
}

# ---- transport ----
fn jlw_engine_pause(e) {
    if (JlwPlaybackEngine_state(e) == JLW_STATE_PLAYING) { JlwPlaybackEngine_set_state(e, JLW_STATE_PAUSED); }
    return 0;
}
fn jlw_engine_stop(e) {
    var h = JlwPlaybackEngine_play_handle(e);
    if (h != 0 && JLW_ENG_STOP_FP != 0) { fncall1(JLW_ENG_STOP_FP, h); }   # cancel the decode thread
    JlwPlaybackEngine_set_play_handle(e, 0);
    JlwPlaybackEngine_set_cmd_tx(e, 0);
    JlwPlaybackEngine_set_decode_status(e, 0);
    JlwPlaybackEngine_set_event_rx(e, 0);
    JlwPlaybackEngine_set_video_frame_rx(e, 0);
    JlwPlaybackEngine_set_is_video(e, 0);
    JlwPlaybackEngine_set_state(e, JLW_STATE_STOPPED);
    JlwPlaybackEngine_set_position(e, 0);
    return 0;
}
# seek(pos_secs): error past the end; else set position.
fn jlw_engine_seek(e, position) {
    var d = JlwPlaybackEngine_duration(e);
    if (jlw_is_finite(d) == 1) {
        if (f64_gt(position, d) == 1) { return JLW_ERR_PLAYBACK; }
    }
    JlwPlaybackEngine_set_position(e, position);
    return JLW_ERR_NONE;
}
# seek_relative(offset_secs): clamp to [0, duration] and seek.
fn jlw_engine_seek_relative(e, offset_secs) {
    var new_pos = f64_add(jlw_engine_position(e), offset_secs);
    if (f64_lt(new_pos, 0) == 1) { new_pos = 0; }
    var d = JlwPlaybackEngine_duration(e);
    if (jlw_is_finite(d) == 1) { if (f64_gt(new_pos, d) == 1) { new_pos = d; } }
    return jlw_engine_seek(e, new_pos);
}
# play(): start playback of the loaded file. With an audio backend wired, spawns a
# background decode thread (non-blocking) and stores its handle; without one (unit
# tests), it's a state-only transition. Errors when no file is loaded.
fn jlw_engine_play(e) {
    if (JlwPlaybackEngine_current_path(e) == 0) { return JLW_ERR_PLAYBACK; }
    if (JLW_ENG_PLAY_FP != 0) {
        var vol_pct = f64_to(f64_mul(JlwPlaybackEngine_volume(e), 100.0));
        JlwPlaybackEngine_set_play_handle(e, fncall2(JLW_ENG_PLAY_FP, JlwPlaybackEngine_current_path(e), vol_pct));
    }
    JlwPlaybackEngine_set_state(e, JLW_STATE_PLAYING);
    return JLW_ERR_NONE;
}
# open(path): probe. Errors on a missing file; real probe (duration/codec) stubbed.
fn jlw_engine_open(e, path) {
    if (file_exists(path) == 0) { return JLW_ERR_NOT_FOUND; }
    JlwPlaybackEngine_set_current_path(e, path);
    return JLW_ERR_NONE;
}
fn jlw_engine_toggle(e) {
    var st = JlwPlaybackEngine_state(e);
    if (st == JLW_STATE_PLAYING) { jlw_engine_pause(e); return JLW_ERR_NONE; }
    if (st == JLW_STATE_BUFFERING) { return JLW_ERR_NONE; }
    return jlw_engine_play(e);   # Paused / Stopped
}

# status(): full snapshot (current_item is caller-mapped, so 0/None here).
#must_use
fn jlw_engine_status(e) {
    return jlw_pb_status_new(jlw_engine_state(e), 0, jlw_engine_position(e),
                             JlwPlaybackEngine_duration(e), JlwPlaybackEngine_volume(e), JlwPlaybackEngine_muted(e));
}

# prepare_next / poll_events / take_video_frame -- no-ops without a decode thread.
fn jlw_engine_prepare_next(e, path) { return 0; }
# poll_events(): drain playback events. With a live decode thread, emit
# TrackFinished once the handle reports done (then clear it + go Stopped) -- the
# source the TUI's engine-event handler advances the queue on. No thread -> empty.
#must_use
fn jlw_engine_poll_events(e) {
    var evs = vec_new();
    var h = JlwPlaybackEngine_play_handle(e);
    if (h != 0 && JLW_ENG_DONE_FP != 0) {
        if (fncall1(JLW_ENG_DONE_FP, h) == 1) {
            vec_push(evs, jlw_engine_event_new(JLW_EVT_TRACK_FINISHED, 0));
            JlwPlaybackEngine_set_play_handle(e, 0);
            JlwPlaybackEngine_set_state(e, JLW_STATE_STOPPED);
        }
    }
    return evs;
}
#must_use
fn jlw_engine_take_video_frame(e) { return 0; }   # None without a video channel

# format_duration moved to core/types.cyr (shared by playback + ui).
