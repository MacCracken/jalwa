# gui/draw.cyr -- the GUI draw-command layer (Phase 1 of the Wayland GUI).
# Ports the egui immediate-mode view bodies of rust-old/crates/jalwa-gui/src/views/*
# as a PURE "GuiApp state -> ordered draw-command list" -- no pixels, no syscalls,
# no window. This is the headless-TESTABLE core (assert the command list for a given
# app state); a later CPU rasterizer (raster.cyr) executes the list and a quarantined
# present shell (present.cyr) blits it to a Wayland surface.
#
# dhancha (retained-mode toolkit) is the design template but NOT a dep: it needs a
# newer toolchain + drags in setu/sadish/rekha and lacks jalwa's widgets (slider/
# image/list/scroll), so the command IR + builders are hand-rolled here. Builders
# reuse the already-tested jlw_gui_* helpers (theme colors, sidebar_entries, nav
# color, play_label/mute codes, format_track_title/volume, progress_ratio, ...).

# ---- draw-command kinds ----
var JLW_DRAW_RECT   = 0;   # filled rectangle (color)
var JLW_DRAW_TEXT   = 1;   # text: cstr at (x,y), color; aux = max_chars (0 = no cap)
var JLW_DRAW_BORDER = 2;   # 1px rectangle outline (color)
var JLW_DRAW_IMAGE  = 3;   # album art: text = art id/path, (x,y,w,h)
var JLW_DRAW_CLIP_PUSH = 4;  # push a clip rect (x,y,w,h) for scroll viewports
var JLW_DRAW_CLIP_POP  = 5;

# ---- layout constants (px) ----
var JLW_GUI_SIDEBAR_W   = 180;
var JLW_GUI_TRANSPORT_H = 64;
var JLW_GUI_ROW_H       = 32;   # sidebar / list row height
var JLW_GUI_PAD         = 8;
var JLW_GUI_TEXT_DY     = 20;   # text baseline offset within a row
var JLW_GUI_CELL_W      = 130;  # library grid cell width  (library.rs CELL_WIDTH)
var JLW_GUI_CELL_H      = 170;  # library grid cell height (library.rs CELL_HEIGHT)
var JLW_GUI_ART_SZ      = 100;  # album-art box size (grid + now-playing)

#derive(accessors)
struct JlwDrawCmd { kind; x; y; w; h; color; text; aux; }

#must_use
fn jlw_draw_cmd_new(kind, x, y, w, h, color, text, aux) {
    var c = alloc(sizeof(JlwDrawCmd));
    JlwDrawCmd_set_kind(c, kind);
    JlwDrawCmd_set_x(c, x);   JlwDrawCmd_set_y(c, y);
    JlwDrawCmd_set_w(c, w);   JlwDrawCmd_set_h(c, h);
    JlwDrawCmd_set_color(c, color);
    JlwDrawCmd_set_text(c, text);
    JlwDrawCmd_set_aux(c, aux);
    return c;
}

# 0xRRGGBBAA theme color -> XRGB8888 (0x00RRGGBB) word for the raster/present format.
#inline
#must_use
fn jlw_gui_color_to_xrgb(c) {
    return (jlw_gui_color_r(c) * 65536) + (jlw_gui_color_g(c) * 256) + jlw_gui_color_b(c);
}

# ---- command push helpers ----
fn jlw_gui_draw_rect(cmds, x, y, w, h, color) {
    vec_push(cmds, jlw_draw_cmd_new(JLW_DRAW_RECT, x, y, w, h, color, 0, 0));
    return 0;
}
fn jlw_gui_draw_border(cmds, x, y, w, h, color) {
    vec_push(cmds, jlw_draw_cmd_new(JLW_DRAW_BORDER, x, y, w, h, color, 0, 0));
    return 0;
}
fn jlw_gui_draw_text(cmds, x, y, color, text, max_chars) {
    vec_push(cmds, jlw_draw_cmd_new(JLW_DRAW_TEXT, x, y, 0, 0, color, text, max_chars));
    return 0;
}
fn jlw_gui_draw_image(cmds, x, y, w, h, art_id) {
    vec_push(cmds, jlw_draw_cmd_new(JLW_DRAW_IMAGE, x, y, w, h, 0, art_id, 0));
    return 0;
}
# clip subsequent draws to (x,y,w,h) until the matching pop (scroll viewports).
fn jlw_gui_draw_clip_push(cmds, x, y, w, h) {
    vec_push(cmds, jlw_draw_cmd_new(JLW_DRAW_CLIP_PUSH, x, y, w, h, 0, 0, 0));
    return 0;
}
fn jlw_gui_draw_clip_pop(cmds) {
    vec_push(cmds, jlw_draw_cmd_new(JLW_DRAW_CLIP_POP, 0, 0, 0, 0, 0, 0, 0));
    return 0;
}

# first visible row index to keep `sel` on-screen in a `visible`-row window over
# `count` rows (bottom-anchored auto-scroll). The virtualization jalwa must own.
#must_use
fn jlw_gui_scroll_start(sel, visible, count) {
    var start = 0;
    if (sel >= visible) { start = sel - visible + 1; }
    var maxstart = count - visible;
    if (maxstart < 0) { maxstart = 0; }
    if (start > maxstart) { start = maxstart; }
    if (start < 0) { start = 0; }
    return start;
}

# icon + " " + label as one cstr (sidebar / button labels).
#must_use
fn jlw_gui_icon_label(icon, label) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, icon);
    str_builder_putc(sb, 32);
    str_builder_add_cstr(sb, label);
    return str_cstr(str_builder_build(sb));
}

# ---- sidebar (views/sidebar.rs) ----
# left nav column: panel bg, then one row per nav entry (active row gets a widget-bg
# tint + accent text; others secondary text). Emits into `cmds`. Returns the count.
fn jlw_gui_build_sidebar(app, x, y, w, h, cmds) {
    jlw_gui_draw_rect(cmds, x, y, w, h, JLW_GUI_BG_PANEL);
    var entries = jlw_gui_sidebar_entries(jlw_engine_is_video(JlwGuiApp_engine(app)));
    var view = JlwGuiApp_view(app);
    var ry = y + JLW_GUI_PAD;
    for (var i = 0; i < vec_len(entries); i = i + 1) {
        var e = vec_get(entries, i);
        var active = 0;
        if (JlwGuiNavEntry_view_code(e) == view) { active = 1; }
        if (active == 1) {
            jlw_gui_draw_rect(cmds, x, ry, w, JLW_GUI_ROW_H, JLW_GUI_BG_WIDGET);   # active-row tint
            jlw_gui_draw_rect(cmds, x, ry, 3, JLW_GUI_ROW_H, JLW_GUI_ACCENT);      # luminous edge bar
        }
        jlw_gui_draw_text(cmds, x + JLW_GUI_PAD, ry + JLW_GUI_TEXT_DY,
                          jlw_gui_nav_active_color(active),
                          jlw_gui_icon_label(JlwGuiNavEntry_icon(e), JlwGuiNavEntry_label(e)), 0);
        ry = ry + JLW_GUI_ROW_H;
    }
    return vec_len(cmds);
}

# ---- transport bar (views/transport.rs) ----
# bottom bar: bg, play/pause + prev/next glyph buttons, track title, volume %, and a
# progress/seek bar (bg track + accent fill by progress_ratio). Pure geometry over the
# ported transport helpers. Emits into `cmds`.
fn jlw_gui_build_transport(app, x, y, w, h, cmds) {
    var engine = JlwGuiApp_engine(app);
    jlw_gui_draw_rect(cmds, x, y, w, h, JLW_GUI_BG_PANEL);

    var by = y + JLW_GUI_PAD;
    var bsz = JLW_GUI_ROW_H;
    # transport glyph buttons (prev / play-or-pause / next)
    jlw_gui_draw_text(cmds, x + JLW_GUI_PAD, by + JLW_GUI_TEXT_DY, JLW_GUI_TEXT_PRIMARY, "|<", 0);
    var play_glyph = "|>";
    if (jlw_gui_play_label_code(jlw_engine_state(engine)) == JLW_GUI_ICON_PAUSE) { play_glyph = "||"; }
    jlw_gui_draw_text(cmds, x + JLW_GUI_PAD + bsz, by + JLW_GUI_TEXT_DY, JLW_GUI_ACCENT, play_glyph, 0);
    jlw_gui_draw_text(cmds, x + JLW_GUI_PAD + bsz * 2, by + JLW_GUI_TEXT_DY, JLW_GUI_TEXT_PRIMARY, ">|", 0);

    # track title (artist -- title, or "No media loaded")
    var artist = 0;
    var title = "";
    var has_item = 0;
    var cid = JlwGuiApp_current_playing_id(app);
    if (cid != 0) {
        var item = jlw_library_find_by_id(jlw_gui_app_lib(app), cid);
        if (item != 0) { title = JlwMediaItem_title(item); artist = JlwMediaItem_artist(item); has_item = 1; }
    }
    var tx = x + JLW_GUI_PAD + bsz * 3 + JLW_GUI_PAD;
    jlw_gui_draw_text(cmds, tx, by + JLW_GUI_TEXT_DY, JLW_GUI_TEXT_PRIMARY,
                      jlw_gui_format_track_title(artist, title, has_item), 0);

    # elapsed / total time readout (mono-feel, left of the volume block) when a track is up
    if (has_item == 1) {
        jlw_gui_draw_text(cmds, x + w - 232, by + JLW_GUI_TEXT_DY, JLW_GUI_TEXT_MUTED,
                          jlw_gui_transport_time(jlw_engine_position(engine),
                                                 JlwPlaybackEngine_duration(engine)), 0);
    }

    # volume % (right-aligned area)
    var vx = x + w - 120;
    jlw_gui_draw_text(cmds, vx, by + JLW_GUI_TEXT_DY, JLW_GUI_TEXT_SECONDARY,
                      jlw_gui_format_volume_pct(jlw_engine_volume(engine)), 0);
    if (jlw_gui_mute_icon_code(jlw_engine_muted(engine)) == JLW_GUI_ICON_SPEAKER_MUTED) {
        jlw_gui_draw_text(cmds, vx + 48, by + JLW_GUI_TEXT_DY, JLW_GUI_TEXT_MUTED, "x", 0);
    }

    # progress / seek bar along the bottom of the transport strip -- the playhead emits
    # light: the filled track glows in accent, capped by a small accent knob.
    var barx = x + JLW_GUI_PAD;
    var bary = y + h - JLW_GUI_PAD;
    var barw = w - JLW_GUI_PAD * 2;
    jlw_gui_draw_rect(cmds, barx, bary, barw, 3, JLW_GUI_BG_WIDGET);
    var ratio = jlw_gui_progress_ratio(jlw_engine_position(engine), JlwPlaybackEngine_duration(engine));
    var fillw = f64_to(f64_mul(ratio, f64_from(barw)));
    if (fillw > 0) {
        jlw_gui_draw_rect(cmds, barx, bary, fillw, 3, JLW_GUI_ACCENT);              # glowing fill
        jlw_gui_draw_rect(cmds, barx + fillw - 2, bary - 2, 4, 7, JLW_GUI_ACCENT);  # playhead knob
    }
    return vec_len(cmds);
}

# ---- library list helpers (respecting the search filter) ----
# number of rows in the current library view (all items, or search results).
#must_use
fn jlw_gui_lib_count(app) {
    if (strlen(JlwGuiApp_search_query(app)) > 0) { return vec_len(JlwGuiApp_search_results(app)); }
    return vec_len(JlwLibrary_items(jlw_gui_app_lib(app)));
}
# the item at display row `di`, honoring the search filter, or 0.
#must_use
fn jlw_gui_lib_item_at(app, di) {
    var items = JlwLibrary_items(jlw_gui_app_lib(app));
    if (strlen(JlwGuiApp_search_query(app)) > 0) {
        var sr = JlwGuiApp_search_results(app);
        if (di < 0) { return 0; }
        if (di >= vec_len(sr)) { return 0; }
        var idx = vec_get(sr, di);
        if (idx < 0) { return 0; }
        if (idx >= vec_len(items)) { return 0; }
        return vec_get(items, idx);
    }
    if (di < 0) { return 0; }
    if (di >= vec_len(items)) { return 0; }
    return vec_get(items, di);
}

# ---- library grid mode (views/library.rs grid_view) ----
# CELL_W x CELL_H cells, `columns = w / CELL_W` per row; each cell = an album-art box
# (raster draws a lettered placeholder) + truncated title + artist, tinted for the
# selected cell and colored by playing/selected/default. Virtualized by cell-row. The
# rendered column count is stashed on the app so grid nav (control.cyr) steps by it.
fn jlw_gui_build_library_grid(app, x, y, w, h, cmds) {
    var columns = w / JLW_GUI_CELL_W;
    if (columns < 1) { columns = 1; }
    JlwGuiApp_set_grid_columns(app, columns);
    var count = jlw_gui_lib_count(app);
    var sel = JlwGuiApp_selected_index(app);
    var pid = JlwGuiApp_current_playing_id(app);
    var rows_visible = h / JLW_GUI_CELL_H;
    if (rows_visible < 1) { rows_visible = 1; }
    var total_rows = (count + columns - 1) / columns;
    var start_row = jlw_gui_scroll_start(sel / columns, rows_visible, total_rows);
    var di = start_row * columns;
    var shown = 0;
    jlw_gui_draw_clip_push(cmds, x, y, w, h);          # keep cells inside the content region
    while (di < count && shown < rows_visible) {
        var col = 0;
        while (col < columns && di < count) {
            var item = jlw_gui_lib_item_at(app, di);
            if (item != 0) {
                var cx = x + col * JLW_GUI_CELL_W;
                var cy = y + shown * JLW_GUI_CELL_H;
                var is_playing = 0;
                if (pid != 0) { if (jlw_uuid_eq(JlwMediaItem_id(item), pid) == 1) { is_playing = 1; } }
                var is_selected = 0;
                if (di == sel) { is_selected = 1; }
                if (is_selected == 1) {
                    jlw_gui_draw_rect(cmds, cx, cy, JLW_GUI_CELL_W, JLW_GUI_CELL_H, JLW_GUI_BG_WIDGET);
                    jlw_gui_draw_border(cmds, cx, cy, JLW_GUI_CELL_W, JLW_GUI_CELL_H, JLW_GUI_ACCENT);   # accent frame
                }
                var ax = cx + (JLW_GUI_CELL_W - JLW_GUI_ART_SZ) / 2;
                jlw_gui_draw_image(cmds, ax, cy + JLW_GUI_PAD, JLW_GUI_ART_SZ, JLW_GUI_ART_SZ, JlwMediaItem_title(item));
                var tcy = cy + JLW_GUI_ART_SZ + JLW_GUI_PAD * 2;
                jlw_gui_draw_text(cmds, cx + JLW_GUI_PAD, tcy + 12, jlw_gui_row_color_code(is_playing, is_selected),
                                  jlw_gui_truncate_str(JlwMediaItem_title(item), 16), 0);
                jlw_gui_draw_text(cmds, cx + JLW_GUI_PAD, tcy + 32, JLW_GUI_TEXT_MUTED,
                                  jlw_gui_truncate_str(jlw_gui_np_artist(JlwMediaItem_artist(item)), 16), 0);
            }
            col = col + 1;
            di = di + 1;
        }
        shown = shown + 1;
    }
    jlw_gui_draw_clip_pop(cmds);
    return vec_len(cmds);
}

# "N tracks" / "N matches" -- the Library header count (search-aware).
#must_use
fn jlw_gui_lib_header_line(app) {
    var sb = str_builder_new();
    str_builder_add_int(sb, jlw_gui_lib_count(app));
    if (strlen(JlwGuiApp_search_query(app)) > 0) { str_builder_add_cstr(sb, " matches"); }
    else { str_builder_add_cstr(sb, " tracks"); }
    return str_cstr(str_builder_build(sb));
}

# ---- library view (views/library.rs) -- Visual-Language header + selection chrome ----
# A LIBRARY eyebrow + live count header (search-aware) sits above the list/grid region.
# List mode: a scrollable/virtualized track list; the selected row gets a widget-bg tint
# + an accent edge bar, and playing/selected/default text color comes from row_color_code.
# Grid mode dispatches to jlw_gui_build_library_grid over the same sub-region. Empty/
# no-match state per library.rs:74-88.
fn jlw_gui_build_library(app, x, y, w, h, cmds) {
    jlw_gui_draw_rect(cmds, x, y, w, h, JLW_GUI_BG_DARK);
    jlw_gui_draw_text(cmds, x + JLW_GUI_PAD, y + JLW_GUI_PAD + 4, JLW_GUI_ACCENT, "LIBRARY", 0);
    var count = jlw_gui_lib_count(app);
    if (count > 0) {
        jlw_gui_draw_text(cmds, x + w - 132, y + JLW_GUI_PAD + 4, JLW_GUI_TEXT_MUTED,
                          jlw_gui_lib_header_line(app), 0);
    }
    var hy = y + JLW_GUI_ROW_H + JLW_GUI_PAD;               # list/grid region below the header
    var hh = h - (JLW_GUI_ROW_H + JLW_GUI_PAD);
    if (count == 0) {                                       # library.rs:74-88 empty state
        var msg = "No matches";                            # search active, filtered to nothing
        if (vec_len(JlwLibrary_items(jlw_gui_app_lib(app))) == 0) {
            msg = "Library is empty. Use 'jalwa scan <dir>' to add files.";
        }
        jlw_gui_draw_text(cmds, x + JLW_GUI_PAD, hy + hh / 2, JLW_GUI_TEXT_MUTED, msg, 0);
        return vec_len(cmds);
    }
    if (JlwGuiApp_library_view_mode(app) == JLW_GUI_LIBVIEW_GRID) {
        return jlw_gui_build_library_grid(app, x, hy, w, hh, cmds);
    }
    var visible = hh / JLW_GUI_ROW_H;
    if (visible < 1) { visible = 1; }
    var sel = JlwGuiApp_selected_index(app);
    var start = jlw_gui_scroll_start(sel, visible, count);
    var end = start + visible;
    if (end > count) { end = count; }
    var pid = JlwGuiApp_current_playing_id(app);
    jlw_gui_draw_clip_push(cmds, x, hy, w, hh);        # keep rows inside the list region
    for (var di = start; di < end; di = di + 1) {
        var item = jlw_gui_lib_item_at(app, di);
        if (item != 0) {
            var ry = hy + (di - start) * JLW_GUI_ROW_H;
            var is_playing = 0;
            if (pid != 0) { if (jlw_uuid_eq(JlwMediaItem_id(item), pid) == 1) { is_playing = 1; } }
            var is_selected = 0;
            if (di == sel) { is_selected = 1; }
            if (is_selected == 1) {
                jlw_gui_draw_rect(cmds, x, ry, w, JLW_GUI_ROW_H, JLW_GUI_BG_WIDGET);   # row tint
                jlw_gui_draw_rect(cmds, x, ry, 3, JLW_GUI_ROW_H, JLW_GUI_ACCENT);      # accent edge bar
            }
            jlw_gui_draw_text(cmds, x + JLW_GUI_PAD, ry + JLW_GUI_TEXT_DY,
                              jlw_gui_row_color_code(is_playing, is_selected),
                              jlw_gui_format_library_row(di, JlwMediaItem_title(item), JlwMediaItem_artist(item), JlwMediaItem_duration(item)), 0);
        }
    }
    jlw_gui_draw_clip_pop(cmds);
    return vec_len(cmds);
}

# ---- now playing view (views/now_playing.rs) ----
# album-art placeholder + title/artist/album + details/stats lines, or a muted
# "Nothing playing" when no track is loaded.
fn jlw_gui_build_now_playing(app, x, y, w, h, cmds) {
    jlw_gui_draw_rect(cmds, x, y, w, h, JLW_GUI_BG_DARK);
    var engine = JlwGuiApp_engine(app);
    # accent eyebrow -- the hero's "NOW PLAYING" label (Visual-Language typography tier)
    jlw_gui_draw_text(cmds, x + JLW_GUI_PAD, y + JLW_GUI_PAD + 4, JLW_GUI_ACCENT, "NOW PLAYING", 0);
    var cid = JlwGuiApp_current_playing_id(app);
    var item = 0;
    if (cid != 0) { item = jlw_library_find_by_id(jlw_gui_app_lib(app), cid); }
    if (item == 0) {                                       # now_playing.rs:16-18 (two lines)
        jlw_gui_draw_text(cmds, x + JLW_GUI_PAD, y + h / 2, JLW_GUI_TEXT_MUTED, "Nothing playing", 0);
        jlw_gui_draw_text(cmds, x + JLW_GUI_PAD, y + h / 2 + 20, JLW_GUI_TEXT_MUTED,
                          "Select a track from the Library and press Enter", 0);
        return vec_len(cmds);
    }
    var artsz = 200;
    var ax = x + (w - artsz) / 2;
    var ay = y + JLW_GUI_PAD + JLW_GUI_ROW_H;                      # below the eyebrow
    jlw_gui_draw_border(cmds, ax - 2, ay - 2, artsz + 4, artsz + 4, JLW_GUI_ACCENT_DIM);  # frosted frame
    jlw_gui_draw_image(cmds, ax, ay, artsz, artsz, "");            # album art (id resolved by raster)
    var ty = ay + artsz + JLW_GUI_PAD;
    jlw_gui_draw_text(cmds, ax, ty,       JLW_GUI_TEXT_PRIMARY,   JlwMediaItem_title(item), 0);
    jlw_gui_draw_text(cmds, ax, ty + 24,  JLW_GUI_TEXT_SECONDARY, jlw_gui_np_artist(JlwMediaItem_artist(item)), 0);
    jlw_gui_draw_text(cmds, ax, ty + 44,  JLW_GUI_TEXT_MUTED,     jlw_gui_np_album(JlwMediaItem_album(item)), 0);
    jlw_gui_draw_text(cmds, ax, ty + 72,  JLW_GUI_TEXT_MUTED,
                      jlw_gui_np_details_line(jlw_gui_np_duration(JlwMediaItem_duration(item)),
                                              jlw_gui_np_codec(JlwMediaItem_audio_codec(item)),
                                              jlw_container_format_name(JlwMediaItem_format(item))), 0);
    jlw_gui_draw_text(cmds, ax, ty + 92,  JLW_GUI_TEXT_MUTED,
                      jlw_gui_np_stats_line(JlwMediaItem_play_count(item),
                                            jlw_gui_np_rating(JlwMediaItem_rating(item))), 0);
    # in-view luminous progress line (mirrors the transport playhead, hero-scaled)
    var py = ty + 116;
    jlw_gui_draw_rect(cmds, ax, py, artsz, 4, JLW_GUI_BG_WIDGET);
    var ratio = jlw_gui_progress_ratio(jlw_engine_position(engine), JlwPlaybackEngine_duration(engine));
    var fillw = f64_to(f64_mul(ratio, f64_from(artsz)));
    if (fillw > 0) {
        jlw_gui_draw_rect(cmds, ax, py, fillw, 4, JLW_GUI_ACCENT);
        jlw_gui_draw_rect(cmds, ax + fillw - 2, py - 2, 4, 8, JLW_GUI_ACCENT);
    }
    jlw_gui_draw_text(cmds, ax, py + 14, JLW_GUI_TEXT_MUTED,
                      jlw_gui_transport_time(jlw_engine_position(engine),
                                             JlwPlaybackEngine_duration(engine)), 0);
    return vec_len(cmds);
}

# ---- queue view (views/queue.rs) ----
# scrollable queue list: the current-position row is accent, the selected row gets a
# widget-bg tint; row labels via jlw_gui_queue_row_label (resolving each id's tags).
fn jlw_gui_build_queue(app, x, y, w, h, cmds) {
    jlw_gui_draw_rect(cmds, x, y, w, h, JLW_GUI_BG_DARK);
    var q = JlwGuiApp_queue(app);
    var items = JlwPlayQueue_items(q);
    var pos = JlwPlayQueue_position(q);
    var lib = jlw_gui_app_lib(app);
    var count = vec_len(items);
    if (count == 0) {                                      # queue.rs:47-51 (two lines)
        jlw_gui_draw_text(cmds, x + JLW_GUI_PAD, y + JLW_GUI_TEXT_DY, JLW_GUI_TEXT_MUTED, "Queue is empty", 0);
        jlw_gui_draw_text(cmds, x + JLW_GUI_PAD, y + JLW_GUI_TEXT_DY + 20, JLW_GUI_TEXT_MUTED,
                          "Press 'a' in Library view to enqueue tracks", 0);
        return vec_len(cmds);
    }
    var visible = h / JLW_GUI_ROW_H;
    if (visible < 1) { visible = 1; }
    var sel = JlwGuiApp_selected_index(app);
    var start = jlw_gui_scroll_start(sel, visible, count);
    var end = start + visible;
    if (end > count) { end = count; }
    for (var i = start; i < end; i = i + 1) {
        var item = jlw_library_find_by_id(lib, vec_get(items, i));
        var artist = 0;
        var title = 0;
        if (item != 0) { artist = JlwMediaItem_artist(item); title = JlwMediaItem_title(item); }
        var is_current = 0;
        if (i == pos) { is_current = 1; }
        var ry = y + (i - start) * JLW_GUI_ROW_H;
        if (i == sel) { jlw_gui_draw_rect(cmds, x, ry, w, JLW_GUI_ROW_H, JLW_GUI_BG_WIDGET); }
        var color = JLW_GUI_TEXT_SECONDARY;
        if (is_current == 1) { color = JLW_GUI_ACCENT; }
        jlw_gui_draw_text(cmds, x + JLW_GUI_PAD, ry + JLW_GUI_TEXT_DY, color,
                          jlw_gui_queue_row_label(i, artist, title, is_current), 0);
    }
    return vec_len(cmds);
}

# ---- equalizer view (views/equalizer.rs) ----
# 10 band columns: each a vertical gain bar from the 0 dB midline (up=boost,
# down=cut, gain scaled to +/-12 dB), the band name below, and the selected band
# column tinted. Header shows the enabled state.
fn jlw_gui_build_equalizer(app, x, y, w, h, cmds) {
    jlw_gui_draw_rect(cmds, x, y, w, h, JLW_GUI_BG_DARK);
    var eq = jlw_engine_eq_settings(JlwGuiApp_engine(app));
    var hdr = "Equalizer: OFF";
    if (dhvani_geq_settings_enabled(eq) == 1) { hdr = "Equalizer: ON"; }
    jlw_gui_draw_text(cmds, x + JLW_GUI_PAD, y + JLW_GUI_TEXT_DY, JLW_GUI_TEXT_PRIMARY, hdr, 0);
    var bands = 10;
    var bandw = w / bands;
    var sel = JlwGuiApp_selected_index(app);
    var track_top = y + 48;
    var track_h = h - 100;
    if (track_h < 20) { track_h = 20; }
    var half = track_h / 2;
    var mid = track_top + half;
    for (var i = 0; i < bands; i = i + 1) {
        var bx = x + i * bandw;
        if (i == sel) { jlw_gui_draw_rect(cmds, bx, track_top, bandw, track_h, JLW_GUI_BG_WIDGET); }
        # gain (dB) -> bar length; clamp ratio to +/-1 at +/-12 dB
        var gain = dhvani_geq_settings_band(eq, i);
        var ratio = f64_div(gain, 12.0);
        if (f64_gt(ratio, 1.0) == 1) { ratio = 1.0; }
        if (f64_lt(ratio, f64_neg(1.0)) == 1) { ratio = f64_neg(1.0); }
        var barlen = f64_to(f64_mul(f64_abs(ratio), f64_from(half)));
        if (barlen > 0) {
            if (f64_ge(gain, 0.0) == 1) { jlw_gui_draw_rect(cmds, bx + 4, mid - barlen, bandw - 8, barlen, JLW_GUI_ACCENT); }
            else { jlw_gui_draw_rect(cmds, bx + 4, mid, bandw - 8, barlen, JLW_GUI_ACCENT_DIM); }
        }
        jlw_gui_draw_text(cmds, bx + 2, track_top + track_h + 16, JLW_GUI_TEXT_MUTED, dhvani_geq_band_name(i), 0);
    }
    return vec_len(cmds);
}

# ---- devices view (views/devices.rs) ----
# The GuiApp holds no hardware source (Wave F dropped the yukti HardwareManager
# field), so this mirrors the CLI stub. When device hotplug is wired, list here.
fn jlw_gui_build_devices(app, x, y, w, h, cmds) {
    jlw_gui_draw_rect(cmds, x, y, w, h, JLW_GUI_BG_DARK);
    jlw_gui_draw_text(cmds, x + JLW_GUI_PAD, y + JLW_GUI_TEXT_DY, JLW_GUI_TEXT_MUTED, "No media devices detected", 0);
    return vec_len(cmds);
}

# ---- video view: aethersafta-blocked -> placeholder ----
fn jlw_gui_build_video(app, x, y, w, h, cmds) {
    jlw_gui_draw_rect(cmds, x, y, w, h, JLW_GUI_BG_DARK);
    jlw_gui_draw_text(cmds, x + JLW_GUI_PAD, y + h / 2, JLW_GUI_TEXT_MUTED, "Video unavailable", 0);
    return vec_len(cmds);
}

# ---- settings view (jalwa-native: theme picker) ----
# An accent eyebrow + a THEME section: one row per theme with an accent swatch, its
# name, and an "active" tag on the current theme. The selected row gets a widget-bg
# tint + accent edge bar (matching the sidebar); Up/Down move the selection and Enter
# applies it (control.cyr), while 't' still cycles from anywhere.
fn jlw_gui_build_settings(app, x, y, w, h, cmds) {
    jlw_gui_draw_rect(cmds, x, y, w, h, JLW_GUI_BG_DARK);
    jlw_gui_draw_text(cmds, x + JLW_GUI_PAD, y + JLW_GUI_PAD + 4, JLW_GUI_ACCENT, "SETTINGS", 0);
    jlw_gui_draw_text(cmds, x + JLW_GUI_PAD, y + JLW_GUI_ROW_H + JLW_GUI_TEXT_DY, JLW_GUI_TEXT_SECONDARY, "Theme", 0);
    var sel = JlwGuiApp_selected_index(app);
    var active = jlw_gui_theme_id;
    var ry = y + JLW_GUI_ROW_H * 2;
    for (var i = 0; i < JLW_GUI_THEME_COUNT; i = i + 1) {
        if (i == sel) {
            jlw_gui_draw_rect(cmds, x, ry, w, JLW_GUI_ROW_H, JLW_GUI_BG_WIDGET);   # selection tint
            jlw_gui_draw_rect(cmds, x, ry, 3, JLW_GUI_ROW_H, JLW_GUI_ACCENT);      # accent edge bar
        }
        jlw_gui_draw_rect(cmds, x + JLW_GUI_PAD, ry + 10, 24, 12, jlw_gui_theme_accent(i));   # accent swatch
        var col = JLW_GUI_TEXT_SECONDARY;
        if (i == active) { col = JLW_GUI_ACCENT; }
        jlw_gui_draw_text(cmds, x + JLW_GUI_PAD + 34, ry + JLW_GUI_TEXT_DY, col, jlw_gui_theme_name(i), 0);
        if (i == active) {
            jlw_gui_draw_text(cmds, x + w - 72, ry + JLW_GUI_TEXT_DY, JLW_GUI_ACCENT, "active", 0);
        }
        ry = ry + JLW_GUI_ROW_H;
    }
    jlw_gui_draw_text(cmds, x + JLW_GUI_PAD, ry + JLW_GUI_TEXT_DY, JLW_GUI_TEXT_MUTED,
                      "Up/Down select  •  Enter apply  •  t cycles", 0);
    return vec_len(cmds);
}

# ---- full frame: split the window into sidebar | content | transport, then
# dispatch the content region to the active view's builder. Pure arithmetic.
fn jlw_gui_build_frame(app, w, h, cmds) {
    jlw_gui_draw_rect(cmds, 0, 0, w, h, JLW_GUI_BG_DARK);
    var th = JLW_GUI_TRANSPORT_H;
    var sbw = JLW_GUI_SIDEBAR_W;
    var ch = h - th;
    jlw_gui_build_sidebar(app, 0, 0, sbw, ch, cmds);
    jlw_gui_build_transport(app, 0, h - th, w, th, cmds);
    var cx = sbw;
    var cw = w - sbw;
    var view = JlwGuiApp_view(app);
    if (view == JLW_GUI_VIEW_LIBRARY)     { jlw_gui_build_library(app, cx, 0, cw, ch, cmds); }
    if (view == JLW_GUI_VIEW_NOW_PLAYING) { jlw_gui_build_now_playing(app, cx, 0, cw, ch, cmds); }
    if (view == JLW_GUI_VIEW_QUEUE)       { jlw_gui_build_queue(app, cx, 0, cw, ch, cmds); }
    if (view == JLW_GUI_VIEW_EQUALIZER)   { jlw_gui_build_equalizer(app, cx, 0, cw, ch, cmds); }
    if (view == JLW_GUI_VIEW_DEVICES)     { jlw_gui_build_devices(app, cx, 0, cw, ch, cmds); }
    if (view == JLW_GUI_VIEW_VIDEO)       { jlw_gui_build_video(app, cx, 0, cw, ch, cmds); }
    if (view == JLW_GUI_VIEW_SETTINGS)    { jlw_gui_build_settings(app, cx, 0, cw, ch, cmds); }
    return vec_len(cmds);
}

# ---- input mapping (pure): a key -> a GUI action code ----
# Keys use the TUI's JLW_KEY_* sentinels (arrows/enter/tab) + ASCII bytes; the Phase-3
# present shell translates Wayland keysyms into these. Mirrors rust-old app.rs shortcuts.
var JLW_GUI_ACT_NONE       = 0;
var JLW_GUI_ACT_PLAY_PAUSE = 1;
var JLW_GUI_ACT_NAV_UP     = 2;
var JLW_GUI_ACT_NAV_DOWN   = 3;
var JLW_GUI_ACT_NAV_LEFT   = 4;
var JLW_GUI_ACT_NAV_RIGHT  = 5;
var JLW_GUI_ACT_ENTER      = 6;
var JLW_GUI_ACT_NEXT_VIEW  = 7;
var JLW_GUI_ACT_SEARCH     = 8;
var JLW_GUI_ACT_QUIT       = 9;
var JLW_GUI_ACT_VOL_UP     = 10;
var JLW_GUI_ACT_VOL_DOWN   = 11;
var JLW_GUI_ACT_MUTE       = 12;
var JLW_GUI_ACT_NEXT_TRACK = 13;
var JLW_GUI_ACT_PREV_TRACK = 14;
var JLW_GUI_ACT_EQ_TOGGLE  = 15;
var JLW_GUI_ACT_NORMALIZE  = 16;
var JLW_GUI_ACT_ENQUEUE    = 17;   # 'a' on selected library row (library.rs:148)
var JLW_GUI_ACT_REMOVE     = 18;   # 'd' on selected queue row (queue.rs:102)
var JLW_GUI_ACT_TOGGLE_GRID = 19;  # 'g' toggles library list/grid mode (library.rs:43-58)
var JLW_GUI_ACT_CYCLE_THEME = 20;  # 't' cycles the dark theme (Aurora -> Caustic -> Sacred)

#must_use
fn jlw_gui_key_to_action(key) {
    if (key == 32)              { return JLW_GUI_ACT_PLAY_PAUSE; }   # space
    if (key == JLW_KEY_UP)      { return JLW_GUI_ACT_NAV_UP; }
    if (key == JLW_KEY_DOWN)    { return JLW_GUI_ACT_NAV_DOWN; }
    if (key == JLW_KEY_LEFT)    { return JLW_GUI_ACT_NAV_LEFT; }
    if (key == JLW_KEY_RIGHT)   { return JLW_GUI_ACT_NAV_RIGHT; }
    if (key == JLW_KEY_ENTER)   { return JLW_GUI_ACT_ENTER; }
    if (key == JLW_KEY_TAB)     { return JLW_GUI_ACT_NEXT_VIEW; }
    if (key == 47)              { return JLW_GUI_ACT_SEARCH; }       # '/'
    if (key == 113)             { return JLW_GUI_ACT_QUIT; }         # 'q'
    if (key == 43)              { return JLW_GUI_ACT_VOL_UP; }       # '+'
    if (key == 61)              { return JLW_GUI_ACT_VOL_UP; }       # '=' (unshifted +)
    if (key == 45)              { return JLW_GUI_ACT_VOL_DOWN; }     # '-'
    if (key == 109)             { return JLW_GUI_ACT_MUTE; }         # 'm'
    if (key == 110)             { return JLW_GUI_ACT_NEXT_TRACK; }   # 'n'
    if (key == 112)             { return JLW_GUI_ACT_PREV_TRACK; }   # 'p'
    if (key == 101)             { return JLW_GUI_ACT_EQ_TOGGLE; }    # 'e'
    if (key == 78)              { return JLW_GUI_ACT_NORMALIZE; }    # 'N'
    if (key == 97)              { return JLW_GUI_ACT_ENQUEUE; }      # 'a' (library: enqueue row)
    if (key == 100)             { return JLW_GUI_ACT_REMOVE; }       # 'd' (queue: remove row)
    if (key == 103)             { return JLW_GUI_ACT_TOGGLE_GRID; }  # 'g' (library: list/grid)
    if (key == 116)             { return JLW_GUI_ACT_CYCLE_THEME; }  # 't' (cycle dark theme)
    return JLW_GUI_ACT_NONE;
}
