# gui/art_cache.cyr -- LRU album-art texture cache (portable core).
# Ports rust-old/crates/jalwa-gui/src/art_cache.rs. L4 (needs core/types Uuid).
#
# The egui `TextureHandle` and `load_art()` (lofty/image decode + ctx.load_texture)
# are DEFERRED to dhancha. The portable model keeps the LRU key (id, last_access)
# as two parallel vecs plus the no_art set and the access counter -- everything
# the #[cfg(test)] assertions actually exercise.
#
#   HashMap<Uuid, CacheEntry>  ->  tex_ids (Uuid ptrs) + tex_access (u64, parallel)
#   HashSet<Uuid> no_art       ->  no_art (Uuid ptrs, looked up by value)
# Uuid membership is a linear scan with jlw_uuid_eq (16-byte memeq), the db.cyr idiom.

var JLW_GUI_ART_MAX_TEXTURES = 200;    # const MAX_TEXTURES
var JLW_GUI_ART_MAX_NO_ART   = 1000;   # const MAX_NO_ART

# tex_ids: vec of Uuid ptrs (16-byte). tex_access: parallel vec of u64
# last_access, index-aligned with tex_ids. no_art: vec of Uuid ptrs as a set.
# access_counter: u64, monotonically increasing.
# tex_pix/tex_w/tex_h: decoded-RGBA storage, parallel + index-aligned with tex_ids
# (v1.3.0). tex_pix = chitra RGBA8 buffer ptr, tex_w/tex_h = its pixel dims.
#derive(accessors)
struct JlwGuiArtCache {
    tex_ids; tex_access; tex_pix; tex_w; tex_h; no_art; access_counter;
}

# ArtCache::new()
#must_use
fn jlw_gui_art_cache_new() {
    var self = alloc(sizeof(JlwGuiArtCache));
    JlwGuiArtCache_set_tex_ids(self, vec_new());
    JlwGuiArtCache_set_tex_access(self, vec_new());
    JlwGuiArtCache_set_tex_pix(self, vec_new());
    JlwGuiArtCache_set_tex_w(self, vec_new());
    JlwGuiArtCache_set_tex_h(self, vec_new());
    JlwGuiArtCache_set_no_art(self, vec_new());
    JlwGuiArtCache_set_access_counter(self, 0);
    return self;
}

# Process-global cache (lazily created) -- the raster IMAGE branch resolves art through
# this, keeping jlw_gui_raster's signature stable (mirrors jlw_gui_theme_id / mini_mode).
var JLW_GUI_ART_CACHE_G = 0;
#must_use
fn jlw_gui_art_cache_global() {
    if (JLW_GUI_ART_CACHE_G == 0) { JLW_GUI_ART_CACHE_G = jlw_gui_art_cache_new(); }
    return JLW_GUI_ART_CACHE_G;
}

# no_art.contains(id) -- linear scan by value.
#must_use
fn jlw_gui_art_no_art_contains(self, id) {
    var s = JlwGuiArtCache_no_art(self);
    for (var i = 0; i < vec_len(s); i = i + 1) {
        if (jlw_uuid_eq(vec_get(s, i), id) == 1) { return 1; }
    }
    return 0;
}

# no_art.len() / textures.len() (the #[cfg(test)] counters).
#inline
#must_use
fn jlw_gui_art_no_art_count(self) { return vec_len(JlwGuiArtCache_no_art(self)); }
#inline
#must_use
fn jlw_gui_art_texture_count(self) { return vec_len(JlwGuiArtCache_tex_ids(self)); }

# evict_no_art_if_full(): clear the whole set once it grows past the threshold.
fn jlw_gui_art_evict_no_art_if_full(self) {
    if (vec_len(JlwGuiArtCache_no_art(self)) > JLW_GUI_ART_MAX_NO_ART) {
        JlwGuiArtCache_set_no_art(self, vec_new());
    }
    return 0;
}

# evict_if_full(): LRU -- while at capacity, drop the min-last_access entry from
# both parallel vecs (min_by_key over the HashMap becomes a linear scan).
fn jlw_gui_art_evict_if_full(self) {
    var ids = JlwGuiArtCache_tex_ids(self);
    var acc = JlwGuiArtCache_tex_access(self);
    while (vec_len(ids) >= JLW_GUI_ART_MAX_TEXTURES) {
        var n = vec_len(acc);
        var oldest = 0;
        var oldest_at = vec_get(acc, 0);
        for (var i = 1; i < n; i = i + 1) {
            var a = vec_get(acc, i);
            if (a < oldest_at) { oldest_at = a; oldest = i; }
        }
        vec_remove(ids, oldest);
        vec_remove(acc, oldest);
        vec_remove(JlwGuiArtCache_tex_pix(self), oldest);   # keep the parallel pixel vecs aligned
        vec_remove(JlwGuiArtCache_tex_w(self), oldest);
        vec_remove(JlwGuiArtCache_tex_h(self), oldest);
    }
    return 0;
}

# invalidate(item_id): drop it from textures and no_art (kept-vec rebuild).
fn jlw_gui_art_invalidate(self, item_id) {
    var ids = JlwGuiArtCache_tex_ids(self);
    var acc = JlwGuiArtCache_tex_access(self);
    var pix = JlwGuiArtCache_tex_pix(self);
    var tw = JlwGuiArtCache_tex_w(self);
    var th = JlwGuiArtCache_tex_h(self);
    var n = vec_len(ids);
    var kids = vec_new();
    var kacc = vec_new();
    var kpix = vec_new();
    var kw = vec_new();
    var kh = vec_new();
    for (var i = 0; i < n; i = i + 1) {
        if (jlw_uuid_eq(vec_get(ids, i), item_id) == 0) {
            vec_push(kids, vec_get(ids, i));
            vec_push(kacc, vec_get(acc, i));
            vec_push(kpix, vec_get(pix, i));
            vec_push(kw, vec_get(tw, i));
            vec_push(kh, vec_get(th, i));
        }
    }
    JlwGuiArtCache_set_tex_ids(self, kids);
    JlwGuiArtCache_set_tex_access(self, kacc);
    JlwGuiArtCache_set_tex_pix(self, kpix);
    JlwGuiArtCache_set_tex_w(self, kw);
    JlwGuiArtCache_set_tex_h(self, kh);

    var s = JlwGuiArtCache_no_art(self);
    var m = vec_len(s);
    var ks = vec_new();
    for (var j = 0; j < m; j = j + 1) {
        if (jlw_uuid_eq(vec_get(s, j), item_id) == 0) { vec_push(ks, vec_get(s, j)); }
    }
    JlwGuiArtCache_set_no_art(self, ks);
    return 0;
}

# get() on the load-failure path -- the only branch the portable tests exercise
# (all test paths are nonexistent, so load_art always returns None). Mirrors
# get()'s egui-independent effects: bump access_counter, short-circuit if the id
# is already known no-art, else record it and evict the set if full. Returns 0
# (None). The success path (decode + ctx.load_texture + textures.insert) is
# deferred to dhancha.
fn jlw_gui_art_get_miss(self, item_id) {
    JlwGuiArtCache_set_access_counter(self, JlwGuiArtCache_access_counter(self) + 1);
    if (jlw_gui_art_no_art_contains(self, item_id) == 1) { return 0; }
    vec_push(JlwGuiArtCache_no_art(self), item_id);
    jlw_gui_art_evict_no_art_if_full(self);
    return 0;
}

# record item_id as no-art (eviction-bounded) and return 0 (miss). Helper for get().
fn jlw_gui_art__mark_no_art(self, item_id) {
    vec_push(JlwGuiArtCache_no_art(self), item_id);
    jlw_gui_art_evict_no_art_if_full(self);
    return 0;
}

# get(item_id, path): the REAL v1.3.0 load path (rust-old ArtCache::get, keyed by Uuid,
# re-extracting from the file since the DB carries no art). On a HIT, writes the cached
# {pixels, w, h} into out24 (out+0=RGBA ptr, +8=width, +16=height) and returns 1. On a
# MISS, extracts the embedded cover from `path`, decodes it via chitra (once), caches the
# RGBA, and returns 1 with out24 filled; if there is no cover / decode fails / it is too
# large, records no-art and returns 0. Decoding happens ONCE per id (never per frame) --
# the bump allocator never frees, so a per-frame decode would leak every repaint.
fn jlw_gui_art_get(self, item_id, path, out24) {
    JlwGuiArtCache_set_access_counter(self, JlwGuiArtCache_access_counter(self) + 1);
    var counter = JlwGuiArtCache_access_counter(self);
    var ids = JlwGuiArtCache_tex_ids(self);
    var n = vec_len(ids);
    for (var i = 0; i < n; i = i + 1) {
        if (jlw_uuid_eq(vec_get(ids, i), item_id) == 1) {         # HIT -> touch LRU + return
            vec_set(JlwGuiArtCache_tex_access(self), i, counter);
            store64(out24, vec_get(JlwGuiArtCache_tex_pix(self), i));
            store64(out24 + 8, vec_get(JlwGuiArtCache_tex_w(self), i));
            store64(out24 + 16, vec_get(JlwGuiArtCache_tex_h(self), i));
            return 1;
        }
    }
    if (jlw_gui_art_no_art_contains(self, item_id) == 1) { return 0; }   # known no-art
    var len = 0;                                                  # MISS -> extract + decode
    var bytes = jlw_extract_cover_art(path, &len);
    if (bytes == 0 || len <= 0) { return jlw_gui_art__mark_no_art(self, item_id); }
    var err = 0;
    var img = chitra_image_decode(bytes, len, &err);              # PNG / baseline-JPEG only
    if (img == 0) { return jlw_gui_art__mark_no_art(self, item_id); }
    var w = chitra_image_width(img);
    var h = chitra_image_height(img);
    var px = chitra_image_pixels(img);
    if (px == 0 || w <= 0 || h <= 0 || w > 2048 || h > 2048) {    # oversize guard (rust-old parity)
        return jlw_gui_art__mark_no_art(self, item_id);
    }
    jlw_gui_art_evict_if_full(self);
    vec_push(JlwGuiArtCache_tex_ids(self), item_id);
    vec_push(JlwGuiArtCache_tex_access(self), counter);
    vec_push(JlwGuiArtCache_tex_pix(self), px);
    vec_push(JlwGuiArtCache_tex_w(self), w);
    vec_push(JlwGuiArtCache_tex_h(self), h);
    store64(out24, px);
    store64(out24 + 8, w);
    store64(out24 + 16, h);
    return 1;
}
