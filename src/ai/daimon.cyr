fn jlw_daimon_query_media(client, query, top_k)   { return vec_new(); }
fn jlw_daimon_index_fingerprint(client, path)     { return JLW_ERR_LIBRARY; }
#must_use
fn jlw_daimon_search_similar(client, path, top_k) { return vec_new(); }
