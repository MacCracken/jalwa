    JlwTranscriptionResult_set_language(t, language);
    JlwTranscriptionResult_set_segments(t, segments);
    return t;
}

# ---- RAG string builders ----
# append "M:SS" (from f64 seconds) to a str_builder.
fn jlw_sb_add_mmss(sb, dur_secs) {
    var secs = f64_to(dur_secs);
    str_builder_add_int(sb, secs / 60);
    str_builder_putc(sb, 58);                       # ':'
    var s = secs % 60;
    if (s < 10) { str_builder_putc(sb, 48); }       # zero-pad
    str_builder_add_int(sb, s);
    return 0;
}

# format_item_for_rag: a labeled multi-line description of an item.
#must_use
fn jlw_daimon_format_item_for_rag(item) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Title: ");  str_builder_add_cstr(sb, JlwMediaItem_title(item));
    str_builder_add_cstr(sb, "\nPath: ");  str_builder_add_cstr(sb, JlwMediaItem_path(item));
    str_builder_add_cstr(sb, "\nFormat: "); str_builder_add_cstr(sb, jlw_container_format_name(JlwMediaItem_format(item)));
    str_builder_add_cstr(sb, "\nType: ");
    if (JlwMediaItem_media_type(item) == JLW_MEDIA_VIDEO) { str_builder_add_cstr(sb, "Video"); }
    else { str_builder_add_cstr(sb, "Audio"); }
    var artist = JlwMediaItem_artist(item);
    if (artist != 0) { str_builder_add_cstr(sb, "\nArtist: "); str_builder_add_cstr(sb, artist); }
    var album = JlwMediaItem_album(item);
    if (album != 0) { str_builder_add_cstr(sb, "\nAlbum: "); str_builder_add_cstr(sb, album); }
    var dur = JlwMediaItem_duration(item);
    if (jlw_is_finite(dur) == 1) { str_builder_add_cstr(sb, "\nDuration: "); jlw_sb_add_mmss(sb, dur); }
    var ac = JlwMediaItem_audio_codec(item);
    if (ac != (0 - 1)) { str_builder_add_cstr(sb, "\nCodec: "); str_builder_add_cstr(sb, jlw_audio_codec_name(ac)); }
    var tags = JlwMediaItem_tags(item);
    if (vec_len(tags) > 0) {
        str_builder_add_cstr(sb, "\nTags: ");
        for (var i = 0; i < vec_len(tags); i = i + 1) {
            if (i > 0) { str_builder_add_cstr(sb, ", "); }
            str_builder_add_cstr(sb, vec_get(tags, i));
        }
    }
    var pc = JlwMediaItem_play_count(item);
    if (pc > 0) { str_builder_add_cstr(sb, "\nPlay count: "); str_builder_add_int(sb, pc); }
    var rating = JlwMediaItem_rating(item);
    if (rating != (0 - 1)) { str_builder_add_cstr(sb, "\nRating: "); str_builder_add_int(sb, rating); str_builder_add_cstr(sb, "/5"); }
    return str_cstr(str_builder_build(sb));
}

# build_library_context: "- {title} — {artist} ({dur})[tags]" per item, capped at 100.
#must_use
fn jlw_daimon_build_library_context(library) {
    var sb = str_builder_new();
    var items = JlwLibrary_items(library);
    var n = vec_len(items);
    var limit = n;
    if (limit > 100) { limit = 100; }
    for (var i = 0; i < limit; i = i + 1) {
        var item = vec_get(items, i);
        if (i > 0) { str_builder_putc(sb, 10); }   # '\n'
        str_builder_add_cstr(sb, "- ");
        str_builder_add_cstr(sb, JlwMediaItem_title(item));
        str_builder_add_cstr(sb, " — ");   # em dash (U+2014, matches the Rust format)
        var artist = JlwMediaItem_artist(item);
        if (artist != 0) { str_builder_add_cstr(sb, artist); } else { str_builder_add_cstr(sb, "Unknown"); }
        str_builder_add_cstr(sb, " (");
        var dur = JlwMediaItem_duration(item);
        if (jlw_is_finite(dur) == 1) { jlw_sb_add_mmss(sb, dur); } else { str_builder_putc(sb, 63); }   # '?'
        str_builder_putc(sb, 41);   # ')'
        var tags = JlwMediaItem_tags(item);
        if (vec_len(tags) > 0) {
            str_builder_add_cstr(sb, " [");
            for (var t = 0; t < vec_len(tags); t = t + 1) {
                if (t > 0) { str_builder_add_cstr(sb, ", "); }
                str_builder_add_cstr(sb, vec_get(tags, t));
            }
            str_builder_putc(sb, 93);   # ']'
        }
    }
    return str_cstr(str_builder_build(sb));
}

# parse_llm_recommendation: JSON (or markdown-embedded JSON) -> LlmRecommendation,
# else fallback to a single suggestion wrapping the raw text.
#must_use
fn jlw_daimon_parse_llm(response) {
    var start = jlw_find_char(response, 123, 0);   # '{'
    var end = jlw_rfind_char(response, 125);        # '}'
    if (start >= 0) {
        if (end > start) {
            var jlen = end - start + 1;
            var json = alloc(jlen + 1);
            memcpy(json, response + start, jlen);
            store8(json + jlen, 0);
            var suggestions = vec_new();
            var pos = 0;
            var scanning = 1;
            while (scanning == 1) {
                var ti = jlw_find_substr(json, "\"title\":", pos);
                if (ti < 0) { scanning = 0; }
                else {
                    var val = jlw_json_str_value(json, ti + 8);
                    if (val != 0) { vec_push(suggestions, jlw_llm_suggestion_new(val, 0, "LLM response")); }
                    pos = ti + 8;
                }
            }
            if (vec_len(suggestions) > 0) {
                var mood = 0;
                var mi = jlw_find_substr(json, "\"mood\":", 0);
                if (mi >= 0) { mood = jlw_json_str_value(json, mi + 7); }
                return jlw_llm_recommendation_new(suggestions, mood);
            }
        }
    }
    var sugg = vec_new();
    vec_push(sugg, jlw_llm_suggestion_new(jlw_trim(response), 0, "LLM response"));
    return jlw_llm_recommendation_new(sugg, 0);
}

