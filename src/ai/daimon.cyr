# ai/daimon.cyr -- daimon (agent-runtime) + hoosh (LLM) client.
# Ports rust-old/crates/jalwa-ai/src/daimon.rs. L2: depends on error.cyr +
# core/types.cyr. serde dropped.
#
# STUBS: every async network method (register_agent/ingest/query/search/
# transcribe/llm_recommend) is reqwest+tokio -> deferred to net/http + a real
# hoosh server. The portable core ports faithfully: configs (+redacted debug),
# auth_header, the RAG string builders, and parse_llm_recommendation (a TARGETED
# extractor for the {suggestions:[{title}],mood} shape -- a full bayan JSON parse
# is future work when the HTTP path is unstubbed; only title/count/mood are used).

# ---- small string helpers (self-contained to avoid cross-module symbol clashes) ----
#must_use
fn jlw_find_char(s, ch, from) {
    var n = strlen(s);
    var i = from;
    while (i < n) { if (load8(s + i) == ch) { return i; } i = i + 1; }
    return (0 - 1);
}
#must_use
fn jlw_rfind_char(s, ch) {
    var n = strlen(s);
    var r = (0 - 1);
    for (var i = 0; i < n; i = i + 1) { if (load8(s + i) == ch) { r = i; } }
    return r;
}
#must_use
fn jlw_find_substr(hay, needle, from) {
    var hl = strlen(hay);
    var nl = strlen(needle);
    if (nl == 0) { return from; }
    var i = from;
    while (i + nl <= hl) {
        if (memeq(hay + i, needle, nl) == 1) { return i; }
        i = i + 1;
    }
    return (0 - 1);
}
# read a JSON string value at `from` (expects '"'); returns the alloc'd cstr, or
# 0 if the value isn't a string (e.g. null). Assumes compact JSON (no space).
#must_use
fn jlw_json_str_value(s, from) {
    var n = strlen(s);
    if (from >= n) { return 0; }
    if (load8(s + from) != 34) { return 0; }   # not a "..." string
    var start = from + 1;
    var j = start;
    var scanning = 1;
    while (scanning == 1) {
        if (j >= n) { scanning = 0; }
        else { if (load8(s + j) == 34) { scanning = 0; } else { j = j + 1; } }
    }
    var len = j - start;
    var out = alloc(len + 1);
    memcpy(out, s + start, len);
    store8(out + len, 0);
    return out;
}
#must_use
fn jlw_trim(s) {
    var n = strlen(s);
    var a = 0;
    var t1 = 1;
    while (t1 == 1) {
        if (a >= n) { t1 = 0; }
        else {
            var c = load8(s + a);
            if (c == 32) { a = a + 1; }
            else { if (c == 9) { a = a + 1; } else { if (c == 10) { a = a + 1; } else { if (c == 13) { a = a + 1; } else { t1 = 0; } } } }
        }
    }
    var b = n;
    var t2 = 1;
    while (t2 == 1) {
        if (b <= a) { t2 = 0; }
        else {
            var c = load8(s + b - 1);
            if (c == 32) { b = b - 1; }
            else { if (c == 9) { b = b - 1; } else { if (c == 10) { b = b - 1; } else { if (c == 13) { b = b - 1; } else { t2 = 0; } } } }
        }
    }
    var len = b - a;
    var out = alloc(len + 1);
    memcpy(out, s + a, len);
    store8(out + len, 0);
    return out;
}

# ---- DaimonConfig / HooshConfig ----
#derive(accessors)
struct JlwDaimonConfig { endpoint; api_key; }
#must_use
fn jlw_daimon_config_new(endpoint, api_key) {
    var c = alloc(sizeof(JlwDaimonConfig));
    JlwDaimonConfig_set_endpoint(c, endpoint);
    JlwDaimonConfig_set_api_key(c, api_key);
    return c;
}
#must_use
fn jlw_daimon_config_default() {
    var url = getenv("DAIMON_URL");
    if (url == 0) { url = "http://localhost:8090"; }
    if (strlen(url) == 0) { url = "http://localhost:8090"; }
    return jlw_daimon_config_new(url, getenv("DAIMON_API_KEY"));
}
# Debug with the api_key redacted.
#must_use
fn jlw_daimon_config_debug(c) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "DaimonConfig { endpoint: ");
    str_builder_add_cstr(sb, JlwDaimonConfig_endpoint(c));
    str_builder_add_cstr(sb, ", api_key: ");
    if (JlwDaimonConfig_api_key(c) != 0) { str_builder_add_cstr(sb, "[REDACTED]"); }
    else { str_builder_add_cstr(sb, "None"); }
    str_builder_add_cstr(sb, " }");
    return str_cstr(str_builder_build(sb));
}

#derive(accessors)
struct JlwHooshConfig { endpoint; api_key; model; }
#must_use
fn jlw_hoosh_config_new(endpoint, api_key, model) {
    var c = alloc(sizeof(JlwHooshConfig));
    JlwHooshConfig_set_endpoint(c, endpoint);
    JlwHooshConfig_set_api_key(c, api_key);
    JlwHooshConfig_set_model(c, model);
    return c;
}
#must_use
fn jlw_hoosh_config_default() {
    var url = getenv("HOOSH_URL");
    if (url == 0) { url = "http://localhost:8088"; }
    if (strlen(url) == 0) { url = "http://localhost:8088"; }
    var model = getenv("HOOSH_MODEL");
    if (model == 0) { model = "llama3"; }
    if (strlen(model) == 0) { model = "llama3"; }
    return jlw_hoosh_config_new(url, getenv("HOOSH_API_KEY"), model);
}
#must_use
fn jlw_hoosh_config_debug(c) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "HooshConfig { endpoint: ");
    str_builder_add_cstr(sb, JlwHooshConfig_endpoint(c));
    str_builder_add_cstr(sb, ", api_key: ");
    if (JlwHooshConfig_api_key(c) != 0) { str_builder_add_cstr(sb, "[REDACTED]"); }
    else { str_builder_add_cstr(sb, "None"); }
    str_builder_add_cstr(sb, ", model: ");
    str_builder_add_cstr(sb, JlwHooshConfig_model(c));
    str_builder_add_cstr(sb, " }");
    return str_cstr(str_builder_build(sb));
}

# ---- DaimonClient ----
#derive(accessors)
struct JlwDaimonClient { config; }
#must_use
fn jlw_daimon_client_new(config) {
    var cl = alloc(sizeof(JlwDaimonClient));
    JlwDaimonClient_set_config(cl, config);
    return cl;
}
# auth_header: "Bearer {key}" if a key is set, else 0 (None).
#must_use
fn jlw_daimon_auth_header(client) {
    var key = JlwDaimonConfig_api_key(JlwDaimonClient_config(client));
    if (key == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Bearer ");
    str_builder_add_cstr(sb, key);
    return str_cstr(str_builder_build(sb));
}

