# dhvani.cyr -- bundled distribution
# Version: 2.2.1
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# --- error.cyr ---

# error.cyr -- dhvani error codes + shared f64 tolerances/sentinels + base helpers.
# L0 base module: included FIRST by every build/test entry. Modules never
# `include` each other -- the entry file orders them.
#
# Ports rust-old/src/error.rs (the `NadaError` enum, 9 variants). Rust carried
# a String/int payload per variant; the Cyrius port uses integer codes --
# fallible fns return DHVANI_ERR_NONE (0) on success or a negative code on
# failure. Diagnostic text via dhvani_err_name(). The rich struct-variant
# context (expected/actual strings) is dropped (can't ride an i64 code).
#
# NAMING: every dhvani top-level symbol is `dhvani_`/`DHVANI_`/`DH_`-prefixed so
# the dhvani distlib coexists with the sibling bundles it pulls (naad exports
# bare ERR_NONE / validate_sample_rate / flush_denormal; svara exports SVARA_*)
# in one flat namespace.
#
# FLOATS: dhvani's Rust stored f32 samples; the Cyrius port is f64 throughout
# (the audio-stack math is f64-only). DH_EPSILON preserves the f32::EPSILON
# (2^-23) tolerance the Rust tests used, promoted to f64.

# ================================================================
# Error codes (was `enum NadaError`). One per Rust variant, in order.
# ================================================================
var DHVANI_ERR_NONE                = 0;
var DHVANI_ERR_FORMAT_MISMATCH     = (0 - 1);   # buffer format (rate/channels) mismatch
var DHVANI_ERR_LENGTH_MISMATCH     = (0 - 2);   # buffer sample count mismatch
var DHVANI_ERR_INVALID_SAMPLE_RATE = (0 - 3);   # sample rate zero / out of range
var DHVANI_ERR_INVALID_CHANNELS    = (0 - 4);   # channel count zero / exceeds max
var DHVANI_ERR_DSP                 = (0 - 5);   # DSP processing error
var DHVANI_ERR_CAPTURE             = (0 - 6);   # audio capture/output error
var DHVANI_ERR_INVALID_PARAMETER   = (0 - 7);   # a named parameter out of range
var DHVANI_ERR_CONVERSION          = (0 - 8);   # format conversion error
var DHVANI_ERR_OTHER               = (0 - 9);   # wrapped external error

# ================================================================
# Shared f64 tolerances / sentinels (IEEE-754 bit patterns). Exported for the
# whole crate (converters, filters, tests). DH_EPSILON = f32::EPSILON promoted.
# ================================================================
var DH_EPSILON = 0x3E80000000000000;   # f32::EPSILON = 2^-23 ~ 1.192e-7
var DH_POS_INF = 0x7FF0000000000000;   # +inf
var DH_NEG_INF = 0xFFF0000000000000;   # -inf (amplitude_to_db(<=0) sentinel)
var DH_NAN     = 0x7FF8000000000000;   # quiet NaN (f64 Err sentinel; not finite)

# 1 if `code` is an error (negative), 0 otherwise.
#must_use
fn dhvani_is_err(code) {
    if (code < 0) { return 1; }
    return 0;
}

# Static name for an error code (for diagnostics / logging). Mirrors the Rust
# Display messages, minus the runtime payload (expected/actual/name/value).
#must_use
fn dhvani_err_name(code) {
    if (code == DHVANI_ERR_NONE)                { return "none"; }
    if (code == DHVANI_ERR_FORMAT_MISMATCH)     { return "buffer format mismatch"; }
    if (code == DHVANI_ERR_LENGTH_MISMATCH)     { return "buffer length mismatch"; }
    if (code == DHVANI_ERR_INVALID_SAMPLE_RATE) { return "invalid sample rate"; }
    if (code == DHVANI_ERR_INVALID_CHANNELS)    { return "invalid channel count"; }
    if (code == DHVANI_ERR_DSP)                 { return "DSP error"; }
    if (code == DHVANI_ERR_CAPTURE)             { return "capture error"; }
    if (code == DHVANI_ERR_INVALID_PARAMETER)   { return "invalid parameter"; }
    if (code == DHVANI_ERR_CONVERSION)          { return "conversion error"; }
    if (code == DHVANI_ERR_OTHER)               { return "other error"; }
    return "unknown error";
}

# Finite test: 1 iff x is neither +/-inf nor NaN. abs(x) < +inf holds for
# finite x, fails for infinities (inf < inf is false) and NaN (any NaN
# compare is false). Mirrors Rust `f32::is_finite`.
#must_use
fn dhvani_is_finite(x) {
    return f64_lt(f64_abs(x), DH_POS_INF);
}

# tan(x) = sin(x)/cos(x). The stdlib exposes f64_sin/f64_cos but not f64_tan
# (only f64_tanh); the filter modules (svf, biquad) need tangent for coefficient
# design. Defined here in the L0 base so both share one definition.
#must_use
fn dhvani_tan(x) {
    return f64_div(f64_sin(x), f64_cos(x));
}

# --- simd.cyr ---

# simd.cyr -- scalar audio kernels (the portable path of rust-old/src/simd/mod.rs).
# L0, no internal deps. Ports ONLY the scalar fallbacks; the SSE2/AVX2 (x86.rs)
# and NEON (aarch64.rs) SIMD arms have no Cyrius equivalent and are dropped (see
# docs/development/port-audit.md -- platform-blocked). These scalar kernels are
# the public compute surface buffer/convert/resample call.
#
# Buffers are `vec` handles; f64 samples live directly in the 8-byte slots.
# Integer-PCM sources (i16/i24/u8) hold their integer value per slot. f32->f64
# throughout (the whole port is f64). Everything alloc-free (operate in place).

# -1.0 as an f64 bit pattern. (A bare `-1.0` literal is INTEGER-negated -> wrong;
# negative floats must come from f64_neg() or an explicit bit pattern.)
var DH_NEG_ONE = 0xBFF0000000000000;   # -1.0

# min of two integer lengths.
#inline
#must_use
fn dh_imin(a, b) {
    if (a < b) { return a; }
    return b;
}

# sign-extend the low 24 bits of x (matches Rust `(x << 8) >> 8` on i32).
#inline
#must_use
fn dh_sext24(x) {
    var low = x & 0xFFFFFF;
    if ((low & 0x800000) == 0) { return low; }
    return low - 0x1000000;
}

# ---- gain / mix / dynamics ----

# add_buffers(dst, src) -- dst[i] += src[i] over min length.
fn dhvani_simd_add_buffers(dst, src) {
    var len = dh_imin(vec_len(dst), vec_len(src));
    var i = 0;
    while (i < len) {
        vec_set(dst, i, f64_add(vec_get(dst, i), vec_get(src, i)));
        i = i + 1;
    }
    return 0;
}

# apply_gain(samples, gain) -- multiply every sample by gain.
fn dhvani_simd_apply_gain(samples, gain) {
    var len = vec_len(samples);
    var i = 0;
    while (i < len) {
        vec_set(samples, i, f64_mul(vec_get(samples, i), gain));
        i = i + 1;
    }
    return 0;
}

# clamp(samples, min, max) -- clamp every sample into [min, max].
fn dhvani_simd_clamp(samples, min, max) {
    var len = vec_len(samples);
    var i = 0;
    while (i < len) {
        vec_set(samples, i, f64_clamp(vec_get(samples, i), min, max));
        i = i + 1;
    }
    return 0;
}

# peak_abs(samples) -- max |sample|, 0.0 for empty.
#must_use
fn dhvani_simd_peak_abs(samples) {
    var len = vec_len(samples);
    var peak = 0;              # +0.0
    var i = 0;
    while (i < len) {
        peak = f64_max(peak, f64_abs(vec_get(samples, i)));
        i = i + 1;
    }
    return peak;
}

# sum_of_squares(samples) -- sum(s*s) as f64.
#must_use
fn dhvani_simd_sum_of_squares(samples) {
    var len = vec_len(samples);
    var sum = 0;              # +0.0
    var i = 0;
    while (i < len) {
        var s = vec_get(samples, i);
        sum = f64_add(sum, f64_mul(s, s));
        i = i + 1;
    }
    return sum;
}

# noise_gate(samples, threshold) -- zero samples with |s| < threshold.
fn dhvani_simd_noise_gate(samples, threshold) {
    var len = vec_len(samples);
    var i = 0;
    while (i < len) {
        if (f64_lt(f64_abs(vec_get(samples, i)), threshold) == 1) {
            vec_set(samples, i, 0);
        }
        i = i + 1;
    }
    return 0;
}

# ---- format conversion (integer PCM <-> f32) ----

# i16_to_f32(src, dst) -- src[i] / 32768.0.
fn dhvani_simd_i16_to_f32(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var i = 0;
    while (i < len) {
        vec_set(dst, i, f64_div(f64_from(vec_get(src, i)), 32768.0));
        i = i + 1;
    }
    return 0;
}

# f32_to_i16(src, dst) -- (clamp(src,-1,1) * 32767) truncated to i16.
fn dhvani_simd_f32_to_i16(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var i = 0;
    while (i < len) {
        var c = f64_clamp(vec_get(src, i), DH_NEG_ONE, 1.0);
        vec_set(dst, i, f64_to(f64_trunc(f64_mul(c, 32767.0))));
        i = i + 1;
    }
    return 0;
}

# i24_to_f32(src, dst) -- sign-extend low 24 bits, / 8388608.0.
fn dhvani_simd_i24_to_f32(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var i = 0;
    while (i < len) {
        vec_set(dst, i, f64_div(f64_from(dh_sext24(vec_get(src, i))), 8388608.0));
        i = i + 1;
    }
    return 0;
}

# f32_to_i24(src, dst) -- (clamp(src,-1,1) * 8388607) truncated to i32.
fn dhvani_simd_f32_to_i24(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var i = 0;
    while (i < len) {
        var c = f64_clamp(vec_get(src, i), DH_NEG_ONE, 1.0);
        vec_set(dst, i, f64_to(f64_trunc(f64_mul(c, 8388607.0))));
        i = i + 1;
    }
    return 0;
}

# u8_to_f32(src, dst) -- (src[i] - 128) / 128.0.
fn dhvani_simd_u8_to_f32(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var i = 0;
    while (i < len) {
        vec_set(dst, i, f64_div(f64_sub(f64_from(vec_get(src, i)), 128.0), 128.0));
        i = i + 1;
    }
    return 0;
}

# f32_to_u8(src, dst) -- ((clamp(src,-1,1)*128)+128) clamped to [0,255], to u8.
fn dhvani_simd_f32_to_u8(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var i = 0;
    while (i < len) {
        var c = f64_clamp(vec_get(src, i), DH_NEG_ONE, 1.0);
        var v = f64_add(f64_mul(c, 128.0), 128.0);
        vec_set(dst, i, f64_to(f64_trunc(f64_clamp(v, 0, 255.0))));
        i = i + 1;
    }
    return 0;
}

# ---- resampling kernel ----

# weighted_sum(samples, weights, out_sum, out_weight_sum) -- dot product +
# weight total, written via store64 (Cyrius has no tuple returns). Returns 0.
fn dhvani_simd_weighted_sum(samples, weights, out_sum, out_weight_sum) {
    var len = dh_imin(vec_len(samples), vec_len(weights));
    var sum = 0;            # +0.0
    var wsum = 0;           # +0.0
    var i = 0;
    while (i < len) {
        var w = vec_get(weights, i);
        sum = f64_add(sum, f64_mul(vec_get(samples, i), w));
        wsum = f64_add(wsum, w);
        i = i + 1;
    }
    store64(out_sum, sum);
    store64(out_weight_sum, wsum);
    return 0;
}

# ---- stereo biquad (Direct-Form-I, cross-channel) ----

# biquad_stereo(samples, coeffs, state) -- process interleaved L/R in place.
# coeffs = [b0,b1,b2,a1,a2] (vec), state = [z1L,z2L,z1R,z2R] (vec, mutated).
fn dhvani_simd_biquad_stereo(samples, coeffs, state) {
    var b0 = vec_get(coeffs, 0);
    var b1 = vec_get(coeffs, 1);
    var b2 = vec_get(coeffs, 2);
    var a1 = vec_get(coeffs, 3);
    var a2 = vec_get(coeffs, 4);
    var frames = vec_len(samples) / 2;
    var f = 0;
    while (f < frames) {
        var idx = f * 2;
        # left
        var in_l = vec_get(samples, idx);
        var out_l = f64_add(f64_mul(b0, in_l), vec_get(state, 0));
        vec_set(state, 0, f64_add(f64_sub(f64_mul(b1, in_l), f64_mul(a1, out_l)), vec_get(state, 1)));
        vec_set(state, 1, f64_sub(f64_mul(b2, in_l), f64_mul(a2, out_l)));
        vec_set(samples, idx, out_l);
        # right
        var in_r = vec_get(samples, idx + 1);
        var out_r = f64_add(f64_mul(b0, in_r), vec_get(state, 2));
        vec_set(state, 2, f64_add(f64_sub(f64_mul(b1, in_r), f64_mul(a1, out_r)), vec_get(state, 3)));
        vec_set(state, 3, f64_sub(f64_mul(b2, in_r), f64_mul(a2, out_r)));
        vec_set(samples, idx + 1, out_r);
        f = f + 1;
    }
    return 0;
}

# --- clock.cyr ---

# clock.cyr -- sample-accurate transport clock (position, tempo, A/V sync).
# Ports rust-old/src/clock/mod.rs (AudioClock). L0, no internal deps besides
# error.cyr (dhvani_is_finite). serde derive dropped.
#
# TYPES: position_samples (u64) and sample_rate (u32) are INTEGER counts, stored
# as plain i64 slots (converted to f64 via f64_from only for time math).
# tempo_bpm is an f64 (bit pattern). running (bool) -> i64 flag (0/1).
# Option<f64> (position_beats / samples_per_beat, None when tempo<=0) ->
# DH_CLOCK_NONE (NaN) sentinel; callers test dhvani_is_finite().

var DH_CLOCK_NONE = 0x7FF8000000000000;   # NaN -- Option::None sentinel

#derive(accessors)
struct DhAudioClock { position_samples; sample_rate; tempo_bpm; running; }

# new(sample_rate) -- clock at position 0, no tempo, stopped.
#must_use
fn dhvani_clock_new(sample_rate) {
    var self = alloc(sizeof(DhAudioClock));
    DhAudioClock_set_position_samples(self, 0);
    DhAudioClock_set_sample_rate(self, sample_rate);
    DhAudioClock_set_tempo_bpm(self, 0);
    DhAudioClock_set_running(self, 0);
    return self;
}

# with_tempo(sample_rate, bpm) -- clock at 0 with tempo (bpm is f64).
#must_use
fn dhvani_clock_with_tempo(sample_rate, bpm) {
    var self = alloc(sizeof(DhAudioClock));
    DhAudioClock_set_position_samples(self, 0);
    DhAudioClock_set_sample_rate(self, sample_rate);
    DhAudioClock_set_tempo_bpm(self, bpm);
    DhAudioClock_set_running(self, 0);
    return self;
}

# position_secs -- position_samples / sample_rate (f64).
#inline
#must_use
fn dhvani_clock_position_secs(self) {
    return f64_div(f64_from(DhAudioClock_position_samples(self)),
                   f64_from(DhAudioClock_sample_rate(self)));
}

# position_ms -- position in milliseconds.
#inline
#must_use
fn dhvani_clock_position_ms(self) {
    return f64_mul(dhvani_clock_position_secs(self), 1000.0);
}

# position_beats -- beat position, or DH_CLOCK_NONE (NaN) if tempo<=0.
#inline
#must_use
fn dhvani_clock_position_beats(self) {
    var tempo = DhAudioClock_tempo_bpm(self);
    if (f64_le(tempo, 0) == 1) { return DH_CLOCK_NONE; }
    return f64_div(f64_mul(dhvani_clock_position_secs(self), tempo), 60.0);
}

# advance(frames) -- add frames to position, only when running.
fn dhvani_clock_advance(self, frames) {
    if (DhAudioClock_running(self) == 1) {
        DhAudioClock_set_position_samples(self,
            DhAudioClock_position_samples(self) + frames);
    }
    return 0;
}

# start / stop -- toggle the running flag.
fn dhvani_clock_start(self) { DhAudioClock_set_running(self, 1); return 0; }
fn dhvani_clock_stop(self)  { DhAudioClock_set_running(self, 0); return 0; }

# reset -- position back to 0 (running state unchanged).
fn dhvani_clock_reset(self) { DhAudioClock_set_position_samples(self, 0); return 0; }

# seek_secs(secs) -- position = max(secs*sample_rate, 0) truncated to u64.
fn dhvani_clock_seek_secs(self, secs) {
    var samples = f64_mul(secs, f64_from(DhAudioClock_sample_rate(self)));
    DhAudioClock_set_position_samples(self, f64_to(f64_trunc(f64_max(samples, 0))));
    return 0;
}

# samples_per_beat -- or DH_CLOCK_NONE (NaN) if tempo<=0.
#inline
#must_use
fn dhvani_clock_samples_per_beat(self) {
    var tempo = DhAudioClock_tempo_bpm(self);
    if (f64_le(tempo, 0) == 1) { return DH_CLOCK_NONE; }
    return f64_div(f64_mul(f64_from(DhAudioClock_sample_rate(self)), 60.0), tempo);
}

# pts_us -- presentation timestamp in microseconds (u64), for A/V sync.
#inline
#must_use
fn dhvani_clock_pts_us(self) {
    return f64_to(f64_trunc(f64_mul(dhvani_clock_position_secs(self), 1000000.0)));
}

# --- accessors (mirror the Rust public getters) ---
#inline
#must_use
fn dhvani_clock_position_samples(self) { return DhAudioClock_position_samples(self); }
#inline
#must_use
fn dhvani_clock_sample_rate(self) { return DhAudioClock_sample_rate(self); }
#inline
#must_use
fn dhvani_clock_tempo_bpm(self) { return DhAudioClock_tempo_bpm(self); }
#inline
#must_use
fn dhvani_clock_is_running(self) { return DhAudioClock_running(self); }

# set_tempo(bpm) -- finite && >0 keeps bpm, else clamps to 0 (matches Rust).
fn dhvani_clock_set_tempo(self, bpm) {
    if (dhvani_is_finite(bpm) == 1) {
        if (f64_gt(bpm, 0) == 1) {
            DhAudioClock_set_tempo_bpm(self, bpm);
            return 0;
        }
    }
    DhAudioClock_set_tempo_bpm(self, 0);
    return 0;
}

# --- oscillator.cyr ---

# oscillator.cyr -- anti-aliased waveform generation (PolyBLEP).
# Ports rust-old/src/dsp/oscillator.rs. L0 leaf (deps: error + abaco::poly_blep).
# Waveform enum -> codes; validate() Result -> error code; serde dropped.
# rng_state u32 xorshift inlined with 32-bit masking (anonymous -- does not
# redefine dither's dh_xorshift32_next). TAU via the exact-hex stdlib F64_TAU.

var DH_WAVE_SINE     = 0;
var DH_WAVE_SAW      = 1;
var DH_WAVE_SQUARE   = 2;
var DH_WAVE_TRIANGLE = 3;
var DH_WAVE_NOISE    = 4;

#derive(accessors)
struct DhOscillator { waveform; phase; sample_rate; rng_state; tri_integrator; }

# new(waveform, sample_rate) -- phase 0, seeded RNG.
#must_use
fn dhvani_osc_new(waveform, sample_rate) {
    var self = alloc(sizeof(DhOscillator));
    DhOscillator_set_waveform(self, waveform);
    DhOscillator_set_phase(self, 0);
    DhOscillator_set_sample_rate(self, f64_from(sample_rate));
    DhOscillator_set_rng_state(self, 0x12345678);
    DhOscillator_set_tri_integrator(self, 0);
    return self;
}

# validate -- ERR_NONE if sample_rate > 0, else ERR_INVALID_SAMPLE_RATE.
#must_use
fn dhvani_osc_validate(self) {
    if (f64_le(DhOscillator_sample_rate(self), 0) == 1) { return DHVANI_ERR_INVALID_SAMPLE_RATE; }
    return DHVANI_ERR_NONE;
}

# sample(freq) -- next sample; advances phase. Call once per sample.
fn dhvani_osc_sample(self, freq) {
    var phase = DhOscillator_phase(self);
    var dt = f64_div(freq, DhOscillator_sample_rate(self));
    var wf = DhOscillator_waveform(self);
    var value = 0;
    # Cyrius `var` is function-scoped -- every local below has a unique name.
    var naive = 0;
    var p2 = 0;
    if (wf == DH_WAVE_SINE) {
        value = f64_sin(f64_mul(phase, F64_TAU));
    } elif (wf == DH_WAVE_SAW) {
        naive = f64_sub(f64_mul(2.0, phase), 1.0);
        value = f64_sub(naive, poly_blep(phase, dt));
    } elif (wf == DH_WAVE_SQUARE) {
        naive = f64_neg(1.0);
        if (f64_lt(phase, 0.5) == 1) { naive = 1.0; }
        p2 = f64_add(phase, 0.5);
        if (f64_ge(p2, 1.0) == 1) { p2 = f64_sub(p2, 1.0); }
        value = f64_sub(f64_add(naive, poly_blep(phase, dt)), poly_blep(p2, dt));
    } elif (wf == DH_WAVE_TRIANGLE) {
        naive = f64_neg(1.0);
        if (f64_lt(phase, 0.5) == 1) { naive = 1.0; }
        p2 = f64_add(phase, 0.5);
        if (f64_ge(p2, 1.0) == 1) { p2 = f64_sub(p2, 1.0); }
        var sq_blep = f64_sub(f64_add(naive, poly_blep(phase, dt)), poly_blep(p2, dt));
        # leaky integrator (stored unclamped; returned value is clamped)
        var tri = f64_add(DhOscillator_tri_integrator(self), f64_mul(f64_mul(sq_blep, 4.0), dt));
        tri = f64_mul(tri, f64_sub(1.0, dt));
        DhOscillator_set_tri_integrator(self, tri);
        value = f64_clamp(tri, f64_neg(1.0), 1.0);
    } else {
        # Noise: xorshift32 (u32 wrap emulated with 32-bit masks).
        var s = DhOscillator_rng_state(self);
        s = (s ^ ((s << 13) & 0xFFFFFFFF)) & 0xFFFFFFFF;
        s = (s ^ (s >> 17)) & 0xFFFFFFFF;
        s = (s ^ ((s << 5) & 0xFFFFFFFF)) & 0xFFFFFFFF;
        DhOscillator_set_rng_state(self, s);
        value = f64_sub(f64_mul(f64_div(f64_from(s), f64_from(4294967295)), 2.0), 1.0);
    }
    phase = f64_add(phase, dt);
    if (f64_ge(phase, 1.0) == 1) { phase = f64_sub(phase, 1.0); }
    DhOscillator_set_phase(self, phase);
    return value;
}

fn dhvani_osc_set_waveform(self, wf) { DhOscillator_set_waveform(self, wf); return 0; }
#inline
#must_use
fn dhvani_osc_waveform(self) { return DhOscillator_waveform(self); }

fn dhvani_osc_reset(self) {
    DhOscillator_set_phase(self, 0);
    DhOscillator_set_tri_integrator(self, 0);
    return 0;
}

#inline
#must_use
fn dhvani_osc_phase(self) { return DhOscillator_phase(self); }

fn dhvani_osc_set_sample_rate(self, sample_rate) {
    DhOscillator_set_sample_rate(self, f64_from(sample_rate));
    return 0;
}

# --- gain_smoother.cyr ---

# gain_smoother.cyr -- exponential-moving-average gain smoother (anti-pumping).
# Ports rust-old/src/dsp/gain_smoother.rs. L0, deps error only.
# GainSmootherParams held by GainSmoother as a nested struct handle. Attack
# (gain decreasing, fast) vs release (increasing, slow). serde dropped.

#derive(accessors)
struct DhGainSmootherParams { attack; release; }

#derive(accessors)
struct DhGainSmoother { params; current; }

# ---- GainSmootherParams ----
#must_use
fn dhvani_gsparams_new(attack, release) {
    var p = alloc(sizeof(DhGainSmootherParams));
    DhGainSmootherParams_set_attack(p, attack);
    DhGainSmootherParams_set_release(p, release);
    return p;
}
#must_use
fn dhvani_gsparams_default() { return dhvani_gsparams_new(0.3, 0.05); }
#inline
#must_use
fn dhvani_gsparams_attack(p) { return DhGainSmootherParams_attack(p); }
#inline
#must_use
fn dhvani_gsparams_release(p) { return DhGainSmootherParams_release(p); }

# validate -- ERR_NONE if attack & release in [0,1], else ERR_INVALID_PARAMETER.
#must_use
fn dhvani_gsparams_validate(p) {
    var a = DhGainSmootherParams_attack(p);
    var r = DhGainSmootherParams_release(p);
    if (f64_lt(a, 0) == 1)   { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_gt(a, 1.0) == 1) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_lt(r, 0) == 1)   { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_gt(r, 1.0) == 1) { return DHVANI_ERR_INVALID_PARAMETER; }
    return DHVANI_ERR_NONE;
}

# ---- GainSmoother ----
# new(attack, release) -- clamps coeffs to [0,1]; current starts at 1.0.
#must_use
fn dhvani_gs_new(attack, release) {
    var self = alloc(sizeof(DhGainSmoother));
    DhGainSmoother_set_params(self, dhvani_gsparams_new(f64_clamp(attack, 0, 1.0), f64_clamp(release, 0, 1.0)));
    DhGainSmoother_set_current(self, 1.0);
    return self;
}
#must_use
fn dhvani_gs_from_params(params) {
    var self = alloc(sizeof(DhGainSmoother));
    DhGainSmoother_set_params(self, params);
    DhGainSmoother_set_current(self, 1.0);
    return self;
}

# smooth(target) -- converge toward target (attack coeff if decreasing, else
# release); returns the new smoothed value.
fn dhvani_gs_smooth(self, target) {
    var current = DhGainSmoother_current(self);
    var p = DhGainSmoother_params(self);
    var alpha = DhGainSmootherParams_release(p);
    if (f64_lt(target, current) == 1) { alpha = DhGainSmootherParams_attack(p); }
    current = f64_add(current, f64_mul(alpha, f64_sub(target, current)));
    DhGainSmoother_set_current(self, current);
    return current;
}

#inline
#must_use
fn dhvani_gs_current(self) { return DhGainSmoother_current(self); }
fn dhvani_gs_reset(self, value) { DhGainSmoother_set_current(self, value); return 0; }
fn dhvani_gs_set_params(self, params) { DhGainSmoother_set_params(self, params); return 0; }
#inline
#must_use
fn dhvani_gs_params(self) { return DhGainSmoother_params(self); }

# --- envelope.cyr ---

# envelope.cyr -- ADSR envelope generator.
# Ports rust-old/src/dsp/envelope.rs. L0, deps error only.
# AdsrParams + EnvelopeState enum -> codes. validate()/set_params() Result ->
# error codes. stage_pos is an integer sample counter. serde dropped.

# ---- EnvelopeState ----
var DH_ENV_IDLE    = 0;
var DH_ENV_ATTACK  = 1;
var DH_ENV_DECAY   = 2;
var DH_ENV_SUSTAIN = 3;
var DH_ENV_RELEASE = 4;

#derive(accessors)
struct DhAdsrParams { attack; decay; sustain; release; }

#derive(accessors)
struct DhEnvelope { params; state; level; sample_rate; stage_pos; release_start_level; }

# ---- AdsrParams ----
#must_use
fn dhvani_adsr_new(attack, decay, sustain, release) {
    var p = alloc(sizeof(DhAdsrParams));
    DhAdsrParams_set_attack(p, attack);
    DhAdsrParams_set_decay(p, decay);
    DhAdsrParams_set_sustain(p, sustain);
    DhAdsrParams_set_release(p, release);
    return p;
}
#must_use
fn dhvani_adsr_default() { return dhvani_adsr_new(0.01, 0.1, 0.7, 0.3); }

# validate -- attack/decay/release >= 0, sustain in [0,1].
#must_use
fn dhvani_adsr_validate(p) {
    if (f64_lt(DhAdsrParams_attack(p), 0) == 1)  { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_lt(DhAdsrParams_decay(p), 0) == 1)   { return DHVANI_ERR_INVALID_PARAMETER; }
    var s = DhAdsrParams_sustain(p);
    if (f64_lt(s, 0) == 1)                        { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_gt(s, 1.0) == 1)                      { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_lt(DhAdsrParams_release(p), 0) == 1) { return DHVANI_ERR_INVALID_PARAMETER; }
    return DHVANI_ERR_NONE;
}

# ---- Envelope ----
#must_use
fn dhvani_env_new(params, sample_rate) {
    var self = alloc(sizeof(DhEnvelope));
    DhEnvelope_set_params(self, params);
    DhEnvelope_set_state(self, DH_ENV_IDLE);
    DhEnvelope_set_level(self, 0);
    DhEnvelope_set_sample_rate(self, f64_from(sample_rate));
    DhEnvelope_set_stage_pos(self, 0);
    DhEnvelope_set_release_start_level(self, 0);
    return self;
}

# trigger -- note-on: enter Attack.
fn dhvani_env_trigger(self) {
    DhEnvelope_set_state(self, DH_ENV_ATTACK);
    DhEnvelope_set_stage_pos(self, 0);
    return 0;
}

# release -- note-off: enter Release from the current level (unless Idle).
fn dhvani_env_release(self) {
    if (DhEnvelope_state(self) != DH_ENV_IDLE) {
        DhEnvelope_set_release_start_level(self, DhEnvelope_level(self));
        DhEnvelope_set_state(self, DH_ENV_RELEASE);
        DhEnvelope_set_stage_pos(self, 0);
    }
    return 0;
}

# tick -- advance one sample, return current level (0..1).
fn dhvani_env_tick(self) {
    var state = DhEnvelope_state(self);
    var p = DhEnvelope_params(self);
    var sr = DhEnvelope_sample_rate(self);
    var stage_pos = DhEnvelope_stage_pos(self);
    var samples = 0;
    var progress = 0;
    if (state == DH_ENV_IDLE) {
        DhEnvelope_set_level(self, 0);
    } elif (state == DH_ENV_ATTACK) {
        samples = f64_to(f64_trunc(f64_max(f64_mul(DhAdsrParams_attack(p), sr), 1.0)));
        var lvl = f64_div(f64_from(stage_pos), f64_from(samples));
        if (f64_ge(lvl, 1.0) == 1) {
            DhEnvelope_set_level(self, 1.0);
            DhEnvelope_set_state(self, DH_ENV_DECAY);
            DhEnvelope_set_stage_pos(self, 0);
        } else {
            DhEnvelope_set_level(self, lvl);
            DhEnvelope_set_stage_pos(self, stage_pos + 1);
        }
    } elif (state == DH_ENV_DECAY) {
        samples = f64_to(f64_trunc(f64_max(f64_mul(DhAdsrParams_decay(p), sr), 1.0)));
        progress = f64_div(f64_from(stage_pos), f64_from(samples));
        var sustain = DhAdsrParams_sustain(p);
        DhEnvelope_set_level(self, f64_add(1.0, f64_mul(f64_sub(sustain, 1.0), progress)));
        if (f64_ge(progress, 1.0) == 1) {
            DhEnvelope_set_level(self, sustain);
            DhEnvelope_set_state(self, DH_ENV_SUSTAIN);
            DhEnvelope_set_stage_pos(self, 0);
        } else {
            DhEnvelope_set_stage_pos(self, stage_pos + 1);
        }
    } elif (state == DH_ENV_SUSTAIN) {
        DhEnvelope_set_level(self, DhAdsrParams_sustain(p));
    } else {
        # Release
        samples = f64_to(f64_trunc(f64_max(f64_mul(DhAdsrParams_release(p), sr), 1.0)));
        progress = f64_div(f64_from(stage_pos), f64_from(samples));
        DhEnvelope_set_level(self, f64_mul(DhEnvelope_release_start_level(self), f64_sub(1.0, progress)));
        if (f64_ge(progress, 1.0) == 1) {
            DhEnvelope_set_level(self, 0);
            DhEnvelope_set_state(self, DH_ENV_IDLE);
            DhEnvelope_set_stage_pos(self, 0);
        } else {
            DhEnvelope_set_stage_pos(self, stage_pos + 1);
        }
    }
    return DhEnvelope_level(self);
}

#inline
#must_use
fn dhvani_env_level(self) { return DhEnvelope_level(self); }
#inline
#must_use
fn dhvani_env_state(self) { return DhEnvelope_state(self); }
#must_use
fn dhvani_env_is_finished(self) {
    if (DhEnvelope_state(self) == DH_ENV_IDLE) { return 1; }
    return 0;
}
fn dhvani_env_set_sample_rate(self, sample_rate) { DhEnvelope_set_sample_rate(self, f64_from(sample_rate)); return 0; }

fn dhvani_env_reset(self) {
    DhEnvelope_set_state(self, DH_ENV_IDLE);
    DhEnvelope_set_level(self, 0);
    DhEnvelope_set_stage_pos(self, 0);
    return 0;
}

# set_params -- validate then store; returns error code on invalid params.
fn dhvani_env_set_params(self, params) {
    var rc = dhvani_adsr_validate(params);
    if (dhvani_is_err(rc) == 1) { return rc; }
    DhEnvelope_set_params(self, params);
    return DHVANI_ERR_NONE;
}

# --- lfo.cyr ---

# lfo.cyr -- low-frequency oscillator for modulation (6 shapes).
# Ports rust-old/src/dsp/lfo.rs. L0, deps error only. LfoShape enum -> codes;
# validate() Result -> error code; serde dropped. Output range [-depth,+depth].
# S&H uses xorshift32 (inline, 32-bit masked); TAU via exact-hex F64_TAU.

var DH_LFO_SINE            = 0;
var DH_LFO_TRIANGLE        = 1;
var DH_LFO_SQUARE          = 2;
var DH_LFO_SAWUP           = 3;
var DH_LFO_SAWDOWN         = 4;
var DH_LFO_SAMPLE_AND_HOLD = 5;

#derive(accessors)
struct DhLfo { shape; rate; depth; phase; sample_rate; sh_value; rng_state; prev_phase; }

# new(shape, rate, depth, sample_rate) -- depth clamped to [0,1]; RNG seeded.
#must_use
fn dhvani_lfo_new(shape, rate, depth, sample_rate) {
    var self = alloc(sizeof(DhLfo));
    DhLfo_set_shape(self, shape);
    DhLfo_set_rate(self, rate);
    DhLfo_set_depth(self, f64_clamp(depth, 0, 1.0));
    DhLfo_set_phase(self, 0);
    DhLfo_set_sample_rate(self, f64_from(sample_rate));
    DhLfo_set_sh_value(self, 0);
    DhLfo_set_rng_state(self, 0xDEADBEEF);
    DhLfo_set_prev_phase(self, 0);
    return self;
}

# validate -- rate>=0, depth>=0, sample_rate>0.
#must_use
fn dhvani_lfo_validate(self) {
    if (f64_lt(DhLfo_rate(self), 0) == 1)        { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_lt(DhLfo_depth(self), 0) == 1)       { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_le(DhLfo_sample_rate(self), 0) == 1) { return DHVANI_ERR_INVALID_SAMPLE_RATE; }
    return DHVANI_ERR_NONE;
}

# tick -- advance one sample; return value in [-depth, +depth].
fn dhvani_lfo_tick(self) {
    var phase = DhLfo_phase(self);
    var shape = DhLfo_shape(self);
    var raw = 0;
    if (shape == DH_LFO_SINE) {
        raw = f64_sin(f64_mul(phase, F64_TAU));
    } elif (shape == DH_LFO_TRIANGLE) {
        raw = f64_sub(f64_mul(4.0, f64_abs(f64_sub(phase, 0.5))), 1.0);
    } elif (shape == DH_LFO_SQUARE) {
        raw = f64_neg(1.0);
        if (f64_lt(phase, 0.5) == 1) { raw = 1.0; }
    } elif (shape == DH_LFO_SAWUP) {
        raw = f64_sub(f64_mul(2.0, phase), 1.0);
    } elif (shape == DH_LFO_SAWDOWN) {
        raw = f64_sub(1.0, f64_mul(2.0, phase));
    } else {
        # SampleAndHold: new value on phase wrap.
        if (f64_lt(phase, DhLfo_prev_phase(self)) == 1) {
            var s = DhLfo_rng_state(self);
            s = (s ^ ((s << 13) & 0xFFFFFFFF)) & 0xFFFFFFFF;
            s = (s ^ (s >> 17)) & 0xFFFFFFFF;
            s = (s ^ ((s << 5) & 0xFFFFFFFF)) & 0xFFFFFFFF;
            DhLfo_set_rng_state(self, s);
            DhLfo_set_sh_value(self, f64_sub(f64_mul(f64_div(f64_from(s), f64_from(4294967295)), 2.0), 1.0));
        }
        raw = DhLfo_sh_value(self);
    }
    DhLfo_set_prev_phase(self, phase);
    var new_phase = f64_add(phase, f64_div(DhLfo_rate(self), DhLfo_sample_rate(self)));
    if (f64_ge(new_phase, 1.0) == 1) { new_phase = f64_sub(new_phase, 1.0); }
    DhLfo_set_phase(self, new_phase);
    return f64_mul(raw, DhLfo_depth(self));
}

fn dhvani_lfo_set_sample_rate(self, sample_rate) { DhLfo_set_sample_rate(self, f64_from(sample_rate)); return 0; }

fn dhvani_lfo_reset(self) {
    DhLfo_set_phase(self, 0);
    DhLfo_set_prev_phase(self, 0);
    DhLfo_set_sh_value(self, 0);
    return 0;
}

fn dhvani_lfo_set_rate(self, rate) { DhLfo_set_rate(self, f64_max(rate, 0)); return 0; }
fn dhvani_lfo_set_depth(self, depth) { DhLfo_set_depth(self, f64_clamp(depth, 0, 1.0)); return 0; }
fn dhvani_lfo_set_shape(self, shape) { DhLfo_set_shape(self, shape); return 0; }

#inline
#must_use
fn dhvani_lfo_rate(self) { return DhLfo_rate(self); }
#inline
#must_use
fn dhvani_lfo_depth(self) { return DhLfo_depth(self); }
#inline
#must_use
fn dhvani_lfo_shape(self) { return DhLfo_shape(self); }
#inline
#must_use
fn dhvani_lfo_phase(self) { return DhLfo_phase(self); }

# --- automation.cyr ---

# automation.cyr -- sample-accurate automation curves (breakpoint interpolation).
# Ports rust-old/src/dsp/automation.rs. L0, deps error only (+ F64_PI stdlib).
# CurveType enum -> codes; the Exponential(f32) payload becomes a separate `exp`
# field on the breakpoint. serde dropped.

var DH_CURVE_STEP        = 0;
var DH_CURVE_LINEAR      = 1;
var DH_CURVE_EXPONENTIAL = 2;   # exponent lives in the breakpoint's `exp` field
var DH_CURVE_SMOOTH      = 3;

#derive(accessors)
struct DhBreakpoint { frame; value; curve; exp; }

#derive(accessors)
struct DhAutomationLane { breakpoints; default_value; }

# Breakpoint::new(frame, value, curve, exp). exp is only used for EXPONENTIAL.
#must_use
fn dhvani_breakpoint_new(frame, value, curve, exp) {
    var bp = alloc(sizeof(DhBreakpoint));
    DhBreakpoint_set_frame(bp, frame);
    DhBreakpoint_set_value(bp, value);
    DhBreakpoint_set_curve(bp, curve);
    DhBreakpoint_set_exp(bp, exp);
    return bp;
}

# interpolate between two values along `curve` at `current` frame.
#must_use
fn dhvani_auto_interpolate(from, to, from_frame, to_frame, current, curve, exp) {
    if (from_frame == to_frame) { return to; }
    var t = f64_div(f64_from(current - from_frame), f64_from(to_frame - from_frame));
    t = f64_clamp(t, 0, 1.0);
    if (curve == DH_CURVE_STEP)   { return from; }
    if (curve == DH_CURVE_LINEAR) { return f64_add(from, f64_mul(f64_sub(to, from), t)); }
    if (curve == DH_CURVE_EXPONENTIAL) {
        var e = f64_max(exp, 0.001);
        # f64_pow(0, e) returns NaN in Cyrius (ln(0)); Rust powf(0,e)=0. Guard it.
        var tp = 0;
        if (f64_gt(t, 0) == 1) { tp = f64_pow(t, e); }
        return f64_add(from, f64_mul(f64_sub(to, from), tp));
    }
    # Smooth: cosine interpolation.
    var t_smooth = f64_mul(f64_sub(1.0, f64_cos(f64_mul(t, F64_PI))), 0.5);
    return f64_add(from, f64_mul(f64_sub(to, from), t_smooth));
}

# new(default_value) -- empty lane.
#must_use
fn dhvani_auto_new(default_value) {
    var self = alloc(sizeof(DhAutomationLane));
    DhAutomationLane_set_breakpoints(self, vec_new());
    DhAutomationLane_set_default_value(self, default_value);
    return self;
}

# add(bp) -- insert keeping breakpoints sorted by frame (insertion bubble).
fn dhvani_auto_add(self, bp) {
    var bps = DhAutomationLane_breakpoints(self);
    vec_push(bps, bp);
    var i = vec_len(bps) - 1;
    var moving = 1;
    while (moving == 1) {
        if (i == 0) { moving = 0; }
        else {
            var left = vec_get(bps, i - 1);
            if (DhBreakpoint_frame(left) > DhBreakpoint_frame(bp)) {
                vec_set(bps, i, left);
                vec_set(bps, i - 1, bp);
                i = i - 1;
            } else { moving = 0; }
        }
    }
    return 0;
}

# remove_at(frame) -- drop all breakpoints at `frame`.
fn dhvani_auto_remove_at(self, frame) {
    var bps = DhAutomationLane_breakpoints(self);
    var kept = vec_new();
    var n = vec_len(bps);
    var i = 0;
    while (i < n) {
        var bp = vec_get(bps, i);
        if (DhBreakpoint_frame(bp) != frame) { vec_push(kept, bp); }
        i = i + 1;
    }
    DhAutomationLane_set_breakpoints(self, kept);
    return 0;
}

fn dhvani_auto_clear(self) { DhAutomationLane_set_breakpoints(self, vec_new()); return 0; }
#inline
#must_use
fn dhvani_auto_len(self) { return vec_len(DhAutomationLane_breakpoints(self)); }
#must_use
fn dhvani_auto_is_empty(self) {
    if (vec_len(DhAutomationLane_breakpoints(self)) == 0) { return 1; }
    return 0;
}
#inline
#must_use
fn dhvani_auto_breakpoints(self) { return DhAutomationLane_breakpoints(self); }

# value_at(frame) -- interpolated value.
#must_use
fn dhvani_auto_value_at(self, frame) {
    var bps = DhAutomationLane_breakpoints(self);
    var n = vec_len(bps);
    if (n == 0) { return DhAutomationLane_default_value(self); }
    var first = vec_get(bps, 0);
    if (frame <= DhBreakpoint_frame(first)) {
        if (DhBreakpoint_curve(first) == DH_CURVE_STEP) { return DhAutomationLane_default_value(self); }
        return DhBreakpoint_value(first);
    }
    var last = vec_get(bps, n - 1);
    if (frame >= DhBreakpoint_frame(last)) { return DhBreakpoint_value(last); }
    # first index with frame >= query (binary-search insertion point)
    var idx = 0;
    var found = 0;
    while (found == 0) {
        if (DhBreakpoint_frame(vec_get(bps, idx)) >= frame) { found = 1; } else { idx = idx + 1; }
    }
    if (idx == 0) { return DhBreakpoint_value(first); }
    var prev = vec_get(bps, idx - 1);
    var next = vec_get(bps, idx);
    return dhvani_auto_interpolate(DhBreakpoint_value(prev), DhBreakpoint_value(next),
        DhBreakpoint_frame(prev), DhBreakpoint_frame(next), frame,
        DhBreakpoint_curve(next), DhBreakpoint_exp(next));
}

# render(output, start_frame) -- fill output[i] with value_at(start_frame+i).
fn dhvani_auto_render(self, output, start_frame) {
    var n = vec_len(output);
    var i = 0;
    while (i < n) {
        vec_set(output, i, dhvani_auto_value_at(self, start_frame + i));
        i = i + 1;
    }
    return 0;
}

# render_fast(output, start_frame) -- segment-walking render (monotone seg_idx).
fn dhvani_auto_render_fast(self, output, start_frame) {
    var bps = DhAutomationLane_breakpoints(self);
    var nbp = vec_len(bps);
    var n = vec_len(output);
    if (nbp == 0) {
        var dv = DhAutomationLane_default_value(self);
        var j = 0;
        while (j < n) { vec_set(output, j, dv); j = j + 1; }
        return 0;
    }
    var seg_idx = 0;
    var i = 0;
    while (i < n) {
        var frame = start_frame + i;
        var advancing = 1;
        while (advancing == 1) {
            if (seg_idx < nbp) {
                if (DhBreakpoint_frame(vec_get(bps, seg_idx)) <= frame) { seg_idx = seg_idx + 1; }
                else { advancing = 0; }
            } else { advancing = 0; }
        }
        if (seg_idx == 0) {
            var f0 = vec_get(bps, 0);
            if (DhBreakpoint_curve(f0) == DH_CURVE_STEP) { vec_set(output, i, DhAutomationLane_default_value(self)); }
            else { vec_set(output, i, DhBreakpoint_value(f0)); }
        } elif (seg_idx >= nbp) {
            vec_set(output, i, DhBreakpoint_value(vec_get(bps, nbp - 1)));
        } else {
            var prev = vec_get(bps, seg_idx - 1);
            var next = vec_get(bps, seg_idx);
            vec_set(output, i, dhvani_auto_interpolate(DhBreakpoint_value(prev), DhBreakpoint_value(next),
                DhBreakpoint_frame(prev), DhBreakpoint_frame(next), frame,
                DhBreakpoint_curve(next), DhBreakpoint_exp(next)));
        }
        i = i + 1;
    }
    return 0;
}

# --- midi.cyr ---

# midi.cyr -- MIDI 1.0 core types: NoteEvent, ControlChange, MidiEvent, MidiClip.
# Ports rust-old/src/midi/mod.rs. L0: dep error only (+ stdlib string streq).
# The data-carrying MidiEvent enum -> a `kind` code + a fat struct holding every
# variant's fields (only position/channel are read across variants). FramePos
# (u64) and the u8 fields -> i64 slots. serde dropped. Names are string handles.

# ---- NoteEvent ----
#derive(accessors)
struct DhNoteEvent { position; duration; note; velocity; channel; }
#must_use
fn dhvani_note_event_new(position, duration, note, velocity, channel) {
    var e = alloc(sizeof(DhNoteEvent));
    DhNoteEvent_set_position(e, position);
    DhNoteEvent_set_duration(e, duration);
    DhNoteEvent_set_note(e, note);
    DhNoteEvent_set_velocity(e, velocity);
    DhNoteEvent_set_channel(e, channel);
    return e;
}
#inline
#must_use
