# ---- MidiEvent (data-carrying enum -> kind code + fat struct) ----
var DH_MIDI_NOTE_ON         = 0;
var DH_MIDI_NOTE_OFF        = 1;
var DH_MIDI_CONTROL_CHANGE  = 2;
var DH_MIDI_PITCH_BEND      = 3;
var DH_MIDI_AFTERTOUCH      = 4;
var DH_MIDI_POLY_AFTERTOUCH = 5;
var DH_MIDI_PROGRAM_CHANGE  = 6;

#derive(accessors)
struct DhMidiEvent { kind; position; note; velocity; controller; value; pressure; program; channel; }

# alloc a fully-zeroed event with kind/position/channel set.
#must_use
fn dh_midi_event_alloc(kind, position, channel) {
    var e = alloc(sizeof(DhMidiEvent));
    DhMidiEvent_set_kind(e, kind);
    DhMidiEvent_set_position(e, position);
    DhMidiEvent_set_note(e, 0);
    DhMidiEvent_set_velocity(e, 0);
    DhMidiEvent_set_controller(e, 0);
    DhMidiEvent_set_value(e, 0);
    DhMidiEvent_set_pressure(e, 0);
    DhMidiEvent_set_program(e, 0);
    DhMidiEvent_set_channel(e, channel);
    return e;
}
#must_use
fn dhvani_midi_note_on(position, note, velocity, channel) {
    var e = dh_midi_event_alloc(DH_MIDI_NOTE_ON, position, channel);
    DhMidiEvent_set_note(e, note); DhMidiEvent_set_velocity(e, velocity);
    return e;
}
#must_use
fn dhvani_midi_note_off(position, note, velocity, channel) {
    var e = dh_midi_event_alloc(DH_MIDI_NOTE_OFF, position, channel);
    DhMidiEvent_set_note(e, note); DhMidiEvent_set_velocity(e, velocity);
    return e;
}
#must_use
fn dhvani_midi_control_change(position, controller, value, channel) {
    var e = dh_midi_event_alloc(DH_MIDI_CONTROL_CHANGE, position, channel);
    DhMidiEvent_set_controller(e, controller); DhMidiEvent_set_value(e, value);
    return e;
}
#must_use
fn dhvani_midi_pitch_bend(position, value, channel) {
    var e = dh_midi_event_alloc(DH_MIDI_PITCH_BEND, position, channel);
    DhMidiEvent_set_value(e, value);
    return e;
}
#must_use
fn dhvani_midi_aftertouch(position, pressure, channel) {
    var e = dh_midi_event_alloc(DH_MIDI_AFTERTOUCH, position, channel);
    DhMidiEvent_set_pressure(e, pressure);
    return e;
}
#must_use
fn dhvani_midi_poly_aftertouch(position, note, pressure, channel) {
    var e = dh_midi_event_alloc(DH_MIDI_POLY_AFTERTOUCH, position, channel);
    DhMidiEvent_set_note(e, note); DhMidiEvent_set_pressure(e, pressure);
    return e;
}
#must_use
fn dhvani_midi_program_change(position, program, channel) {
    var e = dh_midi_event_alloc(DH_MIDI_PROGRAM_CHANGE, position, channel);
    DhMidiEvent_set_program(e, program);
    return e;
}
#inline
#must_use
fn dhvani_midi_event_kind(e) { return DhMidiEvent_kind(e); }
#inline
#must_use
fn dhvani_midi_event_position(e) { return DhMidiEvent_position(e); }
#inline
#must_use
fn dhvani_midi_event_channel(e) { return DhMidiEvent_channel(e); }

# ---- MidiClip ----
#derive(accessors)
struct DhMidiClip { name; notes; control_changes; timeline_pos; duration; }
#must_use
fn dhvani_midi_clip_new(name, timeline_pos, duration) {
    var c = alloc(sizeof(DhMidiClip));
    DhMidiClip_set_name(c, name);
    DhMidiClip_set_notes(c, vec_new());
    DhMidiClip_set_control_changes(c, vec_new());
    DhMidiClip_set_timeline_pos(c, timeline_pos);
    DhMidiClip_set_duration(c, duration);
    return c;
}
#inline
#must_use
fn dhvani_midi_clip_name(c) { return DhMidiClip_name(c); }
#inline
#must_use
fn dhvani_midi_clip_notes(c) { return DhMidiClip_notes(c); }
#inline
#must_use
fn dhvani_midi_clip_control_changes(c) { return DhMidiClip_control_changes(c); }
#inline
#must_use
fn dhvani_midi_clip_timeline_pos(c) { return DhMidiClip_timeline_pos(c); }
#inline
#must_use
fn dhvani_midi_clip_duration(c) { return DhMidiClip_duration(c); }
#must_use
fn dhvani_midi_clip_end_pos(c) { return DhMidiClip_timeline_pos(c) + DhMidiClip_duration(c); }
#must_use
fn dhvani_midi_clip_event_count(c) { return vec_len(DhMidiClip_notes(c)) + vec_len(DhMidiClip_control_changes(c)); }

# insert a note handle keeping notes sorted by position (partition_point <=:
# new note goes AFTER equal-position notes).
fn dh_midi_insert_note(notes, e) {
    var pos = DhNoteEvent_position(e);
    vec_push(notes, e);
    var i = vec_len(notes) - 1;
    var moving = 1;
    while (moving == 1) {
        if (i == 0) { moving = 0; }
        else {
            var left = vec_get(notes, i - 1);
            if (DhNoteEvent_position(left) > pos) {
                vec_set(notes, i, left); vec_set(notes, i - 1, e); i = i - 1;
            } else { moving = 0; }
        }
    }
    return 0;
}
fn dhvani_midi_clip_add_note(self, position, duration, note, velocity, channel) {
    dh_midi_insert_note(DhMidiClip_notes(self), dhvani_note_event_new(position, duration, note, velocity, channel));
    return 0;
}
fn dhvani_midi_clip_add_cc(self, position, controller, value, channel) {
    var ccs = DhMidiClip_control_changes(self);
    var e = dhvani_cc_new(position, controller, value, channel);
    vec_push(ccs, e);
    var i = vec_len(ccs) - 1;
    var moving = 1;
    while (moving == 1) {
        if (i == 0) { moving = 0; }
        else {
            var left = vec_get(ccs, i - 1);
            if (DhControlChange_position(left) > position) {
                vec_set(ccs, i, left); vec_set(ccs, i - 1, e); i = i - 1;
            } else { moving = 0; }
        }
    }
    return 0;
}

# notes active at `frame`: position <= frame < position+duration.
#must_use
fn dhvani_midi_clip_notes_at(self, frame) {
    var notes = DhMidiClip_notes(self);
    var n = vec_len(notes);
    var out = vec_new();
    var i = 0;
    while (i < n) {
        var e = vec_get(notes, i);
        var p = DhNoteEvent_position(e);
        if (p <= frame) { if (frame < p + DhNoteEvent_duration(e)) { vec_push(out, e); } }
        i = i + 1;
    }
    return out;
}
# note-ons starting exactly at `frame`.
#must_use
fn dhvani_midi_clip_note_ons_at(self, frame) {
    var notes = DhMidiClip_notes(self);
    var n = vec_len(notes);
    var out = vec_new();
    var i = 0;
    while (i < n) {
        var e = vec_get(notes, i);
        if (DhNoteEvent_position(e) == frame) { vec_push(out, e); }
        i = i + 1;
    }
    return out;
}
# note-offs ending exactly at `frame` (position+duration == frame).
#must_use
fn dhvani_midi_clip_note_offs_at(self, frame) {
    var notes = DhMidiClip_notes(self);
    var n = vec_len(notes);
    var out = vec_new();
    var i = 0;
    while (i < n) {
        var e = vec_get(notes, i);
        if (DhNoteEvent_position(e) + DhNoteEvent_duration(e) == frame) { vec_push(out, e); }
        i = i + 1;
    }
    return out;
}
# note events overlapping [start, end): position < end AND position+duration > start.
#must_use
fn dhvani_midi_clip_events_in_range(self, start, end) {
    var notes = DhMidiClip_notes(self);
    var n = vec_len(notes);
    var out = vec_new();
    var i = 0;
    while (i < n) {
        var e = vec_get(notes, i);
        var p = DhNoteEvent_position(e);
        if (p < end) { if (p + DhNoteEvent_duration(e) > start) { vec_push(out, e); } }
        i = i + 1;
    }
    return out;
}

# merge another clip's notes+CCs (kept sorted); extend duration if needed.
fn dhvani_midi_clip_merge(self, other) {
    var onotes = DhMidiClip_notes(other);
    var nn = vec_len(onotes);
    var i = 0;
    while (i < nn) {
        var e = vec_get(onotes, i);
        dh_midi_insert_note(DhMidiClip_notes(self),
            dhvani_note_event_new(DhNoteEvent_position(e), DhNoteEvent_duration(e), DhNoteEvent_note(e), DhNoteEvent_velocity(e), DhNoteEvent_channel(e)));
        i = i + 1;
    }
    var occs = DhMidiClip_control_changes(other);
    var nc = vec_len(occs);
    var j = 0;
    while (j < nc) {
        var c = vec_get(occs, j);
        dhvani_midi_clip_add_cc(self, DhControlChange_position(c), DhControlChange_controller(c), DhControlChange_value(c), DhControlChange_channel(c));
        j = j + 1;
    }
    if (nn > 0) {
        var last = vec_get(onotes, nn - 1);
        var other_end = DhNoteEvent_position(last) + DhNoteEvent_duration(last);
        if (other_end > DhMidiClip_duration(self)) { DhMidiClip_set_duration(self, other_end); }
    }
    return 0;
}

# transpose all notes by `semitones` (clamped to 0..127).
fn dhvani_midi_clip_transpose(self, semitones) {
    var notes = DhMidiClip_notes(self);
    var n = vec_len(notes);
    var i = 0;
    while (i < n) {
        var e = vec_get(notes, i);
        var nn = DhNoteEvent_note(e) + semitones;
        if (nn < 0) { nn = 0; }
        if (nn > 127) { nn = 127; }
        DhNoteEvent_set_note(e, nn);
        i = i + 1;
    }
    return 0;
}

# quantize note+CC positions to the nearest grid boundary. No-op for grid 0.
fn dhvani_midi_clip_quantize(self, grid_frames) {
    if (grid_frames == 0) { return 0; }
    var half = grid_frames / 2;
    var notes = DhMidiClip_notes(self);
    var n = vec_len(notes);
    var i = 0;
    while (i < n) {
        var e = vec_get(notes, i);
        DhNoteEvent_set_position(e, ((DhNoteEvent_position(e) + half) / grid_frames) * grid_frames);
        i = i + 1;
    }
    var ccs = DhMidiClip_control_changes(self);
    var nc = vec_len(ccs);
    var j = 0;
    while (j < nc) {
        var c = vec_get(ccs, j);
        DhControlChange_set_position(c, ((DhControlChange_position(c) + half) / grid_frames) * grid_frames);
        j = j + 1;
    }
    return 0;
}

# --- voice.cyr ---

# voice.cyr -- polyphonic voice pool: allocation + stealing. Ports
# rust-old/src/midi/voice.rs. L0: dep error only (dhvani_is_finite unused here;
# all logic is integer note/velocity/channel/age + one float for frequency).
#
# The oracle re-exports abaco::dsp::{A4_FREQUENCY, A4_MIDI_NOTE,
# SEMITONES_PER_OCTAVE} (NOT public in abaco) -- redefined locally below as f64
# bit patterns so this module needs no abaco include. frequency() =
# 440 * 2^((note - 69) / 12) via f64_pow.
#
# Enums -> int codes: VoiceState {Idle=0, Active=1, Releasing=2};
# VoiceStealMode {Oldest=0, Quietest=1, Lowest=2, None=3}. note_on returns a
# slot index or DH_VOICE_NONE (-1) when full + stealing disabled. serde +
# Debug/Display dropped.

# ---- MIDI constants (locally defined; abaco does not export these) ----
var DH_A4_FREQUENCY        = 0x407B800000000000;    # 440.0 Hz   (abaco DSP_A4_FREQ)
var DH_A4_MIDI_NOTE        = 0x4051400000000000;    # 69.0       (abaco DSP_A4_MIDI)
var DH_SEMITONES_PER_OCTAVE = 0x4028000000000000;   # 12.0       (abaco DSP_SEMITONES)

# ---- VoiceState codes ----
var DH_VOICE_STATE_IDLE      = 0;
var DH_VOICE_STATE_ACTIVE    = 1;
var DH_VOICE_STATE_RELEASING = 2;

# ---- VoiceStealMode codes ----
var DH_STEAL_OLDEST   = 0;
var DH_STEAL_QUIETEST = 1;
var DH_STEAL_LOWEST   = 2;
var DH_STEAL_NONE     = 3;

# ---- note_on "None" sentinel (Rust Option<usize>::None) ----
var DH_VOICE_NONE = (0 - 1);

# ================================================================
# Voice -- a single synthesizer voice.
# state/note/velocity/channel/age are integer slots; envelope_level/pitch_bend/
# pressure/brightness are f64 bit patterns (Rust f32, widened).
# ================================================================
#derive(accessors)
struct DhVoice { state; note; velocity; channel; envelope_level; age; pitch_bend; pressure; brightness; }

# new() -- an idle voice, all fields zeroed.
#must_use
fn dhvani_voice_new() {
    var v = alloc(sizeof(DhVoice));
    DhVoice_set_state(v, DH_VOICE_STATE_IDLE);
    DhVoice_set_note(v, 0);
    DhVoice_set_velocity(v, 0);
    DhVoice_set_channel(v, 0);
    DhVoice_set_envelope_level(v, 0);
    DhVoice_set_age(v, 0);
    DhVoice_set_pitch_bend(v, 0);
    DhVoice_set_pressure(v, 0);
    DhVoice_set_brightness(v, 0);
    return v;
}

#inline
#must_use
fn dhvani_voice_state(v) { return DhVoice_state(v); }
#inline
#must_use
fn dhvani_voice_note(v) { return DhVoice_note(v); }
#inline
#must_use
fn dhvani_voice_velocity(v) { return DhVoice_velocity(v); }
#inline
#must_use
fn dhvani_voice_channel(v) { return DhVoice_channel(v); }
#inline
#must_use
fn dhvani_voice_envelope_level(v) { return DhVoice_envelope_level(v); }
#inline
#must_use
fn dhvani_voice_age(v) { return DhVoice_age(v); }
#inline
#must_use
fn dhvani_voice_pitch_bend(v) { return DhVoice_pitch_bend(v); }
#inline
#must_use
fn dhvani_voice_pressure(v) { return DhVoice_pressure(v); }
#inline
#must_use
fn dhvani_voice_brightness(v) { return DhVoice_brightness(v); }

# is_idle -- 1 iff state == Idle.
#inline
#must_use
fn dhvani_voice_is_idle(v) {
    if (DhVoice_state(v) == DH_VOICE_STATE_IDLE) { return 1; }
    return 0;
}

# is_active -- 1 iff producing sound (Active or Releasing).
#inline
#must_use
fn dhvani_voice_is_active(v) {
    var st = DhVoice_state(v);
    if (st == DH_VOICE_STATE_ACTIVE) { return 1; }
    if (st == DH_VOICE_STATE_RELEASING) { return 1; }
    return 0;
}

# frequency -- Hz for this voice's note (12-TET, A4=440):
# 440 * 2^((note - 69) / 12).
#inline
#must_use
fn dhvani_voice_frequency(v) {
    var note_f = f64_from(DhVoice_note(v));
    var exponent = f64_div(f64_sub(note_f, DH_A4_MIDI_NOTE), DH_SEMITONES_PER_OCTAVE);
    return f64_mul(DH_A4_FREQUENCY, f64_pow(2.0, exponent));
}

# apply_per_note_cc -- only CC#74 (brightness) is handled; others ignored.
# value clamped to [0, 1].
fn dhvani_voice_apply_per_note_cc(v, controller, value_normalized) {
    if (controller == 74) {
        DhVoice_set_brightness(v, f64_clamp(value_normalized, 0, 1.0));
    }
    return 0;
}

# ---- test-only field setters (Rust tests poke pub(crate) fields directly) ----
fn dhvani_voice_set_note(v, note) { DhVoice_set_note(v, note); return 0; }
fn dhvani_voice_set_envelope_level(v, level) { DhVoice_set_envelope_level(v, level); return 0; }

# ================================================================
# VoiceManager -- polyphonic pool with configurable stealing.
# voices is a vec of DhVoice handles.
# ================================================================
#derive(accessors)
struct DhVoiceManager { voices; max_voices; steal_mode; }

# new(max_voices, steal_mode) -- pool of `max_voices` idle voices.
#must_use
fn dhvani_voice_manager_new(max_voices, steal_mode) {
    var self = alloc(sizeof(DhVoiceManager));
    var voices = vec_new();
    var i = 0;
    while (i < max_voices) {
        vec_push(voices, dhvani_voice_new());
        i = i + 1;
    }
    DhVoiceManager_set_voices(self, voices);
    DhVoiceManager_set_max_voices(self, max_voices);
    DhVoiceManager_set_steal_mode(self, steal_mode);
    return self;
}

# activate_voice -- reset slot idx into an Active note (private helper).
fn dh_voice_activate(self, idx, note, velocity, channel) {
    var voice = vec_get(DhVoiceManager_voices(self), idx);
    DhVoice_set_state(voice, DH_VOICE_STATE_ACTIVE);
    DhVoice_set_note(voice, note);
    DhVoice_set_velocity(voice, velocity);
    DhVoice_set_channel(voice, channel);
    DhVoice_set_envelope_level(voice, 0);
    DhVoice_set_age(voice, 0);
    DhVoice_set_pitch_bend(voice, 0);
    DhVoice_set_pressure(voice, 0);
    DhVoice_set_brightness(voice, 0);
    return 0;
}

# note_on -- allocate a voice for a new note. Returns the slot index, or
# DH_VOICE_NONE (-1) if the pool is full and stealing is disabled.
fn dhvani_voice_manager_note_on(self, note, velocity, channel) {
    var voices = DhVoiceManager_voices(self);
    var n = vec_len(voices);

    # First: find an idle voice (lowest index).
    var idle_idx = DH_VOICE_NONE;
    var i = 0;
    while (i < n) {
        if (idle_idx == DH_VOICE_NONE) {
            if (dhvani_voice_is_idle(vec_get(voices, i)) == 1) { idle_idx = i; }
        }
        i = i + 1;
    }
    if (idle_idx != DH_VOICE_NONE) {
        dh_voice_activate(self, idle_idx, note, velocity, channel);
        return idle_idx;
    }

    # No idle voice -- try stealing per the configured policy.
    var mode = DhVoiceManager_steal_mode(self);
    var steal_idx = DH_VOICE_NONE;

    if (mode == DH_STEAL_OLDEST) {
        # max_by_key(v.age): ties -> LAST element (Rust semantics). >= keeps last.
        if (n > 0) {
            steal_idx = 0;
            var best_age = DhVoice_age(vec_get(voices, 0));
            var j = 1;
            while (j < n) {
                var aj = DhVoice_age(vec_get(voices, j));
                if (aj >= best_age) { steal_idx = j; best_age = aj; }
                j = j + 1;
            }
        }
    } elif (mode == DH_STEAL_QUIETEST) {
        # min_by(envelope_level): ties -> FIRST element (Rust semantics). Strict
        # < keeps first. partial_cmp NaN -> Equal (treated as not-less, keep first).
        if (n > 0) {
            steal_idx = 0;
            var best_env = DhVoice_envelope_level(vec_get(voices, 0));
            var k = 1;
            while (k < n) {
                var ek = DhVoice_envelope_level(vec_get(voices, k));
                if (f64_lt(ek, best_env) == 1) { steal_idx = k; best_env = ek; }
                k = k + 1;
            }
        }
    } elif (mode == DH_STEAL_LOWEST) {
        # min_by_key(v.note): ties -> FIRST element (Rust semantics). Strict <.
        if (n > 0) {
            steal_idx = 0;
            var best_note = DhVoice_note(vec_get(voices, 0));
            var m = 1;
            while (m < n) {
                var nm = DhVoice_note(vec_get(voices, m));
                if (nm < best_note) { steal_idx = m; best_note = nm; }
                m = m + 1;
            }
        }
    } else {
        # DH_STEAL_NONE -- do not steal.
        steal_idx = DH_VOICE_NONE;
    }

    if (steal_idx != DH_VOICE_NONE) {
        dh_voice_activate(self, steal_idx, note, velocity, channel);
        return steal_idx;
    }
    return DH_VOICE_NONE;
}

# note_off -- release the first Active voice matching note+channel.
fn dhvani_voice_manager_note_off(self, note, channel) {
    var voices = DhVoiceManager_voices(self);
    var n = vec_len(voices);
    var i = 0;
    var done = 0;
    while (i < n) {
        if (done == 0) {
            var voice = vec_get(voices, i);
            if (DhVoice_state(voice) == DH_VOICE_STATE_ACTIVE) {
                if (DhVoice_note(voice) == note) {
                    if (DhVoice_channel(voice) == channel) {
                        DhVoice_set_state(voice, DH_VOICE_STATE_RELEASING);
                        done = 1;
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

# free_voice -- mark a slot idle (age reset). Out-of-range index is a no-op.
fn dhvani_voice_manager_free_voice(self, index) {
    var voices = DhVoiceManager_voices(self);
    if (index >= 0) {
        if (index < vec_len(voices)) {
            var voice = vec_get(voices, index);
            DhVoice_set_state(voice, DH_VOICE_STATE_IDLE);
            DhVoice_set_age(voice, 0);
        }
    }
    return 0;
}

# active_count -- number of non-idle voices.
#must_use
fn dhvani_voice_manager_active_count(self) {
    var voices = DhVoiceManager_voices(self);
    var n = vec_len(voices);
    var count = 0;
    var i = 0;
    while (i < n) {
        if (dhvani_voice_is_idle(vec_get(voices, i)) == 0) { count = count + 1; }
        i = i + 1;
    }
    return count;
}

# tick_age -- increment age of every active voice. Call once per process block.
fn dhvani_voice_manager_tick_age(self) {
    var voices = DhVoiceManager_voices(self);
    var n = vec_len(voices);
    var i = 0;
    while (i < n) {
        var voice = vec_get(voices, i);
        if (dhvani_voice_is_active(voice) == 1) {
            DhVoice_set_age(voice, DhVoice_age(voice) + 1);
        }
        i = i + 1;
    }
    return 0;
}

# reset -- return every slot to a fresh idle voice.
fn dhvani_voice_manager_reset(self) {
    var voices = DhVoiceManager_voices(self);
    var n = vec_len(voices);
    var i = 0;
    while (i < n) {
        var voice = vec_get(voices, i);
        DhVoice_set_state(voice, DH_VOICE_STATE_IDLE);
        DhVoice_set_note(voice, 0);
        DhVoice_set_velocity(voice, 0);
        DhVoice_set_channel(voice, 0);
        DhVoice_set_envelope_level(voice, 0);
        DhVoice_set_age(voice, 0);
        DhVoice_set_pitch_bend(voice, 0);
        DhVoice_set_pressure(voice, 0);
        DhVoice_set_brightness(voice, 0);
        i = i + 1;
    }
    return 0;
}

# voice -- borrow slot `index`, or 0 (null) if out of range.
#must_use
fn dhvani_voice_manager_voice(self, index) {
    var voices = DhVoiceManager_voices(self);
    if (index >= 0) {
        if (index < vec_len(voices)) { return vec_get(voices, index); }
    }
    return 0;
}

# voice_mut -- same as voice() (Cyrius handles are shared/mutable).
#must_use
fn dhvani_voice_manager_voice_mut(self, index) {
    return dhvani_voice_manager_voice(self, index);
}

# capacity -- number of voice slots.
#inline
#must_use
fn dhvani_voice_manager_capacity(self) { return DhVoiceManager_max_voices(self); }

# steal_mode -- current steal mode code.
#inline
#must_use
fn dhvani_voice_manager_steal_mode(self) { return DhVoiceManager_steal_mode(self); }

# --- capture.cyr ---

# capture.cyr -- capture/output configuration + device description + event enum.
# Ports rust-old/src/capture/mod.rs (the pure config surface). L1: dep error +
# buffer (DH_MAX_SAMPLE_RATE). The PipeWire backend (capture/pw) is
# platform-blocked and NOT ported; the lock-free record threads (capture/record,
# mpsc + thread::spawn) are single-threaded concerns dropped from this port.
#
# DeviceType (enum)      -> DH_DEVICE_* int codes.
# CaptureEvent (enum)    -> DH_CEVENT_* kind code + a fat struct (device / id).
# Option<u32> device_id  -> i64 sentinel: DH_CAPTURE_NO_DEVICE (-1) == None.
# validate()             -> shared DHVANI_ERR_* code (Rust had none; added per
#                           the port spec; 0 = "use device default" stays valid).
# serde + Display string tests dropped (no runtime representation to port).

# ---- DeviceType (was `enum DeviceType`) -> int codes ----
var DH_DEVICE_SOURCE = 0;   # audio input  (microphone, line-in, desktop capture)
var DH_DEVICE_SINK   = 1;   # audio output (speakers, headphones)

# Static name for a DeviceType code (diagnostics; Rust derived Debug only).
#must_use
fn dhvani_capture_device_type_name(kind) {
    if (kind == DH_DEVICE_SOURCE) { return "source"; }
    if (kind == DH_DEVICE_SINK)   { return "sink"; }
    return "unknown";
}

# ---- device_id sentinel (Option<u32>::None) ----
var DH_CAPTURE_NO_DEVICE = (0 - 1);   # None; any value >= 0 is Some(id)

# ---- AudioDevice (was `struct AudioDevice`) ----
# name is a string handle; device_type is a DH_DEVICE_* code.
#derive(accessors)
struct DhAudioDevice { id; name; device_type; channels; sample_rate; }

#must_use
fn dhvani_capture_device_new(id, name, device_type, channels, sample_rate) {
    var d = alloc(sizeof(DhAudioDevice));
    DhAudioDevice_set_id(d, id);
    DhAudioDevice_set_name(d, name);
    DhAudioDevice_set_device_type(d, device_type);
    DhAudioDevice_set_channels(d, channels);
    DhAudioDevice_set_sample_rate(d, sample_rate);
    return d;
}
#inline
#must_use
fn dhvani_capture_device_id(d) { return DhAudioDevice_id(d); }
#inline
#must_use
fn dhvani_capture_device_name(d) { return DhAudioDevice_name(d); }
#inline
#must_use
fn dhvani_capture_device_type(d) { return DhAudioDevice_device_type(d); }
#inline
#must_use
fn dhvani_capture_device_channels(d) { return DhAudioDevice_channels(d); }
#inline
#must_use
fn dhvani_capture_device_sample_rate(d) { return DhAudioDevice_sample_rate(d); }

# ---- CaptureConfig (was `struct CaptureConfig`) ----
# sample_rate 0 = device default; channels 0 = device default; device_id
# DH_CAPTURE_NO_DEVICE = None.
#derive(accessors)
struct DhCaptureConfig { sample_rate; channels; buffer_frames; device_id; }

#must_use
fn dhvani_capture_config_new(sample_rate, channels, buffer_frames, device_id) {
    var c = alloc(sizeof(DhCaptureConfig));
    DhCaptureConfig_set_sample_rate(c, sample_rate);
    DhCaptureConfig_set_channels(c, channels);
    DhCaptureConfig_set_buffer_frames(c, buffer_frames);
    DhCaptureConfig_set_device_id(c, device_id);
    return c;
}

# Default (impl Default): 48000 Hz, 2 ch, 1024 frames, no device.
#must_use
fn dhvani_capture_config_default() {
    return dhvani_capture_config_new(48000, 2, 1024, DH_CAPTURE_NO_DEVICE);
}

#inline
#must_use
fn dhvani_capture_config_sample_rate(c) { return DhCaptureConfig_sample_rate(c); }
#inline
#must_use
fn dhvani_capture_config_channels(c) { return DhCaptureConfig_channels(c); }
#inline
#must_use
fn dhvani_capture_config_buffer_frames(c) { return DhCaptureConfig_buffer_frames(c); }
#inline
#must_use
fn dhvani_capture_config_device_id(c) { return DhCaptureConfig_device_id(c); }

# 1 iff device_id is Some (>= 0), 0 iff None. Mirrors Option::is_some.
#must_use
fn dhvani_capture_config_has_device(c) {
    if (DhCaptureConfig_device_id(c) < 0) { return 0; }
    return 1;
}

# ---- OutputConfig (was `struct OutputConfig`) ----
# Same field set + defaults as CaptureConfig, kept a distinct type as in Rust.
#derive(accessors)
struct DhOutputConfig { sample_rate; channels; buffer_frames; device_id; }

#must_use
fn dhvani_capture_output_config_new(sample_rate, channels, buffer_frames, device_id) {
    var o = alloc(sizeof(DhOutputConfig));
    DhOutputConfig_set_sample_rate(o, sample_rate);
    DhOutputConfig_set_channels(o, channels);
    DhOutputConfig_set_buffer_frames(o, buffer_frames);
    DhOutputConfig_set_device_id(o, device_id);
    return o;
}

# Default (impl Default): 48000 Hz, 2 ch, 1024 frames, no device.
#must_use
fn dhvani_capture_output_config_default() {
    return dhvani_capture_output_config_new(48000, 2, 1024, DH_CAPTURE_NO_DEVICE);
}

#inline
#must_use
fn dhvani_capture_output_config_sample_rate(o) { return DhOutputConfig_sample_rate(o); }
#inline
#must_use
fn dhvani_capture_output_config_channels(o) { return DhOutputConfig_channels(o); }
#inline
#must_use
fn dhvani_capture_output_config_buffer_frames(o) { return DhOutputConfig_buffer_frames(o); }
#inline
#must_use
fn dhvani_capture_output_config_device_id(o) { return DhOutputConfig_device_id(o); }

#must_use
fn dhvani_capture_output_config_has_device(o) {
    if (DhOutputConfig_device_id(o) < 0) { return 0; }
    return 1;
}

# ---- validate (added per port spec; Rust had no validate) ----
# 0 = "use device default" stays valid; a nonzero sample rate must be in-range
# (<= DH_MAX_SAMPLE_RATE) and a nonzero buffer_frames must be nonzero. Returns a
# shared DHVANI_ERR_* code, DHVANI_ERR_NONE on success.
#must_use
fn dhvani_capture_config_validate(c) {
    var sr = DhCaptureConfig_sample_rate(c);
    if (sr > DH_MAX_SAMPLE_RATE) { return DHVANI_ERR_INVALID_SAMPLE_RATE; }
    return DHVANI_ERR_NONE;
}

#must_use
fn dhvani_capture_output_config_validate(o) {
    var osr = DhOutputConfig_sample_rate(o);
    if (osr > DH_MAX_SAMPLE_RATE) { return DHVANI_ERR_INVALID_SAMPLE_RATE; }
    return DHVANI_ERR_NONE;
}

# ---- CaptureEvent (was data-carrying `enum CaptureEvent`) ----
# kind code + a fat struct: DeviceAdded carries a DhAudioDevice handle (in
# `device`); DeviceRemoved carries a PipeWire id (in `id`); Overflow / Underrun
# carry nothing.
var DH_CEVENT_DEVICE_ADDED   = 0;
var DH_CEVENT_DEVICE_REMOVED = 1;
var DH_CEVENT_OVERFLOW       = 2;
var DH_CEVENT_UNDERRUN       = 3;

#derive(accessors)
struct DhCaptureEvent { kind; device; id; }

# DeviceAdded(device) -- carries the AudioDevice handle.
#must_use
fn dhvani_capture_event_device_added(device) {
    var e = alloc(sizeof(DhCaptureEvent));
    DhCaptureEvent_set_kind(e, DH_CEVENT_DEVICE_ADDED);
    DhCaptureEvent_set_device(e, device);
    DhCaptureEvent_set_id(e, 0);
    return e;
}

# DeviceRemoved { id } -- carries the removed PipeWire id.
#must_use
fn dhvani_capture_event_device_removed(id) {
    var e = alloc(sizeof(DhCaptureEvent));
    DhCaptureEvent_set_kind(e, DH_CEVENT_DEVICE_REMOVED);
    DhCaptureEvent_set_device(e, 0);
    DhCaptureEvent_set_id(e, id);
    return e;
}

# Overflow -- capture buffer overflow (data lost).
#must_use
fn dhvani_capture_event_overflow() {
    var e = alloc(sizeof(DhCaptureEvent));
    DhCaptureEvent_set_kind(e, DH_CEVENT_OVERFLOW);
    DhCaptureEvent_set_device(e, 0);
    DhCaptureEvent_set_id(e, 0);
    return e;
}

# Underrun -- output buffer underrun (silence inserted).
#must_use
fn dhvani_capture_event_underrun() {
    var e = alloc(sizeof(DhCaptureEvent));
    DhCaptureEvent_set_kind(e, DH_CEVENT_UNDERRUN);
    DhCaptureEvent_set_device(e, 0);
    DhCaptureEvent_set_id(e, 0);
    return e;
}

#inline
#must_use
fn dhvani_capture_event_kind(e) { return DhCaptureEvent_kind(e); }
#inline
#must_use
fn dhvani_capture_event_device(e) { return DhCaptureEvent_device(e); }
#inline
#must_use
fn dhvani_capture_event_id(e) { return DhCaptureEvent_id(e); }

# --- record.cyr ---

# record.cyr -- ring-buffer / accumulator recording.
# Ports rust-old/src/capture/record.rs. L1: dep error only (+ stdlib vec).
#
# The Rust original is a lock-free RT->accumulator pipeline: the RT thread
# push()es interleaved f32 chunks into a bounded mpsc channel, a background
# thread drains them into a Vec (or a Vec<Vec> of takes for loop recording),
# and finish() joins and returns. The Cyrius port is SINGLE-THREADED, so the
# channel + accumulator thread collapse into direct in-place accumulation:
# push_samples() appends straight into the owned vec, finish() returns it.
#
# `channel_bound` (backpressure knob) is retained for fidelity but never drops
# in a single-threaded model -- there is no queue to overflow -- so
# dropped_samples stays 0 (matching every Rust test). f32 samples -> f64 slots.
# serde + Display dropped. mode/RecordingMode enum -> integer codes.

# ---- RecordingMode (was enum) ----
var DH_RECORDING_MODE_NORMAL  = 0;   # linear recording
var DH_RECORDING_MODE_OVERDUB = 1;   # layer on top of existing takes
var DH_RECORDING_MODE_REPLACE = 2;   # overwrite per loop iteration

# Maximum accumulator size (~500 MB of f32 samples in the Rust original).
var DH_MAX_ACCUMULATOR_SAMPLES = 125000000;

# ================================================================
# RecordManager -- flat accumulator: every pushed chunk is appended into one
# growing vec, capped at DH_MAX_ACCUMULATOR_SAMPLES.
# ================================================================
#derive(accessors)
struct DhRecordManager { accumulated; channel_bound; dropped_samples; }

# new(channel_bound) -- channel_bound.max(1) preserved for fidelity.
#must_use
fn dhvani_record_new(channel_bound) {
    var bound = channel_bound;
    if (bound < 1) { bound = 1; }
    var self = alloc(sizeof(DhRecordManager));
    DhRecordManager_set_accumulated(self, vec_new());
    DhRecordManager_set_channel_bound(self, bound);
    DhRecordManager_set_dropped_samples(self, 0);
    return self;
}

# push_samples(data) -- append the chunk unless it would exceed the cap.
# Single-threaded: no backpressure, so nothing is dropped here.
fn dhvani_record_push_samples(self, data) {
    var acc = DhRecordManager_accumulated(self);
    var acc_len = vec_len(acc);
    var chunk_len = vec_len(data);
    if ((acc_len + chunk_len) <= DH_MAX_ACCUMULATOR_SAMPLES) {
        var i = 0;
        while (i < chunk_len) {
            vec_push(acc, vec_get(data, i));
            i = i + 1;
        }
    }
    return 0;
}

# dropped_samples -- count dropped due to backpressure (always 0 here).
#inline
#must_use
fn dhvani_record_dropped_samples(self) {
    return DhRecordManager_dropped_samples(self);
}

# finish -- return all accumulated samples.
#must_use
fn dhvani_record_finish(self) {
    return DhRecordManager_accumulated(self);
}

# ================================================================
# LoopRecordManager -- loop-aware: takes is a vec of vecs (one per loop
# iteration), seeded with a single empty take. Samples append to the last
# take; a loop marker starts a fresh empty take.
# ================================================================
#derive(accessors)
struct DhLoopRecordManager { takes; channel_bound; mode; dropped_samples; }

# new(channel_bound, mode) -- starts with one empty take.
#must_use
fn dhvani_record_loop_new(channel_bound, mode) {
    var bound = channel_bound;
    if (bound < 1) { bound = 1; }
    var takes = vec_new();
    vec_push(takes, vec_new());
    var self = alloc(sizeof(DhLoopRecordManager));
    DhLoopRecordManager_set_takes(self, takes);
    DhLoopRecordManager_set_channel_bound(self, bound);
    DhLoopRecordManager_set_mode(self, mode);
    DhLoopRecordManager_set_dropped_samples(self, 0);
    return self;
}

# mode -- current recording mode code.
#inline
#must_use
fn dhvani_record_loop_mode(self) {
    return DhLoopRecordManager_mode(self);
}

# push_samples(data) -- append into the current (last) take unless capped.
fn dhvani_record_loop_push_samples(self, data) {
    var takes = DhLoopRecordManager_takes(self);
    var n = vec_len(takes);
    if (n > 0) {
        var current = vec_get(takes, n - 1);
        var cur_len = vec_len(current);
        var chunk_len = vec_len(data);
        if ((cur_len + chunk_len) <= DH_MAX_ACCUMULATOR_SAMPLES) {
            var i = 0;
            while (i < chunk_len) {
                vec_push(current, vec_get(data, i));
                i = i + 1;
            }
        }
    }
    return 0;
}

# push_loop_marker -- start a new empty take.
fn dhvani_record_loop_push_marker(self) {
    vec_push(DhLoopRecordManager_takes(self), vec_new());
    return 0;
}

# dropped_samples -- always 0 in the single-threaded port.
#inline
#must_use
fn dhvani_record_loop_dropped_samples(self) {
    return DhLoopRecordManager_dropped_samples(self);
}

# finish -- return all takes (each inner vec is one loop iteration; empties kept).
#must_use
fn dhvani_record_loop_finish(self) {
    return DhLoopRecordManager_takes(self);
}

# --- buffer.cyr ---

# buffer.cyr -- AudioBuffer: unified f64 sample buffers + mixing, resampling,
# and a reusable BufferPool. Ports rust-old/src/buffer/mod.rs.
# L1: depends on error.cyr + simd.cyr (peak/rms/gain/clamp/mix kernels).
#
# samples: a `vec` of f64 (was Vec<f32>). channels/sample_rate/frames: integer
# counts. SampleFormat/Layout enums -> integer codes. Fallible constructors
# (from_interleaved/mix/resample_linear return Result) -> a valid handle, or 0
# (null) on error. serde dropped. AudioBufferRef (borrowed view) is deferred --
# in Cyrius a "ref" is the same handle read via accessors; add when a consumer
# needs the distinct type.

# ---- SampleFormat (was enum) ----
var DH_FMT_F32 = 0;
var DH_FMT_I16 = 1;
var DH_FMT_I32 = 2;
var DH_FMT_I24 = 3;
var DH_FMT_F64 = 4;
var DH_FMT_U8  = 5;

# ---- Layout (was enum) ----
var DH_LAYOUT_INTERLEAVED = 0;
var DH_LAYOUT_PLANAR      = 1;

var DH_MAX_SAMPLE_RATE = 768000;

# bytes_per_sample for a SampleFormat code.
#must_use
fn dhvani_format_bytes_per_sample(fmt) {
    if (fmt == DH_FMT_F32) { return 4; }
    if (fmt == DH_FMT_I16) { return 2; }
    if (fmt == DH_FMT_I32) { return 4; }
    if (fmt == DH_FMT_I24) { return 3; }
    if (fmt == DH_FMT_F64) { return 8; }
    if (fmt == DH_FMT_U8)  { return 1; }
    return 0;
}

# Display name for a SampleFormat code (was impl Display).
#must_use
fn dhvani_format_name(fmt) {
    if (fmt == DH_FMT_F32) { return "f32"; }
    if (fmt == DH_FMT_I16) { return "i16"; }
    if (fmt == DH_FMT_I32) { return "i32"; }
    if (fmt == DH_FMT_I24) { return "i24"; }
    if (fmt == DH_FMT_F64) { return "f64"; }
    if (fmt == DH_FMT_U8)  { return "u8"; }
    return "unknown";
}

# build a `vec` of n zeros (was vec![0.0; n]).
#must_use
fn dh_vec_zeros(n) {
    var v = vec_new();
    var i = 0;
    while (i < n) { vec_push(v, 0); i = i + 1; }
    return v;
}

#derive(accessors)
struct DhAudioBuffer { samples; channels; sample_rate; frames; }

# from_interleaved(samples, channels, sample_rate) -> buffer handle, or 0 on
# error (0 channels, bad sample rate, or length not divisible by channels).
#must_use
fn dhvani_buffer_from_interleaved(samples, channels, sample_rate) {
    if (channels == 0) { return 0; }
    if (sample_rate == 0) { return 0; }
    if (sample_rate > DH_MAX_SAMPLE_RATE) { return 0; }
    var len = vec_len(samples);
    if (len > 0) {
        if ((len % channels) > 0) { return 0; }
    }
    var self = alloc(sizeof(DhAudioBuffer));
    DhAudioBuffer_set_samples(self, samples);
    DhAudioBuffer_set_channels(self, channels);
    DhAudioBuffer_set_sample_rate(self, sample_rate);
    DhAudioBuffer_set_frames(self, len / channels);
    return self;
}

# silence(channels, frames, sample_rate) -- a zero-filled buffer.
#must_use
fn dhvani_buffer_silence(channels, frames, sample_rate) {
    var self = alloc(sizeof(DhAudioBuffer));
    DhAudioBuffer_set_samples(self, dh_vec_zeros(channels * frames));
    DhAudioBuffer_set_channels(self, channels);
    DhAudioBuffer_set_sample_rate(self, sample_rate);
    DhAudioBuffer_set_frames(self, frames);
    return self;
}

# --- accessors ---
#inline
#must_use
fn dhvani_buffer_samples(self) { return DhAudioBuffer_samples(self); }
#inline
#must_use
fn dhvani_buffer_channels(self) { return DhAudioBuffer_channels(self); }
#inline
#must_use
fn dhvani_buffer_sample_rate(self) { return DhAudioBuffer_sample_rate(self); }
#inline
#must_use
fn dhvani_buffer_frames(self) { return DhAudioBuffer_frames(self); }
#inline
#must_use
fn dhvani_buffer_total_samples(self) { return vec_len(DhAudioBuffer_samples(self)); }

# duration in seconds.
#inline
#must_use
fn dhvani_buffer_duration_secs(self) {
    return f64_div(f64_from(DhAudioBuffer_frames(self)),
                   f64_from(DhAudioBuffer_sample_rate(self)));
}

# peak amplitude across all channels.
#must_use
fn dhvani_buffer_peak(self) {
    return dhvani_simd_peak_abs(DhAudioBuffer_samples(self));
}

# RMS level (0.0 for an empty buffer).
#must_use
fn dhvani_buffer_rms(self) {
    var samples = DhAudioBuffer_samples(self);
    var len = vec_len(samples);
    if (len == 0) { return 0; }
    return f64_sqrt(f64_div(dhvani_simd_sum_of_squares(samples), f64_from(len)));
}

# multiply all samples by gain.
fn dhvani_buffer_apply_gain(self, gain) {
    dhvani_simd_apply_gain(DhAudioBuffer_samples(self), gain);
    return 0;
}

# clamp all samples to [-1.0, 1.0].
fn dhvani_buffer_clamp(self) {
    dhvani_simd_clamp(DhAudioBuffer_samples(self), DH_NEG_ONE, 1.0);
    return 0;
}

# deep-copy a buffer (was #[derive(Clone)]).
#must_use
fn dhvani_buffer_clone(self) {
    var src = DhAudioBuffer_samples(self);
    var len = vec_len(src);
    var dst = vec_new();
    var i = 0;
    while (i < len) { vec_push(dst, vec_get(src, i)); i = i + 1; }
    var b = alloc(sizeof(DhAudioBuffer));
    DhAudioBuffer_set_samples(b, dst);
    DhAudioBuffer_set_channels(b, DhAudioBuffer_channels(self));
    DhAudioBuffer_set_sample_rate(b, DhAudioBuffer_sample_rate(self));
    DhAudioBuffer_set_frames(b, DhAudioBuffer_frames(self));
    return b;
}

# mix(buffers) -- sum a `vec` of buffer handles (same channels + sample rate).
# Empty -> a silent stereo buffer; channel/rate mismatch -> 0.
#must_use
fn dhvani_buffer_mix(buffers) {
    var n = vec_len(buffers);
    if (n == 0) { return dhvani_buffer_silence(2, 0, 44100); }
    var first = vec_get(buffers, 0);
    var channels = DhAudioBuffer_channels(first);
    var sample_rate = DhAudioBuffer_sample_rate(first);
    var max_frames = 0;
    var i = 0;
    while (i < n) {
        var b = vec_get(buffers, i);
        var bch = DhAudioBuffer_channels(b);
        if (bch < channels) { return 0; }
        if (bch > channels) { return 0; }
        var bsr = DhAudioBuffer_sample_rate(b);
        if (bsr < sample_rate) { return 0; }
        if (bsr > sample_rate) { return 0; }
        var bf = DhAudioBuffer_frames(b);
        if (bf > max_frames) { max_frames = bf; }
        i = i + 1;
    }
    var mixed = dh_vec_zeros(max_frames * channels);
    var j = 0;
    while (j < n) {
        dhvani_simd_add_buffers(mixed, DhAudioBuffer_samples(vec_get(buffers, j)));
        j = j + 1;
    }
    var out = alloc(sizeof(DhAudioBuffer));
    DhAudioBuffer_set_samples(out, mixed);
    DhAudioBuffer_set_channels(out, channels);
    DhAudioBuffer_set_sample_rate(out, sample_rate);
    DhAudioBuffer_set_frames(out, max_frames);
    return out;
}

# resample_linear(buf, target_rate) -- linear-interpolated rate conversion.
# Bad rate -> 0; same rate -> clone; empty -> silence.
#must_use
fn dhvani_buffer_resample_linear(buf, target_rate) {
    if (target_rate == 0) { return 0; }
    if (target_rate > DH_MAX_SAMPLE_RATE) { return 0; }
    var src_rate = DhAudioBuffer_sample_rate(buf);
    if (target_rate == src_rate) { return dhvani_buffer_clone(buf); }
    var frames = DhAudioBuffer_frames(buf);
    var ch = DhAudioBuffer_channels(buf);
    if (frames == 0) { return dhvani_buffer_silence(ch, 0, target_rate); }
    var ratio = f64_div(f64_from(target_rate), f64_from(src_rate));
    var new_frames = f64_to(f64_ceil(f64_mul(f64_from(frames), ratio)));
    var src = DhAudioBuffer_samples(buf);
    var src_len = vec_len(src);
    var out = dh_vec_zeros(new_frames * ch);
    var frame = 0;
    while (frame < new_frames) {
        var src_pos = f64_div(f64_from(frame), ratio);
        var src_frame = f64_to(f64_floor(src_pos));
        var frac = f64_sub(src_pos, f64_from(src_frame));
        var c = 0;
        while (c < ch) {
            var i0 = src_frame * ch + c;
            var nxt = src_frame + 1;
            if (nxt > frames - 1) { nxt = frames - 1; }
            var i1 = nxt * ch + c;
            var s0 = 0;
            if (i0 < src_len) { s0 = vec_get(src, i0); }
            var s1 = 0;
            if (i1 < src_len) { s1 = vec_get(src, i1); }
            vec_set(out, frame * ch + c, f64_add(s0, f64_mul(frac, f64_sub(s1, s0))));
            c = c + 1;
        }
        frame = frame + 1;
    }
    var ob = alloc(sizeof(DhAudioBuffer));
    DhAudioBuffer_set_samples(ob, out);
    DhAudioBuffer_set_channels(ob, ch);
    DhAudioBuffer_set_sample_rate(ob, target_rate);
    DhAudioBuffer_set_frames(ob, new_frames);
    return ob;
}

# ---- BufferPool: reuse buffers to avoid per-cycle allocation ----
#derive(accessors)
struct DhBufferPool { buffers; channels; frames; sample_rate; }

# new(capacity, channels, frames, sample_rate) -- pool of `capacity` silent buffers.
#must_use
fn dhvani_pool_new(capacity, channels, frames, sample_rate) {
    var buffers = vec_new();
    var i = 0;
    while (i < capacity) {
        vec_push(buffers, dhvani_buffer_silence(channels, frames, sample_rate));
        i = i + 1;
    }
    var self = alloc(sizeof(DhBufferPool));
    DhBufferPool_set_buffers(self, buffers);
    DhBufferPool_set_channels(self, channels);
    DhBufferPool_set_frames(self, frames);
    DhBufferPool_set_sample_rate(self, sample_rate);
    return self;
}

# acquire -- pop a buffer, or allocate a fresh silent one if the pool is empty.
#must_use
fn dhvani_pool_acquire(self) {
    var buffers = DhBufferPool_buffers(self);
    if (vec_len(buffers) > 0) { return vec_pop(buffers); }
    return dhvani_buffer_silence(DhBufferPool_channels(self),
                                 DhBufferPool_frames(self),
                                 DhBufferPool_sample_rate(self));
}

# release -- silence a buffer and return it to the pool.
fn dhvani_pool_release(self, buf) {
    var samples = DhAudioBuffer_samples(buf);
    var len = vec_len(samples);
    var i = 0;
    while (i < len) { vec_set(samples, i, 0); i = i + 1; }
    vec_push(DhBufferPool_buffers(self), buf);
    return 0;
}

# number of buffers currently available.
#inline
#must_use
fn dhvani_pool_available(self) {
    return vec_len(DhBufferPool_buffers(self));
}

# --- convert.cyr ---

# convert.cyr -- format, layout, and channel-mapping conversion.
# Ports rust-old/src/buffer/convert.rs. L2: depends on error + simd (dh_imin,
# dh_sext24, DH_NEG_ONE) + buffer (AudioBuffer, from_interleaved).
#
# The i16/i24/u8 <-> f32 converters that Rust's convert.rs delegated to `simd`
# are NOT re-wrapped here -- call dhvani_simd_{i16,i24,u8}_* directly. This
# module adds i32<->f32, i24-packed, f64<->f32, planar<->interleaved, channel
# up/down-mix, and 5.1 downmix.
#
# Same-size sample converters take a caller-provided out `vec` (alloc-free);
# size-changing ops (packed, planar, channel maps) return a fresh vec/buffer.

var DH_FRAC_1_SQRT_2 = F64_FRAC_1_SQRT2;   # 1/sqrt(2), ITU downmix coeff (exact-hex stdlib const)

# ---- i32 <-> f32 (same size, caller-out) ----

# i32_to_f32(src, dst) -- src[i] / 2^31.
fn dhvani_convert_i32_to_f32(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var i = 0;
    while (i < len) {
        vec_set(dst, i, f64_div(f64_from(vec_get(src, i)), f64_from(2147483648)));
        i = i + 1;
    }
    return 0;
}

# f32_to_i32(src, dst) -- (clamp(src,-1,1) * (2^31 - 1)) truncated to i32.
fn dhvani_convert_f32_to_i32(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var i = 0;
    while (i < len) {
        var c = f64_clamp(vec_get(src, i), DH_NEG_ONE, 1.0);
        vec_set(dst, i, f64_to(f64_trunc(f64_mul(c, f64_from(2147483647)))));
        i = i + 1;
    }
    return 0;
}

# ---- f64 <-> f32 (identity in the all-f64 port; kept for API parity) ----
fn dhvani_convert_f64_to_f32(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var i = 0;
    while (i < len) { vec_set(dst, i, vec_get(src, i)); i = i + 1; }
    return 0;
}
fn dhvani_convert_f32_to_f64(src, dst) {
    var len = dh_imin(vec_len(src), vec_len(dst));
    var i = 0;
    while (i < len) { vec_set(dst, i, vec_get(src, i)); i = i + 1; }
    return 0;
}

# ---- 24-bit packed bytes <-> f32 (3 bytes/sample, little-endian) ----

# i24_packed_to_f32(bytes) -> fresh vec of len(bytes)/3 samples.
#must_use
fn dhvani_convert_i24_packed_to_f32(bytes) {
    var n = vec_len(bytes) / 3;
    var dst = vec_new();
    var i = 0;
    while (i < n) {
        var b0 = vec_get(bytes, i * 3);
        var b1 = vec_get(bytes, i * 3 + 1);
        var b2 = vec_get(bytes, i * 3 + 2);
        var raw = b0 | (b1 << 8) | (b2 << 16);
        vec_push(dst, f64_div(f64_from(dh_sext24(raw)), 8388608.0));
        i = i + 1;
    }
    return dst;
}

# f32_to_i24_packed(samples) -> fresh vec of len*3 bytes.
#must_use
fn dhvani_convert_f32_to_i24_packed(samples) {
    var out = vec_new();
    var len = vec_len(samples);
    var i = 0;
    while (i < len) {
        var c = f64_clamp(vec_get(samples, i), DH_NEG_ONE, 1.0);
        var val = f64_to(f64_trunc(f64_mul(c, 8388607.0)));
        vec_push(out, val & 0xFF);
        vec_push(out, (val >> 8) & 0xFF);
        vec_push(out, (val >> 16) & 0xFF);
        i = i + 1;
    }
    return out;
}

# ---- layout: interleaved <-> planar ----

# interleaved_to_planar(buf) -> a vec of `channels` plane vecs.
#must_use
fn dhvani_convert_interleaved_to_planar(buf) {
    var ch = DhAudioBuffer_channels(buf);
    var frames = DhAudioBuffer_frames(buf);
    var samples = DhAudioBuffer_samples(buf);
    var planes = vec_new();
    var c = 0;
    while (c < ch) { vec_push(planes, vec_new()); c = c + 1; }
    var frame = 0;
    while (frame < frames) {
        var cc = 0;
        while (cc < ch) {
            vec_push(vec_get(planes, cc), vec_get(samples, frame * ch + cc));
            cc = cc + 1;
        }
        frame = frame + 1;
    }
    return planes;
}

# planar_to_interleaved(channels, sample_rate) -> buffer, or 0 on empty /
# length-mismatch.
#must_use
fn dhvani_convert_planar_to_interleaved(channels, sample_rate) {
    var ch_count = vec_len(channels);
    if (ch_count == 0) { return 0; }
    var frames = vec_len(vec_get(channels, 0));
    var i = 0;
    while (i < ch_count) {
        if (vec_len(vec_get(channels, i)) != frames) { return 0; }
        i = i + 1;
    }
    var samples = vec_new();
    var frame = 0;
    while (frame < frames) {
        var c = 0;
        while (c < ch_count) {
            vec_push(samples, vec_get(vec_get(channels, c), frame));
            c = c + 1;
        }
        frame = frame + 1;
    }
    return dhvani_buffer_from_interleaved(samples, ch_count, sample_rate);
}

# ---- channel maps ----

# mono_to_stereo(buf) -- duplicate the single channel; 0 if not mono.
#must_use
fn dhvani_convert_mono_to_stereo(buf) {
    if (DhAudioBuffer_channels(buf) != 1) { return 0; }
    var src = DhAudioBuffer_samples(buf);
    var len = vec_len(src);
    var out = vec_new();
    var i = 0;
    while (i < len) {
        var s = vec_get(src, i);
        vec_push(out, s);
        vec_push(out, s);
        i = i + 1;
    }
    return dhvani_buffer_from_interleaved(out, 2, DhAudioBuffer_sample_rate(buf));
}

# stereo_to_mono(buf) -- average L and R; 0 if not stereo.
#must_use
fn dhvani_convert_stereo_to_mono(buf) {
    if (DhAudioBuffer_channels(buf) != 2) { return 0; }
    var src = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    var out = vec_new();
    var frame = 0;
    while (frame < frames) {
        var l = vec_get(src, frame * 2);
        var r = vec_get(src, frame * 2 + 1);
        vec_push(out, f64_mul(f64_add(l, r), 0.5));
        frame = frame + 1;
    }
    return dhvani_buffer_from_interleaved(out, 1, DhAudioBuffer_sample_rate(buf));
}

# downmix_5_1_to_stereo(buf) -- ITU-R BS.775 (L,R,C,LFE,Ls,Rs); LFE dropped.
# 0 if not 6 channels.
#must_use
fn dhvani_convert_downmix_5_1_to_stereo(buf) {
    if (DhAudioBuffer_channels(buf) != 6) { return 0; }
    var src = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    var out = vec_new();
    var frame = 0;
    while (frame < frames) {
        var base = frame * 6;
        var l = vec_get(src, base);
        var r = vec_get(src, base + 1);
        var c = vec_get(src, base + 2);
        var ls = vec_get(src, base + 4);
        var rs = vec_get(src, base + 5);
        var lo = f64_add(f64_add(l, f64_mul(DH_FRAC_1_SQRT_2, c)), f64_mul(DH_FRAC_1_SQRT_2, ls));
        var ro = f64_add(f64_add(r, f64_mul(DH_FRAC_1_SQRT_2, c)), f64_mul(DH_FRAC_1_SQRT_2, rs));
        vec_push(out, lo);
        vec_push(out, ro);
        frame = frame + 1;
    }
    return dhvani_buffer_from_interleaved(out, 2, DhAudioBuffer_sample_rate(buf));
}

# --- dither.cyr ---

# dither.cyr -- dithering for bit-depth reduction. Ports rust-old/src/buffer/dither.rs.
# L1, self-contained. TPDF (triangular PDF, flat noise) and noise-shaped (first-
# order error feedback). Rust returned a fresh Vec<f32>; the Cyrius port writes
# into a caller-provided output `vec` (alloc-free under the bump allocator).
#
# RNG: xorshift32 with u32 wrapping. Cyrius is i64-only, so every shift result is
# masked to 32 bits (& 0xFFFFFFFF) or the sequence diverges. u32::MAX = 4294967295.

# u32::MAX = 4294967295 (RNG normalization divisor). Stored as an integer and
# converted with f64_from at use -- a decimal literal >= ~2^24 misparses.
var DH_U32_MAX = 4294967295;

# xorshift32 step: advance a 32-bit state, return the next value.
#must_use
fn dh_xorshift32_next(s) {
    s = (s ^ ((s << 13) & 0xFFFFFFFF)) & 0xFFFFFFFF;
    s = (s ^ (s >> 17)) & 0xFFFFFFFF;
    s = (s ^ ((s << 5) & 0xFFFFFFFF)) & 0xFFFFFFFF;
    return s;
}

# one uniform sample in [-1, 1): (state / u32::MAX) * 2 - 1.
#must_use
fn dh_rng_bipolar(state) {
    return f64_sub(f64_mul(f64_div(f64_from(state), f64_from(DH_U32_MAX)), 2.0), 1.0);
}

# tpdf_dither(samples, out, target_bits) -- fill `out` (same length as samples)
# with TPDF-dithered samples. Returns 0.
fn dhvani_dither_tpdf(samples, out, target_bits) {
    var lsb = 1 << (target_bits - 1);
    var quant_step = f64_div(1.0, f64_from(lsb));
    var rng = 0x12345678;
    var len = vec_len(samples);
    var i = 0;
    while (i < len) {
        rng = dh_xorshift32_next(rng);
        var r1 = dh_rng_bipolar(rng);
        rng = dh_xorshift32_next(rng);
        var r2 = dh_rng_bipolar(rng);
        var dither = f64_mul(f64_mul(f64_add(r1, r2), 0.5), quant_step);
        vec_set(out, i, f64_add(vec_get(samples, i), dither));
        i = i + 1;
    }
    return 0;
}

# noise_shaped_dither(samples, out, target_bits) -- first-order error-feedback
# dither into `out`. Returns 0.
fn dhvani_dither_noise_shaped(samples, out, target_bits) {
    var lsb = 1 << (target_bits - 1);
    var quant_step = f64_div(1.0, f64_from(lsb));
    var rng = 0x12345678;
    var error = 0;             # +0.0
    var len = vec_len(samples);
    var i = 0;
    while (i < len) {
        var shaped = f64_sub(vec_get(samples, i), error);
        rng = dh_xorshift32_next(rng);
        var r1 = dh_rng_bipolar(rng);
        rng = dh_xorshift32_next(rng);
        var r2 = dh_rng_bipolar(rng);
        var dither = f64_mul(f64_mul(f64_add(r1, r2), 0.5), quant_step);
        var dithered = f64_add(shaped, dither);
        var quantized = f64_mul(f64_round(f64_div(dithered, quant_step)), quant_step);
        error = f64_sub(quantized, shaped);
        vec_set(out, i, quantized);
        i = i + 1;
    }
    return 0;
}

# --- resample.cyr ---

# resample.cyr -- windowed-sinc resampling with configurable quality.
# Ports rust-old/src/buffer/resample.rs (scalar path; the SIMD weighted_sum
# path is dropped -- platform-blocked). L1: depends on error + buffer.
# ResampleQuality enum -> codes. serde dropped. Result -> null-handle sentinel.

# Exact-hex stdlib constants (a long decimal literal loses precision vs the oracle).
var DH_PI  = F64_PI;
var DH_TAU = F64_TAU;

# ResampleQuality (kernel half-width in samples).
var DH_RESAMPLE_DRAFT = 0;   # 4-point  (half-width 2)
var DH_RESAMPLE_GOOD  = 1;   # 16-point (half-width 8)
var DH_RESAMPLE_BEST  = 2;   # 64-point (half-width 32)

#must_use
fn dhvani_resample_kernel_half_width(quality) {
    if (quality == DH_RESAMPLE_DRAFT) { return 2; }
    if (quality == DH_RESAMPLE_GOOD)  { return 8; }
    if (quality == DH_RESAMPLE_BEST)  { return 32; }
    return 8;
}

# windowed_sinc(x, half_width) -- sinc * Blackman-Harris window.
#must_use
fn dhvani_resample_windowed_sinc(x, half_width) {
    var ax = f64_abs(x);
    if (f64_lt(ax, 0.0000000001) == 1) { return 1.0; }   # |x| < 1e-10 -> 1.0
    var pix = f64_mul(DH_PI, x);
    var sinc = f64_div(f64_sin(pix), pix);
    if (f64_gt(ax, half_width) == 1) { return 0; }        # outside window -> 0
    var t = f64_mul(f64_add(f64_div(x, half_width), 1.0), 0.5);
    var tau_t = f64_mul(DH_TAU, t);
    var window = f64_sub(
        f64_add(
            f64_sub(0.35875, f64_mul(0.48829, f64_cos(tau_t))),
            f64_mul(0.14128, f64_cos(f64_mul(2.0, tau_t)))
        ),
        f64_mul(0.01168, f64_cos(f64_mul(3.0, tau_t))));
    return f64_mul(sinc, window);
}

# resample_sinc(buf, target_rate, quality) -- buffer handle, or 0 on rate==0.
# same rate -> clone; empty -> silence.
#must_use
fn dhvani_resample_sinc(buf, target_rate, quality) {
    if (target_rate == 0) { return 0; }
    var src_rate = DhAudioBuffer_sample_rate(buf);
    if (target_rate == src_rate) { return dhvani_buffer_clone(buf); }
    var frames = DhAudioBuffer_frames(buf);
    var ch = DhAudioBuffer_channels(buf);
    if (frames == 0) { return dhvani_buffer_silence(ch, 0, target_rate); }

    var ratio = f64_div(f64_from(target_rate), f64_from(src_rate));
    var new_frames = f64_to(f64_ceil(f64_mul(f64_from(frames), ratio)));
    var half_width = dhvani_resample_kernel_half_width(quality);
    # downsampling scales the kernel to avoid aliasing.
    var filter_scale = 1.0;
    var kernel_scale = 1.0;
    if (f64_lt(ratio, 1.0) == 1) {
        filter_scale = ratio;
        kernel_scale = ratio;
    }
    var src = DhAudioBuffer_samples(buf);
    var out = dh_vec_zeros(new_frames * ch);
    var frame = 0;
    while (frame < new_frames) {
        var src_pos = f64_div(f64_from(frame), ratio);
        var src_center = f64_to(f64_floor(src_pos));
        var frac = f64_sub(src_pos, f64_from(src_center));
        var scaled_half = f64_to(f64_ceil(f64_div(f64_from(half_width), filter_scale)));
        var c = 0;
        while (c < ch) {
            var sum = 0;
            var weight_sum = 0;
            var i = 0 - scaled_half;
            while (i <= scaled_half) {
                var src_idx = src_center + i;
                if (src_idx >= 0) {
                    if (src_idx < frames) {
                        var x = f64_mul(f64_sub(f64_from(i), frac), kernel_scale);
                        var w = dhvani_resample_windowed_sinc(x, f64_from(scaled_half));
                        sum = f64_add(sum, f64_mul(vec_get(src, src_idx * ch + c), w));
                        weight_sum = f64_add(weight_sum, w);
                    }
                }
                i = i + 1;
            }
            if (f64_gt(f64_abs(weight_sum), 0.0000000001) == 1) {
                vec_set(out, frame * ch + c, f64_div(sum, weight_sum));
            }
            c = c + 1;
        }
        frame = frame + 1;
    }
    var ob = alloc(sizeof(DhAudioBuffer));
    DhAudioBuffer_set_samples(ob, out);
    DhAudioBuffer_set_channels(ob, ch);
    DhAudioBuffer_set_sample_rate(ob, target_rate);
    DhAudioBuffer_set_frames(ob, new_frames);
    return ob;
}

# --- waveform.cyr ---

# waveform.cyr -- downsampled peak data for visualization.
# Ports rust-old/src/analysis/waveform.rs. L0: deps error + buffer.
# WaveformData: channels[ch] = a flat vec of (min,max) pairs interleaved
# (min at 2i, max at 2i+1) -- Vec<Vec<(f32,f32)>> flattened per channel.

#derive(accessors)
struct DhWaveformData { channels; peaks_per_second; sample_rate; }

#must_use
fn dhvani_waveform_num_peaks(self) {
    var channels = DhWaveformData_channels(self);
    if (vec_len(channels) == 0) { return 0; }
    return vec_len(vec_get(channels, 0)) / 2;
}
#inline
#must_use
fn dhvani_waveform_num_channels(self) { return vec_len(DhWaveformData_channels(self)); }
#must_use
fn dhvani_waveform_duration_secs(self) {
    var pps = DhWaveformData_peaks_per_second(self);
    if (pps == 0) { return 0; }
    return f64_div(f64_from(dhvani_waveform_num_peaks(self)), f64_from(pps));
}
# (min,max) of peak i on channel c.
#must_use
fn dhvani_waveform_min(self, c, i) { return vec_get(vec_get(DhWaveformData_channels(self), c), i * 2); }
#must_use
fn dhvani_waveform_max(self, c, i) { return vec_get(vec_get(DhWaveformData_channels(self), c), i * 2 + 1); }

# compute_waveform(buf, peaks_per_second) -- (min,max) per time window per channel.
#must_use
fn dhvani_waveform_compute(buf, peaks_per_second) {
    var pps = peaks_per_second;
    if (pps < 1) { pps = 1; }
    var ch = DhAudioBuffer_channels(buf);
    var frames = DhAudioBuffer_frames(buf);
    var samples = DhAudioBuffer_samples(buf);
    var spp = f64_to(f64_ceil(f64_div(f64_from(DhAudioBuffer_sample_rate(buf)), f64_from(pps))));
    if (spp < 1) { spp = 1; }
    var num_peaks = (frames + spp - 1) / spp;   # div_ceil
    var channels = vec_new();
    var c0 = 0;
    while (c0 < ch) { vec_push(channels, vec_new()); c0 = c0 + 1; }
    var peak_idx = 0;
    while (peak_idx < num_peaks) {
        var start_frame = peak_idx * spp;
        var end_frame = (peak_idx + 1) * spp;
        if (end_frame > frames) { end_frame = frames; }
        var c = 0;
        while (c < ch) {
            var min_val = DH_POS_INF;
            var max_val = DH_NEG_INF;
            var frame = start_frame;
            while (frame < end_frame) {
                var sample = vec_get(samples, frame * ch + c);
                min_val = f64_min(min_val, sample);
                max_val = f64_max(max_val, sample);
                frame = frame + 1;
            }
            if (min_val == DH_POS_INF) { min_val = 0; max_val = 0; }
            var chan = vec_get(channels, c);
            vec_push(chan, min_val);
            vec_push(chan, max_val);
            c = c + 1;
        }
        peak_idx = peak_idx + 1;
    }
    var self = alloc(sizeof(DhWaveformData));
    DhWaveformData_set_channels(self, channels);
    DhWaveformData_set_peaks_per_second(self, pps);
    DhWaveformData_set_sample_rate(self, DhAudioBuffer_sample_rate(buf));
    return self;
}

# --- zcr.cyr ---

# zcr.cyr -- zero-crossing rate (sign changes per second).
# Ports rust-old/src/analysis/zcr.rs. L0: deps error + buffer.
# ZcrResult struct; Result -> null-handle sentinel (buffer < 2 frames).

#derive(accessors)
struct DhZcrResult { rate_hz; per_channel; total_crossings; }

# zero_crossing_rate(buf) -> result handle, or 0 if fewer than 2 frames.
#must_use
fn dhvani_zcr_compute(buf) {
    var frames = DhAudioBuffer_frames(buf);
    if (frames < 2) { return 0; }
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    var per_channel = vec_new();
    var total = 0;
    var c = 0;
    while (c < ch) {
        var crossings = 0;
        var prev = vec_get(samples, c);
        var frame = 1;
        while (frame < frames) {
            var curr = vec_get(samples, frame * ch + c);
            # sign change positive<->negative (zero->nonzero not counted)
            if (f64_gt(prev, 0) == 1) { if (f64_lt(curr, 0) == 1) { crossings = crossings + 1; } }
            if (f64_lt(prev, 0) == 1) { if (f64_gt(curr, 0) == 1) { crossings = crossings + 1; } }
            prev = curr;
            frame = frame + 1;
        }
        var rate = f64_div(f64_mul(f64_from(crossings), f64_from(DhAudioBuffer_sample_rate(buf))), f64_from(frames - 1));
        vec_push(per_channel, rate);
        total = total + crossings;
        c = c + 1;
    }
    var sum = 0;
    var i = 0;
    while (i < ch) { sum = f64_add(sum, vec_get(per_channel, i)); i = i + 1; }
    var self = alloc(sizeof(DhZcrResult));
    DhZcrResult_set_rate_hz(self, f64_div(sum, f64_from(ch)));
    DhZcrResult_set_per_channel(self, per_channel);
    DhZcrResult_set_total_crossings(self, total);
    return self;
}

#inline
#must_use
fn dhvani_zcr_rate_hz(self) { return DhZcrResult_rate_hz(self); }
#inline
#must_use
fn dhvani_zcr_total_crossings(self) { return DhZcrResult_total_crossings(self); }
# per-channel rate at index c.
#must_use
fn dhvani_zcr_per_channel(self, c) { return vec_get(DhZcrResult_per_channel(self), c); }

# --- pan.cyr ---

# pan.cyr -- constant-power (sin/cos) stereo panner.
# Ports rust-old/src/dsp/pan.rs. L1: deps error + buffer + abaco::constant_power_pan.
# pan in [-1,+1]; abaco's constant_power_pan(pan, out_l, out_r) writes gains via
# out-pointers. serde/Default dropped.

#derive(accessors)
struct DhStereoPanner { pan; gain_l; gain_r; }

# new(pan) -- panner at the given position (-1 left .. +1 right).
#must_use
fn dhvani_pan_new(pan) {
    var self = alloc(sizeof(DhStereoPanner));
    DhStereoPanner_set_pan(self, 0);
    DhStereoPanner_set_gain_l(self, 0);
    DhStereoPanner_set_gain_r(self, 0);
    dhvani_pan_set_pan(self, pan);
    return self;
}

# set_pan(pan) -- clamp to [-1,1] and recompute L/R gains.
fn dhvani_pan_set_pan(self, pan) {
    var clamped = f64_clamp(pan, f64_neg(1.0), 1.0);
    DhStereoPanner_set_pan(self, clamped);
    var lp = alloc(8);
    var rp = alloc(8);
    constant_power_pan(clamped, lp, rp);
    DhStereoPanner_set_gain_l(self, load64(lp));
    DhStereoPanner_set_gain_r(self, load64(rp));
    return 0;
}

#inline
#must_use
fn dhvani_pan_pan(self) { return DhStereoPanner_pan(self); }
#inline
#must_use
fn dhvani_pan_gain_l(self) { return DhStereoPanner_gain_l(self); }
#inline
#must_use
fn dhvani_pan_gain_r(self) { return DhStereoPanner_gain_r(self); }

# process(buf) -- apply pan gains to L/R in place. No-op for < 2 channels.
fn dhvani_pan_process(self, buf) {
    var ch = DhAudioBuffer_channels(buf);
    if (ch < 2) { return 0; }
    var samples = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    var gl = DhStereoPanner_gain_l(self);
    var gr = DhStereoPanner_gain_r(self);
    var frame = 0;
    while (frame < frames) {
        var l_idx = frame * ch;
        var r_idx = frame * ch + 1;
        vec_set(samples, l_idx, f64_mul(vec_get(samples, l_idx), gl));
        vec_set(samples, r_idx, f64_mul(vec_get(samples, r_idx), gr));
        frame = frame + 1;
    }
    return 0;
}

# --- svf.cyr ---

# svf.cyr -- State Variable Filter (Cytomic / Andrew Simper topology).
# Ports rust-old/src/dsp/svf.rs. L1: deps error + buffer. SvfMode enum -> codes.
# Per-channel state (ic1eq/ic2eq) as a vec of DhSvfState. serde dropped;
# f32 params widen to f64. Stable under real-time cutoff modulation.

var DH_SVF_LOWPASS   = 0;
var DH_SVF_HIGHPASS  = 1;
var DH_SVF_BANDPASS  = 2;
var DH_SVF_NOTCH     = 3;
var DH_SVF_ALLPASS   = 4;
var DH_SVF_PEAK      = 5;
var DH_SVF_LOWSHELF  = 6;
var DH_SVF_HIGHSHELF = 7;

#derive(accessors)
struct DhSvfState { ic1eq; ic2eq; }

#derive(accessors)
struct DhSvfFilter { mode; freq_hz; q; gain_db; sample_rate; states; bypassed; mix; g; k; a1; a2; a3; a; }

# new(mode, freq_hz, q, gain_db, sample_rate, channels).
#must_use
fn dhvani_svf_new(mode, freq_hz, q, gain_db, sample_rate, channels) {
    var self = alloc(sizeof(DhSvfFilter));
    DhSvfFilter_set_mode(self, mode);
    DhSvfFilter_set_freq_hz(self, freq_hz);
    DhSvfFilter_set_q(self, f64_max(q, 0.01));
    DhSvfFilter_set_gain_db(self, gain_db);
    DhSvfFilter_set_sample_rate(self, sample_rate);
    var states = vec_new();
    var c = 0;
    while (c < channels) {
        var st = alloc(sizeof(DhSvfState));
        DhSvfState_set_ic1eq(st, 0);
        DhSvfState_set_ic2eq(st, 0);
        vec_push(states, st);
        c = c + 1;
    }
    DhSvfFilter_set_states(self, states);
    DhSvfFilter_set_bypassed(self, 0);
    DhSvfFilter_set_mix(self, 1.0);
    DhSvfFilter_set_g(self, 0);
    DhSvfFilter_set_k(self, 0);
    DhSvfFilter_set_a1(self, 0);
    DhSvfFilter_set_a2(self, 0);
    DhSvfFilter_set_a3(self, 0);
    DhSvfFilter_set_a(self, 1.0);
    dhvani_svf_update_coeffs(self);
    return self;
}

# recompute g/k/a1/a2/a3/a from current params.
fn dhvani_svf_update_coeffs(self) {
    var sr = f64_from(DhSvfFilter_sample_rate(self));
    var freq = f64_clamp(DhSvfFilter_freq_hz(self), 1.0, f64_mul(sr, 0.499));
    var g = dhvani_tan(f64_div(f64_mul(F64_PI, freq), sr));
    var q = f64_max(DhSvfFilter_q(self), 0.01);
    var k = f64_div(1.0, q);
    var a = f64_pow(10.0, f64_div(DhSvfFilter_gain_db(self), 40.0));
    DhSvfFilter_set_a(self, a);
    var mode = DhSvfFilter_mode(self);
    if (mode == DH_SVF_PEAK) {
        k = f64_div(1.0, f64_mul(q, a));
    } elif (mode == DH_SVF_LOWSHELF) {
        g = f64_mul(g, f64_sqrt(a));
    } elif (mode == DH_SVF_HIGHSHELF) {
        g = f64_div(g, f64_sqrt(a));
    }
    var denom = f64_add(1.0, f64_mul(g, f64_add(g, k)));
    var a1 = f64_div(1.0, denom);
    var a2 = f64_mul(g, a1);
    var a3 = f64_mul(g, a2);
    DhSvfFilter_set_g(self, g);
    DhSvfFilter_set_k(self, k);
    DhSvfFilter_set_a1(self, a1);
    DhSvfFilter_set_a2(self, a2);
    DhSvfFilter_set_a3(self, a3);
    return 0;
}

# process one sample for `channel`; updates channel state.
fn dhvani_svf_process_sample_internal(self, input, channel) {
    var s = vec_get(DhSvfFilter_states(self), channel);
    var ic1 = DhSvfState_ic1eq(s);
    var ic2 = DhSvfState_ic2eq(s);
    var k = DhSvfFilter_k(self);
    var a = DhSvfFilter_a(self);
    var v3 = f64_sub(input, ic2);
    var v1 = f64_add(f64_mul(DhSvfFilter_a1(self), ic1), f64_mul(DhSvfFilter_a2(self), v3));
    var v2 = f64_add(f64_add(ic2, f64_mul(DhSvfFilter_a2(self), ic1)), f64_mul(DhSvfFilter_a3(self), v3));
    DhSvfState_set_ic1eq(s, f64_sub(f64_mul(2.0, v1), ic1));
    DhSvfState_set_ic2eq(s, f64_sub(f64_mul(2.0, v2), ic2));
    var mode = DhSvfFilter_mode(self);
    if (mode == DH_SVF_LOWPASS)  { return v2; }
    if (mode == DH_SVF_HIGHPASS) { return f64_sub(f64_sub(input, f64_mul(k, v1)), v2); }
    if (mode == DH_SVF_BANDPASS) { return v1; }
    if (mode == DH_SVF_NOTCH)    { return f64_sub(input, f64_mul(k, v1)); }
    if (mode == DH_SVF_ALLPASS)  { return f64_sub(input, f64_mul(f64_mul(2.0, k), v1)); }
    if (mode == DH_SVF_PEAK)     { return f64_add(input, f64_mul(f64_sub(f64_mul(a, a), 1.0), v1)); }
    if (mode == DH_SVF_LOWSHELF) {
        return f64_add(f64_add(input, f64_mul(f64_sub(f64_mul(a, a), 1.0), v2)),
                       f64_mul(f64_mul(f64_sub(a, 1.0), k), v1));
    }
    # HighShelf
    var hp = f64_sub(f64_sub(input, f64_mul(k, v1)), v2);
    return f64_add(f64_add(input, f64_mul(f64_sub(f64_mul(a, a), 1.0), hp)),
                   f64_mul(f64_mul(f64_sub(a, 1.0), k), v1));
}

# process(buf) -- filter in place with dry/wet mix.
fn dhvani_svf_process(self, buf) {
    if (DhSvfFilter_bypassed(self) == 1) { return 0; }
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    var mix = DhSvfFilter_mix(self);
    var dry = f64_sub(1.0, mix);
    var frame = 0;
    while (frame < frames) {
        var c = 0;
        while (c < ch) {
            var idx = frame * ch + c;
            var input = vec_get(samples, idx);
            var output = dhvani_svf_process_sample_internal(self, input, c);
            vec_set(samples, idx, f64_add(f64_mul(input, dry), f64_mul(output, mix)));
            c = c + 1;
        }
        frame = frame + 1;
    }
    return 0;
}

# process_sample(sample, channel) -- passthrough if channel out of range.
#must_use
fn dhvani_svf_process_sample(self, sample, channel) {
    if (channel < vec_len(DhSvfFilter_states(self))) {
        return dhvani_svf_process_sample_internal(self, sample, channel);
    }
    return sample;
}

fn dhvani_svf_set_params(self, mode, freq_hz, q, gain_db) {
    DhSvfFilter_set_mode(self, mode);
    DhSvfFilter_set_freq_hz(self, freq_hz);
    DhSvfFilter_set_q(self, f64_max(q, 0.01));
    DhSvfFilter_set_gain_db(self, gain_db);
    dhvani_svf_update_coeffs(self);
    return 0;
}
fn dhvani_svf_set_frequency(self, freq_hz) { DhSvfFilter_set_freq_hz(self, freq_hz); dhvani_svf_update_coeffs(self); return 0; }
fn dhvani_svf_set_q(self, q) { DhSvfFilter_set_q(self, f64_max(q, 0.01)); dhvani_svf_update_coeffs(self); return 0; }
fn dhvani_svf_set_gain_db(self, gain_db) { DhSvfFilter_set_gain_db(self, gain_db); dhvani_svf_update_coeffs(self); return 0; }
fn dhvani_svf_set_sample_rate(self, sample_rate) { DhSvfFilter_set_sample_rate(self, sample_rate); dhvani_svf_update_coeffs(self); return 0; }
fn dhvani_svf_set_bypass(self, bypassed) { DhSvfFilter_set_bypassed(self, bypassed); return 0; }
fn dhvani_svf_set_mix(self, mix) { DhSvfFilter_set_mix(self, f64_clamp(mix, 0, 1.0)); return 0; }

fn dhvani_svf_reset(self) {
    var states = DhSvfFilter_states(self);
    var n = vec_len(states);
    var i = 0;
    while (i < n) {
        var st = vec_get(states, i);
        DhSvfState_set_ic1eq(st, 0);
        DhSvfState_set_ic2eq(st, 0);
        i = i + 1;
    }
    return 0;
}

#inline
#must_use
fn dhvani_svf_mode(self) { return DhSvfFilter_mode(self); }
#inline
#must_use
fn dhvani_svf_freq_hz(self) { return DhSvfFilter_freq_hz(self); }
#inline
#must_use
fn dhvani_svf_q(self) { return DhSvfFilter_q(self); }
#inline
#must_use
fn dhvani_svf_gain_db(self) { return DhSvfFilter_gain_db(self); }
#inline
#must_use
fn dhvani_svf_mix(self) { return DhSvfFilter_mix(self); }
#must_use
fn dhvani_svf_is_bypassed(self) {
    if (DhSvfFilter_bypassed(self) == 1) { return 1; }
    return 0;
}

# --- biquad.cyr ---

# biquad.cyr -- RBJ Audio EQ Cookbook biquad filters (Direct Form II Transposed).
# Ports rust-old/src/dsp/biquad.rs. L1: deps error + buffer + abaco
# (angular_frequency, db_gain_factor). FilterType enum with data-carrying
# Peaking/LowShelf/HighShelf{gain_db} -> integer code + a separate gain_db
# param/field. The SIMD stereo fast path is dropped (scalar per-channel loop).

var DH_BQ_LOWPASS   = 0;
var DH_BQ_HIGHPASS  = 1;
var DH_BQ_BANDPASS  = 2;
var DH_BQ_NOTCH     = 3;
var DH_BQ_ALLPASS   = 4;
var DH_BQ_PEAKING   = 5;   # uses gain_db
var DH_BQ_LOWSHELF  = 6;   # uses gain_db
var DH_BQ_HIGHSHELF = 7;   # uses gain_db

#derive(accessors)
struct DhBiquadCoeffs { b0; b1; b2; a1; a2; }

#derive(accessors)
struct DhBiquadState { z1; z2; }

#derive(accessors)
struct DhBiquadFilter { coeffs; states; filter_type; gain_db; freq_hz; q; sample_rate; bypassed; mix; }

# design(filter_type, gain_db, freq_hz, q, sample_rate) -> coeffs handle.
#must_use
fn dhvani_biquad_design(filter_type, gain_db, freq_hz, q, sample_rate) {
    var sr = f64_from(sample_rate);
    var f0 = f64_clamp(freq_hz, 1.0, f64_mul(sr, 0.499));
    var qq = f64_max(q, 0.01);
    var w0 = angular_frequency(f0, sr);
    var cos_w0 = f64_cos(w0);
    var sin_w0 = f64_sin(w0);
    var alpha = f64_div(sin_w0, f64_mul(2.0, qq));
    var neg2cos = f64_mul(f64_neg(2.0), cos_w0);
    var b0 = 0; var b1 = 0; var b2 = 0;
    var a0 = 0; var a1 = 0; var a2 = 0;
    var a = 0; var tsa = 0;
    if (filter_type == DH_BQ_LOWPASS) {
        b1 = f64_sub(1.0, cos_w0);
        b0 = f64_div(b1, 2.0);
        b2 = b0;
        a0 = f64_add(1.0, alpha); a1 = neg2cos; a2 = f64_sub(1.0, alpha);
    } elif (filter_type == DH_BQ_HIGHPASS) {
        b0 = f64_div(f64_add(1.0, cos_w0), 2.0);
        b1 = f64_neg(f64_add(1.0, cos_w0));
        b2 = b0;
        a0 = f64_add(1.0, alpha); a1 = neg2cos; a2 = f64_sub(1.0, alpha);
    } elif (filter_type == DH_BQ_BANDPASS) {
        b0 = alpha; b1 = 0; b2 = f64_neg(alpha);
        a0 = f64_add(1.0, alpha); a1 = neg2cos; a2 = f64_sub(1.0, alpha);
    } elif (filter_type == DH_BQ_NOTCH) {
        b0 = 1.0; b1 = neg2cos; b2 = 1.0;
        a0 = f64_add(1.0, alpha); a1 = neg2cos; a2 = f64_sub(1.0, alpha);
    } elif (filter_type == DH_BQ_ALLPASS) {
        b0 = f64_sub(1.0, alpha); b1 = neg2cos; b2 = f64_add(1.0, alpha);
        a0 = f64_add(1.0, alpha); a1 = neg2cos; a2 = f64_sub(1.0, alpha);
    } elif (filter_type == DH_BQ_PEAKING) {
        a = db_gain_factor(gain_db);
        b0 = f64_add(1.0, f64_mul(alpha, a));
        b1 = neg2cos;
        b2 = f64_sub(1.0, f64_mul(alpha, a));
        a0 = f64_add(1.0, f64_div(alpha, a));
        a1 = neg2cos;
        a2 = f64_sub(1.0, f64_div(alpha, a));
    } elif (filter_type == DH_BQ_LOWSHELF) {
        a = db_gain_factor(gain_db);
        tsa = f64_mul(f64_mul(2.0, f64_sqrt(a)), alpha);
        b0 = f64_mul(a, f64_add(f64_sub(f64_add(a, 1.0), f64_mul(f64_sub(a, 1.0), cos_w0)), tsa));
        b1 = f64_mul(f64_mul(2.0, a), f64_sub(f64_sub(a, 1.0), f64_mul(f64_add(a, 1.0), cos_w0)));
        b2 = f64_mul(a, f64_sub(f64_sub(f64_add(a, 1.0), f64_mul(f64_sub(a, 1.0), cos_w0)), tsa));
        a0 = f64_add(f64_add(f64_add(a, 1.0), f64_mul(f64_sub(a, 1.0), cos_w0)), tsa);
        a1 = f64_mul(f64_neg(2.0), f64_add(f64_sub(a, 1.0), f64_mul(f64_add(a, 1.0), cos_w0)));
        a2 = f64_sub(f64_add(f64_add(a, 1.0), f64_mul(f64_sub(a, 1.0), cos_w0)), tsa);
    } else {
        # HighShelf
        a = db_gain_factor(gain_db);
        tsa = f64_mul(f64_mul(2.0, f64_sqrt(a)), alpha);
        b0 = f64_mul(a, f64_add(f64_add(f64_add(a, 1.0), f64_mul(f64_sub(a, 1.0), cos_w0)), tsa));
        b1 = f64_mul(f64_mul(f64_neg(2.0), a), f64_add(f64_sub(a, 1.0), f64_mul(f64_add(a, 1.0), cos_w0)));
        b2 = f64_mul(a, f64_sub(f64_add(f64_add(a, 1.0), f64_mul(f64_sub(a, 1.0), cos_w0)), tsa));
        a0 = f64_add(f64_sub(f64_add(a, 1.0), f64_mul(f64_sub(a, 1.0), cos_w0)), tsa);
        a1 = f64_mul(2.0, f64_sub(f64_sub(a, 1.0), f64_mul(f64_add(a, 1.0), cos_w0)));
        a2 = f64_sub(f64_sub(f64_add(a, 1.0), f64_mul(f64_sub(a, 1.0), cos_w0)), tsa);
    }
    var c = alloc(sizeof(DhBiquadCoeffs));
    DhBiquadCoeffs_set_b0(c, f64_div(b0, a0));
    DhBiquadCoeffs_set_b1(c, f64_div(b1, a0));
    DhBiquadCoeffs_set_b2(c, f64_div(b2, a0));
    DhBiquadCoeffs_set_a1(c, f64_div(a1, a0));
    DhBiquadCoeffs_set_a2(c, f64_div(a2, a0));
    return c;
}

# unity (pass-through) coefficients.
#must_use
fn dhvani_biquad_coeffs_unity() {
    var c = alloc(sizeof(DhBiquadCoeffs));
    DhBiquadCoeffs_set_b0(c, 1.0);
    DhBiquadCoeffs_set_b1(c, 0);
    DhBiquadCoeffs_set_b2(c, 0);
    DhBiquadCoeffs_set_a1(c, 0);
    DhBiquadCoeffs_set_a2(c, 0);
    return c;
}

# process one sample through a state (Direct Form II Transposed).
fn dhvani_biquad_state_process(st, input, c) {
    var out = f64_add(f64_mul(DhBiquadCoeffs_b0(c), input), DhBiquadState_z1(st));
    DhBiquadState_set_z1(st, f64_add(f64_sub(f64_mul(DhBiquadCoeffs_b1(c), input), f64_mul(DhBiquadCoeffs_a1(c), out)), DhBiquadState_z2(st)));
    DhBiquadState_set_z2(st, f64_sub(f64_mul(DhBiquadCoeffs_b2(c), input), f64_mul(DhBiquadCoeffs_a2(c), out)));
    return out;
}

# new(filter_type, gain_db, freq_hz, q, sample_rate, channels).
#must_use
fn dhvani_biquad_new(filter_type, gain_db, freq_hz, q, sample_rate, channels) {
    var self = alloc(sizeof(DhBiquadFilter));
    DhBiquadFilter_set_coeffs(self, dhvani_biquad_design(filter_type, gain_db, freq_hz, q, sample_rate));
    var states = vec_new();
    var c = 0;
    while (c < channels) {
        var st = alloc(sizeof(DhBiquadState));
        DhBiquadState_set_z1(st, 0);
        DhBiquadState_set_z2(st, 0);
        vec_push(states, st);
        c = c + 1;
    }
    DhBiquadFilter_set_states(self, states);
    DhBiquadFilter_set_filter_type(self, filter_type);
    DhBiquadFilter_set_gain_db(self, gain_db);
    DhBiquadFilter_set_freq_hz(self, freq_hz);
    DhBiquadFilter_set_q(self, q);
    DhBiquadFilter_set_sample_rate(self, sample_rate);
    DhBiquadFilter_set_bypassed(self, 0);
    DhBiquadFilter_set_mix(self, 1.0);
    return self;
}

# process(buf) -- filter in place with dry/wet mix (scalar per-channel).
fn dhvani_biquad_process(self, buf) {
    if (DhBiquadFilter_bypassed(self) == 1) { return 0; }
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    var coeffs = DhBiquadFilter_coeffs(self);
    var states = DhBiquadFilter_states(self);
    var mix = DhBiquadFilter_mix(self);
    var dry = f64_sub(1.0, mix);
    var frame = 0;
    while (frame < frames) {
        var c = 0;
        while (c < ch) {
            var idx = frame * ch + c;
            var input = vec_get(samples, idx);
            var wet = dhvani_biquad_state_process(vec_get(states, c), input, coeffs);
            vec_set(samples, idx, f64_add(f64_mul(input, dry), f64_mul(wet, mix)));
            c = c + 1;
        }
        frame = frame + 1;
    }
    return 0;
}

# process_sample(sample, channel) -- passthrough if channel out of range.
#must_use
fn dhvani_biquad_process_sample(self, sample, channel) {
    if (channel < vec_len(DhBiquadFilter_states(self))) {
        return dhvani_biquad_state_process(vec_get(DhBiquadFilter_states(self), channel), sample, DhBiquadFilter_coeffs(self));
    }
    return sample;
}

fn dhvani_biquad_reset(self) {
    var states = DhBiquadFilter_states(self);
    var n = vec_len(states);
    var i = 0;
    while (i < n) {
        var st = vec_get(states, i);
        DhBiquadState_set_z1(st, 0);
        DhBiquadState_set_z2(st, 0);
        i = i + 1;
    }
    return 0;
}

# set_params(filter_type, gain_db, freq_hz, q) -- recompute coeffs, keep state.
fn dhvani_biquad_set_params(self, filter_type, gain_db, freq_hz, q) {
    DhBiquadFilter_set_filter_type(self, filter_type);
    DhBiquadFilter_set_gain_db(self, gain_db);
    DhBiquadFilter_set_freq_hz(self, freq_hz);
    DhBiquadFilter_set_q(self, q);
    DhBiquadFilter_set_coeffs(self, dhvani_biquad_design(filter_type, gain_db, freq_hz, q, DhBiquadFilter_sample_rate(self)));
    return 0;
}
fn dhvani_biquad_set_sample_rate(self, sample_rate) {
    DhBiquadFilter_set_sample_rate(self, sample_rate);
    DhBiquadFilter_set_coeffs(self, dhvani_biquad_design(DhBiquadFilter_filter_type(self), DhBiquadFilter_gain_db(self), DhBiquadFilter_freq_hz(self), DhBiquadFilter_q(self), sample_rate));
    return 0;
}
fn dhvani_biquad_set_bypass(self, bypassed) { DhBiquadFilter_set_bypassed(self, bypassed); return 0; }
fn dhvani_biquad_set_mix(self, mix) { DhBiquadFilter_set_mix(self, f64_clamp(mix, 0, 1.0)); return 0; }

#inline
#must_use
fn dhvani_biquad_filter_type(self) { return DhBiquadFilter_filter_type(self); }
#inline
#must_use
fn dhvani_biquad_freq_hz(self) { return DhBiquadFilter_freq_hz(self); }
#inline
#must_use
fn dhvani_biquad_q(self) { return DhBiquadFilter_q(self); }
#inline
#must_use
fn dhvani_biquad_mix(self) { return DhBiquadFilter_mix(self); }
#must_use
fn dhvani_biquad_is_bypassed(self) {
    if (DhBiquadFilter_bypassed(self) == 1) { return 1; }
    return 0;
}

# --- routing.cyr ---

# routing.cyr -- N×M channel routing matrix with per-crosspoint gain.
# Ports rust-old/src/dsp/routing.rs. L1: deps error + buffer.
# Vec<Vec<f32>> gains -> a flat `vec` arena indexed [out*inputs + inp]
# (Vec-arena-over-nested). apply() Result -> null-handle sentinel. serde dropped.

#derive(accessors)
struct DhRoutingMatrix { gains; inputs; outputs; }

# new(inputs, outputs) -- all crosspoints zero.
#must_use
fn dhvani_routing_new(inputs, outputs) {
    var self = alloc(sizeof(DhRoutingMatrix));
    DhRoutingMatrix_set_gains(self, dh_vec_zeros(outputs * inputs));
    DhRoutingMatrix_set_inputs(self, inputs);
    DhRoutingMatrix_set_outputs(self, outputs);
    return self;
}

# set_gain(output_ch, input_ch, gain) -- 1 on success, 0 if out of bounds.
fn dhvani_routing_set_gain(self, output_ch, input_ch, gain) {
    if (output_ch < DhRoutingMatrix_outputs(self)) {
        if (input_ch < DhRoutingMatrix_inputs(self)) {
            vec_set(DhRoutingMatrix_gains(self), output_ch * DhRoutingMatrix_inputs(self) + input_ch, gain);
            return 1;
        }
    }
    return 0;
}

# gain(output_ch, input_ch) -- crosspoint gain, or 0.0 if out of bounds.
#must_use
fn dhvani_routing_gain(self, output_ch, input_ch) {
    if (output_ch < DhRoutingMatrix_outputs(self)) {
        if (input_ch < DhRoutingMatrix_inputs(self)) {
            return vec_get(DhRoutingMatrix_gains(self), output_ch * DhRoutingMatrix_inputs(self) + input_ch);
        }
    }
    return 0;
}

#inline
#must_use
fn dhvani_routing_inputs(self) { return DhRoutingMatrix_inputs(self); }
#inline
#must_use
fn dhvani_routing_outputs(self) { return DhRoutingMatrix_outputs(self); }

# identity(channels) -- pass-through (unity on the diagonal).
#must_use
fn dhvani_routing_identity(channels) {
    var m = dhvani_routing_new(channels, channels);
    var i = 0;
    while (i < channels) { dhvani_routing_set_gain(m, i, i, 1.0); i = i + 1; }
    return m;
}
#must_use
fn dhvani_routing_mono_to_stereo() {
    var m = dhvani_routing_new(1, 2);
    dhvani_routing_set_gain(m, 0, 0, 1.0);
    dhvani_routing_set_gain(m, 1, 0, 1.0);
    return m;
}
#must_use
fn dhvani_routing_stereo_to_mono() {
    var m = dhvani_routing_new(2, 1);
    dhvani_routing_set_gain(m, 0, 0, 0.5);
    dhvani_routing_set_gain(m, 0, 1, 0.5);
    return m;
}
#must_use
fn dhvani_routing_mid_side_encode() {
    var m = dhvani_routing_new(2, 2);
    dhvani_routing_set_gain(m, 0, 0, 0.5);
    dhvani_routing_set_gain(m, 0, 1, 0.5);
    dhvani_routing_set_gain(m, 1, 0, 0.5);
    dhvani_routing_set_gain(m, 1, 1, f64_neg(0.5));
    return m;
}
#must_use
fn dhvani_routing_mid_side_decode() {
    var m = dhvani_routing_new(2, 2);
    dhvani_routing_set_gain(m, 0, 0, 1.0);
    dhvani_routing_set_gain(m, 0, 1, 1.0);
    dhvani_routing_set_gain(m, 1, 0, 1.0);
    dhvani_routing_set_gain(m, 1, 1, f64_neg(1.0));
    return m;
}

# apply(buf) -- route to a new buffer with `outputs` channels; 0 on channel
# count mismatch.
#must_use
fn dhvani_routing_apply(self, buf) {
    var in_ch = DhAudioBuffer_channels(buf);
    var inputs = DhRoutingMatrix_inputs(self);
    if (in_ch != inputs) { return 0; }
    var frames = DhAudioBuffer_frames(buf);
    var out_ch = DhRoutingMatrix_outputs(self);
    var samples = DhAudioBuffer_samples(buf);
    var gains = DhRoutingMatrix_gains(self);
    var output = dh_vec_zeros(frames * out_ch);
    var frame = 0;
    while (frame < frames) {
        var o = 0;
        while (o < out_ch) {
            var sum = 0;
            var i = 0;
            while (i < inputs) {
                var gain = vec_get(gains, o * inputs + i);
                if (gain != 0) {
                    sum = f64_add(sum, f64_mul(vec_get(samples, frame * in_ch + i), gain));
                }
                i = i + 1;
            }
            vec_set(output, frame * out_ch + o, sum);
            o = o + 1;
        }
        frame = frame + 1;
    }
    return dhvani_buffer_from_interleaved(output, out_ch, DhAudioBuffer_sample_rate(buf));
}

# --- dsp.cyr ---

# dsp.cyr -- DSP facade: free-function processors + shared soft-knee math.
# Ports the OWN code of rust-old/src/dsp/mod.rs (the module re-exports are
# implicit in the flat bundle). L1: deps error + simd + buffer. The abaco DSP
# math (amplitude_to_db / db_to_amplitude / sanitize_sample) is used directly
# from abaco by consumers.

# noise_gate(buf, threshold) -- silence samples with |s| < threshold.
fn dhvani_dsp_noise_gate(buf, threshold) {
    dhvani_simd_noise_gate(DhAudioBuffer_samples(buf), threshold);
    return 0;
}

# hard_limiter(buf, ceiling) -- clamp to [-|ceiling|, |ceiling|].
fn dhvani_dsp_hard_limiter(buf, ceiling) {
    var c = f64_abs(ceiling);
    dhvani_simd_clamp(DhAudioBuffer_samples(buf), f64_neg(c), c);
    return 0;
}

# normalize(buf, target_peak) -- scale so the peak reaches target_peak.
fn dhvani_dsp_normalize(buf, target_peak) {
    var peak = dhvani_buffer_peak(buf);
    if (f64_gt(peak, 0) == 1) {
        dhvani_buffer_apply_gain(buf, f64_div(target_peak, peak));
    }
    return 0;
}

# soft_knee_gain(env_db, threshold_db, knee_db, slope) -- gain reduction in dB
# (negative = reduction). Shared by compressor + limiter for the quadratic
# knee region. slope = 1/ratio - 1 (compressor) or -1.0 (limiter).
#must_use
fn dhvani_dsp_soft_knee_gain(env_db, threshold_db, knee_db, slope) {
    var half_knee = f64_div(knee_db, 2.0);
    var lower = f64_sub(threshold_db, half_knee);
    var upper = f64_add(threshold_db, half_knee);
    if (f64_le(env_db, lower) == 1) { return 0; }
    if (f64_ge(env_db, upper) == 1) { return f64_mul(slope, f64_sub(env_db, threshold_db)); }
    var x = f64_sub(env_db, lower);
    return f64_div(f64_mul(f64_mul(slope, x), x), f64_mul(2.0, knee_db));
}

# --- compressor.cyr ---

# compressor.cyr -- dynamic range compressor (dB-domain, envelope follower).
# Ports rust-old/src/dsp/compressor.rs. L1: deps error + simd + buffer + dsp
# (soft_knee_gain) + abaco (time_constant, amplitude_to_db, db_to_amplitude).
# new()/set_params() Result -> handle-or-null / error code. serde + with_*
# builders dropped (untested convenience). knee via dsp::soft_knee_gain.

#derive(accessors)
struct DhCompressorParams { threshold_db; ratio; attack_ms; release_ms; makeup_gain_db; knee_db; mix; }

#derive(accessors)
struct DhCompressor { params; envelope_db; gain_reduction_db; sample_rate; bypassed; }

# ---- CompressorParams ----
#must_use
fn dhvani_compparams_new(threshold_db, ratio, attack_ms, release_ms, makeup_gain_db, knee_db, mix) {
    var p = alloc(sizeof(DhCompressorParams));
    DhCompressorParams_set_threshold_db(p, threshold_db);
    DhCompressorParams_set_ratio(p, ratio);
    DhCompressorParams_set_attack_ms(p, attack_ms);
    DhCompressorParams_set_release_ms(p, release_ms);
    DhCompressorParams_set_makeup_gain_db(p, makeup_gain_db);
    DhCompressorParams_set_knee_db(p, knee_db);
    DhCompressorParams_set_mix(p, mix);
    return p;
}
#must_use
fn dhvani_compparams_default() { return dhvani_compparams_new(f64_neg(20.0), 4.0, 10.0, 100.0, 0, 0, 1.0); }

# validate -- ratio>=1, attack/release/knee >= 0.
#must_use
fn dhvani_compparams_validate(p) {
    if (f64_lt(DhCompressorParams_ratio(p), 1.0) == 1)       { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_lt(DhCompressorParams_attack_ms(p), 0) == 1)     { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_lt(DhCompressorParams_release_ms(p), 0) == 1)    { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_lt(DhCompressorParams_knee_db(p), 0) == 1)       { return DHVANI_ERR_INVALID_PARAMETER; }
    return DHVANI_ERR_NONE;
}

# ---- Compressor ----
# new(params, sample_rate) -- handle, or 0 if params invalid.
#must_use
fn dhvani_comp_new(params, sample_rate) {
    if (dhvani_is_err(dhvani_compparams_validate(params)) == 1) { return 0; }
    var self = alloc(sizeof(DhCompressor));
    DhCompressor_set_params(self, params);
    DhCompressor_set_envelope_db(self, f64_neg(120.0));
    DhCompressor_set_gain_reduction_db(self, 0);
    DhCompressor_set_sample_rate(self, sample_rate);
    DhCompressor_set_bypassed(self, 0);
    return self;
}

# gain curve for an envelope level (dB): slope = 1/ratio - 1.
#must_use
fn dhvani_comp_compute_gain(self, env_db) {
    var p = DhCompressor_params(self);
    var slope = f64_sub(f64_div(1.0, DhCompressorParams_ratio(p)), 1.0);
    return dhvani_dsp_soft_knee_gain(env_db, DhCompressorParams_threshold_db(p), DhCompressorParams_knee_db(p), slope);
}

# process(buf) -- compress in place.
fn dhvani_comp_process(self, buf) {
    var p = DhCompressor_params(self);
    if (f64_le(DhCompressorParams_ratio(p), 1.0) == 1) { return 0; }
    if (DhCompressor_bypassed(self) == 1) { return 0; }
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    var sr = DhCompressor_sample_rate(self);
    var attack_coeff = time_constant(DhCompressorParams_attack_ms(p), sr);
    var release_coeff = time_constant(DhCompressorParams_release_ms(p), sr);
    var makeup_lin = db_to_amplitude(DhCompressorParams_makeup_gain_db(p));
    var mix = f64_clamp(DhCompressorParams_mix(p), 0, 1.0);
    var dry = f64_sub(1.0, mix);
    var env_db = DhCompressor_envelope_db(self);
    var frame = 0;
    while (frame < frames) {
        var peak = 0;
        var c = 0;
        while (c < ch) {
            peak = f64_max(peak, f64_abs(vec_get(samples, frame * ch + c)));
            c = c + 1;
        }
        var input_db = f64_max(amplitude_to_db(peak), f64_neg(120.0));
        var coeff = release_coeff;
        if (f64_gt(input_db, env_db) == 1) { coeff = attack_coeff; }
        env_db = f64_add(f64_mul(coeff, env_db), f64_mul(f64_sub(1.0, coeff), input_db));
        var gain_db = dhvani_comp_compute_gain(self, env_db);
        DhCompressor_set_gain_reduction_db(self, gain_db);
        if (dhvani_is_finite(gain_db) == 1) {
            var gain_lin = f64_mul(db_to_amplitude(gain_db), makeup_lin);
            var c2 = 0;
            while (c2 < ch) {
                var idx = frame * ch + c2;
                var dry_sample = vec_get(samples, idx);
                var wet_sample = f64_mul(dry_sample, gain_lin);
                var out = f64_add(f64_mul(dry_sample, dry), f64_mul(wet_sample, mix));
                if (dhvani_is_finite(out) == 0) { out = 0; }
                vec_set(samples, idx, out);
                c2 = c2 + 1;
            }
        }
        frame = frame + 1;
    }
    DhCompressor_set_envelope_db(self, env_db);
    return 0;
}

#inline
#must_use
fn dhvani_comp_gain_reduction_db(self) { return DhCompressor_gain_reduction_db(self); }
#inline
#must_use
fn dhvani_comp_envelope_db(self) { return DhCompressor_envelope_db(self); }
fn dhvani_comp_set_bypass(self, bypassed) { DhCompressor_set_bypassed(self, bypassed); return 0; }
#must_use
fn dhvani_comp_is_bypassed(self) { if (DhCompressor_bypassed(self) == 1) { return 1; } return 0; }
fn dhvani_comp_set_sample_rate(self, sample_rate) { DhCompressor_set_sample_rate(self, sample_rate); return 0; }
fn dhvani_comp_reset(self) {
    DhCompressor_set_envelope_db(self, f64_neg(120.0));
    DhCompressor_set_gain_reduction_db(self, 0);
    return 0;
}

# set_params -- validate then store; error code on invalid.
fn dhvani_comp_set_params(self, params) {
    var rc = dhvani_compparams_validate(params);
    if (dhvani_is_err(rc) == 1) { return rc; }
    DhCompressor_set_params(self, params);
    return DHVANI_ERR_NONE;
}

# --- limiter.cyr ---

# limiter.cyr -- brick-wall envelope limiter (instant attack, soft-knee).
# Ports rust-old/src/dsp/limiter.rs. L1: deps error + simd + buffer + dsp
# (soft_knee_gain) + abaco (time_constant, amplitude_to_db, db_to_amplitude).
# Limiter = inf:1 compression -> soft_knee slope = -1.0. serde + with_* dropped.

#derive(accessors)
struct DhLimiterParams { ceiling_db; release_ms; knee_db; mix; }

#derive(accessors)
struct DhEnvelopeLimiter { params; envelope_db; sample_rate; bypassed; }

# ---- LimiterParams ----
#must_use
fn dhvani_limparams_new(ceiling_db, release_ms, knee_db, mix) {
    var p = alloc(sizeof(DhLimiterParams));
    DhLimiterParams_set_ceiling_db(p, ceiling_db);
    DhLimiterParams_set_release_ms(p, release_ms);
    DhLimiterParams_set_knee_db(p, knee_db);
    DhLimiterParams_set_mix(p, mix);
    return p;
}
#must_use
fn dhvani_limparams_default() { return dhvani_limparams_new(f64_neg(0.3), 50.0, 0, 1.0); }

# validate -- ceiling <= 0, release/knee >= 0.
#must_use
fn dhvani_limparams_validate(p) {
    if (f64_gt(DhLimiterParams_ceiling_db(p), 0) == 1)    { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_lt(DhLimiterParams_release_ms(p), 0) == 1)    { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_lt(DhLimiterParams_knee_db(p), 0) == 1)       { return DHVANI_ERR_INVALID_PARAMETER; }
    return DHVANI_ERR_NONE;
}

# ---- EnvelopeLimiter ----
#must_use
fn dhvani_lim_new(params, sample_rate) {
    if (dhvani_is_err(dhvani_limparams_validate(params)) == 1) { return 0; }
    var self = alloc(sizeof(DhEnvelopeLimiter));
    DhEnvelopeLimiter_set_params(self, params);
    DhEnvelopeLimiter_set_envelope_db(self, f64_neg(120.0));
    DhEnvelopeLimiter_set_sample_rate(self, sample_rate);
    DhEnvelopeLimiter_set_bypassed(self, 0);
    return self;
}

# gain curve (slope = -1.0, i.e. inf:1).
#must_use
fn dhvani_lim_compute_gain(self, env_db) {
    var p = DhEnvelopeLimiter_params(self);
    return dhvani_dsp_soft_knee_gain(env_db, DhLimiterParams_ceiling_db(p), DhLimiterParams_knee_db(p), f64_neg(1.0));
}

# process(buf) -- limit in place with a hard-clamp safety net.
fn dhvani_lim_process(self, buf) {
    if (DhEnvelopeLimiter_bypassed(self) == 1) { return 0; }
    var p = DhEnvelopeLimiter_params(self);
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    var release_coeff = time_constant(DhLimiterParams_release_ms(p), DhEnvelopeLimiter_sample_rate(self));
    var ceiling_lin = db_to_amplitude(DhLimiterParams_ceiling_db(p));
    var neg_ceiling = f64_neg(ceiling_lin);
    var mix = f64_clamp(DhLimiterParams_mix(p), 0, 1.0);
    var dry = f64_sub(1.0, mix);
    var env_db = DhEnvelopeLimiter_envelope_db(self);
    var frame = 0;
    while (frame < frames) {
        var peak = 0;
        var c = 0;
        while (c < ch) {
            peak = f64_max(peak, f64_abs(vec_get(samples, frame * ch + c)));
            c = c + 1;
        }
        var input_db = f64_max(amplitude_to_db(peak), f64_neg(120.0));
        if (f64_gt(input_db, env_db) == 1) {
            env_db = input_db;
        } else {
            env_db = f64_add(f64_mul(release_coeff, env_db), f64_mul(f64_sub(1.0, release_coeff), input_db));
        }
        var gain_db = dhvani_lim_compute_gain(self, env_db);
        if (f64_lt(gain_db, 0) == 1) {
            if (dhvani_is_finite(gain_db) == 1) {
                var gain_lin = db_to_amplitude(gain_db);
                var c2 = 0;
                while (c2 < ch) {
                    var idx = frame * ch + c2;
                    var dry_sample = vec_get(samples, idx);
                    vec_set(samples, idx, f64_add(f64_mul(dry_sample, dry), f64_mul(f64_mul(dry_sample, gain_lin), mix)));
                    c2 = c2 + 1;
                }
            }
        }
        # hard-clamp safety net on every channel
        var c3 = 0;
        while (c3 < ch) {
            var idx3 = frame * ch + c3;
            vec_set(samples, idx3, f64_clamp(vec_get(samples, idx3), neg_ceiling, ceiling_lin));
            c3 = c3 + 1;
        }
        frame = frame + 1;
    }
    DhEnvelopeLimiter_set_envelope_db(self, env_db);
    return 0;
}

#must_use
fn dhvani_lim_gain_reduction_db(self) { return dhvani_lim_compute_gain(self, DhEnvelopeLimiter_envelope_db(self)); }
#inline
#must_use
fn dhvani_lim_envelope_db(self) { return DhEnvelopeLimiter_envelope_db(self); }
fn dhvani_lim_set_bypass(self, bypassed) { DhEnvelopeLimiter_set_bypassed(self, bypassed); return 0; }
#must_use
fn dhvani_lim_is_bypassed(self) { if (DhEnvelopeLimiter_bypassed(self) == 1) { return 1; } return 0; }
fn dhvani_lim_set_sample_rate(self, sample_rate) { DhEnvelopeLimiter_set_sample_rate(self, sample_rate); return 0; }
fn dhvani_lim_reset(self) { DhEnvelopeLimiter_set_envelope_db(self, f64_neg(120.0)); return 0; }

fn dhvani_lim_set_params(self, params) {
    var rc = dhvani_limparams_validate(params);
    if (dhvani_is_err(rc) == 1) { return rc; }
    DhEnvelopeLimiter_set_params(self, params);
    return DHVANI_ERR_NONE;
}

# --- delay.cyr ---

# delay.cyr -- delay line with feedback + modulated delay (chorus/flanger).
# Ports rust-old/src/dsp/delay.rs. L1: deps error + buffer. Per-channel ring
# buffers = a vec of per-channel `vec`s. serde dropped.

#derive(accessors)
struct DhDelayLine { buffers; write_pos; delay_samples; max_delay_samples; feedback; mix; bypassed; }

#derive(accessors)
struct DhModulatedDelayParams { base_delay_ms; depth_ms; rate_hz; feedback; mix; }

#derive(accessors)
struct DhModulatedDelay { delay; params; lfo_phase; sample_rate; bypassed; }

# ---- DelayLine ----
#must_use
fn dhvani_delay_new(delay_ms, max_delay_ms, feedback, mix, sample_rate, channels) {
    var self = alloc(sizeof(DhDelayLine));
    var max_samples = f64_to(f64_trunc(f64_mul(f64_div(f64_max(max_delay_ms, delay_ms), 1000.0), f64_from(sample_rate))));
    if (max_samples < 1) { max_samples = 1; }
    var delay_samples = f64_to(f64_trunc(f64_mul(f64_div(delay_ms, 1000.0), f64_from(sample_rate))));
    if (delay_samples > max_samples) { delay_samples = max_samples; }
    var buffers = vec_new();
    var c = 0;
    while (c < channels) { vec_push(buffers, dh_vec_zeros(max_samples)); c = c + 1; }
    DhDelayLine_set_buffers(self, buffers);
    DhDelayLine_set_write_pos(self, 0);
    DhDelayLine_set_delay_samples(self, delay_samples);
    DhDelayLine_set_max_delay_samples(self, max_samples);
    DhDelayLine_set_feedback(self, f64_clamp(feedback, 0, 0.99));
    DhDelayLine_set_mix(self, f64_clamp(mix, 0, 1.0));
    DhDelayLine_set_bypassed(self, 0);
    return self;
}

# process one sample for a channel (does NOT advance write_pos).
fn dhvani_delay_process_sample(self, input, channel) {
    var max = DhDelayLine_max_delay_samples(self);
    var wp = DhDelayLine_write_pos(self);
    var ring = vec_get(DhDelayLine_buffers(self), channel);
    var read_pos = (wp + max - DhDelayLine_delay_samples(self)) % max;
    var delayed = vec_get(ring, read_pos);
    vec_set(ring, wp, f64_add(input, f64_mul(delayed, DhDelayLine_feedback(self))));
    var mix = DhDelayLine_mix(self);
    return f64_add(f64_mul(input, f64_sub(1.0, mix)), f64_mul(delayed, mix));
}

# read a fractional delay position via linear interpolation.
#must_use
fn dhvani_delay_read_interpolated(self, channel, delay_frac) {
    var max = DhDelayLine_max_delay_samples(self);
    var wp = DhDelayLine_write_pos(self);
    var ring = vec_get(DhDelayLine_buffers(self), channel);
    var delay_int = f64_to(f64_trunc(delay_frac));
    var frac = f64_sub(delay_frac, f64_from(delay_int));
    var pos0 = (wp + max - delay_int) % max;
    var pos1 = (wp + max - delay_int - 1) % max;
    return f64_add(f64_mul(vec_get(ring, pos0), f64_sub(1.0, frac)), f64_mul(vec_get(ring, pos1), frac));
}

# process(buf) -- fixed delay in place.
fn dhvani_delay_process(self, buf) {
    if (DhDelayLine_bypassed(self) == 1) { return 0; }
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    var max = DhDelayLine_max_delay_samples(self);
    var frame = 0;
    while (frame < frames) {
        var c = 0;
        while (c < ch) {
            var idx = frame * ch + c;
            var out = dhvani_delay_process_sample(self, vec_get(samples, idx), c);
            if (dhvani_is_finite(out) == 0) { out = 0; }
            vec_set(samples, idx, out);
            c = c + 1;
        }
        DhDelayLine_set_write_pos(self, (DhDelayLine_write_pos(self) + 1) % max);
        frame = frame + 1;
    }
    return 0;
}

fn dhvani_delay_set_bypass(self, bypassed) { DhDelayLine_set_bypassed(self, bypassed); return 0; }
#must_use
fn dhvani_delay_is_bypassed(self) { if (DhDelayLine_bypassed(self) == 1) { return 1; } return 0; }
#inline
#must_use
fn dhvani_delay_latency_frames(self) { return DhDelayLine_delay_samples(self); }
fn dhvani_delay_set_delay_ms(self, delay_ms, sample_rate) {
    var samples = f64_to(f64_trunc(f64_mul(f64_div(delay_ms, 1000.0), f64_from(sample_rate))));
    var max = DhDelayLine_max_delay_samples(self);
    if (samples > max) { samples = max; }
    DhDelayLine_set_delay_samples(self, samples);
    return 0;
}
fn dhvani_delay_reset(self) {
    var buffers = DhDelayLine_buffers(self);
    var nc = vec_len(buffers);
    var c = 0;
    while (c < nc) {
        var ring = vec_get(buffers, c);
        var n = vec_len(ring);
        var i = 0;
        while (i < n) { vec_set(ring, i, 0); i = i + 1; }
        c = c + 1;
    }
    DhDelayLine_set_write_pos(self, 0);
    return 0;
}

# ---- ModulatedDelayParams ----
#must_use
fn dhvani_moddelayparams_new(base_delay_ms, depth_ms, rate_hz, feedback, mix) {
    var p = alloc(sizeof(DhModulatedDelayParams));
    DhModulatedDelayParams_set_base_delay_ms(p, base_delay_ms);
    DhModulatedDelayParams_set_depth_ms(p, depth_ms);
    DhModulatedDelayParams_set_rate_hz(p, rate_hz);
    DhModulatedDelayParams_set_feedback(p, feedback);
    DhModulatedDelayParams_set_mix(p, mix);
    return p;
}
#must_use
fn dhvani_moddelayparams_default() { return dhvani_moddelayparams_new(7.0, 3.0, 0.5, 0.3, 0.5); }
#must_use
fn dhvani_moddelayparams_validate(p) {
    if (f64_lt(DhModulatedDelayParams_base_delay_ms(p), 0) == 1) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_lt(DhModulatedDelayParams_depth_ms(p), 0) == 1)      { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_lt(DhModulatedDelayParams_rate_hz(p), 0) == 1)       { return DHVANI_ERR_INVALID_PARAMETER; }
    var fb = DhModulatedDelayParams_feedback(p);
    if (f64_lt(fb, 0) == 1)    { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_gt(fb, 0.99) == 1) { return DHVANI_ERR_INVALID_PARAMETER; }
    var mx = DhModulatedDelayParams_mix(p);
    if (f64_lt(mx, 0) == 1)    { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_gt(mx, 1.0) == 1)  { return DHVANI_ERR_INVALID_PARAMETER; }
    return DHVANI_ERR_NONE;
}

# ---- ModulatedDelay ----
#must_use
fn dhvani_moddelay_new(params, sample_rate, channels) {
    var self = alloc(sizeof(DhModulatedDelay));
    var max_ms = f64_add(f64_add(DhModulatedDelayParams_base_delay_ms(params), DhModulatedDelayParams_depth_ms(params)), 1.0);
    DhModulatedDelay_set_delay(self, dhvani_delay_new(DhModulatedDelayParams_base_delay_ms(params), max_ms,
        DhModulatedDelayParams_feedback(params), DhModulatedDelayParams_mix(params), sample_rate, channels));
    DhModulatedDelay_set_params(self, params);
    DhModulatedDelay_set_lfo_phase(self, 0);
    DhModulatedDelay_set_sample_rate(self, sample_rate);
    DhModulatedDelay_set_bypassed(self, 0);
    return self;
}

fn dhvani_moddelay_process(self, buf) {
    if (DhModulatedDelay_bypassed(self) == 1) { return 0; }
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    var p = DhModulatedDelay_params(self);
    var delay = DhModulatedDelay_delay(self);
    var sr = DhModulatedDelay_sample_rate(self);
    var phase_inc = f64_div(DhModulatedDelayParams_rate_hz(p), f64_from(sr));
    var lfo_phase = DhModulatedDelay_lfo_phase(self);
    var base = DhModulatedDelayParams_base_delay_ms(p);
    var depth = DhModulatedDelayParams_depth_ms(p);
    var feedback = DhModulatedDelayParams_feedback(p);
    var mix = DhModulatedDelayParams_mix(p);
    var max = DhDelayLine_max_delay_samples(delay);
    var frame = 0;
    while (frame < frames) {
        var lfo = f64_sin(f64_mul(f64_mul(2.0, F64_PI), lfo_phase));
        var delay_ms = f64_add(base, f64_mul(depth, lfo));
        var delay_frac = f64_max(f64_mul(f64_div(delay_ms, 1000.0), f64_from(sr)), 0);
        var wp = DhDelayLine_write_pos(delay);
        var c = 0;
        while (c < ch) {
            var idx = frame * ch + c;
            var input = vec_get(samples, idx);
            var delayed = dhvani_delay_read_interpolated(delay, c, delay_frac);
            var ring = vec_get(DhDelayLine_buffers(delay), c);
            vec_set(ring, wp, f64_add(input, f64_mul(delayed, feedback)));
            var out = f64_add(f64_mul(input, f64_sub(1.0, mix)), f64_mul(delayed, mix));
            if (dhvani_is_finite(out) == 0) { out = 0; }
            vec_set(samples, idx, out);
            c = c + 1;
        }
        DhDelayLine_set_write_pos(delay, (wp + 1) % max);
        lfo_phase = f64_add(lfo_phase, phase_inc);
        if (f64_ge(lfo_phase, 1.0) == 1) { lfo_phase = f64_sub(lfo_phase, 1.0); }
        frame = frame + 1;
    }
    DhModulatedDelay_set_lfo_phase(self, lfo_phase);
    return 0;
}

#inline
#must_use
fn dhvani_moddelay_latency_frames(self) {
    var p = DhModulatedDelay_params(self);
    return f64_to(f64_trunc(f64_mul(f64_div(DhModulatedDelayParams_base_delay_ms(p), 1000.0), f64_from(DhModulatedDelay_sample_rate(self)))));
}
#inline
#must_use
fn dhvani_moddelay_lfo_phase(self) { return DhModulatedDelay_lfo_phase(self); }
fn dhvani_moddelay_set_bypass(self, bypassed) { DhModulatedDelay_set_bypassed(self, bypassed); return 0; }
#must_use
fn dhvani_moddelay_is_bypassed(self) { if (DhModulatedDelay_bypassed(self) == 1) { return 1; } return 0; }

fn dhvani_moddelay_set_params(self, params) {
    var delay = DhModulatedDelay_delay(self);
    DhDelayLine_set_feedback(delay, f64_clamp(DhModulatedDelayParams_feedback(params), 0, 0.99));
    DhDelayLine_set_mix(delay, f64_clamp(DhModulatedDelayParams_mix(params), 0, 1.0));
    DhModulatedDelay_set_params(self, params);
    return 0;
}
fn dhvani_moddelay_set_sample_rate(self, sample_rate) {
    DhModulatedDelay_set_sample_rate(self, sample_rate);
    var p = DhModulatedDelay_params(self);
    var channels = vec_len(DhDelayLine_buffers(DhModulatedDelay_delay(self)));
    var max_ms = f64_add(f64_add(DhModulatedDelayParams_base_delay_ms(p), DhModulatedDelayParams_depth_ms(p)), 1.0);
    DhModulatedDelay_set_delay(self, dhvani_delay_new(DhModulatedDelayParams_base_delay_ms(p), max_ms,
        DhModulatedDelayParams_feedback(p), DhModulatedDelayParams_mix(p), sample_rate, channels));
    DhModulatedDelay_set_lfo_phase(self, 0);
    return 0;
}
fn dhvani_moddelay_reset(self) {
    dhvani_delay_reset(DhModulatedDelay_delay(self));
    DhModulatedDelay_set_lfo_phase(self, 0);
    return 0;
}

# --- reverb.cyr ---

# reverb.cyr -- Schroeder/Freeverb reverb (4 combs -> 2 allpass, per channel).
# Ports rust-old/src/dsp/reverb.rs. L1: deps error + buffer. Comb/allpass rings
# as `vec`s; filter banks as vecs of filter handles. serde dropped.
# Base delays @44100 scaled to the target rate. ALLPASS_FEEDBACK = 0.5.

#derive(accessors)
struct DhReverbParams { room_size; damping; mix; }

#derive(accessors)
struct DhCombFilter { buffer; write_pos; feedback; damp; damp_state; }

#derive(accessors)
struct DhAllpassFilter { buffer; write_pos; }

#derive(accessors)
struct DhReverb { combs_l; combs_r; allpasses_l; allpasses_r; params; bypassed; }

# ---- ReverbParams ----
#must_use
fn dhvani_reverbparams_new(room_size, damping, mix) {
    var p = alloc(sizeof(DhReverbParams));
    DhReverbParams_set_room_size(p, room_size);
    DhReverbParams_set_damping(p, damping);
    DhReverbParams_set_mix(p, mix);
    return p;
}
#must_use
fn dhvani_reverbparams_default() { return dhvani_reverbparams_new(0.5, 0.5, 0.3); }
#must_use
fn dhvani_reverbparams_validate(p) {
    var rs = DhReverbParams_room_size(p);
    if (f64_lt(rs, 0) == 1)   { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_gt(rs, 1.0) == 1) { return DHVANI_ERR_INVALID_PARAMETER; }
    var dp = DhReverbParams_damping(p);
    if (f64_lt(dp, 0) == 1)   { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_gt(dp, 1.0) == 1) { return DHVANI_ERR_INVALID_PARAMETER; }
    var mx = DhReverbParams_mix(p);
    if (f64_lt(mx, 0) == 1)   { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_gt(mx, 1.0) == 1) { return DHVANI_ERR_INVALID_PARAMETER; }
    return DHVANI_ERR_NONE;
}

# scale a base delay (@44100) to the target rate; min 1.
#must_use
fn dhvani_reverb_scale_delay(base, sample_rate) {
    var s = f64_to(f64_round(f64_div(f64_mul(f64_from(base), f64_from(sample_rate)), 44100.0)));
    if (s < 1) { s = 1; }
    return s;
}

# ---- CombFilter ----
#must_use
fn dhvani_comb_new(delay_samples) {
    var self = alloc(sizeof(DhCombFilter));
    var d = delay_samples;
    if (d < 1) { d = 1; }
    DhCombFilter_set_buffer(self, dh_vec_zeros(d));
    DhCombFilter_set_write_pos(self, 0);
    DhCombFilter_set_feedback(self, 0.5);
    DhCombFilter_set_damp(self, 0.5);
    DhCombFilter_set_damp_state(self, 0);
    return self;
}
fn dhvani_comb_process(self, input) {
    var ring = DhCombFilter_buffer(self);
    var wp = DhCombFilter_write_pos(self);
    var output = vec_get(ring, wp);
    var damp = DhCombFilter_damp(self);
    var ds = f64_add(f64_mul(output, f64_sub(1.0, damp)), f64_mul(DhCombFilter_damp_state(self), damp));
    DhCombFilter_set_damp_state(self, ds);
    vec_set(ring, wp, f64_add(input, f64_mul(ds, DhCombFilter_feedback(self))));
    DhCombFilter_set_write_pos(self, (wp + 1) % vec_len(ring));
    return output;
}
fn dhvani_comb_reset(self) {
    var ring = DhCombFilter_buffer(self);
    var n = vec_len(ring); var i = 0;
    while (i < n) { vec_set(ring, i, 0); i = i + 1; }
    DhCombFilter_set_write_pos(self, 0);
    DhCombFilter_set_damp_state(self, 0);
    return 0;
}

# ---- AllpassFilter ----
#must_use
fn dhvani_allpass_new(delay_samples) {
    var self = alloc(sizeof(DhAllpassFilter));
    var d = delay_samples;
    if (d < 1) { d = 1; }
    DhAllpassFilter_set_buffer(self, dh_vec_zeros(d));
    DhAllpassFilter_set_write_pos(self, 0);
    return self;
}
fn dhvani_allpass_process(self, input) {
    var ring = DhAllpassFilter_buffer(self);
    var wp = DhAllpassFilter_write_pos(self);
    var buffered = vec_get(ring, wp);
    vec_set(ring, wp, f64_add(input, f64_mul(buffered, 0.5)));
    DhAllpassFilter_set_write_pos(self, (wp + 1) % vec_len(ring));
    return f64_add(f64_neg(input), buffered);
}
fn dhvani_allpass_reset(self) {
    var ring = DhAllpassFilter_buffer(self);
    var n = vec_len(ring); var i = 0;
    while (i < n) { vec_set(ring, i, 0); i = i + 1; }
    DhAllpassFilter_set_write_pos(self, 0);
    return 0;
}

# ---- Reverb ----
# run one channel's chain: sum 4 combs (x0.25) -> cascade allpasses.
#must_use
fn dhvani_reverb_run_chain(combs, allpasses, input) {
    var comb_sum = 0;
    var nc = vec_len(combs); var i = 0;
    while (i < nc) { comb_sum = f64_add(comb_sum, dhvani_comb_process(vec_get(combs, i), input)); i = i + 1; }
    comb_sum = f64_mul(comb_sum, 0.25);
    var out = comb_sum;
    var na = vec_len(allpasses); var j = 0;
    while (j < na) { out = dhvani_allpass_process(vec_get(allpasses, j), out); j = j + 1; }
    return out;
}

fn dhvani_reverb_set_combs_fd(combs, feedback, damp) {
    var n = vec_len(combs); var i = 0;
    while (i < n) {
        var comb = vec_get(combs, i);
        DhCombFilter_set_feedback(comb, feedback);
        DhCombFilter_set_damp(comb, damp);
        i = i + 1;
    }
    return 0;
}
fn dhvani_reverb_update_params(self, params) {
    var feedback = f64_add(f64_mul(f64_clamp(DhReverbParams_room_size(params), 0, 1.0), 0.9), 0.05);
    var damp = f64_clamp(DhReverbParams_damping(params), 0, 1.0);
    dhvani_reverb_set_combs_fd(DhReverb_combs_l(self), feedback, damp);
    dhvani_reverb_set_combs_fd(DhReverb_combs_r(self), feedback, damp);
    return 0;
}

#must_use
fn dhvani_reverb_new(params, sample_rate) {
    if (dhvani_is_err(dhvani_reverbparams_validate(params)) == 1) { return 0; }
    var self = alloc(sizeof(DhReverb));
    var cd = vec_new(); vec_push(cd, 1557); vec_push(cd, 1617); vec_push(cd, 1491); vec_push(cd, 1422);
    var combs_l = vec_new();
    var combs_r = vec_new();
    var i = 0;
    while (i < 4) {
        vec_push(combs_l, dhvani_comb_new(dhvani_reverb_scale_delay(vec_get(cd, i), sample_rate)));
        vec_push(combs_r, dhvani_comb_new(dhvani_reverb_scale_delay(vec_get(cd, i) + 23, sample_rate)));
        i = i + 1;
    }
    var ad = vec_new(); vec_push(ad, 225); vec_push(ad, 556);
    var allpasses_l = vec_new();
    var allpasses_r = vec_new();
    var j = 0;
    while (j < 2) {
        vec_push(allpasses_l, dhvani_allpass_new(dhvani_reverb_scale_delay(vec_get(ad, j), sample_rate)));
        vec_push(allpasses_r, dhvani_allpass_new(dhvani_reverb_scale_delay(vec_get(ad, j) + 23, sample_rate)));
        j = j + 1;
    }
    DhReverb_set_combs_l(self, combs_l);
    DhReverb_set_combs_r(self, combs_r);
    DhReverb_set_allpasses_l(self, allpasses_l);
    DhReverb_set_allpasses_r(self, allpasses_r);
    DhReverb_set_params(self, params);
    DhReverb_set_bypassed(self, 0);
    dhvani_reverb_update_params(self, params);
    return self;
}

fn dhvani_reverb_process(self, buf) {
    if (DhReverb_bypassed(self) == 1) { return 0; }
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    var p = DhReverb_params(self);
    var mix = DhReverbParams_mix(p);
    var dry = f64_sub(1.0, mix);
    var combs_l = DhReverb_combs_l(self);
    var combs_r = DhReverb_combs_r(self);
    var allpasses_l = DhReverb_allpasses_l(self);
    var allpasses_r = DhReverb_allpasses_r(self);
    var frame = 0;
    while (frame < frames) {
        if (ch == 1) {
            var input = vec_get(samples, frame);
            var rev = dhvani_reverb_run_chain(combs_l, allpasses_l, input);
            var out = f64_add(f64_mul(input, dry), f64_mul(rev, mix));
            if (dhvani_is_finite(out) == 0) { out = 0; }
            vec_set(samples, frame, out);
        } else {
            var l_idx = frame * ch;
            var r_idx = frame * ch + 1;
            var input_l = vec_get(samples, l_idx);
            var input_r = vec_get(samples, r_idx);
            var rev_l = dhvani_reverb_run_chain(combs_l, allpasses_l, input_l);
            var rev_r = dhvani_reverb_run_chain(combs_r, allpasses_r, input_r);
            var out_l = f64_add(f64_mul(input_l, dry), f64_mul(rev_l, mix));
            var out_r = f64_add(f64_mul(input_r, dry), f64_mul(rev_r, mix));
            if (dhvani_is_finite(out_l) == 0) { out_l = 0; }
            if (dhvani_is_finite(out_r) == 0) { out_r = 0; }
            vec_set(samples, l_idx, out_l);
            vec_set(samples, r_idx, out_r);
        }
        frame = frame + 1;
    }
    return 0;
}

fn dhvani_reverb_set_bypass(self, bypassed) { DhReverb_set_bypassed(self, bypassed); return 0; }
#must_use
fn dhvani_reverb_is_bypassed(self) { if (DhReverb_bypassed(self) == 1) { return 1; } return 0; }

fn dhvani_reverb_set_params(self, params) {
    var rc = dhvani_reverbparams_validate(params);
    if (dhvani_is_err(rc) == 1) { return rc; }
    dhvani_reverb_update_params(self, params);
    DhReverb_set_params(self, params);
    return DHVANI_ERR_NONE;
}

fn dhvani_reverb_set_sample_rate(self, sample_rate) {
    var was_bypassed = DhReverb_bypassed(self);
    var fresh = dhvani_reverb_new(DhReverb_params(self), sample_rate);
    if (fresh != 0) {
        DhReverb_set_combs_l(self, DhReverb_combs_l(fresh));
        DhReverb_set_combs_r(self, DhReverb_combs_r(fresh));
        DhReverb_set_allpasses_l(self, DhReverb_allpasses_l(fresh));
        DhReverb_set_allpasses_r(self, DhReverb_allpasses_r(fresh));
    }
    DhReverb_set_bypassed(self, was_bypassed);
    return 0;
}

fn dhvani_reverb_reset_combs(combs) {
    var n = vec_len(combs); var i = 0;
    while (i < n) { dhvani_comb_reset(vec_get(combs, i)); i = i + 1; }
    return 0;
}
fn dhvani_reverb_reset_allpasses(aps) {
    var n = vec_len(aps); var i = 0;
    while (i < n) { dhvani_allpass_reset(vec_get(aps, i)); i = i + 1; }
    return 0;
}
fn dhvani_reverb_reset(self) {
    dhvani_reverb_reset_combs(DhReverb_combs_l(self));
    dhvani_reverb_reset_combs(DhReverb_combs_r(self));
    dhvani_reverb_reset_allpasses(DhReverb_allpasses_l(self));
    dhvani_reverb_reset_allpasses(DhReverb_allpasses_r(self));
    return 0;
}

# --- analysis.cyr ---

# analysis.cyr -- Spectrum type + DFT + loudness/silence/gain helpers.
# Ports the OWN code of rust-old/src/analysis/mod.rs (the per-submodule facade
# re-exports are implicit in the flat bundle). L1: deps error + simd + buffer +
# abaco (amplitude_to_db). Spectrum consumed by fft.cyr (spectrum_fft) too.
# log10(x) = ln(x)/ln(10) (no f64_log10 in stdlib).

#derive(accessors)
struct DhSpectrum { magnitudes; magnitude_db; freq_resolution; sample_rate; fft_size; peak_frequency; peak_magnitude_db; }

#must_use
fn dh_log10(x) { return f64_div(f64_ln(x), F64_LN10); }

# from_magnitudes(magnitudes, freq_resolution, sample_rate, fft_size) -> Spectrum.
#must_use
fn dhvani_spectrum_from_magnitudes(magnitudes, freq_resolution, sample_rate, fft_size) {
    var n = vec_len(magnitudes);
    var magnitude_db = dh_vec_zeros(n);
    var peak_idx = 0;
    var peak_mag = 0;
    var i = 0;
    while (i < n) {
        var m = vec_get(magnitudes, i);
        if (f64_gt(m, 0.0000000001) == 1) { vec_set(magnitude_db, i, f64_mul(20.0, dh_log10(m))); }
        else { vec_set(magnitude_db, i, f64_neg(200.0)); }
        if (f64_gt(m, peak_mag) == 1) { peak_mag = m; peak_idx = i; }
        i = i + 1;
    }
    var peak_magnitude_db = f64_neg(200.0);
    if (f64_gt(peak_mag, 0.0000000001) == 1) { peak_magnitude_db = f64_mul(20.0, dh_log10(peak_mag)); }
    var self = alloc(sizeof(DhSpectrum));
    DhSpectrum_set_magnitudes(self, magnitudes);
    DhSpectrum_set_magnitude_db(self, magnitude_db);
    DhSpectrum_set_freq_resolution(self, freq_resolution);
    DhSpectrum_set_sample_rate(self, sample_rate);
    DhSpectrum_set_fft_size(self, fft_size);
    DhSpectrum_set_peak_frequency(self, f64_mul(f64_from(peak_idx), freq_resolution));
    DhSpectrum_set_peak_magnitude_db(self, peak_magnitude_db);
    return self;
}

#inline
#must_use
fn dhvani_spectrum_magnitudes(self) { return DhSpectrum_magnitudes(self); }
#inline
#must_use
fn dhvani_spectrum_freq_resolution(self) { return DhSpectrum_freq_resolution(self); }
#inline
#must_use
fn dhvani_spectrum_bin_count(self) { return vec_len(DhSpectrum_magnitudes(self)); }
#must_use
fn dhvani_spectrum_bin_frequency(self, bin) { return f64_mul(f64_from(bin), DhSpectrum_freq_resolution(self)); }
# magnitude at bin k.
#must_use
fn dhvani_spectrum_magnitude(self, k) { return vec_get(DhSpectrum_magnitudes(self), k); }
# dominant frequency (peak bin frequency); 0.0 for an empty spectrum.
#must_use
fn dhvani_spectrum_dominant_frequency(self) { return DhSpectrum_peak_frequency(self); }

# spectral centroid — magnitude-weighted mean frequency; 0.0 for silence.
#must_use
fn dhvani_spectrum_spectral_centroid(self) {
    var mags = DhSpectrum_magnitudes(self);
    var fr = DhSpectrum_freq_resolution(self);
    var n = vec_len(mags);
    var total = 0;
    var i = 0;
    while (i < n) { total = f64_add(total, vec_get(mags, i)); i = i + 1; }
    if (f64_le(total, 0) == 1) { return 0; }
    var weighted = 0;
    var j = 0;
    while (j < n) { weighted = f64_add(weighted, f64_mul(f64_mul(f64_from(j), fr), vec_get(mags, j))); j = j + 1; }
    return f64_div(weighted, total);
}

# spectral rolloff — frequency below which `threshold` fraction of energy sits.
#must_use
fn dhvani_spectrum_spectral_rolloff(self, threshold) {
    var mags = DhSpectrum_magnitudes(self);
    var fr = DhSpectrum_freq_resolution(self);
    var n = vec_len(mags);
    var total_energy = 0;
    var i = 0;
    while (i < n) { var m = vec_get(mags, i); total_energy = f64_add(total_energy, f64_mul(m, m)); i = i + 1; }
    if (f64_le(total_energy, 0) == 1) { return 0; }
    var target = f64_mul(total_energy, f64_clamp(threshold, 0, 1.0));
    var cumulative = 0;
    var k = 0;
    while (k < n) {
        var mm = vec_get(mags, k);
        cumulative = f64_add(cumulative, f64_mul(mm, mm));
        if (f64_ge(cumulative, target) == 1) { return f64_mul(f64_from(k), fr); }
        k = k + 1;
    }
    return f64_mul(f64_from(n), fr);
}

# spectrum_dft(buf, window_size) -- O(n^2) DFT magnitude spectrum, or 0 on error.
#must_use
fn dhvani_analysis_spectrum_dft(buf, window_size) {
    var samples = DhAudioBuffer_samples(buf);
    var slen = vec_len(samples);
    if (slen == 0) { return 0; }
    if (DhAudioBuffer_channels(buf) == 0) { return 0; }
    var n = window_size;
    if (slen < window_size) { n = slen; }
    var num_bins = n / 2;
    var magnitudes = dh_vec_zeros(num_bins);
    var k = 0;
    while (k < num_bins) {
        var re = 0;
        var im = 0;
        var i = 0;
        while (i < n) {
            var angle = f64_div(f64_mul(f64_mul(f64_mul(f64_neg(2.0), F64_PI), f64_from(k)), f64_from(i)), f64_from(n));
            var s = vec_get(samples, i);
            re = f64_add(re, f64_mul(s, f64_cos(angle)));
            im = f64_add(im, f64_mul(s, f64_sin(angle)));
            i = i + 1;
        }
        vec_set(magnitudes, k, f64_div(f64_sqrt(f64_add(f64_mul(re, re), f64_mul(im, im))), f64_from(n)));
        k = k + 1;
    }
    dhvani_analysis_normalize(magnitudes, num_bins);
    var freq_resolution = f64_div(f64_from(DhAudioBuffer_sample_rate(buf)), f64_from(n));
    return dhvani_spectrum_from_magnitudes(magnitudes, freq_resolution, DhAudioBuffer_sample_rate(buf), n);
}

# normalize magnitudes to 0..1 by the peak (shared by DFT + FFT).
fn dhvani_analysis_normalize(magnitudes, num_bins) {
    var max = 0;
    var m = 0;
    while (m < num_bins) { max = f64_max(max, vec_get(magnitudes, m)); m = m + 1; }
    if (f64_gt(max, 0) == 1) {
        var p = 0;
        while (p < num_bins) { vec_set(magnitudes, p, f64_div(vec_get(magnitudes, p), max)); p = p + 1; }
    }
    return 0;
}

# loudness_lufs(buf) -- simplified EBU R128; -inf for empty/silence.
#must_use
fn dhvani_analysis_loudness_lufs(buf) {
    var samples = DhAudioBuffer_samples(buf);
    var len = vec_len(samples);
    if (len == 0) { return DH_NEG_INF; }
    var sum = 0;
    var i = 0;
    while (i < len) { var s = vec_get(samples, i); sum = f64_add(sum, f64_mul(s, s)); i = i + 1; }
    var mean_sq = f64_div(sum, f64_from(len));
    if (f64_le(mean_sq, 0) == 1) { return DH_NEG_INF; }
    return f64_add(f64_neg(0.691), f64_mul(10.0, dh_log10(mean_sq)));
}

# is_silent(buf, threshold_db) -- peak dB below threshold.
#must_use
fn dhvani_analysis_is_silent(buf, threshold_db) {
    if (f64_lt(amplitude_to_db(dhvani_buffer_peak(buf)), threshold_db) == 1) { return 1; }
    return 0;
}

# suggest_gain(buf, target_rms) -- linear gain clamped to [0.1, 10.0]; 1.0 for silence.
#must_use
fn dhvani_analysis_suggest_gain(buf, target_rms) {
    var rms = dhvani_buffer_rms(buf);
    if (f64_lt(rms, 0.000001) == 1) { return 1.0; }
    return f64_clamp(f64_div(target_rms, rms), 0.1, 10.0);
}

# --- fft.cyr ---

# fft.cyr -- radix-2 Cooley-Tukey FFT + windowed magnitude spectrum.
# Ports rust-old/src/analysis/fft.rs. L1: deps error + simd + buffer + analysis
# (Spectrum). fft_in_place operates on two f64 `vec`s (real, imag) in place.

# smallest power of two >= v (v >= 1). Ports usize::next_power_of_two.
#must_use
fn dh_next_pow2(v) {
    var p = 1;
    while (p < v) { p = p << 1; }
    return p;
}
# 1 if n is a power of two (n > 0), else 0.
#must_use
fn dh_is_pow2(n) {
    if (n == 0) { return 0; }
    if ((n & (n - 1)) == 0) { return 1; }
    return 0;
}

# in-place radix-2 FFT on parallel real/imag vecs. Returns 1 on success, 0 if
# length is not a power of two / mismatched / zero.
fn dhvani_fft_in_place(real, imag) {
    var n = vec_len(real);
    if (dh_is_pow2(n) == 0) { return 0; }
    if (n != vec_len(imag)) { return 0; }
    # bit-reversal permutation
    var j = 0;
    var i = 0;
    while (i < n) {
        if (i < j) {
            var tr0 = vec_get(real, i); vec_set(real, i, vec_get(real, j)); vec_set(real, j, tr0);
            var ti0 = vec_get(imag, i); vec_set(imag, i, vec_get(imag, j)); vec_set(imag, j, ti0);
        }
        var m = n >> 1;
        var cont = 1;
        while (cont == 1) {
            if (m >= 1) {
                if (j >= m) { j = j - m; m = m >> 1; } else { cont = 0; }
            } else { cont = 0; }
        }
        j = j + m;
        i = i + 1;
    }
    # butterfly stages
    var len = 2;
    while (len <= n) {
        var half = len / 2;
        var angle_step = f64_div(f64_mul(f64_neg(2.0), F64_PI), f64_from(len));
        var start = 0;
        while (start < n) {
            var angle = 0;
            var k = 0;
            while (k < half) {
                var cos_a = f64_cos(angle);
                var sin_a = f64_sin(angle);
                var ii = start + k;
                var jj = start + k + half;
                var rj = vec_get(real, jj);
                var ij = vec_get(imag, jj);
                var tr = f64_sub(f64_mul(rj, cos_a), f64_mul(ij, sin_a));
                var ti = f64_add(f64_mul(rj, sin_a), f64_mul(ij, cos_a));
                var ri = vec_get(real, ii);
                var iiv = vec_get(imag, ii);
                vec_set(real, jj, f64_sub(ri, tr));
                vec_set(imag, jj, f64_sub(iiv, ti));
                vec_set(real, ii, f64_add(ri, tr));
                vec_set(imag, ii, f64_add(iiv, ti));
                angle = f64_add(angle, angle_step);
                k = k + 1;
            }
            start = start + len;
        }
        len = len << 1;
    }
    return 1;
}

# spectrum_fft(buf, window_size) -- Hann-windowed radix-2 FFT magnitude
# spectrum; window_size rounded DOWN to a power of two (>=2). 0 on error.
#must_use
fn dhvani_fft_spectrum(buf, window_size) {
    var samples = DhAudioBuffer_samples(buf);
    var slen = vec_len(samples);
    if (slen == 0) { return 0; }
    if (DhAudioBuffer_channels(buf) == 0) { return 0; }
    var ws = window_size;
    if (dh_is_pow2(ws) == 0) { ws = dh_next_pow2(ws) >> 1; }
    if (ws < 2) { ws = 2; }
    var n = ws;
    if (slen < ws) { n = slen; }
    var num_bins = ws / 2;
    var real = dh_vec_zeros(ws);
    var imag = dh_vec_zeros(ws);
    var denom = n - 1;
    if (denom < 1) { denom = 1; }
    var i = 0;
    while (i < n) {
        var window = f64_mul(0.5, f64_sub(1.0, f64_cos(f64_div(f64_mul(f64_mul(2.0, F64_PI), f64_from(i)), f64_from(denom)))));
        vec_set(real, i, f64_mul(vec_get(samples, i), window));
        i = i + 1;
    }
    var freq_resolution = f64_div(f64_from(DhAudioBuffer_sample_rate(buf)), f64_from(ws));
    if (dhvani_fft_in_place(real, imag) == 0) { return 0; }
    var magnitudes = dh_vec_zeros(num_bins);
    var k = 0;
    while (k < num_bins) {
        var re = vec_get(real, k);
        var im = vec_get(imag, k);
        vec_set(magnitudes, k, f64_div(f64_sqrt(f64_add(f64_mul(re, re), f64_mul(im, im))), f64_from(ws)));
        k = k + 1;
    }
    dhvani_analysis_normalize(magnitudes, num_bins);
    return dhvani_spectrum_from_magnitudes(magnitudes, freq_resolution, DhAudioBuffer_sample_rate(buf), ws);
}

# --- loudness.cyr ---

# loudness.cyr -- EBU R128 loudness: K-weighting + gated LUFS.
# Ports rust-old/src/analysis/loudness.rs. L2: deps error + simd + buffer +
# biquad + abaco. K-weighting = HighShelf(1681Hz,+4dB,Q0.707) cascaded with
# HighPass(38Hz,Q0.5), built via dhvani_biquad_new. measure_r128 -> a
# R128Loudness handle, or 0 (null) on error (empty buffer / zero channels).
#
# FLOAT NOTES: negative float constants (-70, -10, -0.691) go through f64_neg.
# The Rust f32::NEG_INFINITY sentinel maps to DH_NEG_INF (error.cyr).
# 10.0.powf(lufs/10) has a positive base so f64_pow is safe. log10 via dh_log10
# (analysis.cyr). The 400ms block / 100ms hop counts are integer sample counts.

#derive(accessors)
struct DhR128Loudness { integrated_lufs; range_lu; short_term_lufs; momentary_lufs; }

# --- R128Loudness accessors (was impl getters) ---
#inline
#must_use
fn dhvani_r128_integrated_lufs(self) { return DhR128Loudness_integrated_lufs(self); }
#inline
#must_use
fn dhvani_r128_range_lu(self) { return DhR128Loudness_range_lu(self); }
#inline
#must_use
fn dhvani_r128_short_term_lufs(self) { return DhR128Loudness_short_term_lufs(self); }
#inline
#must_use
fn dhvani_r128_momentary_lufs(self) { return DhR128Loudness_momentary_lufs(self); }

# construct an R128Loudness handle.
#must_use
fn dhvani_r128_new(integrated_lufs, range_lu, short_term_lufs, momentary_lufs) {
    var self = alloc(sizeof(DhR128Loudness));
    DhR128Loudness_set_integrated_lufs(self, integrated_lufs);
    DhR128Loudness_set_range_lu(self, range_lu);
    DhR128Loudness_set_short_term_lufs(self, short_term_lufs);
    DhR128Loudness_set_momentary_lufs(self, momentary_lufs);
    return self;
}

# Apply K-weighting filter -- returns a new `vec` of filtered samples.
# Stage 1: HighShelf at 1681 Hz, +4 dB, Q=0.707. Stage 2: HighPass at 38 Hz,
# Q=0.5. The oracle applies both per-sample (shelf then HP) with per-channel
# state; a cascade of two LTI biquads is order-invariant across the pass, so we
# process the whole buffer through the shelf then through the HP (identical
# output). Works on a cloned buffer so the input is untouched.
#must_use
fn dhvani_loudness_apply_k_weighting(buf) {
    var sr = DhAudioBuffer_sample_rate(buf);
    var ch = DhAudioBuffer_channels(buf);
    var work = dhvani_buffer_clone(buf);
    # Stage 1: High shelf at ~1681 Hz, +4 dB (pre-emphasis for head acoustics)
    var shelf = dhvani_biquad_new(DH_BQ_HIGHSHELF, 4.0, 1681.0, 0.707, sr, ch);
    dhvani_biquad_process(shelf, work);
    # Stage 2: High pass at ~38 Hz (remove DC and sub-bass)
    var hp = dhvani_biquad_new(DH_BQ_HIGHPASS, 0, 38.0, 0.5, sr, ch);
    dhvani_biquad_process(hp, work);
    return DhAudioBuffer_samples(work);
}

# Average block LUFS values in the linear power domain per EBU R128.
# mean_power = mean(10^(lufs/10)); -inf if empty or non-positive power.
#must_use
fn dhvani_loudness_lufs_from_blocks(blocks) {
    var n = vec_len(blocks);
    if (n == 0) { return DH_NEG_INF; }
    var sum = 0;
    var i = 0;
    while (i < n) {
        var lufs = vec_get(blocks, i);
        sum = f64_add(sum, f64_pow(10.0, f64_div(lufs, 10.0)));
        i = i + 1;
    }
    var mean_power = f64_div(sum, f64_from(n));
    if (f64_gt(mean_power, 0) == 1) {
        return f64_add(f64_neg(0.691), f64_mul(10.0, dh_log10(mean_power)));
    }
    return DH_NEG_INF;
}

# ascending in-place insertion sort of a `vec` of f64 (mirrors partial_cmp with
# NaN treated as Equal -- our block loudness values are finite or -inf, both of
# which f64_gt orders correctly).
fn dhvani_loudness_sort_asc(v) {
    var n = vec_len(v);
    var i = 1;
    while (i < n) {
        var key = vec_get(v, i);
        var j = i - 1;
        var cont = 1;
        while (cont == 1) {
            if (j < 0) { cont = 0; }
            elif (f64_gt(vec_get(v, j), key) == 1) {
                vec_set(v, j + 1, vec_get(v, j));
                j = j - 1;
            } else { cont = 0; }
        }
        vec_set(v, j + 1, key);
        i = i + 1;
    }
    return 0;
}

# Compute Loudness Range (LRA): p95 - p10 of sorted gated blocks. 0.0 if <2.
#must_use
fn dhvani_loudness_compute_lra(blocks) {
    var n = vec_len(blocks);
    if (n < 2) { return 0; }
    var sorted = vec_new();
    var s = 0;
    while (s < n) { vec_push(sorted, vec_get(blocks, s)); s = s + 1; }
    dhvani_loudness_sort_asc(sorted);
    var nf = f64_from(n);
    var idx10 = f64_to(f64_mul(nf, 0.1));
    var idx95 = f64_to(f64_min(f64_mul(nf, 0.95), f64_sub(nf, 1.0)));
    var p10 = vec_get(sorted, idx10);
    var p95 = vec_get(sorted, idx95);
    return f64_sub(p95, p10);
}

# Measure EBU R128 integrated loudness. Returns an R128Loudness handle, or 0
# (null) on error (empty buffer / zero channels).
#must_use
fn dhvani_loudness_measure_r128(buf) {
    var samples = DhAudioBuffer_samples(buf);
    if (vec_len(samples) == 0) { return 0; }
    if (DhAudioBuffer_channels(buf) == 0) { return 0; }

    var sr = DhAudioBuffer_sample_rate(buf);
    var ch = DhAudioBuffer_channels(buf);

    # Step 1: Apply K-weighting filter
    var filtered = dhvani_loudness_apply_k_weighting(buf);

    # Step 2: mean square per 400ms block (75% overlap = 100ms hop)
    var block_samples = f64_to(f64_mul(f64_from(sr), 0.4));
    var hop_samples = f64_to(f64_mul(f64_from(sr), 0.1));
    if (block_samples < 1) { block_samples = 1; }
    if (hop_samples < 1) { hop_samples = 1; }

    var block_loudness = vec_new();
    var frames = DhAudioBuffer_frames(buf);
    var pos = 0;
    while ((pos + block_samples) <= frames) {
        var mean_sq = 0;
        var count = 0;
        var frame = pos;
        while (frame < (pos + block_samples)) {
            var c = 0;
            while (c < ch) {
                var sv = vec_get(filtered, frame * ch + c);
                mean_sq = f64_add(mean_sq, f64_mul(sv, sv));
                count = count + 1;
                c = c + 1;
            }
            frame = frame + 1;
        }
        if (count > 0) { mean_sq = f64_div(mean_sq, f64_from(count)); }
        var lufs = DH_NEG_INF;
        if (f64_gt(mean_sq, 0) == 1) {
            lufs = f64_add(f64_neg(0.691), f64_mul(10.0, dh_log10(mean_sq)));
        }
        vec_push(block_loudness, lufs);
        pos = pos + hop_samples;
    }

    var nblocks = vec_len(block_loudness);
    if (nblocks == 0) {
        return dhvani_r128_new(DH_NEG_INF, 0, DH_NEG_INF, DH_NEG_INF);
    }

    # Step 3: Absolute gate at -70 LUFS
    var neg70 = f64_neg(70.0);
    var above_abs_gate = vec_new();
    var a = 0;
    while (a < nblocks) {
        var la = vec_get(block_loudness, a);
        if (f64_gt(la, neg70) == 1) { vec_push(above_abs_gate, la); }
        a = a + 1;
    }

    var last_block = vec_get(block_loudness, nblocks - 1);
    if (vec_len(above_abs_gate) == 0) {
        return dhvani_r128_new(DH_NEG_INF, 0, last_block, last_block);
    }

    # Ungated loudness (above absolute gate) -- linear power domain mean.
    var ungated_lufs = dhvani_loudness_lufs_from_blocks(above_abs_gate);

    # Step 4: Relative gate at ungated - 10 LU
    var relative_threshold = f64_sub(ungated_lufs, 10.0);
    var above_rel_gate = vec_new();
    var r = 0;
    var nabs = vec_len(above_abs_gate);
    while (r < nabs) {
        var lr = vec_get(above_abs_gate, r);
        if (f64_gt(lr, relative_threshold) == 1) { vec_push(above_rel_gate, lr); }
        r = r + 1;
    }

    var integrated_lufs = ungated_lufs;
    if (vec_len(above_rel_gate) > 0) {
        integrated_lufs = dhvani_loudness_lufs_from_blocks(above_rel_gate);
    }

    # Momentary = last 400ms block
    var momentary_lufs = last_block;

    # Short-term = mean of last ~3s (30 blocks) in linear power domain
    var short_term_blocks = 30;
    if (nblocks < 30) { short_term_blocks = nblocks; }
    var st_slice = vec_new();
    var st_start = nblocks - short_term_blocks;
    var st = st_start;
    while (st < nblocks) { vec_push(st_slice, vec_get(block_loudness, st)); st = st + 1; }
    var short_term_lufs = dhvani_loudness_lufs_from_blocks(st_slice);

    # LRA: 95th - 10th percentile of relatively-gated blocks
    var range_lu = dhvani_loudness_compute_lra(above_rel_gate);

    return dhvani_r128_new(integrated_lufs, range_lu, short_term_lufs, momentary_lufs);
}

# --- dynamics.cyr ---

# dynamics.cyr -- Dynamics analysis: per-channel peak, RMS, true peak, crest
# factor, dynamic range, LUFS. Ports rust-old/src/analysis/dynamics.rs.
# L1: deps error + simd + buffer + abaco (amplitude_to_db). Does not use Spectrum.
#
# DynamicsAnalysis result -> a struct handle with vec fields (peak/peak_db/
# true_peak/true_peak_db/rms/rms_db/crest_factor_db) and scalar fields
# (lufs, dynamic_range_db, frame_count, channel_count). #[must_use] fns ->
# plain fns; the analyze entry point returns a valid handle. serde/Display N/A.

#derive(accessors)
struct DhDynamicsAnalysis {
    peak;
    peak_db;
    true_peak;
    true_peak_db;
    rms;
    rms_db;
    crest_factor_db;
    lufs;
    dynamic_range_db;
    frame_count;
    channel_count;
}

# --- accessors (return the whole per-channel vec / scalar) ---
#inline
#must_use
fn dhvani_dynamics_peak(self) { return DhDynamicsAnalysis_peak(self); }
#inline
#must_use
fn dhvani_dynamics_peak_db(self) { return DhDynamicsAnalysis_peak_db(self); }
#inline
#must_use
fn dhvani_dynamics_true_peak(self) { return DhDynamicsAnalysis_true_peak(self); }
#inline
#must_use
fn dhvani_dynamics_true_peak_db(self) { return DhDynamicsAnalysis_true_peak_db(self); }
#inline
#must_use
fn dhvani_dynamics_rms(self) { return DhDynamicsAnalysis_rms(self); }
#inline
#must_use
fn dhvani_dynamics_rms_db(self) { return DhDynamicsAnalysis_rms_db(self); }
#inline
#must_use
fn dhvani_dynamics_crest_factor_db(self) { return DhDynamicsAnalysis_crest_factor_db(self); }
#inline
#must_use
fn dhvani_dynamics_lufs(self) { return DhDynamicsAnalysis_lufs(self); }
#inline
#must_use
fn dhvani_dynamics_dynamic_range_db(self) { return DhDynamicsAnalysis_dynamic_range_db(self); }
#inline
#must_use
fn dhvani_dynamics_frame_count(self) { return DhDynamicsAnalysis_frame_count(self); }
#inline
#must_use
fn dhvani_dynamics_channel_count(self) { return DhDynamicsAnalysis_channel_count(self); }

# max_peak() -- max peak across channels (linear), folded from 0.0.
#must_use
fn dhvani_dynamics_max_peak(self) {
    var peak = DhDynamicsAnalysis_peak(self);
    var n = vec_len(peak);
    var acc = 0;
    var i = 0;
    while (i < n) { acc = f64_max(acc, vec_get(peak, i)); i = i + 1; }
    return acc;
}

# max_peak_db() -- max peak dB across channels, folded from -inf.
#must_use
fn dhvani_dynamics_max_peak_db(self) {
    var pdb = DhDynamicsAnalysis_peak_db(self);
    var n = vec_len(pdb);
    var acc = DH_NEG_INF;
    var i = 0;
    while (i < n) { acc = f64_max(acc, vec_get(pdb, i)); i = i + 1; }
    return acc;
}

# max_true_peak() -- max true peak across channels (linear), folded from 0.0.
#must_use
fn dhvani_dynamics_max_true_peak(self) {
    var tp = DhDynamicsAnalysis_true_peak(self);
    var n = vec_len(tp);
    var acc = 0;
    var i = 0;
    while (i < n) { acc = f64_max(acc, vec_get(tp, i)); i = i + 1; }
    return acc;
}

# max_true_peak_db() -- max true peak dB across channels, folded from -inf.
#must_use
fn dhvani_dynamics_max_true_peak_db(self) {
    var tpdb = DhDynamicsAnalysis_true_peak_db(self);
    var n = vec_len(tpdb);
    var acc = DH_NEG_INF;
    var i = 0;
    while (i < n) { acc = f64_max(acc, vec_get(tpdb, i)); i = i + 1; }
    return acc;
}

# mean_rms() -- mean of per-channel rms (linear); 0.0 for empty.
#must_use
fn dhvani_dynamics_mean_rms(self) {
    var rms = DhDynamicsAnalysis_rms(self);
    var n = vec_len(rms);
    if (n == 0) { return 0; }
    var sum = 0;
    var i = 0;
    while (i < n) { sum = f64_add(sum, vec_get(rms, i)); i = i + 1; }
    return f64_div(sum, f64_from(n));
}

# mean_crest_factor_db() -- mean of per-channel crest factor dB; 0.0 for empty.
#must_use
fn dhvani_dynamics_mean_crest_factor_db(self) {
    var cf = DhDynamicsAnalysis_crest_factor_db(self);
    var n = vec_len(cf);
    if (n == 0) { return 0; }
    var sum = 0;
    var i = 0;
    while (i < n) { sum = f64_add(sum, vec_get(cf, i)); i = i + 1; }
    return f64_div(sum, f64_from(n));
}

# analyze_dynamics(buf) -- comprehensive per-channel dynamics analysis.
#must_use
fn dhvani_analyze_dynamics(buf) {
    var ch = DhAudioBuffer_channels(buf);
    var frames = DhAudioBuffer_frames(buf);
    var samples = DhAudioBuffer_samples(buf);

    var peak = dh_vec_zeros(ch);
    var rms_sum = dh_vec_zeros(ch);
    var true_peak = dh_vec_zeros(ch);

    # Per-channel peak and RMS accumulation.
    var c = 0;
    while (c < ch) {
        var frame = 0;
        while (frame < frames) {
            var s = vec_get(samples, frame * ch + c);
            var absv = f64_abs(s);
            if (f64_gt(absv, vec_get(peak, c)) == 1) { vec_set(peak, c, absv); }
            vec_set(rms_sum, c, f64_add(vec_get(rms_sum, c), f64_mul(s, s)));
            frame = frame + 1;
        }

        # True peak: 4x oversampled inter-sample detection using 4-point cubic
        # Hermite (Catmull-Rom) interpolation.
        if (frames > 1) {
            var tp = vec_get(peak, c);
            var f2 = 0;
            var last = frames - 1;
            while (f2 < last) {
                var s0 = vec_get(samples, f2 * ch + c);
                var s1 = vec_get(samples, (f2 + 1) * ch + c);
                var sm1 = s0;
                if (f2 > 0) { sm1 = vec_get(samples, (f2 - 1) * ch + c); }
                var s2 = s1;
                if ((f2 + 2) < frames) { s2 = vec_get(samples, (f2 + 2) * ch + c); }
                var k = 1;
                while (k < 4) {
                    var t = f64_div(f64_from(k), 4.0);
                    var t2 = f64_mul(t, t);
                    var t3 = f64_mul(t2, t);
                    # 0.5 * (2*s0 + (-sm1 + s1)*t
                    #        + (2*sm1 - 5*s0 + 4*s1 - s2)*t2
                    #        + (-sm1 + 3*s0 - 3*s1 + s2)*t3)
                    var c0 = f64_mul(2.0, s0);
                    var c1 = f64_mul(f64_add(f64_neg(sm1), s1), t);
                    var c2quad = f64_sub(f64_add(f64_sub(f64_mul(2.0, sm1), f64_mul(5.0, s0)), f64_mul(4.0, s1)), s2);
                    var c2t = f64_mul(c2quad, t2);
                    var c3cub = f64_add(f64_sub(f64_add(f64_neg(sm1), f64_mul(3.0, s0)), f64_mul(3.0, s1)), s2);
                    var c3t = f64_mul(c3cub, t3);
                    var interp = f64_mul(0.5, f64_add(f64_add(f64_add(c0, c1), c2t), c3t));
                    tp = f64_max(tp, f64_abs(interp));
                    k = k + 1;
                }
                f2 = f2 + 1;
            }
            vec_set(true_peak, c, tp);
        }
        elif (frames == 1) {
            vec_set(true_peak, c, vec_get(peak, c));
        }

        c = c + 1;
    }

    # rms per channel: sqrt(sum / frames), or 0.0 when frames == 0.
    var rms = dh_vec_zeros(ch);
    var ri = 0;
    while (ri < ch) {
        if (frames > 0) {
            vec_set(rms, ri, f64_sqrt(f64_div(vec_get(rms_sum, ri), f64_from(frames))));
        }
        ri = ri + 1;
    }

    # dB conversions per channel.
    var peak_db = dh_vec_zeros(ch);
    var rms_db = dh_vec_zeros(ch);
    var true_peak_db = dh_vec_zeros(ch);
    var di = 0;
    while (di < ch) {
        vec_set(peak_db, di, amplitude_to_db(vec_get(peak, di)));
        vec_set(rms_db, di, amplitude_to_db(vec_get(rms, di)));
        vec_set(true_peak_db, di, amplitude_to_db(vec_get(true_peak, di)));
        di = di + 1;
    }

    # crest factor: p - r if r > -inf, else 0.0.
    var crest_factor_db = dh_vec_zeros(ch);
    var ci = 0;
    while (ci < ch) {
        var pval = vec_get(peak_db, ci);
        var rval = vec_get(rms_db, ci);
        if (f64_gt(rval, DH_NEG_INF) == 1) {
            vec_set(crest_factor_db, ci, f64_sub(pval, rval));
        }
        ci = ci + 1;
    }

    # Simplified LUFS: mean RMS-squared across channels in LUFS scale.
    var total_sq_sum = 0;
    var ti = 0;
    while (ti < ch) { total_sq_sum = f64_add(total_sq_sum, vec_get(rms_sum, ti)); ti = ti + 1; }
    var frames_denom = frames;
    if (frames_denom < 1) { frames_denom = 1; }
    var total_rms_sq = f64_div(total_sq_sum, f64_mul(f64_from(ch), f64_from(frames_denom)));
    var lufs = DH_NEG_INF;
    # 1e-20 threshold. log10(x) = ln(x)/ln(10) (no f64_log10 in stdlib).
    if (f64_gt(total_rms_sq, 0x3BC79CA10C924223) == 1) {
        var log10_rms = f64_div(f64_ln(total_rms_sq), F64_LN10);
        lufs = f64_add(f64_neg(0.691), f64_mul(10.0, log10_rms));
    }

    # dynamic range: max peak dB - mean RMS dB.
    var max_peak_db = DH_NEG_INF;
    var mi = 0;
    while (mi < ch) { max_peak_db = f64_max(max_peak_db, vec_get(peak_db, mi)); mi = mi + 1; }
    var mean_rms_db = DH_NEG_INF;
    if (ch > 0) {
        var sum_rms_db = 0;
        var mj = 0;
        while (mj < ch) { sum_rms_db = f64_add(sum_rms_db, vec_get(rms_db, mj)); mj = mj + 1; }
        mean_rms_db = f64_div(sum_rms_db, f64_from(ch));
    }
    var dynamic_range_db = f64_sub(max_peak_db, mean_rms_db);

    var self = alloc(sizeof(DhDynamicsAnalysis));
    DhDynamicsAnalysis_set_peak(self, peak);
    DhDynamicsAnalysis_set_peak_db(self, peak_db);
    DhDynamicsAnalysis_set_true_peak(self, true_peak);
    DhDynamicsAnalysis_set_true_peak_db(self, true_peak_db);
    DhDynamicsAnalysis_set_rms(self, rms);
    DhDynamicsAnalysis_set_rms_db(self, rms_db);
    DhDynamicsAnalysis_set_crest_factor_db(self, crest_factor_db);
    DhDynamicsAnalysis_set_lufs(self, lufs);
    DhDynamicsAnalysis_set_dynamic_range_db(self, dynamic_range_db);
    DhDynamicsAnalysis_set_frame_count(self, frames);
    DhDynamicsAnalysis_set_channel_count(self, ch);
    return self;
}

# --- stft.cyr ---

# stft.cyr -- Short-Time Fourier Transform for spectrogram generation.
# Ports rust-old/src/analysis/stft.rs. L1: deps error + simd + buffer + analysis
# + fft (dhvani_fft_in_place). Hann-windowed overlapping frames -> per-frame
# magnitude spectra. Spectrogram + StftProcessor.
#
# Spectrogram.frames was Vec<Vec<f32>>: here a `vec` of frame handles, each a
# `vec` of f64 magnitudes (window_size/2 bins). num_bins/sample_rate are integer
# counts; freq_resolution/time_resolution are f64. Fallible stft()/new()/compute()
# return a valid handle, or 0 (null) on error (empty buffer / bad window / hop=0).

#derive(accessors)
struct DhSpectrogram { frames; num_bins; freq_resolution; time_resolution; sample_rate; }

# ---- Spectrogram accessors / methods ----
#inline
#must_use
fn dhvani_spectrogram_frames(self) { return DhSpectrogram_frames(self); }
#inline
#must_use
fn dhvani_spectrogram_num_bins(self) { return DhSpectrogram_num_bins(self); }
#inline
#must_use
fn dhvani_spectrogram_freq_resolution(self) { return DhSpectrogram_freq_resolution(self); }
#inline
#must_use
fn dhvani_spectrogram_time_resolution(self) { return DhSpectrogram_time_resolution(self); }
#inline
#must_use
fn dhvani_spectrogram_sample_rate(self) { return DhSpectrogram_sample_rate(self); }

# number of time frames.
#inline
#must_use
fn dhvani_spectrogram_num_frames(self) { return vec_len(DhSpectrogram_frames(self)); }

# frequency of a bin index (Hz).
#must_use
fn dhvani_spectrogram_bin_frequency(self, bin) {
    return f64_mul(f64_from(bin), DhSpectrogram_freq_resolution(self));
}

# time in seconds of a frame index.
#must_use
fn dhvani_spectrogram_frame_time(self, frame) {
    return f64_mul(f64_from(frame), DhSpectrogram_time_resolution(self));
}

# the magnitude `vec` for one frame index.
#inline
#must_use
fn dhvani_spectrogram_frame(self, frame) {
    return vec_get(DhSpectrogram_frames(self), frame);
}

# ---- Hann window builder: 0.5 * (1 - cos(2*pi*i/(window_size-1))) ----
#must_use
fn dhvani_stft_hann_window(window_size) {
    var window = dh_vec_zeros(window_size);
    var denom = f64_from(window_size - 1);
    var i = 0;
    while (i < window_size) {
        var w = f64_mul(0.5, f64_sub(1.0, f64_cos(f64_div(f64_mul(f64_mul(2.0, F64_PI), f64_from(i)), denom))));
        vec_set(window, i, w);
        i = i + 1;
    }
    return window;
}

# shared STFT core: given a precomputed window (len window_size), a buffer, and a
# hop_size, build the frames vec. Preallocates real/imag scratch ONCE.
#must_use
fn dhvani_stft_run(window, window_size, buf, hop_size) {
    var num_bins = window_size / 2;
    var samples = DhAudioBuffer_samples(buf);
    var ch = DhAudioBuffer_channels(buf);
    var total_mono_frames = DhAudioBuffer_frames(buf);

    var frames = vec_new();
    var pos = 0;
    # Pre-allocate scratch buffers ONCE to avoid per-frame heap allocation.
    var real = dh_vec_zeros(window_size);
    var imag = dh_vec_zeros(window_size);

    while ((pos + window_size) <= total_mono_frames) {
        # zero the scratch (real.fill(0.0); imag.fill(0.0))
        var z = 0;
        while (z < window_size) { vec_set(real, z, 0); vec_set(imag, z, 0); z = z + 1; }

        var i = 0;
        while (i < window_size) {
            vec_set(real, i, f64_mul(vec_get(samples, (pos + i) * ch), vec_get(window, i)));
            i = i + 1;
        }

        if (dhvani_fft_in_place(real, imag) == 0) {
            vec_push(frames, dh_vec_zeros(num_bins));
            pos = pos + hop_size;
        } else {
            var magnitudes = dh_vec_zeros(num_bins);
            var k = 0;
            while (k < num_bins) {
                var re = vec_get(real, k);
                var im = vec_get(imag, k);
                var mag = f64_div(f64_sqrt(f64_add(f64_mul(re, re), f64_mul(im, im))), f64_from(window_size));
                vec_set(magnitudes, k, mag);
                k = k + 1;
            }
            vec_push(frames, magnitudes);
            pos = pos + hop_size;
        }
    }
    return frames;
}

# build the Spectrogram result struct from computed frames + metadata.
#must_use
fn dhvani_stft_make_spectrogram(frames, num_bins, sample_rate, window_size, hop_size) {
    var self = alloc(sizeof(DhSpectrogram));
    DhSpectrogram_set_frames(self, frames);
    DhSpectrogram_set_num_bins(self, num_bins);
    DhSpectrogram_set_freq_resolution(self, f64_div(f64_from(sample_rate), f64_from(window_size)));
    DhSpectrogram_set_time_resolution(self, f64_div(f64_from(hop_size), f64_from(sample_rate)));
    DhSpectrogram_set_sample_rate(self, sample_rate);
    return self;
}

# stft(buf, window_size, hop_size) -- Hann-windowed spectrogram, or 0 on error.
# Errors: empty buffer, window_size not a power of two, window_size < 4, hop_size == 0.
#must_use
fn dhvani_stft(buf, window_size, hop_size) {
    if (vec_len(DhAudioBuffer_samples(buf)) == 0) { return 0; }
    if (dh_is_pow2(window_size) == 0) { return 0; }
    if (window_size < 4) { return 0; }
    if (hop_size == 0) { return 0; }
    var num_bins = window_size / 2;
    var window = dhvani_stft_hann_window(window_size);
    var frames = dhvani_stft_run(window, window_size, buf, hop_size);
    return dhvani_stft_make_spectrogram(frames, num_bins, DhAudioBuffer_sample_rate(buf), window_size, hop_size);
}

# ---- StftProcessor: cached Hann window ----
#derive(accessors)
struct DhStftProcessor { window; window_size; }

# new(window_size) -- precompute the Hann window; 0 if window not pow2 or < 4.
#must_use
fn dhvani_stftproc_new(window_size) {
    if (dh_is_pow2(window_size) == 0) { return 0; }
    if (window_size < 4) { return 0; }
    var self = alloc(sizeof(DhStftProcessor));
    DhStftProcessor_set_window(self, dhvani_stft_hann_window(window_size));
    DhStftProcessor_set_window_size(self, window_size);
    return self;
}

# compute(self, buf, hop_size) -- spectrogram using the cached window, or 0 on error.
# Errors: empty buffer, hop_size == 0.
#must_use
fn dhvani_stftproc_compute(self, buf, hop_size) {
    if (vec_len(DhAudioBuffer_samples(buf)) == 0) { return 0; }
    if (hop_size == 0) { return 0; }
    var window_size = DhStftProcessor_window_size(self);
    var num_bins = window_size / 2;
    var frames = dhvani_stft_run(DhStftProcessor_window(self), window_size, buf, hop_size);
    return dhvani_stft_make_spectrogram(frames, num_bins, DhAudioBuffer_sample_rate(buf), window_size, hop_size);
}

# window size.
#inline
#must_use
fn dhvani_stftproc_window_size(self) { return DhStftProcessor_window_size(self); }

# --- chroma.cyr ---

# chroma.cyr -- Chromagram: 12 pitch-class energies from the FFT spectrum.
# Ports rust-old/src/analysis/chroma.rs. L1: deps error + simd + buffer +
# abaco + analysis (Spectrum) + fft (spectrum_fft). Maps each FFT bin frequency
# to a pitch class (round(12 * log2(freq / C0)) mod 12), accumulates squared
# magnitude (energy) per class, normalizes to 0..1. serde + Display dropped.

# ---- PITCH_CLASSES lookup (was [&str; 12]) ----
#must_use
fn dhvani_chroma_pitch_class_name(idx) {
    if (idx == 0)  { return "C"; }
    if (idx == 1)  { return "C#"; }
    if (idx == 2)  { return "D"; }
    if (idx == 3)  { return "D#"; }
    if (idx == 4)  { return "E"; }
    if (idx == 5)  { return "F"; }
    if (idx == 6)  { return "F#"; }
    if (idx == 7)  { return "G"; }
    if (idx == 8)  { return "G#"; }
    if (idx == 9)  { return "A"; }
    if (idx == 10) { return "A#"; }
    if (idx == 11) { return "B"; }
    return "unknown";
}

#derive(accessors)
struct DhChromagram { chroma; }

# from_array(chroma) -- wrap a 12-slot `vec` of pitch-class energies.
#must_use
fn dhvani_chromagram_from_array(chroma) {
    var self = alloc(sizeof(DhChromagram));
    DhChromagram_set_chroma(self, chroma);
    return self;
}

# chroma() -- energy per pitch class (0=C, ..., 11=B). Normalized 0..1.
#inline
#must_use
fn dhvani_chromagram_chroma(self) { return DhChromagram_chroma(self); }

# dominant_class() -- index of the dominant (max-energy) pitch class.
# argmax with partial_cmp: first index reached whose value is strictly greater
# than the running best wins (ties keep the earlier index), starting from 0.
#must_use
fn dhvani_chromagram_dominant_class(self) {
    var chroma = DhChromagram_chroma(self);
    var best_idx = 0;
    var best_val = vec_get(chroma, 0);
    var i = 1;
    while (i < 12) {
        var v = vec_get(chroma, i);
        if (f64_gt(v, best_val) == 1) { best_val = v; best_idx = i; }
        i = i + 1;
    }
    return best_idx;
}

# dominant_name() -- name of the dominant pitch class.
#must_use
fn dhvani_chromagram_dominant_name(self) {
    return dhvani_chroma_pitch_class_name(dhvani_chromagram_dominant_class(self));
}

# chromagram(buf, window_size) -- compute a chromagram from an audio buffer.
# Maps FFT bin freqs to 12 pitch classes: class = round(12*log2(freq/C0)) mod 12
# with C0 = 16.3516 Hz. Bins below C0 or below 1 Hz are skipped. 0 on FFT error.
#must_use
fn dhvani_chroma_chromagram(buf, window_size) {
    var spec = dhvani_fft_spectrum(buf, window_size);
    if (spec == 0) { return 0; }
    var chroma = dh_vec_zeros(12);
    var c0 = 16.3516;
    var mags = dhvani_spectrum_magnitudes(spec);
    var num_bins = vec_len(mags);
    var bin = 0;
    while (bin < num_bins) {
        var mag = vec_get(mags, bin);
        var freq = dhvani_spectrum_bin_frequency(spec, bin);
        if (f64_lt(freq, c0) == 1) { bin = bin + 1; }
        elif (f64_lt(freq, 1.0) == 1) { bin = bin + 1; }
        else {
            var semitones = f64_mul(12.0, f64_log2(f64_div(freq, c0)));
            var rounded = f64_to(f64_round(semitones));
            # rem_euclid(12): always in [0, 11].
            var class = ((rounded % 12) + 12) % 12;
            vec_set(chroma, class, f64_add(vec_get(chroma, class), f64_mul(mag, mag)));
            bin = bin + 1;
        }
    }
    # Normalize to 0..1 by the peak.
    var max = 0;
    var m = 0;
    while (m < 12) { max = f64_max(max, vec_get(chroma, m)); m = m + 1; }
    if (f64_gt(max, 0) == 1) {
        var p = 0;
        while (p < 12) { vec_set(chroma, p, f64_div(vec_get(chroma, p), max)); p = p + 1; }
    }
    return dhvani_chromagram_from_array(chroma);
}

# --- convolution.cyr ---

# convolution.cyr -- FFT-based partitioned overlap-add convolution reverb.
# Ports rust-old/src/dsp/convolution.rs. L1: deps error + simd + buffer +
# analysis + fft (dhvani_fft_in_place, dh_next_pow2).
#
# Rust Vec<(Vec<f64>,Vec<f64>)> -> a `vec` of DhComplexBuf handles (each holds a
# `real` vec + an `imag` vec). Vec<Vec<f32>>/Vec<Vec<f64>> -> a `vec` of vec
# handles. Vec<Vec<(...)>> (per-channel FDL) -> a `vec` of vec-of-DhComplexBuf.
# f32 samples stored as f64 slots (lossless for the tested values). serde +
# Display + Clone dropped. IFFT via the conjugate trick, exactly as the oracle.

# ---- ComplexBuf: one frequency-domain block (parallel real/imag vecs) ----
#derive(accessors)
struct DhComplexBuf { real; imag; }

#must_use
fn dhvani_cbuf_new(fft_size) {
    var self = alloc(sizeof(DhComplexBuf));
    DhComplexBuf_set_real(self, dh_vec_zeros(fft_size));
    DhComplexBuf_set_imag(self, dh_vec_zeros(fft_size));
    return self;
}

# fill both real/imag with zeros.
fn dhvani_cbuf_clear(self, fft_size) {
    var r = DhComplexBuf_real(self);
    var im = DhComplexBuf_imag(self);
    var i = 0;
    while (i < fft_size) { vec_set(r, i, 0); vec_set(im, i, 0); i = i + 1; }
    return 0;
}

# ---- ConvolutionReverb ----
#derive(accessors)
struct DhConvolutionReverb {
    fft_size;
    block_size;
    ir_partitions;
    input_buffers;
    overlap;
    write_pos;
    mix;
    channels;
    scratch_real;
    scratch_imag;
    fdl;
    fdl_pos;
}

# partition_ir(ir, block_size, fft_size) -> a `vec` of DhComplexBuf handles.
# Empty IR -> an empty vec. Each partition is a zero-padded, FFT'd block.
#must_use
fn dhvani_conv_partition_ir(ir, block_size, fft_size) {
    var parts = vec_new();
    var ir_len = vec_len(ir);
    if (ir_len == 0) { return parts; }
    # num_partitions = ir.len().div_ceil(block_size)
    var num_partitions = f64_to(f64_ceil(f64_div(f64_from(ir_len), f64_from(block_size))));
    var p = 0;
    while (p < num_partitions) {
        var start = p * block_size;
        var end = start + block_size;
        if (end > ir_len) { end = ir_len; }
        var cb = dhvani_cbuf_new(fft_size);
        var real = DhComplexBuf_real(cb);
        var i = start;
        while (i < end) { vec_set(real, i - start, vec_get(ir, i)); i = i + 1; }
        dhvani_fft_in_place(real, DhComplexBuf_imag(cb));
        vec_push(parts, cb);
        p = p + 1;
    }
    return parts;
}

# with_block_size(ir, block_size, mix, sample_rate) -> handle.
#must_use
fn dhvani_conv_with_block_size(ir_samples, block_size, mix, sample_rate) {
    var bs = block_size;
    if (bs < 1) { bs = 1; }
    bs = dh_next_pow2(bs);
    var fft_size = bs * 2;
    var ir_partitions = dhvani_conv_partition_ir(ir_samples, bs, fft_size);
    var self = alloc(sizeof(DhConvolutionReverb));
    DhConvolutionReverb_set_fft_size(self, fft_size);
    DhConvolutionReverb_set_block_size(self, bs);
    DhConvolutionReverb_set_ir_partitions(self, ir_partitions);
    DhConvolutionReverb_set_input_buffers(self, vec_new());
    DhConvolutionReverb_set_overlap(self, vec_new());
    DhConvolutionReverb_set_write_pos(self, 0);
    DhConvolutionReverb_set_mix(self, f64_clamp(mix, 0, 1.0));
    DhConvolutionReverb_set_channels(self, 0);
    DhConvolutionReverb_set_scratch_real(self, dh_vec_zeros(fft_size));
    DhConvolutionReverb_set_scratch_imag(self, dh_vec_zeros(fft_size));
    DhConvolutionReverb_set_fdl(self, vec_new());
    DhConvolutionReverb_set_fdl_pos(self, 0);
    return self;
}

# new(ir, mix, sample_rate) -- default block size 512.
#must_use
fn dhvani_conv_new(ir_samples, mix, sample_rate) {
    return dhvani_conv_with_block_size(ir_samples, 512, mix, sample_rate);
}

# set_mix(mix) -- clamp to [0,1].
fn dhvani_conv_set_mix(self, mix) {
    DhConvolutionReverb_set_mix(self, f64_clamp(mix, 0, 1.0));
    return 0;
}

#inline
#must_use
fn dhvani_conv_mix(self) { return DhConvolutionReverb_mix(self); }

# set_ir(ir) -- rebuild partitions from a new IR, then reset state.
fn dhvani_conv_set_ir(self, ir_samples) {
    var parts = dhvani_conv_partition_ir(ir_samples,
        DhConvolutionReverb_block_size(self), DhConvolutionReverb_fft_size(self));
    DhConvolutionReverb_set_ir_partitions(self, parts);
    dhvani_conv_reset(self);
    return 0;
}

# reset() -- zero input buffers, overlap, FDL; reset write/fdl positions.
fn dhvani_conv_reset(self) {
    var fft_size = DhConvolutionReverb_fft_size(self);
    var block_size = DhConvolutionReverb_block_size(self);
    var input_buffers = DhConvolutionReverb_input_buffers(self);
    var nib = vec_len(input_buffers);
    var a = 0;
    while (a < nib) {
        var ib = vec_get(input_buffers, a);
        var ni = vec_len(ib);
        var bi = 0;
        while (bi < ni) { vec_set(ib, bi, 0); bi = bi + 1; }
        a = a + 1;
    }
    var overlap = DhConvolutionReverb_overlap(self);
    var nov = vec_len(overlap);
    var ci = 0;
    while (ci < nov) {
        var ov = vec_get(overlap, ci);
        var no = vec_len(ov);
        var di = 0;
        while (di < no) { vec_set(ov, di, 0); di = di + 1; }
        ci = ci + 1;
    }
    var fdl = DhConvolutionReverb_fdl(self);
    var nfd = vec_len(fdl);
    var ei = 0;
    while (ei < nfd) {
        var ch_fdl = vec_get(fdl, ei);
        var np = vec_len(ch_fdl);
        var fi = 0;
        while (fi < np) {
            dhvani_cbuf_clear(vec_get(ch_fdl, fi), fft_size);
            fi = fi + 1;
        }
        ei = ei + 1;
    }
    DhConvolutionReverb_set_write_pos(self, 0);
    DhConvolutionReverb_set_fdl_pos(self, 0);
    return 0;
}

# ensure_channels(ch) -- (re)allocate per-channel buffers when count changes.
fn dhvani_conv_ensure_channels(self, ch) {
    if (DhConvolutionReverb_channels(self) == ch) { return 0; }
    DhConvolutionReverb_set_channels(self, ch);
    var block_size = DhConvolutionReverb_block_size(self);
    var fft_size = DhConvolutionReverb_fft_size(self);
    var num_partitions = vec_len(DhConvolutionReverb_ir_partitions(self));
    if (num_partitions < 1) { num_partitions = 1; }
    var input_buffers = vec_new();
    var overlap = vec_new();
    var fdl = vec_new();
    var c = 0;
    while (c < ch) {
        vec_push(input_buffers, dh_vec_zeros(block_size));
        vec_push(overlap, dh_vec_zeros(fft_size));
        var ch_fdl = vec_new();
        var p = 0;
        while (p < num_partitions) {
            vec_push(ch_fdl, dhvani_cbuf_new(fft_size));
            p = p + 1;
        }
        vec_push(fdl, ch_fdl);
        c = c + 1;
    }
    DhConvolutionReverb_set_input_buffers(self, input_buffers);
    DhConvolutionReverb_set_overlap(self, overlap);
    DhConvolutionReverb_set_fdl(self, fdl);
    DhConvolutionReverb_set_write_pos(self, 0);
    DhConvolutionReverb_set_fdl_pos(self, 0);
    return 0;
}

# process_block(channel) -- partitioned convolution for one channel's block.
fn dhvani_conv_process_block(self, channel) {
    var fft_size = DhConvolutionReverb_fft_size(self);
    var block_size = DhConvolutionReverb_block_size(self);
    var ir_partitions = DhConvolutionReverb_ir_partitions(self);
    var num_partitions = vec_len(ir_partitions);
    var fdl_pos = DhConvolutionReverb_fdl_pos(self);
    var fdl = DhConvolutionReverb_fdl(self);
    var ch_fdl = vec_get(fdl, channel);
    var input_ch = vec_get(DhConvolutionReverb_input_buffers(self), channel);

    var scratch_real = DhConvolutionReverb_scratch_real(self);
    var scratch_imag = DhConvolutionReverb_scratch_imag(self);
    # FFT the input block (zero-padded)
    var z = 0;
    while (z < fft_size) { vec_set(scratch_real, z, 0); vec_set(scratch_imag, z, 0); z = z + 1; }
    var i = 0;
    while (i < block_size) { vec_set(scratch_real, i, vec_get(input_ch, i)); i = i + 1; }
    if (dhvani_fft_in_place(scratch_real, scratch_imag) == 0) { return 0; }

    # Store in the frequency delay line (copy scratch into fdl[fdl_pos]).
    var slot = vec_get(ch_fdl, fdl_pos);
    var slot_r = DhComplexBuf_real(slot);
    var slot_i = DhComplexBuf_imag(slot);
    var cp = 0;
    while (cp < fft_size) {
        vec_set(slot_r, cp, vec_get(scratch_real, cp));
        vec_set(slot_i, cp, vec_get(scratch_imag, cp));
        cp = cp + 1;
    }

    # Accumulate: sum over all partitions (FDL[pos-k] * IR[k]).
    var acc_real = dh_vec_zeros(fft_size);
    var acc_imag = dh_vec_zeros(fft_size);
    var k = 0;
    while (k < num_partitions) {
        var fdl_idx = (fdl_pos + num_partitions - k) % num_partitions;
        var fslot = vec_get(ch_fdl, fdl_idx);
        var fdl_r = DhComplexBuf_real(fslot);
        var fdl_i = DhComplexBuf_imag(fslot);
        var iref = vec_get(ir_partitions, k);
        var ir_r = DhComplexBuf_real(iref);
        var ir_i = DhComplexBuf_imag(iref);
        var bin = 0;
        while (bin < fft_size) {
            var fr = vec_get(fdl_r, bin);
            var fi = vec_get(fdl_i, bin);
            var cr = vec_get(ir_r, bin);
            var di = vec_get(ir_i, bin);
            # (a+bi)(c+di) = (ac-bd) + (ad+bc)i
            vec_set(acc_real, bin, f64_add(vec_get(acc_real, bin), f64_sub(f64_mul(fr, cr), f64_mul(fi, di))));
            vec_set(acc_imag, bin, f64_add(vec_get(acc_imag, bin), f64_add(f64_mul(fr, di), f64_mul(fi, cr))));
            bin = bin + 1;
        }
        k = k + 1;
    }

    # IFFT via conjugate: IFFT(X) = conj(FFT(conj(X))) / N
    var n2 = 0;
    while (n2 < fft_size) { vec_set(acc_imag, n2, f64_neg(vec_get(acc_imag, n2))); n2 = n2 + 1; }
    if (dhvani_fft_in_place(acc_real, acc_imag) == 0) { return 0; }
    var scale = f64_div(1.0, f64_from(fft_size));

    # Overlap-add into output.
    var ov = vec_get(DhConvolutionReverb_overlap(self), channel);
    var o = 0;
    while (o < fft_size) {
        vec_set(ov, o, f64_add(vec_get(ov, o), f64_mul(vec_get(acc_real, o), scale)));
        o = o + 1;
    }
    return 0;
}

# process(buf) -- convolution reverb in place. No-op if IR is empty.
#inline
fn dhvani_conv_process(self, buf) {
    var ir_partitions = DhConvolutionReverb_ir_partitions(self);
    if (vec_len(ir_partitions) == 0) { return 0; }

    var ch = DhAudioBuffer_channels(buf);
    dhvani_conv_ensure_channels(self, ch);

    var mix = DhConvolutionReverb_mix(self);
    var dry = f64_sub(1.0, mix);
    var frames = DhAudioBuffer_frames(buf);
    var samples = DhAudioBuffer_samples(buf);
    var samples_len = vec_len(samples);
    var block_size = DhConvolutionReverb_block_size(self);
    var fft_size = DhConvolutionReverb_fft_size(self);
    var input_buffers = DhConvolutionReverb_input_buffers(self);
    var num_partitions = vec_len(ir_partitions);
    if (num_partitions < 1) { num_partitions = 1; }

    var frame = 0;
    while (frame < frames) {
        # Fill input block.
        var write_pos = DhConvolutionReverb_write_pos(self);
        var remaining_in_block = block_size - write_pos;
        var to_copy = remaining_in_block;
        var avail = frames - frame;
        if (avail < to_copy) { to_copy = avail; }

        var c0 = 0;
        while (c0 < ch) {
            var ibuf = vec_get(input_buffers, c0);
            var ii = 0;
            while (ii < to_copy) {
                vec_set(ibuf, write_pos + ii, vec_get(samples, (frame + ii) * ch + c0));
                ii = ii + 1;
            }
            c0 = c0 + 1;
        }
        write_pos = write_pos + to_copy;
        DhConvolutionReverb_set_write_pos(self, write_pos);

        # When the block is full, process it.
        if (write_pos >= block_size) {
            var cb = 0;
            while (cb < ch) {
                dhvani_conv_process_block(self, cb);
                cb = cb + 1;
            }
            DhConvolutionReverb_set_fdl_pos(self, (DhConvolutionReverb_fdl_pos(self) + 1) % num_partitions);
            DhConvolutionReverb_set_write_pos(self, 0);

            # Write output: overlap[0..block_size] is the current block output.
            var block_start = frame + to_copy - block_size;
            var cw = 0;
            while (cw < ch) {
                var ov = vec_get(DhConvolutionReverb_overlap(self), cw);
                var oi = 0;
                while (oi < block_size) {
                    var src_idx = (block_start + oi) * ch + cw;
                    if (src_idx < samples_len) {
                        var wet = vec_get(ov, oi);
                        var cur = vec_get(samples, src_idx);
                        vec_set(samples, src_idx, f64_add(f64_mul(cur, dry), f64_mul(wet, mix)));
                    }
                    oi = oi + 1;
                }
                # Shift overlap: move tail forward.
                var tail_len = fft_size - block_size;
                var ti = 0;
                while (ti < tail_len) {
                    vec_set(ov, ti, vec_get(ov, block_size + ti));
                    ti = ti + 1;
                }
                var tj = tail_len;
                while (tj < fft_size) { vec_set(ov, tj, 0); tj = tj + 1; }
                cw = cw + 1;
            }
        }

        frame = frame + to_copy;
    }
    return 0;
}

# --- noise_reduction.cyr ---

# noise_reduction.cyr -- spectral noise reduction (STFT soft gating).
# Ports rust-old/src/dsp/noise_reduction.rs. L1: deps error + simd + buffer +
# analysis + fft (dhvani_fft_in_place). NoiseReducer preallocates window/real/
# imag/avg_magnitude scratch once in `new`; `process` reuses them across calls.
#
# Two-pass per channel: pass 1 estimates the average magnitude spectrum (noise
# floor); pass 2 soft-gates bins below threshold and rebuilds via overlap-add.
# IFFT via conjugate: IFFT(X) = conj(FFT(conj(X))) / N. Rust stored f32 samples
# (cast `as f64` before windowing) -- the Cyrius port is f64 throughout, so the
# window multiply is direct. serde/Debug/Clone/Default dropped.

var DH_NR_WINDOW_SIZE = 2048;
var DH_NR_HOP_SIZE    = 1024;   # WINDOW_SIZE / 2 -- 50% overlap
var DH_NR_NUM_BINS    = 1024;   # WINDOW_SIZE / 2

#derive(accessors)
struct DhNoiseReducer { window; real; imag; avg_magnitude; }

# new() -- allocate scratch: Hann window + zeroed real/imag (WINDOW_SIZE) +
# zeroed avg_magnitude (NUM_BINS).
#must_use
fn dhvani_noise_reducer_new() {
    var window = vec_new();
    var denom = DH_NR_WINDOW_SIZE - 1;
    var i = 0;
    while (i < DH_NR_WINDOW_SIZE) {
        var w = f64_mul(0.5, f64_sub(1.0, f64_cos(f64_div(f64_mul(f64_mul(2.0, F64_PI), f64_from(i)), f64_from(denom)))));
        vec_push(window, w);
        i = i + 1;
    }
    var self = alloc(sizeof(DhNoiseReducer));
    DhNoiseReducer_set_window(self, window);
    DhNoiseReducer_set_real(self, dh_vec_zeros(DH_NR_WINDOW_SIZE));
    DhNoiseReducer_set_imag(self, dh_vec_zeros(DH_NR_WINDOW_SIZE));
    DhNoiseReducer_set_avg_magnitude(self, dh_vec_zeros(DH_NR_NUM_BINS));
    return self;
}

# fill a vec's first `n` slots with 0.
fn dh_nr_fill_zero(v, n) {
    var i = 0;
    while (i < n) { vec_set(v, i, 0); i = i + 1; }
    return 0;
}

# process_channel(self, samples, strength) -- gate one mono `vec` in place.
fn dhvani_noise_reducer_process_channel(self, samples, strength) {
    var n = vec_len(samples);
    if (n < DH_NR_WINDOW_SIZE) { return 0; }

    var window = DhNoiseReducer_window(self);
    var real = DhNoiseReducer_real(self);
    var imag = DhNoiseReducer_imag(self);
    var avg = DhNoiseReducer_avg_magnitude(self);

    # Pass 1: estimate average magnitude spectrum (noise floor)
    dh_nr_fill_zero(avg, DH_NR_NUM_BINS);
    var frame_count = 0;
    var pos = 0;
    while (pos + DH_NR_WINDOW_SIZE <= n) {
        dh_nr_fill_zero(real, DH_NR_WINDOW_SIZE);
        dh_nr_fill_zero(imag, DH_NR_WINDOW_SIZE);
        var i1 = 0;
        while (i1 < DH_NR_WINDOW_SIZE) {
            vec_set(real, i1, f64_mul(vec_get(samples, pos + i1), vec_get(window, i1)));
            i1 = i1 + 1;
        }
        if (dhvani_fft_in_place(real, imag) == 0) {
            pos = pos + DH_NR_HOP_SIZE;
        } else {
            var k1 = 0;
            while (k1 < DH_NR_NUM_BINS) {
                var re1 = vec_get(real, k1);
                var im1 = vec_get(imag, k1);
                vec_set(avg, k1, f64_add(vec_get(avg, k1), f64_sqrt(f64_add(f64_mul(re1, re1), f64_mul(im1, im1)))));
                k1 = k1 + 1;
            }
            frame_count = frame_count + 1;
            pos = pos + DH_NR_HOP_SIZE;
        }
    }

    if (frame_count == 0) { return 0; }
    var fc = f64_from(frame_count);
    var mi = 0;
    while (mi < DH_NR_NUM_BINS) {
        vec_set(avg, mi, f64_div(vec_get(avg, mi), fc));
        mi = mi + 1;
    }

    # Pass 2: gate + reconstruct via overlap-add. Per-channel length buffers.
    var output = dh_vec_zeros(n);
    var window_sum = dh_vec_zeros(n);
    pos = 0;
    while (pos + DH_NR_WINDOW_SIZE <= n) {
        dh_nr_fill_zero(real, DH_NR_WINDOW_SIZE);
        dh_nr_fill_zero(imag, DH_NR_WINDOW_SIZE);
        var i2 = 0;
        while (i2 < DH_NR_WINDOW_SIZE) {
            vec_set(real, i2, f64_mul(vec_get(samples, pos + i2), vec_get(window, i2)));
            i2 = i2 + 1;
        }
        if (dhvani_fft_in_place(real, imag) == 0) {
            pos = pos + DH_NR_HOP_SIZE;
        } else {
            # Soft gate: attenuate bins below threshold
            var gate_factor = f64_mul(strength, 1.5);
            var k2 = 0;
            while (k2 < DH_NR_NUM_BINS) {
                var re2 = vec_get(real, k2);
                var im2 = vec_get(imag, k2);
                var mag = f64_sqrt(f64_add(f64_mul(re2, re2), f64_mul(im2, im2)));
                var threshold = f64_mul(vec_get(avg, k2), gate_factor);
                if (f64_lt(mag, threshold) == 1) {
                    if (f64_gt(threshold, 0.0) == 1) {
                        var attenuation = f64_div(mag, threshold);
                        vec_set(real, k2, f64_mul(re2, attenuation));
                        vec_set(imag, k2, f64_mul(im2, attenuation));
                        # Mirror for negative frequencies
                        if (k2 > 0) {
                            if (k2 < DH_NR_NUM_BINS) {
                                var mirror = DH_NR_WINDOW_SIZE - k2;
                                vec_set(real, mirror, f64_mul(vec_get(real, mirror), attenuation));
                                vec_set(imag, mirror, f64_mul(vec_get(imag, mirror), attenuation));
                            }
                        }
                    }
                }
                k2 = k2 + 1;
            }

            # Inverse FFT (conjugate: negate imag, forward FFT, divide by N)
            var ci = 0;
            while (ci < DH_NR_WINDOW_SIZE) {
                vec_set(imag, ci, f64_neg(vec_get(imag, ci)));
                ci = ci + 1;
            }
            if (dhvani_fft_in_place(real, imag) == 0) {
                pos = pos + DH_NR_HOP_SIZE;
            } else {
                var scale = f64_div(1.0, f64_from(DH_NR_WINDOW_SIZE));
                var ri = 0;
                while (ri < DH_NR_WINDOW_SIZE) {
                    vec_set(real, ri, f64_mul(vec_get(real, ri), scale));
                    ri = ri + 1;
                }
                # Overlap-add with window
                var oi = 0;
                while (oi < DH_NR_WINDOW_SIZE) {
                    var wv = vec_get(window, oi);
                    var op = pos + oi;
                    vec_set(output, op, f64_add(vec_get(output, op), f64_mul(vec_get(real, oi), wv)));
                    vec_set(window_sum, op, f64_add(vec_get(window_sum, op), f64_mul(wv, wv)));
                    oi = oi + 1;
                }
                pos = pos + DH_NR_HOP_SIZE;
            }
        }
    }

    # Normalize by window sum and write back
    var ni = 0;
    while (ni < n) {
        if (f64_gt(vec_get(window_sum, ni), 0.0000000001) == 1) {
            vec_set(samples, ni, f64_div(vec_get(output, ni), vec_get(window_sum, ni)));
        }
        if (dhvani_is_finite(vec_get(samples, ni)) == 0) {
            vec_set(samples, ni, 0);
        }
        ni = ni + 1;
    }
    return 0;
}

# process(self, buf, strength) -- apply spectral noise reduction in place.
fn dhvani_noise_reducer_process(self, buf, strength) {
    var s = f64_clamp(strength, 0.0, 1.0);
    var frames = DhAudioBuffer_frames(buf);
    var samples = DhAudioBuffer_samples(buf);
    if (frames < DH_NR_WINDOW_SIZE) {
        # Too short for STFT -- fall back to a simple amplitude gate.
        var threshold = f64_mul(s, 0.05);
        var slen = vec_len(samples);
        var si = 0;
        while (si < slen) {
            if (f64_lt(f64_abs(vec_get(samples, si)), threshold) == 1) {
                vec_set(samples, si, 0);
            }
            si = si + 1;
        }
        return 0;
    }

    var ch = DhAudioBuffer_channels(buf);

    # Process each channel independently
    var c = 0;
    while (c < ch) {
        # Extract mono channel
        var mono = vec_new();
        var f = 0;
        while (f < frames) {
            vec_push(mono, vec_get(samples, f * ch + c));
            f = f + 1;
        }
        dhvani_noise_reducer_process_channel(self, mono, s);
        # Write back
        var fw = 0;
        while (fw < frames) {
            vec_set(samples, fw * ch + c, vec_get(mono, fw));
            fw = fw + 1;
        }
        c = c + 1;
    }
    return 0;
}

# noise_reduce(buf, strength) -- one-shot spectral noise reduction in place.
fn dhvani_noise_reduce(buf, strength) {
    var reducer = dhvani_noise_reducer_new();
    dhvani_noise_reducer_process(reducer, buf, strength);
    return 0;
}

# --- eq.cyr ---

# eq.cyr -- Parametric EQ: N-band biquad cascade with configurable band types.
# Ports rust-old/src/dsp/eq.rs. L1: deps error + simd + buffer + abaco + biquad.
#
# BandType enum -> integer code. EqBandConfig -> struct. ParametricEq holds a
# vec of band configs (parallel) and a vec of biquad filter handles, plus a
# struct-owned dry scratch vec (allocated once, reused per process() call) so the
# dry/wet mix path never clones buf.samples per call (alloc-hot: the bump
# allocator never frees). band()/set_band() Option -> index-valid / sentinel.
# to_filter_type() -> (biquad code, gain_db) threaded as separate args to
# dhvani_biquad_new / dhvani_biquad_set_params. serde + Display dropped.

# ---- BandType (was enum) ----
var DH_BAND_PEAKING   = 0;
var DH_BAND_LOWSHELF  = 1;
var DH_BAND_HIGHSHELF = 2;
var DH_BAND_LOWPASS   = 3;
var DH_BAND_HIGHPASS  = 4;
var DH_BAND_BANDPASS  = 5;
var DH_BAND_NOTCH     = 6;

# BandType -> biquad filter-type code (was to_filter_type()). The gain_db payload
# of the Peaking/LowShelf/HighShelf variants is threaded separately (the biquad
# port already takes gain_db as its own arg).
#must_use
fn dhvani_eq_band_to_filter_type(band_type) {
    if (band_type == DH_BAND_PEAKING)   { return DH_BQ_PEAKING; }
    if (band_type == DH_BAND_LOWSHELF)  { return DH_BQ_LOWSHELF; }
    if (band_type == DH_BAND_HIGHSHELF) { return DH_BQ_HIGHSHELF; }
    if (band_type == DH_BAND_LOWPASS)   { return DH_BQ_LOWPASS; }
    if (band_type == DH_BAND_HIGHPASS)  { return DH_BQ_HIGHPASS; }
    if (band_type == DH_BAND_BANDPASS)  { return DH_BQ_BANDPASS; }
    return DH_BQ_NOTCH;
}

# ---- EqBandConfig ----
#derive(accessors)
struct DhEqBandConfig { band_type; freq_hz; gain_db; q; enabled; }

# new(band_type, freq_hz, gain_db, q, enabled).
#must_use
fn dhvani_eq_band_config_new(band_type, freq_hz, gain_db, q, enabled) {
    var cfg = alloc(sizeof(DhEqBandConfig));
    DhEqBandConfig_set_band_type(cfg, band_type);
    DhEqBandConfig_set_freq_hz(cfg, freq_hz);
    DhEqBandConfig_set_gain_db(cfg, gain_db);
    DhEqBandConfig_set_q(cfg, q);
    DhEqBandConfig_set_enabled(cfg, enabled);
    return cfg;
}

# --- EqBandConfig accessors ---
#inline
#must_use
fn dhvani_eq_band_config_band_type(cfg) { return DhEqBandConfig_band_type(cfg); }
#inline
#must_use
fn dhvani_eq_band_config_freq_hz(cfg) { return DhEqBandConfig_freq_hz(cfg); }
#inline
#must_use
fn dhvani_eq_band_config_gain_db(cfg) { return DhEqBandConfig_gain_db(cfg); }
#inline
#must_use
fn dhvani_eq_band_config_q(cfg) { return DhEqBandConfig_q(cfg); }
#inline
#must_use
fn dhvani_eq_band_config_enabled(cfg) { return DhEqBandConfig_enabled(cfg); }

# ---- ParametricEq ----
# configs + filts are parallel vecs (was Vec<(EqBandConfig, BiquadFilter)>).
# dry_scratch is a struct-owned f64 vec reused every process() call so the
# dry/wet path never allocates per call.
#derive(accessors)
struct DhParametricEq { configs; filts; sample_rate; channels; bypassed; mix; dry_scratch; }

# build a biquad filter for a band config.
#must_use
fn dhvani_eq_build_filter(cfg, sample_rate, channels) {
    return dhvani_biquad_new(
        dhvani_eq_band_to_filter_type(DhEqBandConfig_band_type(cfg)),
        DhEqBandConfig_gain_db(cfg),
        DhEqBandConfig_freq_hz(cfg),
        DhEqBandConfig_q(cfg),
        sample_rate,
        channels);
}

# new(bands, sample_rate, channels) -- bands is a vec of DhEqBandConfig handles.
#must_use
fn dhvani_eq_new(bands, sample_rate, channels) {
    var self = alloc(sizeof(DhParametricEq));
    var configs = vec_new();
    var filts = vec_new();
    var n = vec_len(bands);
    var i = 0;
    while (i < n) {
        var cfg = vec_get(bands, i);
        vec_push(configs, cfg);
        vec_push(filts, dhvani_eq_build_filter(cfg, sample_rate, channels));
        i = i + 1;
    }
    DhParametricEq_set_configs(self, configs);
    DhParametricEq_set_filts(self, filts);
    DhParametricEq_set_sample_rate(self, sample_rate);
    DhParametricEq_set_channels(self, channels);
    DhParametricEq_set_bypassed(self, 0);
    DhParametricEq_set_mix(self, 1.0);
    DhParametricEq_set_dry_scratch(self, vec_new());
    return self;
}

fn dhvani_eq_set_bypass(self, bypassed) {
    DhParametricEq_set_bypassed(self, bypassed);
    return 0;
}

#must_use
fn dhvani_eq_is_bypassed(self) {
    if (DhParametricEq_bypassed(self) == 1) { return 1; }
    return 0;
}

# process(buf) -- run each enabled band's filter in series, in place. When
# mix < 1.0, snapshot dry into the struct-owned scratch (reused, resized to the
# sample count) then blend dry*(1-mix) + wet*mix. No per-call allocation.
#inline
fn dhvani_eq_process(self, buf) {
    if (DhParametricEq_bypassed(self) == 1) { return 0; }
    var configs = DhParametricEq_configs(self);
    var filts = DhParametricEq_filts(self);
    var n = vec_len(configs);
    var mix = DhParametricEq_mix(self);
    if (f64_lt(mix, 1.0) == 1) {
        var samples = DhAudioBuffer_samples(buf);
        var len = vec_len(samples);
        var scratch = DhParametricEq_dry_scratch(self);
        var slen = vec_len(scratch);
        # resize scratch to len, reusing existing capacity.
        while (slen < len) { vec_push(scratch, 0); slen = slen + 1; }
        # copy dry samples into scratch.
        var k = 0;
        while (k < len) { vec_set(scratch, k, vec_get(samples, k)); k = k + 1; }
        var i = 0;
        while (i < n) {
            if (DhEqBandConfig_enabled(vec_get(configs, i)) == 1) {
                dhvani_biquad_process(vec_get(filts, i), buf);
            }
            i = i + 1;
        }
        var dry = f64_sub(1.0, mix);
        var j = 0;
        while (j < len) {
            var d = vec_get(scratch, j);
            var s = vec_get(samples, j);
            vec_set(samples, j, f64_add(f64_mul(d, dry), f64_mul(s, mix)));
            j = j + 1;
        }
    } else {
        var i2 = 0;
        while (i2 < n) {
            if (DhEqBandConfig_enabled(vec_get(configs, i2)) == 1) {
                dhvani_biquad_process(vec_get(filts, i2), buf);
            }
            i2 = i2 + 1;
        }
    }
    return 0;
}

# set_band(index, config) -- rebuild that band's coeffs, replace config. No-op
# if index out of range (Option::None branch).
fn dhvani_eq_set_band(self, index, config) {
    var configs = DhParametricEq_configs(self);
    if (index < vec_len(configs)) {
        var filt = vec_get(DhParametricEq_filts(self), index);
        dhvani_biquad_set_params(
            filt,
            dhvani_eq_band_to_filter_type(DhEqBandConfig_band_type(config)),
            DhEqBandConfig_gain_db(config),
            DhEqBandConfig_freq_hz(config),
            DhEqBandConfig_q(config));
        vec_set(configs, index, config);
    }
    return 0;
}

# add_band(config) -- append a new band + its filter.
fn dhvani_eq_add_band(self, config) {
    vec_push(DhParametricEq_configs(self), config);
    vec_push(DhParametricEq_filts(self),
             dhvani_eq_build_filter(config,
                                    DhParametricEq_sample_rate(self),
                                    DhParametricEq_channels(self)));
    return 0;
}

# remove_band(index) -- remove a band by index. No-op if out of range.
fn dhvani_eq_remove_band(self, index) {
    var configs = DhParametricEq_configs(self);
    if (index < vec_len(configs)) {
        vec_remove(configs, index);
        vec_remove(DhParametricEq_filts(self), index);
    }
    return 0;
}

# number of bands.
#inline
#must_use
fn dhvani_eq_band_count(self) {
    return vec_len(DhParametricEq_configs(self));
}

# band(index) -- config handle, or 0 (null / None) if index out of range.
#must_use
fn dhvani_eq_band(self, index) {
    var configs = DhParametricEq_configs(self);
    if (index < vec_len(configs)) {
        return vec_get(configs, index);
    }
    return 0;
}

# set_params(bands) -- replace all bands + rebuild all filters. bands is a vec
# of DhEqBandConfig handles.
fn dhvani_eq_set_params(self, bands) {
    var configs = vec_new();
    var filts = vec_new();
    var sr = DhParametricEq_sample_rate(self);
    var ch = DhParametricEq_channels(self);
    var n = vec_len(bands);
    var i = 0;
    while (i < n) {
        var cfg = vec_get(bands, i);
        vec_push(configs, cfg);
        vec_push(filts, dhvani_eq_build_filter(cfg, sr, ch));
        i = i + 1;
    }
    DhParametricEq_set_configs(self, configs);
    DhParametricEq_set_filts(self, filts);
    return 0;
}

# set_mix(mix) -- clamp to [0, 1].
fn dhvani_eq_set_mix(self, mix) {
    DhParametricEq_set_mix(self, f64_clamp(mix, 0, 1.0));
    return 0;
}

#inline
#must_use
fn dhvani_eq_mix(self) { return DhParametricEq_mix(self); }

# set_sample_rate(sample_rate) -- update rate, rebuild all coeffs.
fn dhvani_eq_set_sample_rate(self, sample_rate) {
    DhParametricEq_set_sample_rate(self, sample_rate);
    var configs = DhParametricEq_configs(self);
    var filts = DhParametricEq_filts(self);
    var n = vec_len(configs);
    var i = 0;
    while (i < n) {
        var cfg = vec_get(configs, i);
        var filt = vec_get(filts, i);
        dhvani_biquad_set_sample_rate(filt, sample_rate);
        dhvani_biquad_set_params(
            filt,
            dhvani_eq_band_to_filter_type(DhEqBandConfig_band_type(cfg)),
            DhEqBandConfig_gain_db(cfg),
            DhEqBandConfig_freq_hz(cfg),
            DhEqBandConfig_q(cfg));
        i = i + 1;
    }
    return 0;
}

# reset all filter states.
fn dhvani_eq_reset(self) {
    var filts = DhParametricEq_filts(self);
    var n = vec_len(filts);
    var i = 0;
    while (i < n) {
        dhvani_biquad_reset(vec_get(filts, i));
        i = i + 1;
    }
    return 0;
}

# --- deesser.cyr ---

# deesser.cyr -- De-esser: sibilance reduction via a biquad BandPass sidechain.
# Ports rust-old/src/dsp/deesser.rs. L2: deps error + simd + buffer +
# abaco (db_to_amplitude) + biquad (BandPass detector).
#
# Detects energy in the sibilant band (typ. 4-9 kHz) with a BandPass biquad
# sidechain and ducks the signal when it exceeds threshold. The Rust used a
# pre-allocated Vec<f32> `sidechain` reclaimed each call via std::mem::take
# wrapped in a temp AudioBuffer. The Cyrius port owns a `sidechain` vec AND a
# `scratch` AudioBuffer wrapper, both allocated once in new(); process() resizes
# the sidechain vec in place -- no per-call allocation on the hot path.
#
# DeEsserParams::validate -> DHVANI_ERR_NONE / negative DHVANI_ERR_INVALID_PARAMETER.
# new()/set_params Result -> handle-or-null / error code. serde + Display dropped.

#derive(accessors)
struct DhDeEsserParams { freq_hz; threshold_db; reduction_db; q; }

#derive(accessors)
struct DhDeEsser { params; detector; sidechain; scratch; sample_rate; channels; bypassed; }

# ---- DeEsserParams ----
#must_use
fn dhvani_deesserparams_new(freq_hz, threshold_db, reduction_db, q) {
    var p = alloc(sizeof(DhDeEsserParams));
    DhDeEsserParams_set_freq_hz(p, freq_hz);
    DhDeEsserParams_set_threshold_db(p, threshold_db);
    DhDeEsserParams_set_reduction_db(p, reduction_db);
    DhDeEsserParams_set_q(p, q);
    return p;
}

# default: freq 6000, threshold -20 dB, reduction 6 dB, q 2.
#must_use
fn dhvani_deesserparams_default() {
    return dhvani_deesserparams_new(6000.0, f64_neg(20.0), 6.0, 2.0);
}

# validate -- freq_hz>0, reduction_db>=0, q>0.
#must_use
fn dhvani_deesserparams_validate(p) {
    if (f64_le(DhDeEsserParams_freq_hz(p), 0) == 1)     { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_lt(DhDeEsserParams_reduction_db(p), 0) == 1) { return DHVANI_ERR_INVALID_PARAMETER; }
    if (f64_le(DhDeEsserParams_q(p), 0) == 1)            { return DHVANI_ERR_INVALID_PARAMETER; }
    return DHVANI_ERR_NONE;
}

# ---- DeEsser ----
# new(params, sample_rate, channels) -- handle, or 0 if params invalid.
#must_use
fn dhvani_deesser_new(params, sample_rate, channels) {
    if (dhvani_is_err(dhvani_deesserparams_validate(params)) == 1) { return 0; }
    var self = alloc(sizeof(DhDeEsser));
    var detector = dhvani_biquad_new(DH_BQ_BANDPASS, 0,
                                     DhDeEsserParams_freq_hz(params),
                                     DhDeEsserParams_q(params),
                                     sample_rate, channels);
    DhDeEsser_set_params(self, params);
    DhDeEsser_set_detector(self, detector);
    # reusable sidechain sample vec (grows to buffer length, reused per call)
    DhDeEsser_set_sidechain(self, vec_new());
    # reusable AudioBuffer wrapper around the sidechain vec (rebound each call)
    var scratch = alloc(sizeof(DhAudioBuffer));
    DhAudioBuffer_set_samples(scratch, DhDeEsser_sidechain(self));
    DhAudioBuffer_set_channels(scratch, channels);
    DhAudioBuffer_set_sample_rate(scratch, sample_rate);
    DhAudioBuffer_set_frames(scratch, 0);
    DhDeEsser_set_scratch(self, scratch);
    DhDeEsser_set_sample_rate(self, sample_rate);
    DhDeEsser_set_channels(self, channels);
    DhDeEsser_set_bypassed(self, 0);
    return self;
}

fn dhvani_deesser_set_bypass(self, bypassed) { DhDeEsser_set_bypassed(self, bypassed); return 0; }
#must_use
fn dhvani_deesser_is_bypassed(self) { if (DhDeEsser_bypassed(self) == 1) { return 1; } return 0; }

# process(buf) -- duck sibilance in place.
#inline
fn dhvani_deesser_process(self, buf) {
    if (DhDeEsser_bypassed(self) == 1) { return 0; }
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    var frames = DhAudioBuffer_frames(buf);
    var total = vec_len(samples);
    var params = DhDeEsser_params(self);

    # Reuse pre-allocated sidechain vec: resize to buf length, copy samples.
    var side = DhDeEsser_sidechain(self);
    var cur = vec_len(side);
    var i = 0;
    while (i < total) {
        if (i < cur) { vec_set(side, i, vec_get(samples, i)); }
        else         { vec_push(side, vec_get(samples, i)); }
        i = i + 1;
    }
    # (buffers only grow here; the reused vec length always >= total)

    # Rebind the reusable scratch AudioBuffer to this call's format, then filter.
    var scratch = DhDeEsser_scratch(self);
    DhAudioBuffer_set_samples(scratch, side);
    DhAudioBuffer_set_channels(scratch, ch);
    DhAudioBuffer_set_sample_rate(scratch, DhAudioBuffer_sample_rate(buf));
    DhAudioBuffer_set_frames(scratch, frames);
    dhvani_biquad_process(DhDeEsser_detector(self), scratch);

    var threshold_lin = db_to_amplitude(DhDeEsserParams_threshold_db(params));
    var max_reduction_lin = db_to_amplitude(f64_neg(DhDeEsserParams_reduction_db(params)));

    var frame = 0;
    while (frame < frames) {
        # Detect sidechain peak across channels.
        var sidechain_peak = 0;
        var c = 0;
        while (c < ch) {
            sidechain_peak = f64_max(sidechain_peak, f64_abs(vec_get(side, frame * ch + c)));
            c = c + 1;
        }
        # If sidechain exceeds threshold, compute proportional gain reduction.
        if (f64_gt(sidechain_peak, threshold_lin) == 1) {
            var excess_ratio = f64_div(sidechain_peak, threshold_lin);
            var reduction = f64_max(f64_div(1.0, excess_ratio), max_reduction_lin);
            var c2 = 0;
            while (c2 < ch) {
                var idx = frame * ch + c2;
                var out = f64_mul(vec_get(samples, idx), reduction);
                if (dhvani_is_finite(out) == 0) { out = 0; }
                vec_set(samples, idx, out);
                c2 = c2 + 1;
            }
        }
        frame = frame + 1;
    }
    return 0;
}

# set_sample_rate -- rebuild the detector filter for the new rate.
fn dhvani_deesser_set_sample_rate(self, sample_rate) {
    DhDeEsser_set_sample_rate(self, sample_rate);
    var params = DhDeEsser_params(self);
    DhDeEsser_set_detector(self, dhvani_biquad_new(DH_BQ_BANDPASS, 0,
        DhDeEsserParams_freq_hz(params), DhDeEsserParams_q(params),
        sample_rate, DhDeEsser_channels(self)));
    return 0;
}

# reset -- clear detector filter state.
fn dhvani_deesser_reset(self) {
    dhvani_biquad_reset(DhDeEsser_detector(self));
    return 0;
}

# set_params -- validate, rebuild detector, store; error code on invalid.
fn dhvani_deesser_set_params(self, params) {
    var rc = dhvani_deesserparams_validate(params);
    if (dhvani_is_err(rc) == 1) { return rc; }
    DhDeEsser_set_detector(self, dhvani_biquad_new(DH_BQ_BANDPASS, 0,
        DhDeEsserParams_freq_hz(params), DhDeEsserParams_q(params),
        DhDeEsser_sample_rate(self), DhDeEsser_channels(self)));
    DhDeEsser_set_params(self, params);
    return DHVANI_ERR_NONE;
}

#inline
#must_use
fn dhvani_deesser_detector(self) { return DhDeEsser_detector(self); }

# --- ops.cyr ---

# ops.cyr -- buffer utilities: crossfade + fade in/out.
# Ports rust-old/src/buffer/ops.rs. L2: depends on error + buffer.
# CrossfadeType/FadeCurve enums -> codes. Result -> null-handle sentinel.
#
# The EqualPower branch called abaco::dsp::equal_power_crossfade, which is
# (cos(t*PI/2), sin(t*PI/2)); matched inline here so ops stays abaco-free.
# normalize_to_lufs (analysis-gated in Rust) is at the bottom — it pulls
# dhvani_loudness_measure_r128 + abaco db_to_amplitude, so in the dist bundle
# ops must follow loudness.

var DH_PI_2 = F64_PI_2;   # PI/2 (equal-power crossfade angle scale; exact-hex stdlib const)

# ---- CrossfadeType ----
var DH_XFADE_LINEAR      = 0;
var DH_XFADE_EQUAL_POWER = 1;

# ---- FadeCurve ----
var DH_FADE_LINEAR      = 0;
var DH_FADE_EXPONENTIAL = 1;

# crossfade(a, b, kind) -- `a` fades out, `b` fades in over their full length.
# Requires equal channels/rate/frames; returns 0 on mismatch.
#must_use
fn dhvani_ops_crossfade(a, b, kind) {
    var channels = DhAudioBuffer_channels(a);
    if (channels != DhAudioBuffer_channels(b)) { return 0; }
    if (DhAudioBuffer_sample_rate(a) != DhAudioBuffer_sample_rate(b)) { return 0; }
    var frames = DhAudioBuffer_frames(a);
    if (frames != DhAudioBuffer_frames(b)) { return 0; }
    var sa = DhAudioBuffer_samples(a);
    var sb = DhAudioBuffer_samples(b);
    var len = vec_len(sa);
    var out = dh_vec_zeros(len);
    var i = 0;
    while (i < len) {
        var frame = i / channels;
        var t = 1.0;
        if (frames > 1) { t = f64_div(f64_from(frame), f64_from(frames - 1)); }
        var gain_a = 0;
        var gain_b = 0;
        if (kind == DH_XFADE_EQUAL_POWER) {
            var angle = f64_mul(t, DH_PI_2);
            gain_a = f64_cos(angle);
            gain_b = f64_sin(angle);
        } else {
            gain_a = f64_sub(1.0, t);
            gain_b = t;
        }
        vec_set(out, i, f64_add(f64_mul(vec_get(sa, i), gain_a), f64_mul(vec_get(sb, i), gain_b)));
        i = i + 1;
    }
    var ob = alloc(sizeof(DhAudioBuffer));
    DhAudioBuffer_set_samples(ob, out);
    DhAudioBuffer_set_channels(ob, channels);
    DhAudioBuffer_set_sample_rate(ob, DhAudioBuffer_sample_rate(a));
    DhAudioBuffer_set_frames(ob, frames);
    return ob;
}

# fade_in(buf, fade_frames, curve) -- ramp the first `fade_frames` up from
# silence (in place). Clamped to the buffer length.
fn dhvani_ops_fade_in(buf, fade_frames, curve) {
    var frames = DhAudioBuffer_frames(buf);
    var ff = fade_frames;
    if (ff > frames) { ff = frames; }
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    var frame = 0;
    while (frame < ff) {
        var t = 1.0;
        if (ff > 1) { t = f64_div(f64_from(frame), f64_from(ff - 1)); }
        var gain = t;
        if (curve == DH_FADE_EXPONENTIAL) { gain = f64_mul(t, t); }
        var c = 0;
        while (c < ch) {
            var idx = frame * ch + c;
            vec_set(samples, idx, f64_mul(vec_get(samples, idx), gain));
            c = c + 1;
        }
        frame = frame + 1;
    }
    return 0;
}

# fade_out(buf, fade_frames, curve) -- ramp the last `fade_frames` down to
# silence (in place). Clamped to the buffer length.
fn dhvani_ops_fade_out(buf, fade_frames, curve) {
    var frames = DhAudioBuffer_frames(buf);
    var ff = fade_frames;
    if (ff > frames) { ff = frames; }
    var ch = DhAudioBuffer_channels(buf);
    var samples = DhAudioBuffer_samples(buf);
    var start = frames - ff;
    var frame = 0;
    while (frame < ff) {
        var t = 0;
        if (ff > 1) { t = f64_div(f64_from(frame), f64_from(ff - 1)); }
        var gain = f64_sub(1.0, t);
        if (curve == DH_FADE_EXPONENTIAL) {
            var inv = f64_sub(1.0, t);
            gain = f64_mul(inv, inv);
        }
        var c = 0;
        while (c < ch) {
            var idx = (start + frame) * ch + c;
            vec_set(samples, idx, f64_mul(vec_get(samples, idx), gain));
            c = c + 1;
        }
        frame = frame + 1;
    }
    return 0;
}

# normalize_to_lufs(buf, target_lufs) -- measure integrated R128 loudness, apply
# the gain needed to reach target_lufs, return the applied gain in dB. A silent
# or too-quiet signal (integrated < -120 LUFS or non-finite) is a no-op -> 0.0.
# Rust returns Result<f32>: since a valid gain_db can be negative, the Err path
# (measurement failed, e.g. empty buffer) returns NaN, not a negative code —
# callers test dhvani_is_finite (finite == success). analysis-gated: needs
# dhvani_loudness_measure_r128 (loudness.cyr) + db_to_amplitude (abaco).
#must_use
fn dhvani_ops_normalize_to_lufs(buf, target_lufs) {
    var r128 = dhvani_loudness_measure_r128(buf);
    if (r128 == 0) { return DH_NAN; }
    var current = dhvani_r128_integrated_lufs(r128);
    if (dhvani_is_finite(current) == 0) { return 0; }
    if (f64_lt(current, f64_neg(f64_from(120))) == 1) { return 0; }
    var gain_db = f64_sub(target_lufs, current);
    dhvani_buffer_apply_gain(buf, db_to_amplitude(gain_db));
    return gain_db;
}

# --- meter.cyr ---

# meter.cyr -- lock-free audio metering + block-accumulating level meter.
# Ports rust-old/src/meter/mod.rs. L1: deps error + simd + buffer + math (F64_*)
# + ganita (f64_pow) + abaco (not required here; log10 done inline via F64_LN10).
#
# ATOMICS: the Rust PeakMeter/MeterBank use AtomicU32/AtomicUsize (f32 bit
# patterns) for lock-free RT<->UI sharing. The Cyrius port is single-threaded,
# so the shared peak levels are PLAIN f64 struct fields (no atomic ops) --
# behaviorally identical for the tests. store()/load() no longer round through
# f32 bits; the whole port is f64, so store keeps the f64 value directly.
#
# RETURNS: load()/read_all() returned [f32;2] / Vec<[f32;2]> in Rust. In Cyrius
# a stereo pair is a 2-element `vec` (index 0 = left, 1 = right); read_all() is a
# `vec` of such pairs. peak()/rms()/peak_hold() return the owned `vec` handles.
#
# DROPPED: Debug/Display formatters, the SharedMeterBank Arc alias (Cyrius is
# single-threaded -- shared_meter_bank just builds a MeterBank), and the
# threaded store/load test (ported as a plain sequential store then load).
#
# FLOAT TRAPS: negative float literals via f64_neg (-200.0, -0.691, -70/10,
# -10/10); the decay/gate powers via f64_pow; log10(x)=ln(x)/F64_LN10.

# ---- constants (was module-level `const`) ----
# DB_FLOOR = -200.0 (silence sentinel for dB conversion).
var DH_METER_DB_FLOOR = 0xC069000000000000;        # -200.0
# LINEAR_FLOOR = 1e-10 (minimum linear amplitude treated as non-zero).
var DH_METER_LINEAR_FLOOR = 0x3DDB7CDFD9D7BDBB;    # 1e-10
# LUFS_OFFSET = -0.691 (EBU R128 offset).
var DH_METER_LUFS_OFFSET = 0xBFE61CAC083126E9;     # -0.691
# LUFS_BLOCK_DURATION = 0.4 s (EBU R128 400ms block).
var DH_METER_LUFS_BLOCK_DURATION = 0x3FD999999999999A;  # 0.4
# PEAK_DECAY_COEFFICIENT = 0.9995 per sample.
var DH_METER_PEAK_DECAY = 0x3FEFFBE76C8B4396;      # 0.9995
# MAX_LUFS_BLOCKS = 1500 (~10 min of 400ms blocks).
var DH_METER_MAX_LUFS_BLOCKS = 1500;

# log10(x) = ln(x)/ln(10); the stdlib has no f64_log10.
#must_use
fn dhvani_meter_log10(x) { return f64_div(f64_ln(x), F64_LN10); }

# linear_to_db(linear) -- 20*log10, or DB_FLOOR below LINEAR_FLOOR.
#must_use
fn dhvani_meter_linear_to_db(linear) {
    if (f64_lt(linear, DH_METER_LINEAR_FLOOR) == 1) { return DH_METER_DB_FLOOR; }
    return f64_mul(20.0, dhvani_meter_log10(linear));
}

# ================================================================
# PeakMeter -- a single stereo peak level (was two AtomicU32).
# ================================================================
#derive(accessors)
struct DhPeakMeter { left; right; }

# new() -- a meter reading zero.
#must_use
fn dhvani_meter_peak_new() {
    var self = alloc(sizeof(DhPeakMeter));
    DhPeakMeter_set_left(self, 0);   # +0.0
    DhPeakMeter_set_right(self, 0);  # +0.0
    return self;
}

# store(left, right) -- set the stereo peak level.
#inline
fn dhvani_meter_peak_store(self, left, right) {
    DhPeakMeter_set_left(self, left);
    DhPeakMeter_set_right(self, right);
    return 0;
}

# load() -- a 2-element vec [left, right].
#inline
#must_use
fn dhvani_meter_peak_load(self) {
    var out = vec_new();
    vec_push(out, DhPeakMeter_left(self));
    vec_push(out, DhPeakMeter_right(self));
    return out;
}

# ================================================================
# MeterBank -- a bank of stereo peak meters with dynamic activation.
# ================================================================
#derive(accessors)
struct DhMeterBank { slots; active; }

# new(capacity) -- pre-allocate `capacity` zeroed meters, all active.
#must_use
fn dhvani_meter_bank_new(capacity) {
    var slots = vec_new();
    var i = 0;
    while (i < capacity) { vec_push(slots, dhvani_meter_peak_new()); i = i + 1; }
    var self = alloc(sizeof(DhMeterBank));
    DhMeterBank_set_slots(self, slots);
    DhMeterBank_set_active(self, capacity);
    return self;
}

# len() -- number of active slots.
#inline
#must_use
fn dhvani_meter_bank_len(self) { return DhMeterBank_active(self); }

# is_empty() -- 1 iff no active slots.
#must_use
fn dhvani_meter_bank_is_empty(self) {
    if (DhMeterBank_active(self) == 0) { return 1; }
    return 0;
}

# capacity() -- total allocated slots.
#inline
#must_use
fn dhvani_meter_bank_capacity(self) { return vec_len(DhMeterBank_slots(self)); }

# store(index, left, right) -- no-op if index out of bounds.
fn dhvani_meter_bank_store(self, index, left, right) {
    var slots = DhMeterBank_slots(self);
    if (index < vec_len(slots)) {
        dhvani_meter_peak_store(vec_get(slots, index), left, right);
    }
    return 0;
}

# load(index) -- [left, right], or [0.0, 0.0] if index out of bounds.
#must_use
fn dhvani_meter_bank_load(self, index) {
    var slots = DhMeterBank_slots(self);
    if (index < vec_len(slots)) { return dhvani_meter_peak_load(vec_get(slots, index)); }
    var zeros = vec_new();
    vec_push(zeros, 0);   # +0.0
    vec_push(zeros, 0);   # +0.0
    return zeros;
}

# read_all() -- a vec of [left,right] pairs, one per active slot.
#must_use
fn dhvani_meter_bank_read_all(self) {
    var active = DhMeterBank_active(self);
    var out = vec_new();
    var i = 0;
    while (i < active) { vec_push(out, dhvani_meter_bank_load(self, i)); i = i + 1; }
    return out;
}

# set_active(count) -- clamp to capacity, then store as active.
fn dhvani_meter_bank_set_active(self, count) {
    var cap = vec_len(DhMeterBank_slots(self));
    var n = count;
    if (n > cap) { n = cap; }
    DhMeterBank_set_active(self, n);
    return 0;
}

# shared_meter_bank(capacity) -- Rust returned an Arc<MeterBank>; the
# single-threaded Cyrius port just builds a MeterBank.
#must_use
fn dhvani_meter_shared_bank(capacity) { return dhvani_meter_bank_new(capacity); }

# ================================================================
# LevelMeter -- block-accumulating meter (peak, RMS, LUFS, peak-hold).
# ================================================================
#derive(accessors)
struct DhLevelMeter { peak; rms; lufs; channels; rms_sum; rms_count; lufs_blocks; lufs_buffer; lufs_buffer_pos; peak_hold; peak_decay; }

# new(channels, sample_rate) -- allocate per-channel state; lufs = DB_FLOOR.
# lufs_buffer length = (sample_rate * 0.4) truncated (Rust `as usize`).
#must_use
fn dhvani_meter_level_new(channels, sample_rate) {
    var self = alloc(sizeof(DhLevelMeter));
    DhLevelMeter_set_peak(self, dh_vec_zeros(channels));
    DhLevelMeter_set_rms(self, dh_vec_zeros(channels));
    DhLevelMeter_set_lufs(self, DH_METER_DB_FLOOR);
    DhLevelMeter_set_channels(self, channels);
    DhLevelMeter_set_rms_sum(self, dh_vec_zeros(channels));
    DhLevelMeter_set_rms_count(self, 0);
    DhLevelMeter_set_lufs_blocks(self, vec_new());
    var buf_len = f64_to(f64_trunc(f64_mul(sample_rate, DH_METER_LUFS_BLOCK_DURATION)));
    DhLevelMeter_set_lufs_buffer(self, dh_vec_zeros(buf_len));
    DhLevelMeter_set_lufs_buffer_pos(self, 0);
    DhLevelMeter_set_peak_hold(self, dh_vec_zeros(channels));
    DhLevelMeter_set_peak_decay(self, DH_METER_PEAK_DECAY);
    return self;
}

# process(buf) -- analyze a buffer, update peak/rms/lufs/peak_hold.
fn dhvani_meter_level_process(self, buf) {
    var frames = DhAudioBuffer_frames(buf);
    var buf_channels = DhAudioBuffer_channels(buf);
    var channels = DhLevelMeter_channels(self);
    var active_channels = buf_channels;
    if (channels < active_channels) { active_channels = channels; }
    var samples = DhAudioBuffer_samples(buf);
    var peak = DhLevelMeter_peak(self);
    var rms = DhLevelMeter_rms(self);
    var rms_sum = DhLevelMeter_rms_sum(self);
    var lufs_buffer = DhLevelMeter_lufs_buffer(self);
    var lufs_blocks = DhLevelMeter_lufs_blocks(self);
    var lufs_len = vec_len(lufs_buffer);

    # Reset per-block peak.
    var rp = 0;
    while (rp < vec_len(peak)) { vec_set(peak, rp, 0); rp = rp + 1; }

    var rms_count = DhLevelMeter_rms_count(self);
    var lufs_pos = DhLevelMeter_lufs_buffer_pos(self);

    var frame = 0;
    while (frame < frames) {
        var channel_sq_sum = 0;   # +0.0
        var ch = 0;
        while (ch < active_channels) {
            var sample = vec_get(samples, frame * buf_channels + ch);
            var absval = f64_abs(sample);
            if (f64_gt(absval, vec_get(peak, ch)) == 1) { vec_set(peak, ch, absval); }
            var sq = f64_mul(sample, sample);
            vec_set(rms_sum, ch, f64_add(vec_get(rms_sum, ch), sq));
            channel_sq_sum = f64_add(channel_sq_sum, sq);
            ch = ch + 1;
        }

        rms_count = rms_count + 1;

        var mean_sq = 0;   # +0.0
        if (active_channels > 0) { mean_sq = f64_div(channel_sq_sum, f64_from(active_channels)); }
        if (lufs_pos < lufs_len) {
            vec_set(lufs_buffer, lufs_pos, mean_sq);
            lufs_pos = lufs_pos + 1;
        }

        if (lufs_pos >= lufs_len) {
            var block_sum = 0;   # +0.0
            var bi = 0;
            while (bi < lufs_len) { block_sum = f64_add(block_sum, vec_get(lufs_buffer, bi)); bi = bi + 1; }
            var block_power = f64_div(block_sum, f64_from(lufs_len));
            vec_push(lufs_blocks, block_power);
            lufs_pos = 0;
            dhvani_meter_level_compute_lufs(self);
        }
        frame = frame + 1;
    }

    DhLevelMeter_set_rms_count(self, rms_count);
    DhLevelMeter_set_lufs_buffer_pos(self, lufs_pos);

    # Update RMS.
    if (rms_count > 0) {
        var uc = 0;
        while (uc < channels) {
            vec_set(rms, uc, f64_sqrt(f64_div(vec_get(rms_sum, uc), f64_from(rms_count))));
            uc = uc + 1;
        }
    }

    # Update peak hold with decay (scaled by frame count).
    var peak_hold = DhLevelMeter_peak_hold(self);
    var decay = f64_pow(DhLevelMeter_peak_decay(self), f64_from(frames));
    var hc = 0;
    while (hc < channels) {
        if (f64_gt(vec_get(peak, hc), vec_get(peak_hold, hc)) == 1) {
            vec_set(peak_hold, hc, vec_get(peak, hc));
        } else {
            vec_set(peak_hold, hc, f64_mul(vec_get(peak_hold, hc), decay));
        }
        hc = hc + 1;
    }
    return 0;
}

# compute_lufs() -- simplified EBU R128 gating over lufs_blocks.
fn dhvani_meter_level_compute_lufs(self) {
    var lufs_blocks = DhLevelMeter_lufs_blocks(self);
    var n = vec_len(lufs_blocks);
    if (n == 0) { DhLevelMeter_set_lufs(self, DH_METER_DB_FLOOR); return 0; }
    if (n > DH_METER_MAX_LUFS_BLOCKS) {
        var drain_count = n - DH_METER_MAX_LUFS_BLOCKS;
        var d = 0;
        while (d < drain_count) { vec_remove(lufs_blocks, 0); d = d + 1; }
        n = vec_len(lufs_blocks);
    }

    # abs_gate = 10^(-70/10) = 10^-7.
    var abs_gate = f64_pow(10.0, f64_neg(f64_div(70.0, 10.0)));

    var gated_count = 0;
    var gated_sum = 0;   # +0.0
    var i = 0;
    while (i < n) {
        var p = vec_get(lufs_blocks, i);
        if (f64_gt(p, abs_gate) == 1) { gated_count = gated_count + 1; gated_sum = f64_add(gated_sum, p); }
        i = i + 1;
    }

    if (gated_count == 0) { DhLevelMeter_set_lufs(self, DH_METER_DB_FLOOR); return 0; }

    var mean_power = f64_div(gated_sum, f64_from(gated_count));
    # rel_gate = mean_power * 10^(-10/10) = mean_power * 0.1.
    var rel_gate = f64_mul(mean_power, f64_pow(10.0, f64_neg(f64_div(10.0, 10.0))));

    var final_count = 0;
    var final_sum = 0;   # +0.0
    var j = 0;
    while (j < n) {
        var pp = vec_get(lufs_blocks, j);
        if (f64_gt(pp, abs_gate) == 1) {
            if (f64_gt(pp, rel_gate) == 1) { final_count = final_count + 1; final_sum = f64_add(final_sum, pp); }
        }
        j = j + 1;
    }

    if (final_count == 0) { DhLevelMeter_set_lufs(self, DH_METER_DB_FLOOR); return 0; }

    var integrated = f64_div(final_sum, f64_from(final_count));
    DhLevelMeter_set_lufs(self, f64_add(DH_METER_LUFS_OFFSET, f64_mul(10.0, dhvani_meter_log10(integrated))));
    return 0;
}

# --- accessors ---
#inline
#must_use
fn dhvani_meter_level_peak(self) { return DhLevelMeter_peak(self); }
#inline
#must_use
fn dhvani_meter_level_rms(self) { return DhLevelMeter_rms(self); }
#inline
#must_use
fn dhvani_meter_level_lufs(self) { return DhLevelMeter_lufs(self); }

# peak_db(channel) -- dB of the channel's peak (0.0 if channel out of range).
#must_use
fn dhvani_meter_level_peak_db(self, channel) {
    var peak = DhLevelMeter_peak(self);
    var v = 0;   # +0.0 (Rust unwrap_or(0.0))
    if (channel < vec_len(peak)) { v = vec_get(peak, channel); }
    return dhvani_meter_linear_to_db(v);
}

# rms_db(channel) -- dB of the channel's RMS (0.0 if out of range).
#must_use
fn dhvani_meter_level_rms_db(self, channel) {
    var rms = DhLevelMeter_rms(self);
    var v = 0;   # +0.0
    if (channel < vec_len(rms)) { v = vec_get(rms, channel); }
    return dhvani_meter_linear_to_db(v);
}

# peak_hold_db(channel) -- dB of the channel's peak hold (0.0 if out of range).
#must_use
fn dhvani_meter_level_peak_hold_db(self, channel) {
    var ph = DhLevelMeter_peak_hold(self);
    var v = 0;   # +0.0
    if (channel < vec_len(ph)) { v = vec_get(ph, channel); }
    return dhvani_meter_linear_to_db(v);
}

#inline
#must_use
fn dhvani_meter_level_peak_hold(self) { return DhLevelMeter_peak_hold(self); }
#inline
#must_use
fn dhvani_meter_level_channels(self) { return DhLevelMeter_channels(self); }

# reset() -- clear all meter state.
fn dhvani_meter_level_reset(self) {
    var channels = DhLevelMeter_channels(self);
    var peak = DhLevelMeter_peak(self);
    var rms = DhLevelMeter_rms(self);
    var rms_sum = DhLevelMeter_rms_sum(self);
    var peak_hold = DhLevelMeter_peak_hold(self);
    var lufs_buffer = DhLevelMeter_lufs_buffer(self);
    var i = 0;
    while (i < vec_len(peak)) { vec_set(peak, i, 0); i = i + 1; }
    var r = 0;
    while (r < vec_len(rms)) { vec_set(rms, r, 0); r = r + 1; }
    DhLevelMeter_set_lufs(self, DH_METER_DB_FLOOR);
    var s = 0;
    while (s < vec_len(rms_sum)) { vec_set(rms_sum, s, 0); s = s + 1; }
    DhLevelMeter_set_rms_count(self, 0);
    DhLevelMeter_set_lufs_blocks(self, vec_new());
    var lb = 0;
    while (lb < vec_len(lufs_buffer)) { vec_set(lufs_buffer, lb, 0); lb = lb + 1; }
    DhLevelMeter_set_lufs_buffer_pos(self, 0);
    var h = 0;
    while (h < vec_len(peak_hold)) { vec_set(peak_hold, h, 0); h = h + 1; }
    return 0;
}

# --- midi_routing.cyr ---

# midi_routing.cyr -- MIDI channel/note filtering, velocity curves, CC mapping.
# Ports rust-old/src/midi/routing.rs. Pure integer logic for routing/filtering;
# f64 arithmetic only in the velocity curves (sqrt/square) and CC value mapping.
# L1: deps error + midi (consumes DhNoteEvent + dhvani_note_event_*). serde
# dropped.
#
# VelocityCurve (data-carrying enum) -> a `kind` code + a separate fixed-value
# payload threaded through apply(). Option<u8> channel_filter -> -1 sentinel for
# None (channels are 0..15). Prefix dhvani_midiroute_ (dsp routing owns
# dhvani_routing_).

# ================================================================
# VelocityCurve -- kind codes. The Fixed(u8) payload rides as a separate arg.
# ================================================================
var DH_MIDIROUTE_CURVE_LINEAR = 0;
var DH_MIDIROUTE_CURVE_SOFT   = 1;
var DH_MIDIROUTE_CURVE_HARD   = 2;
var DH_MIDIROUTE_CURVE_FIXED  = 3;

# Apply a velocity curve to a raw 0..127 velocity. `kind` is one of the curve
# codes; `fixed_value` is only read when kind == FIXED. Rust `as u8` truncates
# toward zero -> f64_to. Non-Fixed curves ignore `fixed_value`.
#must_use
fn dhvani_midiroute_curve_apply(kind, fixed_value, velocity) {
    if (kind == DH_MIDIROUTE_CURVE_LINEAR) { return velocity; }
    if (kind == DH_MIDIROUTE_CURVE_SOFT) {
        var ns = f64_div(f64_from(velocity), 127.0);
        return f64_to(f64_mul(f64_sqrt(ns), 127.0));
    }
    if (kind == DH_MIDIROUTE_CURVE_HARD) {
        var nh = f64_div(f64_from(velocity), 127.0);
        return f64_to(f64_mul(f64_mul(nh, nh), 127.0));
    }
    return fixed_value;
}

# ================================================================
# MidiRoute -- filter + transform rule.
# channel_filter: -1 = None (all channels), else 0..15.
# velocity_curve: a curve kind code; velocity_fixed holds the Fixed payload.
# note_min/note_max: inclusive note range (0..127, min <= max).
# ================================================================
#derive(accessors)
struct DhMidiRoute { channel_filter; velocity_curve; velocity_fixed; note_min; note_max; }

# Clamp a channel-filter Option to 0..15. `ch` == -1 means None (kept as -1).
#must_use
fn dh_midiroute_clamp_channel(ch) {
    if (ch < 0) { return (0 - 1); }
    if (ch > 15) { return 15; }
    return ch;
}

# new(channel_filter, velocity_curve, velocity_fixed, note_min, note_max).
# channel_filter -1 = None. note_range clamped so min <= max and both 0..127.
#must_use
fn dhvani_midiroute_new(channel_filter, velocity_curve, velocity_fixed, note_min, note_max) {
    var self = alloc(sizeof(DhMidiRoute));
    DhMidiRoute_set_channel_filter(self, dh_midiroute_clamp_channel(channel_filter));
    DhMidiRoute_set_velocity_curve(self, velocity_curve);
    DhMidiRoute_set_velocity_fixed(self, velocity_fixed);
    var lo = note_min;
    if (lo > 127) { lo = 127; }
    var hi = note_max;
    if (hi > 127) { hi = 127; }
    if (hi < lo) { hi = lo; }
    DhMidiRoute_set_note_min(self, lo);
    DhMidiRoute_set_note_max(self, hi);
    return self;
}

# passthrough -- all events unmodified: no channel filter, Linear, full range.
#must_use
fn dhvani_midiroute_passthrough() {
    return dhvani_midiroute_new((0 - 1), DH_MIDIROUTE_CURVE_LINEAR, 0, 0, 127);
}

# default == passthrough.
#must_use
fn dhvani_midiroute_default() { return dhvani_midiroute_passthrough(); }

#inline
#must_use
fn dhvani_midiroute_channel_filter(self) { return DhMidiRoute_channel_filter(self); }
#inline
#must_use
fn dhvani_midiroute_velocity_curve(self) { return DhMidiRoute_velocity_curve(self); }
#inline
#must_use
fn dhvani_midiroute_velocity_fixed(self) { return DhMidiRoute_velocity_fixed(self); }
#inline
#must_use
fn dhvani_midiroute_note_min(self) { return DhMidiRoute_note_min(self); }
#inline
#must_use
fn dhvani_midiroute_note_max(self) { return DhMidiRoute_note_max(self); }

# set_channel_filter -- -1 = None; otherwise clamped to 0..15.
fn dhvani_midiroute_set_channel_filter(self, channel) {
    DhMidiRoute_set_channel_filter(self, dh_midiroute_clamp_channel(channel));
    return 0;
}

# set_velocity_curve -- kind + Fixed payload (ignored for non-Fixed).
fn dhvani_midiroute_set_velocity_curve(self, velocity_curve, velocity_fixed) {
    DhMidiRoute_set_velocity_curve(self, velocity_curve);
    DhMidiRoute_set_velocity_fixed(self, velocity_fixed);
    return 0;
}

# set_note_range -- clamp to 0..127 with min <= max.
fn dhvani_midiroute_set_note_range(self, min, max) {
    var lo = min;
    if (lo > 127) { lo = 127; }
    var hi = max;
    if (hi > 127) { hi = 127; }
    if (hi < lo) { hi = lo; }
    DhMidiRoute_set_note_min(self, lo);
    DhMidiRoute_set_note_max(self, hi);
    return 0;
}

# filter_event -- filter + transform a DhNoteEvent. Returns a NEW DhNoteEvent
# handle (velocity-transformed clone) if the event passes, or 0 (None) if the
# channel filter or note range rejects it.
#must_use
fn dhvani_midiroute_filter_event(self, event) {
    var cf = DhMidiRoute_channel_filter(self);
    if (cf >= 0) {
        if (dhvani_note_event_channel(event) != cf) { return 0; }
    }
    var note = dhvani_note_event_note(event);
    if (note < DhMidiRoute_note_min(self)) { return 0; }
    if (note > DhMidiRoute_note_max(self)) { return 0; }
    var vel = dhvani_midiroute_curve_apply(DhMidiRoute_velocity_curve(self), DhMidiRoute_velocity_fixed(self), dhvani_note_event_velocity(event));
    return dhvani_note_event_new(dhvani_note_event_position(event), dhvani_note_event_duration(event), note, vel, dhvani_note_event_channel(event));
}

# ================================================================
# CcMapping -- maps a MIDI CC number to a parameter value range.
# cc: 0..127; param_index: usize; min_value/max_value: f64 param bounds.
# ================================================================
#derive(accessors)
struct DhCcMapping { cc; param_index; min_value; max_value; }

#must_use
fn dhvani_midiroute_cc_new(cc, param_index, min_value, max_value) {
    var m = alloc(sizeof(DhCcMapping));
    DhCcMapping_set_cc(m, cc);
    DhCcMapping_set_param_index(m, param_index);
    DhCcMapping_set_min_value(m, min_value);
    DhCcMapping_set_max_value(m, max_value);
    return m;
}

#inline
#must_use
fn dhvani_midiroute_cc_number(m) { return DhCcMapping_cc(m); }
#inline
#must_use
fn dhvani_midiroute_cc_param_index(m) { return DhCcMapping_param_index(m); }
#inline
#must_use
fn dhvani_midiroute_cc_min_value(m) { return DhCcMapping_min_value(m); }
#inline
#must_use
fn dhvani_midiroute_cc_max_value(m) { return DhCcMapping_max_value(m); }

# map_value -- 7-bit CC (0..127) -> param range: min + (cc/127)*(max-min).
#must_use
fn dhvani_midiroute_cc_map_value(m, cc_value) {
    var norm = f64_div(f64_from(cc_value), 127.0);
    return f64_add(DhCcMapping_min_value(m), f64_mul(norm, f64_sub(DhCcMapping_max_value(m), DhCcMapping_min_value(m))));
}

# map_value_32 -- 32-bit CC (MIDI 2.0) -> param range. u32::MAX = 4294967295
# exceeds 2^24 so build the f64 via f64_from(int), not a decimal literal.
#must_use
fn dhvani_midiroute_cc_map_value_32(m, cc_value) {
    var norm = f64_div(f64_from(cc_value), f64_from(4294967295));
    return f64_add(DhCcMapping_min_value(m), f64_mul(norm, f64_sub(DhCcMapping_max_value(m), DhCcMapping_min_value(m))));
}

# --- midi_v2.cyr ---

# midi_v2.cyr -- MIDI 2.0 / UMP types: 16-bit velocity, 32-bit CC, per-note
# expression. Ports rust-old/src/midi/v2.rs. L0: dep error only (all integer
# logic -- MIDI note/velocity/channel/CC are ints; no floats here).
#
# The data structs (NoteOnV2, NoteOffV2, ControlChangeV2, PerNotePitchBend,
# PerNoteController, ChannelPressureV2, PolyPressureV2, PitchBendV2) -> Dh<Name>
# structs with untyped i64 slots (FramePos u64, u8/u16/u32 fields all fit).
# The UmpMessageType enum (#[non_exhaustive], 6 variants) -> DH_UMP_* int codes.
# serde dropped (Cyrius has no derive-serde).

# ---- UmpMessageType (enum -> int codes, in Rust variant order) ----
var DH_UMP_UTILITY            = 0;   # Utility (JR Timestamp, JR Clock)
var DH_UMP_SYSTEM_COMMON      = 1;   # System Real-Time / System Common (MIDI 1.0)
var DH_UMP_MIDI1_CHANNEL_VOICE = 2;  # MIDI 1.0 Channel Voice (7-bit)
var DH_UMP_DATA64             = 3;   # Data messages (SysEx 7-bit)
var DH_UMP_MIDI2_CHANNEL_VOICE = 4;  # MIDI 2.0 Channel Voice (32-bit)
var DH_UMP_DATA128            = 5;   # Data messages (SysEx 8-bit)

