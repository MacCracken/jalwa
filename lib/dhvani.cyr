fn dhvani_cc_new(position, controller, value, channel) {
    var e = alloc(sizeof(DhControlChange));
    DhControlChange_set_position(e, position);
    DhControlChange_set_controller(e, controller);
    DhControlChange_set_value(e, value);
    DhControlChange_set_channel(e, channel);
    return e;
}
#inline
#must_use
fn dhvani_cc_position(e) { return DhControlChange_position(e); }
