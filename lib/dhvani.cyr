# --- translate.cyr ---

# translate.cyr -- MIDI 1.0 <-> 2.0 translation: velocity/CC/pitch-bend scaling
# + NoteEvent/ControlChange <-> V2 struct conversion.
# Ports rust-old/src/midi/translate.rs. L1: deps error + midi (DhNoteEvent /
# DhControlChange consumed) + midi_v2 (DhNoteOnV2 / DhControlChangeV2 target
# types + dhvani_midi2_* constructors/accessors -- reused, not redefined here).
# Pure INTEGER bit logic -- no floats. Rust's u8/u16/u32 shifts truncate to the
# type width; the Cyrius port uses i64 slots, so every widening shift result is
# masked (& 0xFFFF / & 0xFFFFFFFF) to reproduce the Rust wrapping exactly.
# serde + Display tests dropped (none in this oracle).

# Pitch bend center value in MIDI 2.0 (32-bit).
var DH_MIDITX_PITCH_BEND_CENTER = 0x80000000;

# ---- scalar scaling (pure integer bit logic) ----

# Scale 7-bit MIDI 1.0 velocity to 16-bit MIDI 2.0.
# MIDI 2.0 spec scaling: v << 9 | v << 2 | v >> 5.
#inline
#must_use
fn dhvani_miditx_velocity_7_to_16(v) {
    if (v == 0) { return 0; }
    return ((v << 9) | (v << 2) | (v >> 5)) & 0xFFFF;
}

# Scale 16-bit MIDI 2.0 velocity to 7-bit MIDI 1.0 (lossy).
#inline
#must_use
fn dhvani_miditx_velocity_16_to_7(v) {
    return (v >> 9) & 0xFF;
}

# Scale 7-bit CC value to 32-bit MIDI 2.0.
#inline
#must_use
fn dhvani_miditx_cc_7_to_32(v) {
    return ((v << 25) | (v << 18) | (v << 11) | (v << 4) | (v >> 3)) & 0xFFFFFFFF;
}

# Scale 32-bit CC value to 7-bit MIDI 1.0 (lossy).
#inline
#must_use
fn dhvani_miditx_cc_32_to_7(v) {
    return (v >> 25) & 0xFF;
}

# Convert 14-bit MIDI 1.0 pitch bend to 32-bit MIDI 2.0.
#inline
#must_use
fn dhvani_miditx_pitch_bend_14_to_32(v) {
    return ((v << 18) | (v << 4) | (v >> 10)) & 0xFFFFFFFF;
}

# Convert 32-bit MIDI 2.0 pitch bend to 14-bit MIDI 1.0 (lossy).
#inline
#must_use
fn dhvani_miditx_pitch_bend_32_to_14(v) {
    return (v >> 18) & 0xFFFF;
}

# ---- struct conversions (V2 types from midi_v2.cyr) ----

# Convert a MIDI 1.0 NoteEvent to a MIDI 2.0 NoteOnV2.
#must_use
fn dhvani_miditx_note_event_to_v2(event) {
    return dhvani_midi2_note_on_new(
        dhvani_note_event_position(event),
        dhvani_note_event_note(event),
        dhvani_miditx_velocity_7_to_16(dhvani_note_event_velocity(event)),
        dhvani_note_event_channel(event),
        0,
        0);
}

# Convert a MIDI 2.0 NoteOnV2 back to a MIDI 1.0 NoteEvent (lossy).
# Requires a duration since NoteOnV2 doesn't carry duration.
#must_use
fn dhvani_miditx_note_on_v2_to_event(event, duration) {
    return dhvani_note_event_new(
        dhvani_midi2_note_on_position(event),
        duration,
        dhvani_midi2_note_on_note(event),
        dhvani_miditx_velocity_16_to_7(dhvani_midi2_note_on_velocity(event)),
        dhvani_midi2_note_on_channel(event));
}

# Convert a MIDI 1.0 ControlChange to MIDI 2.0 ControlChangeV2.
#must_use
fn dhvani_miditx_cc_to_v2(cc) {
    return dhvani_midi2_cc_new(
        dhvani_cc_position(cc),
        dhvani_cc_controller(cc),
        dhvani_miditx_cc_7_to_32(dhvani_cc_value(cc)),
        dhvani_cc_channel(cc));
}

# Convert a MIDI 2.0 ControlChangeV2 to MIDI 1.0 ControlChange (lossy).
#must_use
fn dhvani_miditx_cc_v2_to_cc(cc) {
    return dhvani_cc_new(
        dhvani_midi2_cc_position(cc),
        dhvani_midi2_cc_controller(cc),
        dhvani_miditx_cc_32_to_7(dhvani_midi2_cc_value(cc)),
        dhvani_midi2_cc_channel(cc));
}

# --- graph.cyr ---

# graph.cyr -- audio graph: node-based processing with topological execution.
# Ported one-for-one from rust-old/src/graph/mod.rs. Depends on buffer.cyr
# (dhvani_buffer_silence / dhvani_buffer_samples) + the fnptr stdlib (fncall3).
#
# Design notes (Rust -> Cyrius):
#   * AudioNode trait  -> fn-ptr dispatch. A node is a DhGraphNode struct holding
#     a `process_fp` fn-ptr + opaque `state` pointer + the metadata the trait's
#     default methods carried (finished/bypassed/supports-bypass/latency). The
#     process() call dispatches via fncall3(process_fp, state, inputs, output).
#     Concrete node types (Generator/Gain/...) live in the test unit, exactly as
#     they lived in `mod tests` in Rust.
#   * NodeId(u32) atomic counter -> module-level `var DH_GRAPH_NEXT_ID`.
#   * HashMap<NodeId, _> -> parallel vecs (id-vec + value-vec) + linear scan.
#   * Result<_, &str>    -> plan pointer, or 0 (null) on the "cycle detected" Err.
#   * Option<AudioBuffer> slots -> buffer pointer, or 0 for None.
#   * Arc<Mutex<Option<plan>>> pending-plan cell -> a shared length-1 vec.
#   * process_parallel (#[cfg(feature="parallel")], rayon) -> dropped (no threads).

# ---- NodeId (atomic unique id generator) ----

var DH_GRAPH_NEXT_ID = 1;

# NodeId::next() -- next unique node id (u32 counter, starts at 1).
#must_use
fn dhvani_node_id_next() {
    var id = DH_GRAPH_NEXT_ID;
    DH_GRAPH_NEXT_ID = DH_GRAPH_NEXT_ID + 1;
    return id;
}

# ---- linear-scan helper for HashMap<NodeId,_> ports ----

# index of `id` in the id-vec, or -1 if absent.
fn dh_graph_find(ids, id) {
    var n = vec_len(ids);
    var i = 0;
    while (i < n) {
        if (vec_get(ids, i) == id) { return i; }
        i = i + 1;
    }
    return -1;
}

# ---- AudioNode (trait object -> fn-ptr node) ----

#derive(accessors)
struct DhGraphNode { process_fp; state; ninputs; noutputs; finished; bypassed; supports_byp; latency; name; }

# Construct a node: process fn-ptr, opaque state, port counts, and the flags the
# trait's default methods encode (finished / initial bypass / supports-bypass /
# latency frames) plus a name.
fn dhvani_graph_node_new(process_fp, state, ninputs, noutputs, finished, bypassed, supports_byp, latency, name) {
    var self = alloc(sizeof(DhGraphNode));
    DhGraphNode_set_process_fp(self, process_fp);
    DhGraphNode_set_state(self, state);
    DhGraphNode_set_ninputs(self, ninputs);
    DhGraphNode_set_noutputs(self, noutputs);
    DhGraphNode_set_finished(self, finished);
    DhGraphNode_set_bypassed(self, bypassed);
    DhGraphNode_set_supports_byp(self, supports_byp);
    DhGraphNode_set_latency(self, latency);
    DhGraphNode_set_name(self, name);
    return self;
}

fn dhvani_graph_node_name(node) { return DhGraphNode_name(node); }
fn dhvani_graph_node_num_inputs(node) { return DhGraphNode_ninputs(node); }
fn dhvani_graph_node_num_outputs(node) { return DhGraphNode_noutputs(node); }
fn dhvani_graph_node_is_finished(node) { return DhGraphNode_finished(node); }
fn dhvani_graph_node_is_bypassed(node) { return DhGraphNode_bypassed(node); }
fn dhvani_graph_node_latency(node) { return DhGraphNode_latency(node); }

# process(): dispatch through the stored fn-ptr. inputs = vec of buffer ptrs,
# output = a buffer ptr. The concrete fn reads its own `state`.
fn dhvani_graph_node_process(node, inputs, output) {
    return fncall3(DhGraphNode_process_fp(node), DhGraphNode_state(node), inputs, output);
}

# set_bypass(): only nodes that support it change state; returns 1 on success, 0
# if unsupported (matches the trait default returning false).
fn dhvani_graph_node_set_bypass(node, bypassed) {
    if (DhGraphNode_supports_byp(node) == 1) {
        DhGraphNode_set_bypassed(node, bypassed);
        return 1;
    }
    return 0;
}

# ---- Connection ----

#derive(accessors)
struct DhConnection { cfrom; cto; }

fn dhvani_connection_from(self) { return DhConnection_cfrom(self); }
fn dhvani_connection_to(self) { return DhConnection_cto(self); }

# ---- Graph (non-RT builder) ----

# nodes HashMap -> parallel node_ids / node_ptrs; connections -> conns vec.
#derive(accessors)
struct DhGraph { node_ids; node_ptrs; conns; }

fn dhvani_graph_new() {
    var self = alloc(sizeof(DhGraph));
    DhGraph_set_node_ids(self, vec_new());
    DhGraph_set_node_ptrs(self, vec_new());
    DhGraph_set_conns(self, vec_new());
    return self;
}

# add_node: HashMap insert semantics -- replace an existing id, else append.
fn dhvani_graph_add_node(self, id, node) {
    var ids = DhGraph_node_ids(self);
    var ptrs = DhGraph_node_ptrs(self);
    var idx = dh_graph_find(ids, id);
    if (idx >= 0) {
        vec_set(ptrs, idx, node);
    } else {
        vec_push(ids, id);
        vec_push(ptrs, node);
    }
    return 0;
}

fn dhvani_graph_connect(self, from, to) {
    var c = alloc(sizeof(DhConnection));
    DhConnection_set_cfrom(c, from);
    DhConnection_set_cto(c, to);
    vec_push(DhGraph_conns(self), c);
    return 0;
}

fn dhvani_graph_node_count(self) { return vec_len(DhGraph_node_ids(self)); }
fn dhvani_graph_connection_count(self) { return vec_len(DhGraph_conns(self)); }

# ---- Topological sort (Kahn's algorithm) ----

# Fill out_order with a deterministic topological order of node_ids given conns.
# Returns 0 on success, -1 if a cycle is detected (order shorter than node set).
# Determinism: matches the Rust queue (ascending sort, pop the largest ready id)
# by always taking the max-id node whose in-degree has reached 0.
fn dh_topological_sort(node_ids, conns, out_order) {
    var n = vec_len(node_ids);
    # in-degree parallel to node_ids
    var in_deg = vec_new();
    var a = 0;
    while (a < n) { vec_push(in_deg, 0); a = a + 1; }
    # successors: a vec-of-vecs parallel to node_ids (each holds successor ids)
    var succ = vec_new();
    var b = 0;
    while (b < n) { vec_push(succ, vec_new()); b = b + 1; }
    # tally connections
    var m = vec_len(conns);
    var c = 0;
    while (c < m) {
        var conn = vec_get(conns, c);
        var fi = dh_graph_find(node_ids, DhConnection_cfrom(conn));
        var ti = dh_graph_find(node_ids, DhConnection_cto(conn));
        if (ti >= 0) { vec_set(in_deg, ti, vec_get(in_deg, ti) + 1); }
        if (fi >= 0) { vec_push(vec_get(succ, fi), DhConnection_cto(conn)); }
        c = c + 1;
    }
    # process: repeatedly take the largest-id node with in-degree 0.
    var processed = 0;
    while (processed < n) {
        # scan for the max-id ready (in_deg == 0) node
        var best = -1;
        var besti = -1;
        var i = 0;
        while (i < n) {
            if (vec_get(in_deg, i) == 0) {
                var id = vec_get(node_ids, i);
                if (besti < 0) { best = id; besti = i; }
                elif (id > best) { best = id; besti = i; }
            }
            i = i + 1;
        }
        if (besti < 0) { return -1; }   # nothing ready but nodes remain -> cycle
        vec_set(in_deg, besti, -1);     # mark processed (never ready again)
        vec_push(out_order, best);
        processed = processed + 1;
        # decrement successors' in-degrees
        var sl = vec_get(succ, besti);
        var k = 0;
        var kn = vec_len(sl);
        while (k < kn) {
            var si = dh_graph_find(node_ids, vec_get(sl, k));
            if (si >= 0) {
                if (vec_get(in_deg, si) >= 0) { vec_set(in_deg, si, vec_get(in_deg, si) - 1); }
            }
            k = k + 1;
        }
    }
    return 0;
}

# ---- Level computation (dependency-depth grouping) ----

# Group `order` into levels by max input depth. im_ids/im_lists = input_map
# (node -> its predecessor ids). Returns a vec of levels (each a vec of ids),
# empty levels removed.
fn dh_compute_levels(order, im_ids, im_lists) {
    var d_ids = vec_new();
    var d_vals = vec_new();
    var n = vec_len(order);
    var maxdepth = 0;
    var i = 0;
    while (i < n) {
        var id = vec_get(order, i);
        var dep = 0;
        var imi = dh_graph_find(im_ids, id);
        if (imi >= 0) {
            var preds = vec_get(im_lists, imi);
            var kn = vec_len(preds);
            var found = 0;
            var maxin = 0;
            var k = 0;
            while (k < kn) {
                var pi = dh_graph_find(d_ids, vec_get(preds, k));
                if (pi >= 0) {
                    var pv = vec_get(d_vals, pi);
                    if (found == 0) { maxin = pv; found = 1; }
                    elif (pv > maxin) { maxin = pv; }
                }
                k = k + 1;
            }
            if (found == 1) { dep = maxin + 1; }
        }
        vec_push(d_ids, id);
        vec_push(d_vals, dep);
        if (dep > maxdepth) { maxdepth = dep; }
        i = i + 1;
    }
    # bucket ids into (maxdepth + 1) levels
    var buckets = vec_new();
    var b = 0;
    while (b <= maxdepth) { vec_push(buckets, vec_new()); b = b + 1; }
    var j = 0;
    while (j < n) {
        var id2 = vec_get(order, j);
        var di = dh_graph_find(d_ids, id2);
        vec_push(vec_get(buckets, vec_get(d_vals, di)), id2);
        j = j + 1;
    }
    # retain non-empty levels
    var out = vec_new();
    var l = 0;
    var ln = vec_len(buckets);
    while (l < ln) {
        var lv = vec_get(buckets, l);
        if (vec_len(lv) > 0) { vec_push(out, lv); }
        l = l + 1;
    }
    return out;
}

# ---- ExecutionPlan (compiled, topologically sorted) ----

#derive(accessors)
struct DhExecPlan { order; levels; node_ids; node_ptrs; im_ids; im_lists; lc_ids; lc_vals; }

# node lookup by id inside a plan -> node ptr, or 0 if absent.
fn dh_plan_node(plan, id) {
    var idx = dh_graph_find(DhExecPlan_node_ids(plan), id);
    if (idx < 0) { return 0; }
    return vec_get(DhExecPlan_node_ptrs(plan), idx);
}

# Graph::compile -> ExecutionPlan pointer, or 0 on cycle (the Err case).
fn dhvani_graph_compile(self) {
    var node_ids = DhGraph_node_ids(self);
    var node_ptrs = DhGraph_node_ptrs(self);
    var conns = DhGraph_conns(self);

    var order = vec_new();
    if (dh_topological_sort(node_ids, conns, order) != 0) { return 0; }

    # input_map: for each connection in order, im[to].push(from)
    var im_ids = vec_new();
    var im_lists = vec_new();
    var m = vec_len(conns);
    var c = 0;
    while (c < m) {
        var conn = vec_get(conns, c);
        var to = DhConnection_cto(conn);
        var ii = dh_graph_find(im_ids, to);
        if (ii < 0) {
            vec_push(im_ids, to);
            var fresh = vec_new();
            vec_push(fresh, DhConnection_cfrom(conn));
            vec_push(im_lists, fresh);
        } else {
            vec_push(vec_get(im_lists, ii), DhConnection_cfrom(conn));
        }
        c = c + 1;
    }

    # path_latency: accumulated latency along the longest input path + own.
    var pl_ids = vec_new();
    var pl_vals = vec_new();
    var no = vec_len(order);
    var oi = 0;
    while (oi < no) {
        var id = vec_get(order, oi);
        var node = dh_plan_node2(node_ids, node_ptrs, id);
        var own = 0;
        if (node != 0) { own = dhvani_graph_node_latency(node); }
        var input_max = 0;
        var imi = dh_graph_find(im_ids, id);
        if (imi >= 0) {
            var preds = vec_get(im_lists, imi);
            var pk = 0;
            var pkn = vec_len(preds);
            while (pk < pkn) {
                var ppi = dh_graph_find(pl_ids, vec_get(preds, pk));
                if (ppi >= 0) {
                    var pv = vec_get(pl_vals, ppi);
                    if (pv > input_max) { input_max = pv; }
                }
                pk = pk + 1;
            }
        }
        vec_push(pl_ids, id);
        vec_push(pl_vals, input_max + own);
        oi = oi + 1;
    }

    # latency_comp: for multi-input nodes, delay shorter input paths to align.
    var lc_ids = vec_new();
    var lc_vals = vec_new();
    var oj = 0;
    while (oj < no) {
        var id3 = vec_get(order, oj);
        var imj = dh_graph_find(im_ids, id3);
        if (imj >= 0) {
            var inp = vec_get(im_lists, imj);
            var inn = vec_len(inp);
            if (inn > 1) {
                # max input path latency
                var mil = 0;
                var q = 0;
                while (q < inn) {
                    var qi = dh_graph_find(pl_ids, vec_get(inp, q));
                    if (qi >= 0) {
                        var qv = vec_get(pl_vals, qi);
                        if (qv > mil) { mil = qv; }
                    }
                    q = q + 1;
                }
                # per-input compensation delay
                var r = 0;
                while (r < inn) {
                    var inpid = vec_get(inp, r);
                    var ri = dh_graph_find(pl_ids, inpid);
                    var il = 0;
                    if (ri >= 0) { il = vec_get(pl_vals, ri); }
                    var comp = mil - il;
                    if (comp > 0) {
                        var ei = dh_graph_find(lc_ids, inpid);
                        if (ei >= 0) { vec_set(lc_vals, ei, comp); }
                        else { vec_push(lc_ids, inpid); vec_push(lc_vals, comp); }
                    }
                    r = r + 1;
                }
            }
        }
        oj = oj + 1;
    }

    var levels = dh_compute_levels(order, im_ids, im_lists);

    var plan = alloc(sizeof(DhExecPlan));
    DhExecPlan_set_order(plan, order);
    DhExecPlan_set_levels(plan, levels);
    DhExecPlan_set_node_ids(plan, node_ids);
    DhExecPlan_set_node_ptrs(plan, node_ptrs);
    DhExecPlan_set_im_ids(plan, im_ids);
    DhExecPlan_set_im_lists(plan, im_lists);
    DhExecPlan_set_lc_ids(plan, lc_ids);
    DhExecPlan_set_lc_vals(plan, lc_vals);
    return plan;
}

# node lookup against raw parallel vecs (used during compile before the plan exists).
fn dh_plan_node2(node_ids, node_ptrs, id) {
    var idx = dh_graph_find(node_ids, id);
    if (idx < 0) { return 0; }
    return vec_get(node_ptrs, idx);
}

fn dhvani_plan_order(plan) { return DhExecPlan_order(plan); }
fn dhvani_plan_levels(plan) { return DhExecPlan_levels(plan); }

# is the last node in topo order finished?
fn dhvani_plan_is_finished(plan) {
    var order = DhExecPlan_order(plan);
    var n = vec_len(order);
    if (n == 0) { return 0; }
    var node = dh_plan_node(plan, vec_get(order, n - 1));
    if (node == 0) { return 0; }
    return dhvani_graph_node_is_finished(node);
}

# set bypass for a node; 0 if absent or unsupported.
fn dhvani_plan_set_bypass(plan, id, bypassed) {
    var node = dh_plan_node(plan, id);
    if (node == 0) { return 0; }
    return dhvani_graph_node_set_bypass(node, bypassed);
}

fn dhvani_plan_is_bypassed(plan, id) {
    var node = dh_plan_node(plan, id);
    if (node == 0) { return 0; }
    return dhvani_graph_node_is_bypassed(node);
}

fn dhvani_plan_latency_frames(plan, id) {
    var node = dh_plan_node(plan, id);
    if (node == 0) { return 0; }
    return dhvani_graph_node_latency(node);
}

# compensation delay for a node's output (0 if none).
fn dhvani_plan_compensation_delay(plan, id) {
    var idx = dh_graph_find(DhExecPlan_lc_ids(plan), id);
    if (idx < 0) { return 0; }
    return vec_get(DhExecPlan_lc_vals(plan), idx);
}

# total pipeline latency = max accumulated path latency from source to sink.
#must_use
fn dhvani_plan_total_latency(plan) {
    var order = DhExecPlan_order(plan);
    var im_ids = DhExecPlan_im_ids(plan);
    var im_lists = DhExecPlan_im_lists(plan);
    var nl_ids = vec_new();
    var nl_vals = vec_new();
    var n = vec_len(order);
    var maxlat = 0;
    var i = 0;
    while (i < n) {
        var id = vec_get(order, i);
        var node = dh_plan_node(plan, id);
        var own = 0;
        if (node != 0) { own = dhvani_graph_node_latency(node); }
        var input_max = 0;
        var imi = dh_graph_find(im_ids, id);
        if (imi >= 0) {
            var preds = vec_get(im_lists, imi);
            var k = 0;
            var kn = vec_len(preds);
            while (k < kn) {
                var pi = dh_graph_find(nl_ids, vec_get(preds, k));
                if (pi >= 0) {
                    var pv = vec_get(nl_vals, pi);
                    if (pv > input_max) { input_max = pv; }
                }
                k = k + 1;
            }
        }
        var total = input_max + own;
        vec_push(nl_ids, id);
        vec_push(nl_vals, total);
        if (total > maxlat) { maxlat = total; }
        i = i + 1;
    }
    return maxlat;
}

# ---- GraphProcessor (RT-thread, double-buffered plan swap) ----

# pending = a shared length-1 vec cell (Arc<Mutex<Option<plan>>>); node_outputs
# indexed by NodeId value; 0 = None.
#derive(accessors)
struct DhGraphProc { current_plan; pending; node_outputs; channels; sample_rate; buffer_frames; }

fn dhvani_graph_proc_new(channels, sample_rate, buffer_frames) {
    var self = alloc(sizeof(DhGraphProc));
    DhGraphProc_set_current_plan(self, 0);
    var cell = vec_new();
    vec_push(cell, 0);
    DhGraphProc_set_pending(self, cell);
    DhGraphProc_set_node_outputs(self, vec_new());
    DhGraphProc_set_channels(self, channels);
    DhGraphProc_set_sample_rate(self, sample_rate);
    DhGraphProc_set_buffer_frames(self, buffer_frames);
    return self;
}

# ---- GraphSwapHandle (non-RT thread hands new plans over the pending cell) ----

#derive(accessors)
struct DhSwapHandle { pending; }

fn dhvani_graph_proc_swap_handle(self) {
    var h = alloc(sizeof(DhSwapHandle));
    DhSwapHandle_set_pending(h, DhGraphProc_pending(self));
    return h;
}

fn dhvani_swap_handle_swap(self, plan) {
    vec_set(DhSwapHandle_pending(self), 0, plan);
    return 0;
}

# Arc clone -> another handle over the same pending cell.
fn dhvani_swap_handle_clone(self) {
    var h = alloc(sizeof(DhSwapHandle));
    DhSwapHandle_set_pending(h, DhSwapHandle_pending(self));
    return h;
}

# Process one buffer cycle. Returns the last node's output buffer ptr, or 0 if
# no plan is active.
fn dhvani_graph_proc_process(self) {
    # pick up a pending plan (take() the cell)
    var cell = DhGraphProc_pending(self);
    var newplan = vec_get(cell, 0);
    if (newplan != 0) {
        vec_set(cell, 0, 0);
        # size node_outputs to (max node id + 1), all None
        var norder = DhExecPlan_order(newplan);
        var maxid = 0;
        var mi = 0;
        var mn = vec_len(norder);
        while (mi < mn) {
            var mv = vec_get(norder, mi);
            if (mv > maxid) { maxid = mv; }
            mi = mi + 1;
        }
        var no = vec_new();
        var z = 0;
        while (z <= maxid) { vec_push(no, 0); z = z + 1; }
        DhGraphProc_set_node_outputs(self, no);
        DhGraphProc_set_current_plan(self, newplan);
    }

    var plan = DhGraphProc_current_plan(self);
    if (plan == 0) { return 0; }

    var outputs = DhGraphProc_node_outputs(self);
    var order = DhExecPlan_order(plan);
    var im_ids = DhExecPlan_im_ids(plan);
    var im_lists = DhExecPlan_im_lists(plan);
    var ch = DhGraphProc_channels(self);
    var sr = DhGraphProc_sample_rate(self);
    var bf = DhGraphProc_buffer_frames(self);
    var olen = vec_len(outputs);

    var np = vec_len(order);
    var p = 0;
    while (p < np) {
        var node_id = vec_get(order, p);
        var idx = node_id;

        # gather input buffers from predecessor output slots
        var scratch = vec_new();
        var imi = dh_graph_find(im_ids, node_id);
        if (imi >= 0) {
            var preds = vec_get(im_lists, imi);
            var k = 0;
            var kn = vec_len(preds);
            while (k < kn) {
                var pid = vec_get(preds, k);
                if (pid < olen) {
                    var pbuf = vec_get(outputs, pid);
                    if (pbuf != 0) { vec_push(scratch, pbuf); }
                }
                k = k + 1;
            }
        }

        # take (or create) this node's output buffer, then zero it
        var output = 0;
        if (idx < olen) { output = vec_get(outputs, idx); }
        if (output == 0) { output = dhvani_buffer_silence(ch, bf, sr); }
        var osamp = dhvani_buffer_samples(output);
        var zn = vec_len(osamp);
        var zi = 0;
        while (zi < zn) { vec_set(osamp, zi, 0); zi = zi + 1; }

        # process (or bypass: copy the first input straight through)
        var node = dh_plan_node(plan, node_id);
        if (node != 0) {
            if (dhvani_graph_node_is_bypassed(node) == 1) {
                if (vec_len(scratch) > 0) {
                    var fs = dhvani_buffer_samples(vec_get(scratch, 0));
                    var ci = 0;
                    while (ci < zn) { vec_set(osamp, ci, vec_get(fs, ci)); ci = ci + 1; }
                }
            } else {
                dhvani_graph_node_process(node, scratch, output);
            }
        }

        vec_set(outputs, idx, output);
        p = p + 1;
    }

    # return the last node's output slot (0 if None)
    if (np == 0) { return 0; }
    var lastid = vec_get(order, np - 1);
    if (lastid < vec_len(outputs)) { return vec_get(outputs, lastid); }
    return 0;
}

fn dhvani_graph_proc_is_finished(self) {
    var plan = DhGraphProc_current_plan(self);
    if (plan == 0) { return 0; }
    return dhvani_plan_is_finished(plan);
}

# --- graphic_eq.cyr ---

# graphic_eq.cyr -- 10-band ISO graphic equalizer with named presets.
# Ports rust-old/src/dsp/graphic_eq.rs. L2: deps error + simd + buffer + abaco
# + biquad + eq. Wraps ParametricEq (dhvani_eq_*) with fixed ISO center
# frequencies at Q=1.4.
#
# GraphicEqSettings.bands (Rust [f32;10]) -> a `vec` of 10 f64 slots. enabled ->
# integer flag (0/1). preset(name) matches string literals via streq(...) ==
# (the abaco pattern) and returns a settings handle with the 10-band vec.
# ISO_BANDS / BAND_NAMES are functions returning the i-th entry (Cyrius has no
# static array tables; a small if-chain is the idiom, mirroring dhvani_err_name).
#
# rebuild() -- ALLOC-FREE: the inner ParametricEq always has exactly 10 bands
# (one per ISO frequency), so rebuild() reuses it via in-place
# dhvani_eq_set_band on each band rather than allocating a fresh ParametricEq
# every load_preset/set_band call. The bump allocator never frees, so replacing
# the inner eq per parameter change would leak a full eq (10 biquads + configs)
# each time. set_band recomputes only that band's coeffs and swaps its config.
# serde round-trip + Display tests are the only drops.

var DH_GEQ_Q          = 0x3FF6666666666666;   # GRAPHIC_EQ_Q = 1.4 (exact hex; 1.4 has no finite binary form so the decimal literal would misparse)
var DH_GEQ_MAX_GAIN   = 12.0;                  # MAX_GAIN_DB
var DH_GEQ_FLAT_EPS   = 0x3F847AE147AE147B;    # 0.01 (is_flat / enabled threshold; 0.01 is not exactly representable -> hex)

# ISO center frequency (Hz) for band index i (0..9). All integer-valued so
# decimal literals below 2^24 are safe.
#must_use
fn dhvani_geq_iso_band(i) {
    if (i == 0) { return 31.0; }
    if (i == 1) { return 62.0; }
    if (i == 2) { return 125.0; }
    if (i == 3) { return 250.0; }
    if (i == 4) { return 500.0; }
    if (i == 5) { return 1000.0; }
    if (i == 6) { return 2000.0; }
    if (i == 7) { return 4000.0; }
    if (i == 8) { return 8000.0; }
    return 16000.0;
}

# Display name for band index i (was BAND_NAMES). Out of range -> "?".
#must_use
fn dhvani_geq_band_name(i) {
    if (i == 0) { return "31 Hz"; }
    if (i == 1) { return "62 Hz"; }
    if (i == 2) { return "125 Hz"; }
    if (i == 3) { return "250 Hz"; }
    if (i == 4) { return "500 Hz"; }
    if (i == 5) { return "1 kHz"; }
    if (i == 6) { return "2 kHz"; }
    if (i == 7) { return "4 kHz"; }
    if (i == 8) { return "8 kHz"; }
    if (i == 9) { return "16 kHz"; }
    return "?";
}

# ---- GraphicEqSettings ----
# bands is a `vec` of 10 f64 gains (dB). enabled is 0/1.
#derive(accessors)
struct DhGraphicEqSettings { bands; enabled; }

# default() -- all bands 0 dB, disabled.
#must_use
fn dhvani_geq_settings_default() {
    var s = alloc(sizeof(DhGraphicEqSettings));
    DhGraphicEqSettings_set_bands(s, dh_vec_zeros(10));
    DhGraphicEqSettings_set_enabled(s, 0);
    return s;
}

# flat() -- alias for default (all bands 0 dB, disabled).
#must_use
fn dhvani_geq_settings_flat() {
    return dhvani_geq_settings_default();
}

# is_flat -- true if disabled OR every band's |gain| < 0.01.
#must_use
fn dhvani_geq_settings_is_flat(self) {
    if (DhGraphicEqSettings_enabled(self) == 0) { return 1; }
    var bands = DhGraphicEqSettings_bands(self);
    var i = 0;
    while (i < 10) {
        if (f64_ge(f64_abs(vec_get(bands, i)), DH_GEQ_FLAT_EPS) == 1) { return 0; }
        i = i + 1;
    }
    return 1;
}

# set_band(band, gain_db) -- set a band's gain, clamped to [-12, 12]. No-op if
# band >= 10.
fn dhvani_geq_settings_set_band(self, band, gain_db) {
    if (band < 10) {
        vec_set(DhGraphicEqSettings_bands(self), band,
                f64_clamp(gain_db, f64_neg(DH_GEQ_MAX_GAIN), DH_GEQ_MAX_GAIN));
    }
    return 0;
}

# preset(name) -- named preset. Unknown names -> flat (all 0), enabled=true.
#                          31   62  125  250  500   1k   2k   4k   8k  16k
#must_use
fn dhvani_geq_settings_preset(name) {
    var b = dh_vec_zeros(10);
    if (streq(name, "rock") == 1) {
        vec_set(b, 0, 4.0); vec_set(b, 1, 3.0); vec_set(b, 2, 1.0); vec_set(b, 3, f64_neg(1.0)); vec_set(b, 4, f64_neg(2.0));
        vec_set(b, 5, 0); vec_set(b, 6, 2.0); vec_set(b, 7, 3.0); vec_set(b, 8, 4.0); vec_set(b, 9, 4.0);
    } elif (streq(name, "pop") == 1) {
        vec_set(b, 0, f64_neg(1.0)); vec_set(b, 1, 1.0); vec_set(b, 2, 3.0); vec_set(b, 3, 4.0); vec_set(b, 4, 3.0);
        vec_set(b, 5, 0); vec_set(b, 6, f64_neg(1.0)); vec_set(b, 7, 0); vec_set(b, 8, 1.0); vec_set(b, 9, 2.0);
    } elif (streq(name, "jazz") == 1) {
        vec_set(b, 0, 2.0); vec_set(b, 1, 1.0); vec_set(b, 2, 0); vec_set(b, 3, 1.0); vec_set(b, 4, f64_neg(1.0));
        vec_set(b, 5, f64_neg(1.0)); vec_set(b, 6, 0); vec_set(b, 7, 1.0); vec_set(b, 8, 2.0); vec_set(b, 9, 3.0);
    } elif (streq(name, "classical") == 1) {
        vec_set(b, 0, 0); vec_set(b, 1, 0); vec_set(b, 2, 0); vec_set(b, 3, 0); vec_set(b, 4, 0);
        vec_set(b, 5, 0); vec_set(b, 6, f64_neg(2.0)); vec_set(b, 7, f64_neg(3.0)); vec_set(b, 8, f64_neg(2.0)); vec_set(b, 9, 0);
    } elif (streq(name, "bass") == 1) {
        vec_set(b, 0, 6.0); vec_set(b, 1, 5.0); vec_set(b, 2, 4.0); vec_set(b, 3, 2.0); vec_set(b, 4, 0);
        vec_set(b, 5, 0); vec_set(b, 6, 0); vec_set(b, 7, 0); vec_set(b, 8, 0); vec_set(b, 9, 0);
    } elif (streq(name, "treble") == 1) {
        vec_set(b, 0, 0); vec_set(b, 1, 0); vec_set(b, 2, 0); vec_set(b, 3, 0); vec_set(b, 4, 0);
        vec_set(b, 5, 0); vec_set(b, 6, 2.0); vec_set(b, 7, 4.0); vec_set(b, 8, 5.0); vec_set(b, 9, 6.0);
    } elif (streq(name, "vocal") == 1) {
        vec_set(b, 0, f64_neg(2.0)); vec_set(b, 1, f64_neg(1.0)); vec_set(b, 2, 0); vec_set(b, 3, 2.0); vec_set(b, 4, 4.0);
        vec_set(b, 5, 4.0); vec_set(b, 6, 3.0); vec_set(b, 7, 1.0); vec_set(b, 8, 0); vec_set(b, 9, f64_neg(1.0));
    } elif (streq(name, "electronic") == 1) {
        vec_set(b, 0, 5.0); vec_set(b, 1, 4.0); vec_set(b, 2, 1.0); vec_set(b, 3, 0); vec_set(b, 4, f64_neg(2.0));
        vec_set(b, 5, 0); vec_set(b, 6, 1.0); vec_set(b, 7, 3.0); vec_set(b, 8, 4.0); vec_set(b, 9, 5.0);
    } elif (streq(name, "acoustic") == 1) {
        vec_set(b, 0, 2.0); vec_set(b, 1, 1.0); vec_set(b, 2, 0); vec_set(b, 3, 1.0); vec_set(b, 4, 2.0);
        vec_set(b, 5, 1.0); vec_set(b, 6, 2.0); vec_set(b, 7, 3.0); vec_set(b, 8, 2.0); vec_set(b, 9, 1.0);
    }
    # else: unknown -> all zeros (already zeroed).
    var s = alloc(sizeof(DhGraphicEqSettings));
    DhGraphicEqSettings_set_bands(s, b);
    DhGraphicEqSettings_set_enabled(s, 1);
    return s;
}

# preset_count / preset_name(i) -- the available preset names (was
# preset_names() -> &'static [&str]). "flat" first, then the 9 named presets.
#must_use
fn dhvani_geq_preset_count() { return 10; }
#must_use
fn dhvani_geq_preset_name(i) {
    if (i == 0) { return "flat"; }
    if (i == 1) { return "rock"; }
    if (i == 2) { return "pop"; }
    if (i == 3) { return "jazz"; }
    if (i == 4) { return "classical"; }
    if (i == 5) { return "bass"; }
    if (i == 6) { return "treble"; }
    if (i == 7) { return "vocal"; }
    if (i == 8) { return "electronic"; }
    if (i == 9) { return "acoustic"; }
    return "?";
}

# --- GraphicEqSettings accessors ---
#inline
#must_use
fn dhvani_geq_settings_bands(self) { return DhGraphicEqSettings_bands(self); }
# band gain at index i (0 if out of range).
#inline
#must_use
fn dhvani_geq_settings_band(self, i) {
    if (i < 10) { return vec_get(DhGraphicEqSettings_bands(self), i); }
    return 0;
}
#inline
#must_use
fn dhvani_geq_settings_enabled(self) { return DhGraphicEqSettings_enabled(self); }

# ---- GraphicEq ----
#derive(accessors)
struct DhGraphicEq { inner; settings; sample_rate; channels; }

# build_eq(settings, sample_rate, channels) -- a fresh ParametricEq with 10
# peaking bands at the ISO frequencies, Q=1.4, each enabled iff |gain| >= 0.01.
#must_use
fn dhvani_geq_build_eq(settings, sample_rate, channels) {
    var bands = DhGraphicEqSettings_bands(settings);
    var cfgs = vec_new();
    var i = 0;
    while (i < 10) {
        var gain_db = vec_get(bands, i);
        var enabled = 0;
        if (f64_ge(f64_abs(gain_db), DH_GEQ_FLAT_EPS) == 1) { enabled = 1; }
        vec_push(cfgs, dhvani_eq_band_config_new(DH_BAND_PEAKING, dhvani_geq_iso_band(i), gain_db, DH_GEQ_Q, enabled));
        i = i + 1;
    }
    return dhvani_eq_new(cfgs, sample_rate, channels);
}

# new(sample_rate, channels) -- all bands flat, disabled.
#must_use
fn dhvani_geq_new(sample_rate, channels) {
    var self = alloc(sizeof(DhGraphicEq));
    var settings = dhvani_geq_settings_default();
    DhGraphicEq_set_settings(self, settings);
    DhGraphicEq_set_inner(self, dhvani_geq_build_eq(settings, sample_rate, channels));
    DhGraphicEq_set_sample_rate(self, sample_rate);
    DhGraphicEq_set_channels(self, channels);
    return self;
}

# rebuild -- ALLOC-FREE: re-derive the 10 band configs from the current settings
# and push them into the existing inner ParametricEq via in-place set_band (only
# each band's coeffs are recomputed; no eq/biquad allocation). Rust allocated a
# fresh ParametricEq here; under the bump allocator that leaks, so we mutate.
fn dhvani_geq_rebuild(self) {
    var inner = DhGraphicEq_inner(self);
    var settings = DhGraphicEq_settings(self);
    var bands = DhGraphicEqSettings_bands(settings);
    var i = 0;
    while (i < 10) {
        var gain_db = vec_get(bands, i);
        var enabled = 0;
        if (f64_ge(f64_abs(gain_db), DH_GEQ_FLAT_EPS) == 1) { enabled = 1; }
        dhvani_eq_set_band(inner, i,
            dhvani_eq_band_config_new(DH_BAND_PEAKING, dhvani_geq_iso_band(i), gain_db, DH_GEQ_Q, enabled));
        i = i + 1;
    }
    return 0;
}

# process(buf) -- run the 10-band EQ in place. Bypass entirely if flat/disabled.
# Adapts to a changed sample rate before processing.
#inline
fn dhvani_geq_process(self, buf) {
    if (dhvani_geq_settings_is_flat(DhGraphicEq_settings(self)) == 1) { return 0; }
    var bsr = DhAudioBuffer_sample_rate(buf);
    if (bsr != DhGraphicEq_sample_rate(self)) {
        DhGraphicEq_set_sample_rate(self, bsr);
        # sample rate changed: rebuild inner coeffs at the new rate.
        dhvani_eq_set_sample_rate(DhGraphicEq_inner(self), bsr);
        dhvani_geq_rebuild(self);
    }
    dhvani_eq_process(DhGraphicEq_inner(self), buf);
    return 0;
}

# load_preset(name) -- replace settings with a named preset, rebuild coeffs.
fn dhvani_geq_load_preset(self, name) {
    DhGraphicEq_set_settings(self, dhvani_geq_settings_preset(name));
    dhvani_geq_rebuild(self);
    return 0;
}

# set_band(band, gain_db) -- set a band's gain, rebuild coeffs.
fn dhvani_geq_set_band(self, band, gain_db) {
    dhvani_geq_settings_set_band(DhGraphicEq_settings(self), band, gain_db);
    dhvani_geq_rebuild(self);
    return 0;
}

# set_settings(settings) -- apply full settings, rebuild coeffs.
fn dhvani_geq_set_settings(self, settings) {
    DhGraphicEq_set_settings(self, settings);
    dhvani_geq_rebuild(self);
    return 0;
}

# settings() -- current settings handle.
#inline
#must_use
fn dhvani_geq_settings(self) { return DhGraphicEq_settings(self); }

# set_enabled(enabled) -- toggle the EQ without rebuilding.
fn dhvani_geq_set_enabled(self, enabled) {
    DhGraphicEqSettings_set_enabled(DhGraphicEq_settings(self), enabled);
    return 0;
}

# reset() -- clear inner filter state (call on seek / track change).
fn dhvani_geq_reset(self) {
    dhvani_eq_reset(DhGraphicEq_inner(self));
    return 0;
}

# --- key.cyr ---

# key.cyr -- Krumhansl-Schmuckler key detection from a chromagram.
# Ports rust-old/src/analysis/key.rs. Classifies audio into one of 24 keys
# (12 major + 12 minor) by correlating the 12-bin chromagram against rotated
# Krumhansl-Kessler major/minor profiles (Pearson correlation).
# L1: deps error + simd + buffer + abaco + analysis (Spectrum) + fft +
# chroma (Chromagram). serde + Display dropped.
#
# KeyResult fields: key (name string), root (0..11 pitch class), is_major (0/1),
# confidence (0..1), correlations (24-slot vec: [12 major..., 12 minor...]).

# ---- PITCH_NAMES lookup (was [&str; 12]) ----
#must_use
fn dhvani_key_pitch_name(idx) {
    if (idx == 0)  { return "C"; }
    if (idx == 1)  { return "C#"; }
    if (idx == 2)  { return "D"; }
    if (idx == 3)  { return "D#"; }
    if (idx == 4)  { return "E"; }
    if (idx == 5)  { return "F"; }
    if (idx == 6)  { return "F#"; }
    if (idx == 7)  { return "G"; }
    if (idx == 8)  { return "G#"; }
    if (idx == 9)  { return "A"; }
    if (idx == 10) { return "A#"; }
    if (idx == 11) { return "B"; }
    return "unknown";
}

# ---- MAJOR_PROFILE (Krumhansl-Kessler) as a 12-slot vec ----
# [6.35, 2.23, 3.48, 2.33, 4.38, 4.09, 2.52, 5.19, 2.39, 3.66, 2.29, 2.88]
#must_use
fn dhvani_key_major_profile() {
    var p = vec_new();
    vec_push(p, 6.35);
    vec_push(p, 2.23);
    vec_push(p, 3.48);
    vec_push(p, 2.33);
    vec_push(p, 4.38);
    vec_push(p, 4.09);
    vec_push(p, 2.52);
    vec_push(p, 5.19);
    vec_push(p, 2.39);
    vec_push(p, 3.66);
    vec_push(p, 2.29);
    vec_push(p, 2.88);
    return p;
}

# ---- MINOR_PROFILE (Krumhansl-Kessler) as a 12-slot vec ----
# [6.33, 2.68, 3.52, 5.38, 2.60, 3.53, 2.54, 4.75, 3.98, 2.69, 3.34, 3.17]
#must_use
fn dhvani_key_minor_profile() {
    var p = vec_new();
    vec_push(p, 6.33);
    vec_push(p, 2.68);
    vec_push(p, 3.52);
    vec_push(p, 5.38);
    vec_push(p, 2.60);
    vec_push(p, 3.53);
    vec_push(p, 2.54);
    vec_push(p, 4.75);
    vec_push(p, 3.98);
    vec_push(p, 2.69);
    vec_push(p, 3.34);
    vec_push(p, 3.17);
    return p;
}

#derive(accessors)
struct DhKeyResult { key; root; is_major; confidence; correlations; }

# --- accessors ---
#inline
#must_use
fn dhvani_key_result_key(self) { return DhKeyResult_key(self); }
#inline
#must_use
fn dhvani_key_result_root(self) { return DhKeyResult_root(self); }
#inline
#must_use
fn dhvani_key_result_is_major(self) { return DhKeyResult_is_major(self); }
#inline
#must_use
fn dhvani_key_result_confidence(self) { return DhKeyResult_confidence(self); }
#inline
#must_use
fn dhvani_key_result_correlations(self) { return DhKeyResult_correlations(self); }

# Full key name for (root, is_major): e.g. "C major", "A minor".
# (Replaces the Rust format!("{} {mode}", PITCH_NAMES[root]).)
#must_use
fn dhvani_key_name(root, is_major) {
    var name = dhvani_key_pitch_name(root);
    if (is_major == 1) {
        if (root == 0)  { return "C major"; }
        if (root == 1)  { return "C# major"; }
        if (root == 2)  { return "D major"; }
        if (root == 3)  { return "D# major"; }
        if (root == 4)  { return "E major"; }
        if (root == 5)  { return "F major"; }
        if (root == 6)  { return "F# major"; }
        if (root == 7)  { return "G major"; }
        if (root == 8)  { return "G# major"; }
        if (root == 9)  { return "A major"; }
        if (root == 10) { return "A# major"; }
        if (root == 11) { return "B major"; }
        return "unknown major";
    }
    if (root == 0)  { return "C minor"; }
    if (root == 1)  { return "C# minor"; }
    if (root == 2)  { return "D minor"; }
    if (root == 3)  { return "D# minor"; }
    if (root == 4)  { return "E minor"; }
    if (root == 5)  { return "F minor"; }
    if (root == 6)  { return "F# minor"; }
    if (root == 7)  { return "G minor"; }
    if (root == 8)  { return "G# minor"; }
    if (root == 9)  { return "A minor"; }
    if (root == 10) { return "A# minor"; }
    if (root == 11) { return "B minor"; }
    return "unknown minor";
}

# Pearson correlation between a 12-slot chroma `vec` and a 12-slot key profile
# `vec` rotated to `root`. Mirrors the Rust helper exactly.
#must_use
fn dhvani_key_pearson_correlation(chroma, profile, root) {
    var n = 12.0;

    # Compute means.
    var chroma_sum = 0;
    var profile_sum = 0;
    var s = 0;
    while (s < 12) {
        chroma_sum = f64_add(chroma_sum, vec_get(chroma, s));
        profile_sum = f64_add(profile_sum, vec_get(profile, s));
        s = s + 1;
    }
    var chroma_mean = f64_div(chroma_sum, n);
    var profile_mean = f64_div(profile_sum, n);

    var cov = 0;
    var var_chroma = 0;
    var var_profile = 0;
    var i = 0;
    while (i < 12) {
        var c = f64_sub(vec_get(chroma, (i + root) % 12), chroma_mean);
        var p = f64_sub(vec_get(profile, i), profile_mean);
        cov = f64_add(cov, f64_mul(c, p));
        var_chroma = f64_add(var_chroma, f64_mul(c, c));
        var_profile = f64_add(var_profile, f64_mul(p, p));
        i = i + 1;
    }

    var denom = f64_sqrt(f64_mul(var_chroma, var_profile));
    if (f64_gt(denom, 0.0000000001) == 1) { return f64_div(cov, denom); }
    return 0;
}

# Descending in-place insertion sort of a `vec` of f64 (mirrors Rust
# sort_by(|a,b| b.partial_cmp(a)) with the correlations we produce being finite).
fn dhvani_key_sort_desc(v) {
    var n = vec_len(v);
    var i = 1;
    while (i < n) {
        var key_v = vec_get(v, i);
        var j = i - 1;
        var cont = 1;
        while (cont == 1) {
            if (j < 0) { cont = 0; }
            elif (f64_lt(vec_get(v, j), key_v) == 1) {
                vec_set(v, j + 1, vec_get(v, j));
                j = j - 1;
            } else { cont = 0; }
        }
        vec_set(v, j + 1, key_v);
        i = i + 1;
    }
    return 0;
}

# detect_key_from_chroma(chroma) -- detect key from a pre-computed chromagram.
#must_use
fn dhvani_key_detect_from_chroma(chroma) {
    var chroma_vals = dhvani_chromagram_chroma(chroma);
    var major_profile = dhvani_key_major_profile();
    var minor_profile = dhvani_key_minor_profile();
    var correlations = dh_vec_zeros(24);
    var best_idx = 0;
    var best_corr = DH_NEG_INF;

    # Test all 24 keys (12 major + 12 minor).
    var root = 0;
    while (root < 12) {
        var major_corr = dhvani_key_pearson_correlation(chroma_vals, major_profile, root);
        vec_set(correlations, root, major_corr);
        if (f64_gt(major_corr, best_corr) == 1) {
            best_corr = major_corr;
            best_idx = root;
        }

        var minor_corr = dhvani_key_pearson_correlation(chroma_vals, minor_profile, root);
        vec_set(correlations, 12 + root, minor_corr);
        if (f64_gt(minor_corr, best_corr) == 1) {
            best_corr = minor_corr;
            best_idx = 12 + root;
        }
        root = root + 1;
    }

    var is_major = 0;
    if (best_idx < 12) { is_major = 1; }
    var root_out = best_idx % 12;
    var key = dhvani_key_name(root_out, is_major);

    # Confidence: how much better is the best match vs second-best?
    var sorted = vec_new();
    var si = 0;
    while (si < 24) { vec_push(sorted, vec_get(correlations, si)); si = si + 1; }
    dhvani_key_sort_desc(sorted);
    var confidence = 0;
    if (f64_gt(vec_get(sorted, 0), 0.0) == 1) {
        var s0 = vec_get(sorted, 0);
        var s1 = vec_get(sorted, 1);
        var raw = f64_div(f64_sub(s0, s1), f64_max(f64_abs(s0), 0.001));
        confidence = f64_clamp(raw, 0.0, 1.0);
    }

    var self = alloc(sizeof(DhKeyResult));
    DhKeyResult_set_key(self, key);
    DhKeyResult_set_root(self, root_out);
    DhKeyResult_set_is_major(self, is_major);
    DhKeyResult_set_confidence(self, confidence);
    DhKeyResult_set_correlations(self, correlations);
    return self;
}

# detect_key(buf, window_size) -- compute a chromagram, then detect the key.
# Returns a KeyResult handle, or 0 if the chromagram computation fails.
#must_use
fn dhvani_key_detect(buf, window_size) {
    var chroma = dhvani_chroma_chromagram(buf, window_size);
    if (chroma == 0) { return 0; }
    return dhvani_key_detect_from_chroma(chroma);
}

# --- onset.cyr ---

# onset.cyr -- Onset detection via spectral flux.
# Ports rust-old/src/analysis/onset.rs. L1: deps error + simd + buffer +
# abaco + analysis + fft + stft (dhvani_stft). Frames the signal, computes the
# per-frame spectral difference (sum of positive bin-to-bin increases), normalizes
# the flux by its peak, and peak-picks local maxima above a threshold.
#
# OnsetResult.positions was Vec<usize> (sample positions), strengths Vec<f32>.
# Here each is a `vec`: positions holds integer sample offsets, strengths holds
# f64 flux values. detect_onsets is fallible in Rust (STFT can fail) -> returns a
# valid result handle, or 0 (null) on STFT error. On < 2 frames it returns an
# empty (but non-null) result, matching the Rust Ok(empty).

#derive(accessors)
struct DhOnsetResult { positions; strengths; }

# frame positions (in samples) of detected onsets.
#inline
#must_use
fn dhvani_onset_positions(self) { return DhOnsetResult_positions(self); }

# spectral flux values at each onset.
#inline
#must_use
fn dhvani_onset_strengths(self) { return DhOnsetResult_strengths(self); }

# number of detected onsets.
#inline
#must_use
fn dhvani_onset_count(self) { return vec_len(DhOnsetResult_positions(self)); }

# position (sample offset) of onset index i.
#inline
#must_use
fn dhvani_onset_position(self, i) { return vec_get(DhOnsetResult_positions(self), i); }

# strength (flux) of onset index i.
#inline
#must_use
fn dhvani_onset_strength(self, i) { return vec_get(DhOnsetResult_strengths(self), i); }

# build an OnsetResult from positions + strengths vecs.
#must_use
fn dhvani_onset_make_result(positions, strengths) {
    var self = alloc(sizeof(DhOnsetResult));
    DhOnsetResult_set_positions(self, positions);
    DhOnsetResult_set_strengths(self, strengths);
    return self;
}

# detect_onsets(buf, window_size, hop_size, threshold) -- spectral-flux onsets.
# Returns a result handle, or 0 on STFT error. With < 2 STFT frames returns an
# empty result. threshold is an f64 sensitivity (lower = more sensitive).
#must_use
fn dhvani_detect_onsets(buf, window_size, hop_size, threshold) {
    var sg = dhvani_stft(buf, window_size, hop_size);
    if (sg == 0) { return 0; }

    var num_frames = dhvani_spectrogram_num_frames(sg);
    if (num_frames < 2) {
        return dhvani_onset_make_result(vec_new(), vec_new());
    }

    var num_bins = dhvani_spectrogram_num_bins(sg);

    # Compute spectral flux: sum of positive differences between consecutive frames.
    var flux = vec_new();
    vec_push(flux, 0); # First frame has no predecessor.

    var i = 1;
    while (i < num_frames) {
        var diff_sum = 0;
        var cur = dhvani_spectrogram_frame(sg, i);
        var prev = dhvani_spectrogram_frame(sg, i - 1);
        var bin = 0;
        while (bin < num_bins) {
            var diff = f64_sub(vec_get(cur, bin), vec_get(prev, bin));
            if (f64_gt(diff, 0) == 1) { diff_sum = f64_add(diff_sum, diff); }
            bin = bin + 1;
        }
        vec_push(flux, diff_sum);
        i = i + 1;
    }

    # Normalize flux by its peak (fold over 0.0, so >= 0).
    var flux_len = vec_len(flux);
    var max_flux = 0;
    var m = 0;
    while (m < flux_len) { max_flux = f64_max(max_flux, vec_get(flux, m)); m = m + 1; }
    if (f64_gt(max_flux, 0) == 1) {
        var n = 0;
        while (n < flux_len) { vec_set(flux, n, f64_div(vec_get(flux, n), max_flux)); n = n + 1; }
    }

    # Peak-pick: flux values above threshold that are local maxima.
    var positions = vec_new();
    var strengths = vec_new();

    # flux.len().saturating_sub(1); num_frames >= 2 so flux_len >= 2.
    var upper = flux_len - 1;
    var p = 1;
    while (p < upper) {
        var fp = vec_get(flux, p);
        if (f64_gt(fp, threshold) == 1) {
            if (f64_gt(fp, vec_get(flux, p - 1)) == 1) {
                if (f64_ge(fp, vec_get(flux, p + 1)) == 1) {
                    vec_push(positions, p * hop_size);
                    vec_push(strengths, fp);
                }
            }
        }
        p = p + 1;
    }

    return dhvani_onset_make_result(positions, strengths);
}

# --- beat.cyr ---

# beat.cyr -- Beat and tempo detection via autocorrelation of the onset
# strength function. Ports rust-old/src/analysis/beat.rs. L1: deps error +
# simd + buffer + abaco + analysis + fft + stft (dhvani_stft).
#
# BeatResult had bpm (f32), confidence (f32), beat_positions (Vec<usize>).
# Here bpm/confidence are f64 slots and beat_positions is a `vec` of integer
# sample offsets. detect_tempo is fallible in Rust: the < 1s guard is an Err ->
# here returns 0 (null) so tests can check `!= 0`. STFT failure also -> 0. All
# other early-return Ok(empty/zero) cases return a valid (non-null) handle with
# bpm=0, confidence=0, empty beat_positions.
#
# The onset strength envelope here is spectral flux over EVERY STFT frame
# (envelope[0] = 0), normalized by its peak -- distinct from onset.cyr's
# peak-picked detect_onsets, so it is recomputed inline against dhvani_stft.

#derive(accessors)
struct DhBeatResult { bpm; confidence; beat_positions; }

# ---- BeatResult accessors ----
#inline
#must_use
fn dhvani_beat_bpm(self) { return DhBeatResult_bpm(self); }
#inline
#must_use
fn dhvani_beat_confidence(self) { return DhBeatResult_confidence(self); }
#inline
#must_use
fn dhvani_beat_positions(self) { return DhBeatResult_beat_positions(self); }
#inline
#must_use
fn dhvani_beat_count(self) { return vec_len(DhBeatResult_beat_positions(self)); }
#inline
#must_use
fn dhvani_beat_position(self, i) { return vec_get(DhBeatResult_beat_positions(self), i); }

# build a BeatResult from bpm + confidence + beat_positions vec.
#must_use
fn dhvani_beat_make_result(bpm, confidence, beat_positions) {
    var self = alloc(sizeof(DhBeatResult));
    DhBeatResult_set_bpm(self, bpm);
    DhBeatResult_set_confidence(self, confidence);
    DhBeatResult_set_beat_positions(self, beat_positions);
    return self;
}

# a zero result: bpm=0, confidence=0, empty beat_positions (the Ok(empty) cases).
#must_use
fn dhvani_beat_zero_result() {
    return dhvani_beat_make_result(0, 0, vec_new());
}

# Compute onset strength envelope (spectral flux per STFT frame). Returns a
# `vec` of f64 flux values (envelope[0] = 0), normalized by its peak; or 0
# (null) on STFT error, or an empty vec (non-null) when < 2 frames.
#must_use
fn dhvani_beat_onset_strength_envelope(buf, window_size, hop_size) {
    var sg = dhvani_stft(buf, window_size, hop_size);
    if (sg == 0) { return 0; }

    var num_frames = dhvani_spectrogram_num_frames(sg);
    if (num_frames < 2) { return vec_new(); }

    var num_bins = dhvani_spectrogram_num_bins(sg);

    var envelope = vec_new();
    vec_push(envelope, 0); # first frame has no previous

    var i = 1;
    while (i < num_frames) {
        var flux = 0;
        var cur = dhvani_spectrogram_frame(sg, i);
        var prev = dhvani_spectrogram_frame(sg, i - 1);
        var bin = 0;
        while (bin < num_bins) {
            var diff = f64_sub(vec_get(cur, bin), vec_get(prev, bin));
            if (f64_gt(diff, 0) == 1) { flux = f64_add(flux, diff); }
            bin = bin + 1;
        }
        vec_push(envelope, flux);
        i = i + 1;
    }

    # Normalize by peak (fold over 0.0, so >= 0).
    var env_len = vec_len(envelope);
    var max_flux = 0;
    var m = 0;
    while (m < env_len) { max_flux = f64_max(max_flux, vec_get(envelope, m)); m = m + 1; }
    if (f64_gt(max_flux, 0) == 1) {
        var n = 0;
        while (n < env_len) { vec_set(envelope, n, f64_div(vec_get(envelope, n), max_flux)); n = n + 1; }
    }

    return envelope;
}

# Autocorrelation of a signal over a lag range. result has length max_lag+1;
# result[lag] = (sum_i signal[i]*signal[i+lag]) / (n - lag) for lag in
# min_lag..=max_lag, zero elsewhere.
#inline
#must_use
fn dhvani_beat_autocorrelation(signal, min_lag, max_lag) {
    var n = vec_len(signal);
    var result = dh_vec_zeros(max_lag + 1);

    var lag = min_lag;
    while (lag <= max_lag) {
        var sum = 0;
        var count = n - lag;
        var i = 0;
        while (i < count) {
            sum = f64_add(sum, f64_mul(vec_get(signal, i), vec_get(signal, i + lag)));
            i = i + 1;
        }
        vec_set(result, lag, f64_div(sum, f64_from(count)));
        lag = lag + 1;
    }

    return result;
}

# Find the peak in the autocorrelation result. Writes best_lag, best_val,
# max_val via out-pointers (Rust returned a 3-tuple). Iterates lag from min_lag
# to len-1 (autocorr.iter().enumerate().skip(min_lag)).
fn dhvani_beat_find_peak(autocorr, min_lag, out_best_lag, out_best_val, out_max_val) {
    var best_lag = min_lag;
    var best_val = 0;
    var max_val = 0;

    var len = vec_len(autocorr);
    var lag = min_lag;
    while (lag < len) {
        var val = vec_get(autocorr, lag);
        if (f64_gt(val, max_val) == 1) { max_val = val; }
        if (f64_gt(val, best_val) == 1) { best_val = val; best_lag = lag; }
        lag = lag + 1;
    }

    store64(out_best_lag, best_lag);
    store64(out_best_val, best_val);
    store64(out_max_val, max_val);
    return 0;
}

# Extract beat positions from the onset envelope using the detected period.
# Returns a `vec` of integer sample offsets.
#must_use
fn dhvani_beat_extract_beats(buf, onset_env, hop_size, period_frames) {
    var beats = vec_new();
    var env_len = vec_len(onset_env);
    if (period_frames == 0) { return beats; }
    if (env_len == 0) { return beats; }

    var half_window = period_frames / 4;
    var total = f64_to(f64_mul(f64_from(DhAudioBuffer_frames(buf)), f64_from(DhAudioBuffer_channels(buf))));

    var pos = 0;
    while (pos < env_len) {
        # start = pos.saturating_sub(half_window)
        var start = 0;
        if (pos > half_window) { start = pos - half_window; }
        # end = (pos + half_window).min(env_len)
        var end = pos + half_window;
        if (end > env_len) { end = env_len; }

        # Find strongest onset in window; default best_idx = min(pos, env_len-1).
        var best_idx = pos;
        if (best_idx > env_len - 1) { best_idx = env_len - 1; }
        var best_strength = 0;
        var i = start;
        while (i < end) {
            var strength = vec_get(onset_env, i);
            if (f64_gt(strength, best_strength) == 1) {
                best_strength = strength;
                best_idx = i;
            }
            i = i + 1;
        }

        var sample_pos = best_idx * hop_size;
        if (sample_pos < total) { vec_push(beats, sample_pos); }

        pos = pos + period_frames;
    }

    return beats;
}

# detect_tempo(buf, min_bpm, max_bpm) -- tempo + beat positions.
# Returns a BeatResult handle, or 0 (null) if the buffer is < 1 second (Err)
# or on STFT failure. min_bpm/max_bpm are f64.
#must_use
fn dhvani_detect_tempo(buf, min_bpm, max_bpm) {
    var duration_s = f64_div(f64_from(DhAudioBuffer_frames(buf)), f64_from(DhAudioBuffer_sample_rate(buf)));
    if (f64_lt(duration_s, 1.0) == 1) { return 0; }

    # Step 1: onset strength envelope via spectral flux.
    var window_size = 2048;
    var hop_size = 512;
    var onset_env = dhvani_beat_onset_strength_envelope(buf, window_size, hop_size);
    if (onset_env == 0) { return 0; }

    if (vec_len(onset_env) < 4) { return dhvani_beat_zero_result(); }

    # Step 2: autocorrelation of the onset envelope.
    # onset_sr = sample_rate / hop_size (frames per second)
    var onset_sr = f64_div(f64_from(DhAudioBuffer_sample_rate(buf)), f64_from(hop_size));
    # min_lag = (onset_sr * 60 / max_bpm) as usize
    var min_lag = f64_to(f64_trunc(f64_div(f64_mul(onset_sr, 60.0), max_bpm)));
    # max_lag = (onset_sr * 60 / min_bpm) as usize
    var max_lag = f64_to(f64_trunc(f64_div(f64_mul(onset_sr, 60.0), min_bpm)));
    # max_lag = max_lag.min(onset_env.len() / 2)
    var half_env = vec_len(onset_env) / 2;
    if (max_lag > half_env) { max_lag = half_env; }

    if (min_lag >= max_lag) { return dhvani_beat_zero_result(); }
    if (max_lag == 0) { return dhvani_beat_zero_result(); }

    var autocorr = dhvani_beat_autocorrelation(onset_env, min_lag, max_lag);

    # Step 3: find peak -> dominant tempo.
    var best_lag_p = alloc(8);
    var best_val_p = alloc(8);
    var max_val_p = alloc(8);
    dhvani_beat_find_peak(autocorr, min_lag, best_lag_p, best_val_p, max_val_p);
    var best_lag = load64(best_lag_p);
    var best_val = load64(best_val_p);
    var max_val = load64(max_val_p);

    if (f64_le(max_val, 0) == 1) { return dhvani_beat_zero_result(); }

    var bpm = f64_div(f64_mul(onset_sr, 60.0), f64_from(best_lag));
    var confidence = f64_clamp(f64_div(best_val, max_val), 0, 1.0);

    # Step 4: extract beat positions using the detected period.
    var beat_positions = dhvani_beat_extract_beats(buf, onset_env, hop_size, best_lag);

    return dhvani_beat_make_result(bpm, confidence, beat_positions);
}

# --- synthesis.cyr ---

# synthesis.cyr -- naad synthesis engines bridged to dhvani's AudioBuffer.
# Ported from rust-old/src/synthesis/mod.rs. The Rust module is ~90 lines of
# `pub use naad::...` re-exports (no-ops in Cyrius's flat namespace: consumers
# call naad's bare symbols -- osc_new / fm_engine_new / drum_kick_new / ... --
# directly) plus two closure-based render bridges. Only the bridges carry over.
#
# Depends on: buffer.cyr (AudioBuffer) + naad (via ordered include; see
# docs/development/port-audit.md Wave F include order). Rust `impl FnMut()`
# closures -> fn-ptr + opaque state, dispatched with fncall1 / fncall3 (fnptr
# stdlib). The per-frame sample callback returns an f64 (bit pattern in the
# i64 return slot), so naad's `*_next_sample(self)` fns are valid callbacks as-is.

# render_to_buffer: call sample_fp(state) once per frame, duplicate the mono
# sample across `channels`, and assemble an interleaved AudioBuffer. Falls back
# to silence if construction fails (matches the Rust unwrap_or_else).
fn dhvani_synth_render_to_buffer(sample_fp, state, channels, frames, sample_rate) {
    var samples = vec_new();
    var i = 0;
    while (i < frames) {
        var s = fncall1(sample_fp, state);
        var c = 0;
        while (c < channels) { vec_push(samples, s); c = c + 1; }
        i = i + 1;
    }
    var buf = dhvani_buffer_from_interleaved(samples, channels, sample_rate);
    if (buf == 0) {
        var ch = channels;
        if (ch < 1) { ch = 1; }
        var sr = sample_rate;
        if (sr < 1) { sr = 1; }
        return dhvani_buffer_silence(ch, frames, sr);
    }
    return buf;
}

# render_stereo_to_buffer: sample_fp(state, out_l, out_r) writes (left, right)
# per frame through out-pointers (the Rust closure returned an (f32, f32) tuple).
fn dhvani_synth_render_stereo_to_buffer(sample_fp, state, frames, sample_rate) {
    var samples = vec_new();
    var lp = alloc(8);
    var rp = alloc(8);
    var i = 0;
    while (i < frames) {
        fncall3(sample_fp, state, lp, rp);
        vec_push(samples, load64(lp));
        vec_push(samples, load64(rp));
        i = i + 1;
    }
    var buf = dhvani_buffer_from_interleaved(samples, 2, sample_rate);
    if (buf == 0) {
        var sr = sample_rate;
        if (sr < 1) { sr = 1; }
        return dhvani_buffer_silence(2, frames, sr);
    }
    return buf;
}

# --- sampler.cyr ---

# sampler.cyr -- nidhi sample-playback engine bridged to dhvani's AudioBuffer.
# Ported from rust-old/src/sampler/mod.rs. The Rust module is `pub use nidhi::...`
# re-exports (no-ops in Cyrius's flat namespace) + one render bridge. Only the
# bridge carries over. Requires the nidhi bundle (n_engine_next_sample) to be
# included before this unit, in dependency order:
#   sakshi -> hisab -> goonj -> naad -> shravan -> nidhi   (see port-audit.md).

# render_to_buffer: pull `frames` mono samples from the engine's active voices,
# duplicate across `channels`, assemble an interleaved AudioBuffer (silence
# fallback on construction failure, matching the Rust unwrap_or_else).
fn dhvani_sampler_render_to_buffer(engine, channels, frames, sample_rate) {
    var samples = vec_new();
    var i = 0;
    while (i < frames) {
        var s = n_engine_next_sample(engine);
        var c = 0;
        while (c < channels) { vec_push(samples, s); c = c + 1; }
        i = i + 1;
    }
    var buf = dhvani_buffer_from_interleaved(samples, channels, sample_rate);
    if (buf == 0) {
        var ch = channels;
        if (ch < 1) { ch = 1; }
        var sr = sample_rate;
        if (sr < 1) { sr = 1; }
        return dhvani_buffer_silence(ch, frames, sr);
    }
    return buf;
}

# --- voice_synth.cyr ---

# voice_synth.cyr -- svara vocal synthesis bridged to dhvani's AudioBuffer.
# Ported from rust-old/src/voice_synth/mod.rs. The Rust module is ~150 lines of
# `pub use svara::...` re-exports (no-ops in Cyrius's flat namespace: consumers
# call svara's bare symbols -- svara_voice_new_male / svara_phoneme_synthesize /
# svara_tract_new / ... -- directly) plus three render bridges. Only the bridges
# carry over. The bhava_bridge.rs submodule is a separate dep-blocked file
# (bhava) and is NOT ported here.
#
# Requires the svara bundle (+ its deps naad/goonj/hisab/sakshi) included before
# this unit, in dependency order, then dhvani's error -> simd -> buffer:
#   sakshi -> hisab -> goonj -> naad -> svara -> error -> simd -> buffer.
# See docs/development/port-audit.md Wave F include order.
#
# svara synth fns return either a `vec` of f64 samples (success) or a negative
# error code (svara_is_err). The bridges convert a success vec into an
# interleaved mono AudioBuffer, or 0 (null) on synth failure -- mapping the Rust
# `crate::Result<AudioBuffer>` fallible returns to dhvani's null-handle sentinel.

# render_sequence(sequence, voice, sample_rate) -- render a PhonemeSequence to a
# mono AudioBuffer. Returns 0 (null) on synth failure or buffer-construction
# failure (matching the Rust map_err chains that produced NadaError::Dsp).
#must_use
fn dhvani_vsynth_render_sequence(sequence, voice, sample_rate) {
    var samples = svara_sequence_render(sequence, voice, f64_from(sample_rate));
    if (svara_is_err(samples) == 1) { return 0; }
    return dhvani_buffer_from_interleaved(samples, 1, sample_rate);
}

# render_phoneme(phoneme, voice, sample_rate, duration) -- render a single
# phoneme to a mono AudioBuffer. Returns 0 (null) on synth failure or buffer
# construction failure.
#must_use
fn dhvani_vsynth_render_phoneme(phoneme, voice, sample_rate, duration) {
    var samples = svara_phoneme_synthesize(phoneme, voice, f64_from(sample_rate), duration);
    if (svara_is_err(samples) == 1) { return 0; }
    return dhvani_buffer_from_interleaved(samples, 1, sample_rate);
}

# render_vocal_tract(source, tract, frames, sample_rate) -- the lowest-level
# voice bridge: pull `frames` samples from a GlottalSource through a VocalTract,
# assemble a mono AudioBuffer. Silence fallback on construction failure (matches
# the Rust unwrap_or_else). No closure needed -- the glottal/tract fns are called
# directly per frame.
#must_use
fn dhvani_vsynth_render_vocal_tract(source, tract, frames, sample_rate) {
    var samples = vec_new();
    var i = 0;
    while (i < frames) {
        var glottal = svara_glottal_next_sample(source);
        vec_push(samples, svara_tract_process_sample(tract, glottal));
        i = i + 1;
    }
    var buf = dhvani_buffer_from_interleaved(samples, 1, sample_rate);
    if (buf == 0) {
        var sr = sample_rate;
        if (sr < 1) { sr = 1; }
        return dhvani_buffer_silence(1, frames, sr);
    }
    return buf;
}

# --- g2p.cyr ---

# g2p.cyr -- text->phoneme / text->AudioBuffer bridges over shabda's G2P engine.
# Ported from rust-old/src/g2p/mod.rs. The Rust module is almost entirely
# `pub use shabda::{engine,rules,normalize,syllable,prosody,arpabet,dictionary,
# heteronym,ssml,error}` + `pub use svara::sequence::{PhonemeEvent,
# PhonemeSequence}` re-exports -- no-ops in Cyrius's flat namespace, where a
# consumer calls the bare shabda_* / svara_* / SvPhonemeEvent_* symbols directly
# once the bundles are included. Only the two text_to_phonemes / speak bridges
# carry real code, so only they carry over.
#
# Feature: `g2p` (= shabda + voice). Requires, in dependency order before this
# unit (Wave F chain -- see tests/g2p.tcyr and port-audit.md Wave F):
#   sakshi -> hisab -> goonj -> naad -> svara -> varna -> shabdakosh -> shabda
#   -> dhvani error -> simd -> buffer.
#
# shabda's fallible fns use the out-param + packed-err form (0 == ok, tested
# with shabda_is_err). The Rust `map_err(NadaError::Dsp)` chains collapse to
# dhvani's null-handle sentinel: these handle-returning bridges return 0 on any
# failure (the DHVANI_ERR_DSP signal for a handle return), exactly matching
# dhvani_vsynth_render_sequence in voice_synth.cyr.

# text_to_phonemes(engine, text) -- convert text to a vec of SvPhonemeEvent*
# handles. Returns the events vec on success, or 0 (null == DSP error) on
# empty/whitespace/invalid input (shabda_convert -> shabda_err_invalid_input).
# A successful English convert always yields a non-empty vec, so 0 is an
# unambiguous failure sentinel.
#must_use
fn dhvani_g2p_text_to_phonemes(engine, text) {
    var slot = alloc(8);
    var err = shabda_convert(engine, text, slot);
    if (shabda_is_err(err) == 1) { return 0; }
    return load64(slot);
}

# speak(engine, text, voice, sample_rate) -- G2P + voice synthesis in one call,
# to a mono AudioBuffer. sample_rate is an INTEGER (like the rest of dhvani's
# buffer API). shabda_speak wants an f64 sample_rate (the f32->f64 port rule), so
# we widen with f64_from; dhvani_buffer_from_interleaved wants the raw integer.
# shabda_speak already runs the full convert -> sequence -> render pipeline and
# emits a raw f64 sample vec (shabda_speak_with); the only seam this bridge adds
# is wrapping those samples in a mono AudioBuffer -- svara/shabda deliberately
# don't depend on dhvani. Returns the AudioBuffer handle, or 0 (null == DSP
# error) on convert/render/buffer-construction failure.
#must_use
fn dhvani_g2p_speak(engine, text, voice, sample_rate) {
    var slot = alloc(8);
    var err = shabda_speak(engine, text, voice, f64_from(sample_rate), slot);
    if (shabda_is_err(err) == 1) { return 0; }
    var samples = load64(slot);                 # vec of f64 samples
    return dhvani_buffer_from_interleaved(samples, 1, sample_rate);
}

# --- creature.cyr ---

# creature.cyr -- prani creature vocal synthesis bridged to dhvani's AudioBuffer.
# Ported from rust-old/src/creature/mod.rs. The Rust module is `pub use prani::...`
# re-exports (no-ops in Cyrius's flat namespace: consumers call prani's bare
# symbols -- crvoice_new / crvoice_vocalize / species_supports_vocalization / ...
# -- directly) plus two render bridges. Only the bridges carry over.
#
# Depends on: buffer.cyr (AudioBuffer) + prani (via ordered include; prani itself
# externalizes svara + sakshi, so those precede it -- see port-audit.md Wave F).
# crvoice_vocalize / crvoice_vocalize_with_intent return a vec ptr of mono
# samples on success or a NEGATIVE PRANI_ERR_* sentinel on failure; on failure
# we return 0 (the Rust `?` propagated a NadaError::Dsp).

# render_vocalization: vocalize the voice (mono samples), wrap in a 1-channel
# AudioBuffer. sample_rate is an integer (u32 in Rust); prani wants it as f64.
fn dhvani_creature_render_vocalization(voice, vocalization, sample_rate, duration) {
    var samples = crvoice_vocalize(voice, vocalization, f64_from(sample_rate), duration);
    if (samples < 0) { return 0; }
    return dhvani_buffer_from_interleaved(samples, 1, sample_rate);
}

# render_vocalization_with_intent: same, threading a CallIntent through prani's
# intent-modifier chain.
fn dhvani_creature_render_vocalization_with_intent(voice, vocalization, intent, sample_rate, duration) {
    var samples = crvoice_vocalize_with_intent(voice, vocalization, intent, f64_from(sample_rate), duration);
    if (samples < 0) { return 0; }
    return dhvani_buffer_from_interleaved(samples, 1, sample_rate);
}

# --- environment.cyr ---

# environment.cyr -- garjan environmental synthesis bridged to dhvani's AudioBuffer.
# Ported from rust-old/src/environment/mod.rs. The Rust module is mostly
# `pub use garjan::...` re-exports (no-ops in Cyrius's flat namespace: consumers
# call garjan's bare symbols -- rain_new / thunder_new / impact_synthesize / ...
# -- directly) plus three render bridges. Only the bridges carry over.
#
# Depends on: buffer.cyr (AudioBuffer) + garjan (via ordered include; see
# docs/development/port-audit.md Wave F include order). The Rust generic
# `render_environment<S: EnvironmentSynth>` -> fn-ptr + opaque state: the caller
# passes a `synthesize(state, duration)` fn (e.g. &rain_synthesize) that returns
# an interleaved-mono samples vec (or a negative garjan error code). render_impact
# and render_block are concrete (impact_synthesize / process_block).

# render_environment: call synth_fp(state, duration) to get a mono samples vec,
# then wrap it in an AudioBuffer. Returns a negative garjan error code if the
# synthesizer failed (matches the Rust map_err), or a silence fallback if buffer
# construction fails.
fn dhvani_env_render_environment(synth_fp, state, sample_rate, duration) {
    var samples = fncall2(synth_fp, state, duration);
    if (garjan_is_err(samples) == 1) { return samples; }
    var buf = dhvani_buffer_from_interleaved(samples, 1, sample_rate);
    if (buf == 0) {
        var sr = sample_rate;
        if (sr < 1) { sr = 1; }
        return dhvani_buffer_silence(1, vec_len(samples), sr);
    }
    return buf;
}

# render_impact: synthesize a one-shot impact of the given type, wrap in an
# AudioBuffer (silence fallback on construction failure, per the Rust map_err).
fn dhvani_env_render_impact(impact, impact_type, sample_rate) {
    var samples = impact_synthesize(impact, impact_type);
    if (garjan_is_err(samples) == 1) { return samples; }
    var buf = dhvani_buffer_from_interleaved(samples, 1, sample_rate);
    if (buf == 0) {
        var sr = sample_rate;
        if (sr < 1) { sr = 1; }
        return dhvani_buffer_silence(1, vec_len(samples), sr);
    }
    return buf;
}

# render_block: fill a `frames`-length mono buffer via block_fp(state, output),
# then assemble an interleaved AudioBuffer (silence fallback on failure, matching
# the Rust unwrap_or_else). block_fp is a process_block fn (e.g. &rain_process_block).
fn dhvani_env_render_block(block_fp, state, frames, sample_rate) {
    var samples = vec_new();
    var i = 0;
    while (i < frames) {
        vec_push(samples, 0);
        i = i + 1;
    }
    fncall2(block_fp, state, samples);
    var buf = dhvani_buffer_from_interleaved(samples, 1, sample_rate);
    if (buf == 0) {
        var sr = sample_rate;
        if (sr < 1) { sr = 1; }
        return dhvani_buffer_silence(1, frames, sr);
    }
    return buf;
}

# --- mechanical.cyr ---

# mechanical.cyr -- ghurni mechanical-sound engines bridged to dhvani's AudioBuffer.
# Ported from rust-old/src/mechanical/mod.rs. The Rust module is `pub use ghurni::...`
# re-exports (no-ops in Cyrius's flat namespace: consumers call ghurni's bare
# symbols -- ghurni_engine_new / ghurni_motor_new / ... -- directly) plus three
# render bridges. Only the bridges carry over.
#
# Requires the ghurni bundle (+ its deps sakshi -> hisab -> goonj -> naad) to be
# included before this unit, in dependency order (see port-audit.md Wave F note).
#
# The Rust `render_mechanical<S: Synthesizer>` is generic over the Synthesizer
# trait (process_block + set_rpm). In Cyrius that generic dispatch becomes a
# fn-ptr pair: `process_fp(state, out)` fills a pre-sized vec, `setrpm_fp(state,
# rpm)` retargets the RPM. Each ghurni type's `*_process_block` / `*_set_rpm` fn
# is a valid callback as-is (pass `&ghurni_motor_process_block` + the state ptr).

# render_mechanical: fill a `frames`-length mono buffer via process_fp(state,out),
# then assemble a 1-channel interleaved AudioBuffer (silence fallback on failure,
# matching the Rust unwrap_or_else).
fn dhvani_mech_render(process_fp, state, frames, sample_rate) {
    var samples = vec_new();
    var i = 0;
    while (i < frames) { vec_push(samples, 0); i = i + 1; }
    fncall2(process_fp, state, samples);
    var buf = dhvani_buffer_from_interleaved(samples, 1, sample_rate);
    if (buf == 0) {
        var sr = sample_rate;
        if (sr < 1) { sr = 1; }
        return dhvani_buffer_silence(1, frames, sr);
    }
    return buf;
}

# render_mechanical_at_rpm: set RPM via setrpm_fp(state,rpm), then render.
fn dhvani_mech_render_at_rpm(process_fp, setrpm_fp, state, rpm, frames, sample_rate) {
    fncall2(setrpm_fp, state, rpm);
    return dhvani_mech_render(process_fp, state, frames, sample_rate);
}

# render_engine(engine, rpm, load, sample_rate, duration) -> AudioBuffer or
# DHVANI_ERR_DSP. Calls ghurni_engine_synthesize (returns vec<f64> or GH_ERR_*),
# maps a synthesis error / buffer-construction failure to DHVANI_ERR_DSP.
fn dhvani_mech_render_engine(engine, rpm, load, sample_rate, duration) {
    var samples = ghurni_engine_synthesize(engine, rpm, load, duration);
    if (ghurni_is_err(samples) == 1) { return DHVANI_ERR_DSP; }
    var buf = dhvani_buffer_from_interleaved(samples, 1, sample_rate);
    if (buf == 0) { return DHVANI_ERR_DSP; }
    return buf;
}

# --- acoustics.cyr ---

# acoustics.cyr -- goonj room-simulation / FDN / ambisonics bridged into
# dhvani's AudioBuffer + ConvolutionReverb. Ported from
# rust-old/src/acoustics/mod.rs. The Rust module is mostly `pub use goonj::...`
# re-exports (no-ops in Cyrius's flat namespace: consumers call goonj's bare
# symbols -- acoustic_room_shoebox / fdn_new / new_bformat_ir / write_wav_mono /
# generate_dhvani_ir / ... -- directly). Only the module's own bridge fns +
# room presets carry over.
#
# Requires (in dependency order before this unit): sakshi -> hisab -> goonj,
# then dhvani's error -> simd -> buffer -> fft -> analysis -> convolution.
# goonj IR structs (ImpulseResponse / MultibandIr / DhvaniIr / BFormatIr / Fdn /
# WavBytes) are goonj symbols; dhvani's ConvolutionReverb lives in convolution.cyr.

# ── Bridge: generate a DhvaniIr from (x,y,z) source/listener positions ──
# Rust `generate_ir((sx,sy,sz),(lx,ly,lz), room, config)` builds Vec3s and
# defers to goonj's generate_dhvani_ir. Here we take scalar coords, build
# hisab hvec3s, and call generate_dhvani_ir.
#must_use
fn dhvani_acoustics_generate_ir(sx, sy, sz, lx, ly, lz, room, config) {
    var src = hvec3_new(sx, sy, sz);
    var lis = hvec3_new(lx, ly, lz);
    return generate_dhvani_ir(src, lis, room, config);
}

# ── Bridge: goonj ImpulseResponse -> dhvani ConvolutionReverb ──
# ConvolutionReverb::new(&ir.samples, mix, ir.sample_rate).
#must_use
fn dhvani_acoustics_convolution_from_ir(ir, mix) {
    return dhvani_conv_new(ImpulseResponse_samples(ir), mix,
        ImpulseResponse_sample_rate(ir));
}

# ── Bridge: DhvaniIr (broadband) -> ConvolutionReverb ──
#must_use
fn dhvani_acoustics_convolution_from_dhvani_ir(ir, mix) {
    return dhvani_acoustics_convolution_from_ir(dhvani_ir_ir(ir), mix);
}

# ── Multiband convolution ──
# Collapse the MultibandIr to a broadband IR, build a ConvolutionReverb, and
# process the buffer in place. Returns DHVANI_ERR_NONE.
fn dhvani_acoustics_convolve_multiband(buf, multiband, mix) {
    var broadband = multiband_ir_to_broadband(multiband);
    var reverb = dhvani_conv_new(ImpulseResponse_samples(broadband), mix,
        ImpulseResponse_sample_rate(broadband));
    dhvani_conv_process(reverb, buf);
    return DHVANI_ERR_NONE;
}

# ── FDN reverb over an AudioBuffer ──
# Sum channels to mono per frame, run through the FDN, mix wet back into all
# channels. mix is clamped to [0,1].
fn dhvani_acoustics_process_fdn(fdn, buf, mix) {
    var m = f64_clamp(mix, 0, 1.0);
    var dry = f64_sub(1.0, m);
    var ch = DhAudioBuffer_channels(buf);
    var chmax = ch;
    if (chmax < 1) { chmax = 1; }
    var frames = DhAudioBuffer_frames(buf);
    var samples = DhAudioBuffer_samples(buf);

    var frame = 0;
    while (frame < frames) {
        var mono_in = 0;
        var c = 0;
        while (c < ch) {
            mono_in = f64_add(mono_in, vec_get(samples, frame * ch + c));
            c = c + 1;
        }
        mono_in = f64_div(mono_in, f64_from(chmax));

        var wet = fdn_process_sample(fdn, mono_in);

        var c2 = 0;
        while (c2 < ch) {
            var idx = frame * ch + c2;
            var cur = vec_get(samples, idx);
            vec_set(samples, idx, f64_add(f64_mul(cur, dry), f64_mul(wet, m)));
            c2 = c2 + 1;
        }
        frame = frame + 1;
    }
    return 0;
}

# ── Ambisonics: decode a B-Format IR to a stereo AudioBuffer ──
# Cardioid decode: L = W + Y, R = W - Y. Returns 0 on length mismatch or
# buffer construction failure.
#must_use
fn dhvani_acoustics_decode_bformat_stereo(bformat) {
    var w = BFormatIr_w(bformat);
    var y = BFormatIr_y(bformat);
    var len = vec_len(w);
    if (vec_len(y) != len) { return 0; }

    var samples = vec_new();
    var i = 0;
    while (i < len) {
        var wv = vec_get(w, i);
        var yv = vec_get(y, i);
        vec_push(samples, f64_add(wv, yv));
        vec_push(samples, f64_sub(wv, yv));
        i = i + 1;
    }
    return dhvani_buffer_from_interleaved(samples, 2, BFormatIr_sample_rate(bformat));
}

# ── WAV export ──
# Write the IR as a 16-bit PCM mono WAV; returns a goonj WavBytes handle
# (data pointer + byte length). The Rust version writes into a std::io::Write;
# in Cyrius write_wav_mono materializes the bytes.
#must_use
fn dhvani_acoustics_export_ir_wav(ir) {
    return write_wav_mono(ImpulseResponse_samples(ir),
        ImpulseResponse_sample_rate(ir));
}

# ── Room presets (goonj AcousticRoom + AcousticMaterial) ──
#must_use
fn dhvani_acoustics_preset_studio() {
    return acoustic_room_shoebox(4.5, 3.5, 2.8, acoustic_material_carpet());
}
#must_use
fn dhvani_acoustics_preset_rehearsal_room() {
    return acoustic_room_shoebox(8.0, 5.0, 3.0, acoustic_material_wood());
}
#must_use
fn dhvani_acoustics_preset_concert_hall() {
    return acoustic_room_shoebox(f64_from(40), f64_from(25), f64_from(15),
        acoustic_material_concrete());
}
#must_use
fn dhvani_acoustics_preset_bathroom() {
    return acoustic_room_shoebox(2.5, f64_from(2), 2.4, acoustic_material_glass());
}
#must_use
fn dhvani_acoustics_preset_cathedral() {
    return acoustic_room_shoebox(f64_from(60), f64_from(30), f64_from(28),
        acoustic_material_concrete());
}
#must_use
fn dhvani_acoustics_preset_outdoor() {
    return acoustic_room_shoebox(f64_from(100), f64_from(100), f64_from(50),
        acoustic_material_carpet());
}

# --- playback.cyr ---

# playback.cyr -- dhvani AudioBuffer <-> vani ALSA device I/O (2.1.x feature).
#
# vani (dh(vani)'s sibling) owns raw /dev/snd PCM playback/capture via ioctls
# (no libasound, no FFI) — the real-hardware sink/source the Rust dhvani only had
# via the platform-blocked PipeWire backend. This module bridges dhvani's f64
# AudioBuffer to vani's interleaved little-endian signed PCM (S16 / S24 / S32).
#
# Requires (in dependency order before this unit): yukti -> sakshi -> vani, then
# dhvani error -> simd -> buffer. Externalizes vani exactly like the Wave F
# wrappers externalize the synthesis siblings — a consumer that wants device I/O
# links vani alongside dhvani. It references vani through FUNCTIONS ONLY (never a
# vani const/var) so the whole module DCE-prunes for vani-free consumers of the
# dist bundle. The PURE format bridges need no hardware and are unit-tested; the
# device glue needs /dev/snd. S16 helpers stay as thin wrappers (2.1.0 API).

# ── PCM format params ──────────────────────────────────────────────────────
# bytes-per-sample + full-scale for a bit depth. NB: 32-bit full-scale is
# 2147483647 (>2^24), so f64_from() — a decimal literal there would misparse.
fn dh_pcm_bytes(bit_depth) {
    if (bit_depth == 16) { return 2; }
    if (bit_depth == 24) { return 3; }
    return 4;   # 32
}
fn dh_pcm_scale(bit_depth) {
    if (bit_depth == 16) { return 32767.0; }
    if (bit_depth == 24) { return 8388607.0; }
    return f64_from(2147483647);   # 32-bit
}

# ── Pure format bridge (no vani, no hardware) ──────────────────────────────

# pack `n` f64 samples -> `dst` as little-endian signed PCM at `bit_depth`
# (clamp[-1,1] then trunc(*full-scale)). Alloc-free (caller-owned dst) -> the RT
# path uses this straight into a reusable scratch.
fn dh_pack_le(samples, n, dst, bit_depth) {
    var bytes = dh_pcm_bytes(bit_depth);
    var scale = dh_pcm_scale(bit_depth);
    var i = 0;
    while (i < n) {
        var c = f64_clamp(vec_get(samples, i), DH_NEG_ONE, 1.0);
        var v = f64_to(f64_trunc(f64_mul(c, scale)));
        var off = i * bytes;
        var b = 0;
        while (b < bytes) {
            store8(dst + off + b, (v >> (b * 8)) & 0xFF);
            b = b + 1;
        }
        i = i + 1;
    }
    return 0;
}

# unpack `n` little-endian signed PCM samples at `bit_depth` from `src` into f64
# vec `dst` (sign-extend from bit_depth bits, / full-scale).
fn dh_unpack_le(src, n, dst, bit_depth) {
    var bytes = dh_pcm_bytes(bit_depth);
    var scale = dh_pcm_scale(bit_depth);
    var i = 0;
    while (i < n) {
        var off = i * bytes;
        var v = 0;
        var b = 0;
        while (b < bytes) {
            v = v | (load8(src + off + b) << (b * 8));
            b = b + 1;
        }
        if (v >= (1 << (bit_depth - 1))) { v = v - (1 << bit_depth); }
        vec_set(dst, i, f64_div(f64_from(v), scale));
        i = i + 1;
    }
    return 0;
}

# AudioBuffer f64 -> freshly-allocated little-endian PCM at `bit_depth`
# (channels*frames*bytes). Caller owns it. RT path: use dhvani_player_push.
#must_use
fn dhvani_playback_to_pcm(buf, bit_depth) {
    var samples = dhvani_buffer_samples(buf);
    var n = vec_len(samples);
    var pcm = alloc(n * dh_pcm_bytes(bit_depth));
    dh_pack_le(samples, n, pcm, bit_depth);
    return pcm;
}
#must_use
fn dhvani_playback_to_s16le(buf) { return dhvani_playback_to_pcm(buf, 16); }

# little-endian PCM bytes at `bit_depth` -> AudioBuffer.
#must_use
fn dhvani_capture_from_pcm(pcm, frames, channels, sample_rate, bit_depth) {
    var n = frames * channels;
    var f = dh_vec_zeros(n);
    dh_unpack_le(pcm, n, f, bit_depth);
    return dhvani_buffer_from_interleaved(f, channels, sample_rate);
}
#must_use
fn dhvani_capture_from_s16le(pcm, frames, channels, sample_rate) {
    return dhvani_capture_from_pcm(pcm, frames, channels, sample_rate, 16);
}

# ── Device glue (over vani; needs /dev/snd) ────────────────────────────────

# Open + configure + start a playback device at `bit_depth`. vani handle, or 0.
fn dhvani_playback_open_fmt(card, device, sample_rate, channels, bit_depth) {
    var ores = vani_open_playback(card, device);
    if (is_ok(ores) == 0) { return 0; }
    var d = payload(ores);
    var cres = vani_configure(d, vani_format_new(sample_rate, channels, bit_depth, vani_alsa_for(bit_depth, 1)));
    if (is_ok(cres) == 0) { vani_close(d); return 0; }
    vani_start(d);
    return d;
}
fn dhvani_playback_open(card, device, sample_rate, channels) {
    return dhvani_playback_open_fmt(card, device, sample_rate, channels, 16);
}

# Convert an AudioBuffer to S16_LE and play it. Frames written, or -1.
fn dhvani_playback_write(dev, buf) {
    var frames = dhvani_buffer_frames(buf);
    var pres = vani_play(dev, dhvani_playback_to_s16le(buf), frames);
    if (is_ok(pres) == 0) { return 0 - 1; }
    return payload(pres);
}

fn dhvani_playback_close(dev) { return vani_close(dev); }

# Open + configure + start a capture device at `bit_depth`. Handle, or 0.
fn dhvani_capture_open_fmt(card, device, sample_rate, channels, bit_depth) {
    var ores = vani_open_capture(card, device);
    if (is_ok(ores) == 0) { return 0; }
    var d = payload(ores);
    var cres = vani_configure(d, vani_format_new(sample_rate, channels, bit_depth, vani_alsa_for(bit_depth, 1)));
    if (is_ok(cres) == 0) { vani_close(d); return 0; }
    vani_start(d);
    return d;
}
fn dhvani_capture_open(card, device, sample_rate, channels) {
    return dhvani_capture_open_fmt(card, device, sample_rate, channels, 16);
}

# Record `frames` at `bit_depth` into a new AudioBuffer, or 0 on failure.
#must_use
fn dhvani_capture_read_fmt(dev, frames, channels, sample_rate, bit_depth) {
    var pcm = alloc(frames * channels * dh_pcm_bytes(bit_depth));
    var rres = vani_record(dev, pcm, frames);
    if (is_ok(rres) == 0) { return 0; }
    return dhvani_capture_from_pcm(pcm, frames, channels, sample_rate, bit_depth);
}
#must_use
fn dhvani_capture_read(dev, frames, channels, sample_rate) {
    return dhvani_capture_read_fmt(dev, frames, channels, sample_rate, 16);
}

# ── Ring-buffer RT playback (lock-free, alloc-free producer) ────────────────
# A player owns a vani ring + a reusable scratch PCM buffer, so pushing a block
# converts into scratch and copies into the ring with ZERO per-block allocation
# (the free-less bump allocator demands it). The RT loop: push producer blocks,
# then drain to the device via vani_play_from_ring.

#derive(accessors)
struct DhPlayer { ring; scratch; scratch_bytes; bit_depth; }

# ring_bytes = ring capacity (rounded up to pow2 by vani); scratch is sized for
# the largest block (max_frames * channels samples at `bit_depth`).
#must_use
fn dhvani_player_new_fmt(ring_bytes, max_frames, channels, bit_depth) {
    var self = alloc(sizeof(DhPlayer));
    DhPlayer_set_ring(self, vani_ring_new(ring_bytes));
    var bytes = max_frames * channels * dh_pcm_bytes(bit_depth);
    DhPlayer_set_scratch(self, alloc(bytes));
    DhPlayer_set_scratch_bytes(self, bytes);
    DhPlayer_set_bit_depth(self, bit_depth);
    return self;
}
#must_use
fn dhvani_player_new(ring_bytes, max_frames, channels) {
    return dhvani_player_new_fmt(ring_bytes, max_frames, channels, 16);
}

# the underlying vani ring (pass to vani_play_from_ring / the drain helper).
fn dhvani_player_ring(self) { return DhPlayer_ring(self); }

# Convert an AudioBuffer into the reusable scratch and enqueue it in the ring.
# No allocation. Returns bytes written (< block bytes when the ring is full, so
# the caller should pace / retry the remainder next cycle).
fn dhvani_player_push(self, buf) {
    var samples = dhvani_buffer_samples(buf);
    var n = vec_len(samples);
    var bpp = dh_pcm_bytes(DhPlayer_bit_depth(self));
    var cap = DhPlayer_scratch_bytes(self);
    if (n * bpp > cap) { n = cap / bpp; }   # never overrun the scratch
    dh_pack_le(samples, n, DhPlayer_scratch(self), DhPlayer_bit_depth(self));
    return vani_ring_write(DhPlayer_ring(self), DhPlayer_scratch(self), n * bpp);
}

# Drain queued audio to the device (call from the RT loop after pushing).
fn dhvani_player_drain(self, dev) {
    return vani_play_from_ring(dev, DhPlayer_ring(self));
}

# ── Ring-buffer RT capture (mirror of the player) ──────────────────────────
# A recorder owns a vani ring + reusable scratch. The RT loop: fill the ring
# from the device (vani_record_to_ring), then read decoded blocks back as
# AudioBuffers. No per-block allocation on the fill side.

#derive(accessors)
struct DhRecorder { ring; scratch; scratch_bytes; bit_depth; channels; sample_rate; }

#must_use
fn dhvani_recorder_new_fmt(ring_bytes, max_frames, channels, sample_rate, bit_depth) {
    var self = alloc(sizeof(DhRecorder));
    DhRecorder_set_ring(self, vani_ring_new(ring_bytes));
    var bytes = max_frames * channels * dh_pcm_bytes(bit_depth);
    DhRecorder_set_scratch(self, alloc(bytes));
    DhRecorder_set_scratch_bytes(self, bytes);
    DhRecorder_set_bit_depth(self, bit_depth);
    DhRecorder_set_channels(self, channels);
    DhRecorder_set_sample_rate(self, sample_rate);
    return self;
}
#must_use
fn dhvani_recorder_new(ring_bytes, max_frames, channels, sample_rate) {
    return dhvani_recorder_new_fmt(ring_bytes, max_frames, channels, sample_rate, 16);
}

fn dhvani_recorder_ring(self) { return DhRecorder_ring(self); }

# Fill the ring from the device (call from the RT loop). Returns the vani result.
fn dhvani_recorder_fill(self, dev, frames) {
    return vani_record_to_ring(dev, DhRecorder_ring(self), frames);
}

# Drain up to `frames` whole frames from the ring into a new AudioBuffer (decoded
# per the recorder's bit depth). Returns a buffer of however many whole frames
# were available (0-frame buffer if the ring was empty).
#must_use
fn dhvani_recorder_read(self, frames) {
    var ch = DhRecorder_channels(self);
    var bpp = dh_pcm_bytes(DhRecorder_bit_depth(self));
    var frame_bytes = ch * bpp;
    var want = frames * frame_bytes;
    if (want > DhRecorder_scratch_bytes(self)) { want = DhRecorder_scratch_bytes(self); }
    var got = vani_ring_read(DhRecorder_ring(self), DhRecorder_scratch(self), want);
    got = (got / frame_bytes) * frame_bytes;   # floor to a whole-frame boundary
    var samples = got / bpp;
    var f = dh_vec_zeros(samples);
    dh_unpack_le(DhRecorder_scratch(self), samples, f, DhRecorder_bit_depth(self));
    return dhvani_buffer_from_interleaved(f, ch, DhRecorder_sample_rate(self));
}
