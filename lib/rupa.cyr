# rupa.cyr -- bundled distribution
# Version: 0.1.6
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# --- theme.cyr ---

# theme.cyr — rupa, the sovereign AGNOS desktop theme-token core.
#
# rupa (रूप — form / appearance) is the ONE source of the desktop's visual identity:
# the compositor chrome (aethersafha), the widget toolkit (dhancha), and apps (crab,
# jalwa) all sit above it and read the same tokens. Two aesthetics — consolidated
# from six explorations, unified by "trust made visible" —
#   MUDRA  (मुद्रा, "the seal")   — the sovereign DEFAULT: signed, radius-0, the cyan
#                                    verify-seal; trust reads LOUD.
#   SHANTA (शान्त, "stillness")   — the FOCUS mode: warm, thin, one gold firefly + sage;
#                                    trust reads QUIET (luminance).
# each in dark + light — four grounds from ONE token set.
#
# Colors are LOGICAL 0xRRGGBB (24-bit). rupa carries NO framebuffer packer — that
# keeps it a pure, dependency-light leaf. Each consumer packs a token to its own
# format via the rupa_color_r/g/b channel helpers: aethersafha → bhumi_xrgb, dhancha
# → sd_rgb, jalwa → its XRGB8888. (dhancha's DhWidget bg is already 0x00RRGGBB, so a
# rupa token is directly usable there.)

# ---- RupaTheme struct. Colors 0xRRGGBB; radius px; font PERMILLE (1000 = 1.0). ----
enum RupaThemeOff {
    RU_TH_NAME   = 0;    # str ptr — theme id, e.g. "mudra-dark"
    RU_TH_DARK   = 8;    # 1 = dark ground, 0 = light
    RU_TH_BG     = 16;   # desktop void / root background
    RU_TH_PANEL  = 24;   # panel / titlebar / card surface
    RU_TH_WIDGET = 32;   # raised widget / window body / input surface
    RU_TH_LINE   = 40;   # hairline / divider / border
    RU_TH_INK    = 48;   # primary text
    RU_TH_MUTE   = 56;   # secondary text
    RU_TH_FAINT  = 64;   # tertiary / disabled text
    RU_TH_ACCENT = 72;   # verify seal / focus / firefly — the ONE bold hue
    RU_TH_ALERT  = 80;   # unsigned / destructive / error
    RU_TH_HELD   = 88;   # pending / sandbox / held (MUDRA amber, SHANTA sage)
    RU_TH_RADIUS = 96;   # corner radius px (MUDRA 0, SHANTA 14)
    RU_TH_FONT   = 104;  # font scale PERMILLE (1000 = 1.0)
    # ⭐ THE INK THAT GOES *ON* AN ACCENT FILL (0.1.5). Every other token names a colour you paint
    # WITH; this one names the colour you must paint ON TOP OF `accent`. Without it a selected row,
    # a focused tab or a primary button can be filled but not labelled — the consumer has to guess,
    # and each consumer guesses differently.
    # ⛔ APPENDED AT THE END ON PURPOSE. Every offset above is unchanged, so a consumer reading raw
    # RU_TH_ offsets against an older build still reads the right fields; only RU_TH_SZ grows, and
    # rupa owns the allocation.
    RU_TH_ON_ACCENT = 112;
    # ⭐⭐ THE SCRIM (0.1.6) — the colour a modal backdrop dims WITH, and the ALPHA it dims AT.
    # ⛔ IT IS A TOKEN AND NOT A CONSUMER'S CHOICE, WHICH IS THE WHOLE POINT. dhancha needed a modal
    # backdrop for its sheet and had two bad options: name a colour itself (which crab's ADR 0001
    # forbids the app from doing, and which the toolkit should not do either) or fake the dim with a
    # scanline dither, which is what 0.9.23 shipped. Neither is a decision a widget toolkit gets to
    # make — how far the page recedes behind a dialogue is a PALETTE decision, and it differs between
    # a carbon void and rice paper.
    # ⚠ TWO FIELDS, NOT ONE. A scrim is a colour AND a coverage: on a dark ground the veil is the
    # void at a high alpha; on a light ground the same alpha in the same hue would black the page out.
    # Packing the alpha into the colour would collide with `sd_alpha_of`'s legacy 0-means-opaque rule.
    # ⛔ APPENDED AT THE END, for the same reason `on_accent` was: every offset above is unchanged, so
    # a consumer reading raw `RU_TH_` offsets against an older build still reads the right fields.
    RU_TH_SCRIM    = 120;   # the veil's colour
    RU_TH_SCRIM_A  = 128;   # its coverage, 0..255
    RU_TH_SZ     = 136;
}

fn rupa_theme_new(name, dark, bg, panel, widget, line, ink, mute, faint, accent, alert, held,
  radius, font, on_accent, scrim, scrim_a): i64 {
    var t = alloc(RU_TH_SZ);
    if (t == 0) { return 0; }
    store64(t + RU_TH_NAME, name);
    store64(t + RU_TH_DARK, dark);
    store64(t + RU_TH_BG, bg);
    store64(t + RU_TH_PANEL, panel);
    store64(t + RU_TH_WIDGET, widget);
    store64(t + RU_TH_LINE, line);
    store64(t + RU_TH_INK, ink);
    store64(t + RU_TH_MUTE, mute);
    store64(t + RU_TH_FAINT, faint);
    store64(t + RU_TH_ACCENT, accent);
    store64(t + RU_TH_ALERT, alert);
    store64(t + RU_TH_HELD, held);
    store64(t + RU_TH_RADIUS, radius);
    store64(t + RU_TH_FONT, font);
    store64(t + RU_TH_ON_ACCENT, on_accent);
    store64(t + RU_TH_SCRIM, scrim);
    store64(t + RU_TH_SCRIM_A, scrim_a);
    return t;
}

fn rupa_theme_name(t)    { return load64(t + RU_TH_NAME); }
fn rupa_theme_is_dark(t) { return load64(t + RU_TH_DARK); }
fn rupa_theme_bg(t)      { return load64(t + RU_TH_BG); }
fn rupa_theme_panel(t)   { return load64(t + RU_TH_PANEL); }
fn rupa_theme_widget(t)  { return load64(t + RU_TH_WIDGET); }
fn rupa_theme_line(t)    { return load64(t + RU_TH_LINE); }
fn rupa_theme_ink(t)     { return load64(t + RU_TH_INK); }
fn rupa_theme_mute(t)    { return load64(t + RU_TH_MUTE); }
fn rupa_theme_faint(t)   { return load64(t + RU_TH_FAINT); }
fn rupa_theme_accent(t)  { return load64(t + RU_TH_ACCENT); }
fn rupa_theme_alert(t)   { return load64(t + RU_TH_ALERT); }
fn rupa_theme_held(t)    { return load64(t + RU_TH_HELD); }
fn rupa_theme_radius(t)  { return load64(t + RU_TH_RADIUS); }
fn rupa_theme_font(t)    { return load64(t + RU_TH_FONT); }
fn rupa_theme_on_accent(t) { return load64(t + RU_TH_ON_ACCENT); }
# @public — the modal backdrop's colour and its coverage (0..255). See the ⛔ at `RU_TH_SCRIM`.
fn rupa_theme_scrim(t)   { return load64(t + RU_TH_SCRIM); }
fn rupa_theme_scrim_a(t) { return load64(t + RU_TH_SCRIM_A); }

# ---- 0xRRGGBB → channels (the packer-agnostic interface) ----
fn rupa_color_r(c): i64 { var v = c / 65536; return v - (v / 256) * 256; }   # (c >> 16) & 0xFF
fn rupa_color_g(c): i64 { var v = c / 256;   return v - (v / 256) * 256; }   # (c >> 8)  & 0xFF
fn rupa_color_b(c): i64 { return c - (c / 256) * 256; }                       # c & 0xFF

# ============================================================================
# Contrast (0.1.5) — so "legible on the accent" is a MEASURED property, not a claim.
# ============================================================================

# Relative luminance of 0xRRGGBB, in PERMILLE (0..1000). rupa already speaks permille
# (font scale), and there are no floats in Cyrius.
#
# ⚠ THE GAMMA IS SQUARED, NOT ^2.4. True sRGB linearization is `((c+0.055)/1.055)^2.4`,
# which needs a pow this leaf will not carry. `(c/255)^2` is the standard cheap stand-in.
# ⛔ IT IS AN APPROXIMATION AND THE RATIOS IT REPORTS ARE NOT WCAG NUMBERS — it reads
# ~13.68 where the true ratio is 12.72, and ~5.20 where the true ratio is 4.64. Use it to
# CHOOSE between inks and to catch a fill/ink pairing that is badly wrong; do not quote it
# as a compliance figure. The four shipped `on-accent` values were picked against the true
# ^2.4 computation, and the tests assert both.
fn rupa_luminance(c): i64 {
    var r = rupa_color_r(c);
    var g = rupa_color_g(c);
    var b = rupa_color_b(c);
    var rl = r * r * 1000 / 65025;               # (c/255)^2, in permille
    var gl = g * g * 1000 / 65025;
    var bl = b * b * 1000 / 65025;
    return (rl * 2126 + gl * 7152 + bl * 722) / 10000;   # ITU-R BT.709 weights
}

# Contrast ratio between two colours, x100 — so 450 is the WCAG AA floor (4.5:1) for
# normal text and 300 is the large-text floor. (L1 + 0.05) / (L2 + 0.05), and in permille
# the 0.05 offset is 50.
# ⚠ ORDER-INDEPENDENT by construction: the lighter colour is always the numerator, so
# `rupa_contrast(a, b) == rupa_contrast(b, a)`. A caller must not have to know which is
# the fill and which is the ink.
fn rupa_contrast(a, b): i64 {
    var la = rupa_luminance(a) + 50;
    var lb = rupa_luminance(b) + 50;
    if (la >= lb) { return la * 100 / lb; }
    return lb * 100 / la;
}

# Pick whichever of two inks reads better on `fill`.
# ⛔ THIS EXISTS BECAUSE THE OBVIOUS HEURISTIC IS WRONG. The usual trick — a 299/587/114
# luma against a 128 threshold — picks the LIGHT ink for MUDRA light's 0x0090A6 accent,
# where the dark ink actually reads better (4.64:1 against 3.57:1). Comparing real
# contrast gets all four grounds right; a brightness threshold does not.
# ⚠ Ties go to `ink_a`, so the caller's preferred ink wins when neither is better.
fn rupa_ink_on(fill, ink_a, ink_b): i64 {
    if (rupa_contrast(fill, ink_a) >= rupa_contrast(fill, ink_b)) { return ink_a; }
    return ink_b;
}

# ============================================================================
# The four grounds — the consolidated design's exact hexes.
# ============================================================================

# MUDRA · Carbon (dark) — the out-of-box default. Carbon void, cyan verify seal.
fn rupa_theme_mudra_dark(): i64 {
    return rupa_theme_new("mudra-dark", 1,
      0x0B0C0E, 0x14161B, 0x1B1E24, 0x262A32,
      0xE7E9EF, 0x8B92A0, 0x565C68,
      0x00E5FF, 0xFF4D4D, 0xE9A23B, 0, 1000,
      0x0B0C0E,                                    # on-accent: the carbon void. 12.72:1 on cyan.
      0x0B0C0E, 178);                              # scrim: the void at 70%. A dark ground can take it.
}

# MUDRA · Ledger (light) — the signed-artifact look on warm ledger paper.
fn rupa_theme_mudra_light(): i64 {
    return rupa_theme_new("mudra-light", 0,
      0xEFEADD, 0xF7F3E9, 0xFBF8F0, 0xD8D2C2,
      0x17191E, 0x5E636D, 0x9A947F,
      0x0090A6, 0xC21E1E, 0x946213, 0, 1000,
      0x17191E,                                    # on-accent: the ink. 4.64:1 — the TIGHTEST of the four.
      0x17191E, 102);                              # scrim: the INK at 40%. ⛔ A light ground dims with its
    # own ink and at a far lower alpha — the void at 70% would
    # black the page out rather than recede it.
}

# SHANTA · Nightfall (dark) — warm void, gold firefly, sage. radius 14.
fn rupa_theme_shanta_dark(): i64 {
    return rupa_theme_new("shanta-dark", 1,
      0x14110C, 0x1E1A13, 0x251F17, 0x312A20,
      0xECE4D4, 0xA99E8B, 0x6C6353,
      0xE9C46A, 0xD98A5B, 0x8FB27A, 14, 1000,
      0x14110C,                                    # on-accent: the warm void. 11.27:1 on gold.
      0x14110C, 178);                              # scrim: the warm void at 70%.
}

# SHANTA · First Light (light) — rice-paper cream, warm gold, sage. radius 14.
fn rupa_theme_shanta_light(): i64 {
    return rupa_theme_new("shanta-light", 0,
      0xF2ECDD, 0xFBF6EA, 0xFFFFFF, 0xE4DCC9,
      0x2B2620, 0x847B6C, 0xB3A88F,
      0xC1963A, 0xB06A3E, 0x6F7D5F, 14, 1000,
      0x2B2620,                                    # on-accent: the ink. 5.49:1 on the darker gold.
      0x2B2620, 102);                              # scrim: the ink at 40%, as MUDRA light.
}

# ---- registry: resolve a theme by id (config-driven selection) ----
# Self-contained 0-terminated byte compare (no stdlib string-eq dependency).
fn rupa_streq(a, b): i64 {
    var i = 0;
    while (1 == 1) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ca != cb) { return 0; }
        if (ca == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Build a theme by name. Returns 0 for an unknown id (caller falls back to default).
fn rupa_theme_by_name(name): i64 {
    if (rupa_streq(name, "mudra-dark") == 1)   { return rupa_theme_mudra_dark(); }
    if (rupa_streq(name, "mudra-light") == 1)  { return rupa_theme_mudra_light(); }
    if (rupa_streq(name, "shanta-dark") == 1)  { return rupa_theme_shanta_dark(); }
    if (rupa_streq(name, "shanta-light") == 1) { return rupa_theme_shanta_light(); }
    return 0;
}

# ---- active theme (the system has exactly one at a time) ----
var _rupa_active_theme = 0;

# The active theme, lazily defaulting to MUDRA · Carbon (the out-of-box look).
fn rupa_theme_active(): i64 {
    if (_rupa_active_theme == 0) { _rupa_active_theme = rupa_theme_mudra_dark(); }
    return _rupa_active_theme;
}

# Switch the active theme (e.g. from a shell theme picker or a config value).
fn rupa_theme_set_active(t): i64 {
    if (t != 0) { _rupa_active_theme = t; }
    return 0;
}

# Convenience: switch by id string; returns 1 on success, 0 if the id is unknown.
fn rupa_theme_set_active_name(name): i64 {
    var t = rupa_theme_by_name(name);
    if (t == 0) { return 0; }
    _rupa_active_theme = t;
    return 1;
}

# --- motion.cyr ---

# motion.cyr — the SYSTEM MOTION VOCABULARY: named motion roles the desktop grants and apps inherit.
#
# ⭐⭐ THE RULING THIS IMPLEMENTS (operator, 2026-08-17): *"compositor grants the motion, apps can
# override per-widget, but lets guard against any impossible or highly destructive behaviors."*
# So: one vocabulary defined here, resolved per-widget by the consumer, and **every override passes
# through a clamp** — an app may choose within the envelope, never outside it.
#
# ⚠ IT LIVES IN rupa FOR THE SAME REASON THE COLOUR TOKENS DO. The compositor's chrome and the dhancha
# toolkit and the apps must move as ONE system; a vocabulary owned by the compositor could not be read
# by a client-side toolkit (a toolkit cannot depend on the compositor), and one owned by dhancha would
# leave the compositor's own chrome inventing its own. rupa is the shared core both already read.
#
# ⛔ THIS FILE DOES NOT ANIMATE ANYTHING. It defines roles, resolves overrides, and answers "how far
# through is this, at time t" as pure arithmetic. Drawing belongs to whoever owns pixels. That split is
# what makes every guard below testable on a host with no screen and no clock.

# ============================================================================================
# THE ROLES — what the system grants
# ============================================================================================
# ⚠ ROLES, NOT DURATIONS. An app asking for "220 ms ease-out" has hardcoded a look; an app asking for
# QUICK inherits whatever the desktop decides QUICK means, and moves with everything else when that
# changes. This is exactly why the colour tokens are named `accent`/`alert` and not hex.
enum RupaMotion {
    RU_MO_INSTANT = 0;   # state changes with no travel — a checkbox, a focus ring
    RU_MO_QUICK   = 1;   # small, local acknowledgement — hover, press
    RU_MO_CALM    = 2;   # a panel opening, a window settling
    RU_MO_BUSY    = 3;   # ⭐ THE "system is working" role — periodic, and the one apps may not silence
    RU_MO_COUNT   = 4;
}

enum RupaEase {
    RU_EASE_LINEAR = 0;
    RU_EASE_OUT    = 1;   # decelerate — the default for anything arriving
    RU_EASE_IN_OUT = 2;   # symmetric — the default for anything periodic
}

# ============================================================================================
# ⛔⛔ THE GUARD ENVELOPE — the "impossible or highly destructive" bounds
# ============================================================================================
# ⚠ THE FLASH BAND IS THE ONE THAT MATTERS AND IT IS NOT A STYLE RULE. Periodic visual change between
# roughly **3 Hz and 55 Hz** is the photosensitive-epilepsy trigger band; content flashing in it can
# cause seizures. A widget that "pulses to show it is busy" at 10 Hz is inside it. ⇒ Any periodic role
# is floored at a period of `RU_MO_PERIOD_MIN_MS`, which puts its cycle at or below 3 Hz, and NO
# override can go under it. This is the single hardest limit in the file and the reason the clamp is
# not advisory.
# ⚠ A ZERO DURATION IS NOT "FAST", IT IS ABSENT. A press with no acknowledgement reads as a dead
# control — the same "responds to nothing" failure as a painted-but-inert button. Floored, not allowed.
# ⚠ AND A VERY LONG ONE READS AS HUNG. A 6-second window settle is indistinguishable from a stall, so
# the ceiling is a correctness bound on the operator's belief about the machine, not on taste.
var RU_MO_DUR_MIN_MS    = 60;      # under this, motion is not perceived — it reads as no feedback
var RU_MO_DUR_MAX_MS    = 1200;    # over this, motion reads as the machine being stuck
var RU_MO_PERIOD_MIN_MS = 340;     # ~2.94 Hz — BELOW the 3 Hz photosensitive floor. Never lower this.
var RU_MO_PERIOD_MAX_MS = 4000;    # a "working" pulse slower than this stops reading as activity

# ⭐⭐ REDUCED MOTION — the accessibility switch, and it OUTRANKS every app.
# ⛔ An app override cannot re-enable motion the system has turned off. That inversion is the whole
# point: a per-widget override is a choice WITHIN the envelope, and "the operator cannot tolerate
# motion" is the envelope. Vestibular disorders make this a harm question, not a preference one.
# ⚠ Reduced does NOT mean frozen: BUSY still reports progress, because silently removing the only
# indication that the system is working is its own failure. It collapses to a non-periodic, minimal
# form — see `rupa_motion_duration`.
var ru_motion_reduced = 0;
fn rupa_motion_reduced(): i64 { return ru_motion_reduced; }
fn rupa_motion_set_reduced(v): i64 {
    if (v != 0) { ru_motion_reduced = 1; } else { ru_motion_reduced = 0; }
    return ru_motion_reduced;
}

# ============================================================================================
# THE GRANTED VALUES
# ============================================================================================
fn rupa_motion_is_periodic(role): i64 {
    if (role == RupaMotion.RU_MO_BUSY) { return 1; }
    return 0;
}

fn rupa_motion_default_ease(role): i64 {
    if (role == RupaMotion.RU_MO_INSTANT) { return RupaEase.RU_EASE_LINEAR; }
    if (role == RupaMotion.RU_MO_BUSY)    { return RupaEase.RU_EASE_IN_OUT; }
    return RupaEase.RU_EASE_OUT;
}

# The system's granted duration for a role, in ms. INSTANT is genuinely 0 — it is a state change, not a
# travel — and is the one role exempt from the duration floor, because there is nothing to perceive.
fn rupa_motion_grant_ms(role): i64 {
    if (role == RupaMotion.RU_MO_INSTANT) { return 0; }
    if (role == RupaMotion.RU_MO_QUICK)   { return 120; }
    if (role == RupaMotion.RU_MO_CALM)    { return 260; }
    if (role == RupaMotion.RU_MO_BUSY)    { return 900; }   # one pulse period
    return 0;
}

# ============================================================================================
# ⭐⭐ THE CLAMP — every override goes through here, and it is the whole safety story
# ============================================================================================
# `want_ms` is what an app asked for; 0 or negative means "no override, use the grant".
# -> the duration the consumer must actually use.
#
# ⛔ ORDER IS LOAD-BEARING: reduced-motion is applied LAST, so it cannot be defeated by an override
# that happens to land inside the envelope. Clamping first and then checking reduced would let an app
# that asks for 900 ms get 900 ms on a machine that asked for stillness.
fn rupa_motion_duration(role, want_ms): i64 {
    if (role < 0) { return 0; }
    if (role >= RupaMotion.RU_MO_COUNT) { return 0; }
    var d = rupa_motion_grant_ms(role);
    if (want_ms > 0) { d = want_ms; }
    # INSTANT has no travel to floor; every other role does.
    if (role != RupaMotion.RU_MO_INSTANT) {
        if (rupa_motion_is_periodic(role) == 1) {
            if (d < RU_MO_PERIOD_MIN_MS) { d = RU_MO_PERIOD_MIN_MS; }
            if (d > RU_MO_PERIOD_MAX_MS) { d = RU_MO_PERIOD_MAX_MS; }
        } else {
            if (d < RU_MO_DUR_MIN_MS) { d = RU_MO_DUR_MIN_MS; }
            if (d > RU_MO_DUR_MAX_MS) { d = RU_MO_DUR_MAX_MS; }
        }
    }
    # ⛔ REDUCED MOTION, APPLIED AFTER THE CLAMP AND OUTRANKING THE APP.
    # ⚠ BUSY is NOT silenced — it keeps a slow, non-flashing period, because an app or a desktop that
    # removes the only sign the system is working has replaced motion with a lie about system state.
    if (ru_motion_reduced == 1) {
        if (rupa_motion_is_periodic(role) == 1) { return RU_MO_PERIOD_MAX_MS; }
        return 0;
    }
    return d;
}

# The easing a consumer must use. `want_ease` < 0 means "no override".
# ⚠ An unknown easing id is REFUSED back to the grant rather than clamped into a neighbour: a caller
# passing garbage should get the system's answer, not a silently different curve.
fn rupa_motion_ease(role, want_ease): i64 {
    if (ru_motion_reduced == 1) { return RupaEase.RU_EASE_LINEAR; }
    if (want_ease < 0) { return rupa_motion_default_ease(role); }
    if (want_ease > RupaEase.RU_EASE_IN_OUT) { return rupa_motion_default_ease(role); }
    return want_ease;
}

# ============================================================================================
# PROGRESS — pure arithmetic, so a consumer needs no clock of its own to be tested
# ============================================================================================
# -> 0..255, the eased position at `elapsed_ms` through a `dur_ms` motion.
# ⚠ 0..255 rather than a float: this stack is integer-first, the value feeds colour and geometry
# interpolation that is already 8-bit, and a fixed range makes the endpoints exactly representable.
# ⛔ A ZERO OR NEGATIVE DURATION ANSWERS 255 (finished), never divides. An animation that never
# completes is the "impossible behaviour" a caller would otherwise construct by accident, and a
# divide-by-zero is how it would present.
fn rupa_motion_progress(dur_ms, elapsed_ms, ease): i64 {
    if (dur_ms <= 0) { return 255; }
    if (elapsed_ms <= 0) { return 0; }
    if (elapsed_ms >= dur_ms) { return 255; }
    var t = (elapsed_ms * 255) / dur_ms;          # linear 0..255
    if (ease == RupaEase.RU_EASE_LINEAR) { return t; }
    if (ease == RupaEase.RU_EASE_OUT) {
        # 1-(1-t)^2, in 0..255 fixed point: decelerating arrival.
        var inv = 255 - t;
        return 255 - ((inv * inv) / 255);
    }
    # IN_OUT — symmetric ease, the periodic default.
    if (t < 128) { return (2 * t * t) / 255; }
    var u = 255 - t;
    return 255 - ((2 * u * u) / 255);
}

# Position within a repeating cycle. -> 0..255, rising then falling, so a pulse returns to where it
# started and never jumps.
# ⛔ THE PERIOD IS RE-FLOORED HERE, not trusted. A caller can reach this without going through
# `rupa_motion_duration`, and the flash band must not depend on which door was used.
fn rupa_motion_cycle(period_ms, elapsed_ms, ease): i64 {
    var p = period_ms;
    if (p < RU_MO_PERIOD_MIN_MS) { p = RU_MO_PERIOD_MIN_MS; }
    var e = elapsed_ms;
    if (e < 0) { e = 0; }
    var phase = e % p;
    var half = p / 2;
    if (half <= 0) { return 0; }
    if (phase < half) { return rupa_motion_progress(half, phase, ease); }
    return 255 - rupa_motion_progress(half, phase - half, ease);
}
